(def element ModalWindowPVEResults ()
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)
	(scope
		(var battleResultsStructuredEntity:dhEntity = "getSingleEntity(CC.battleResultsStructured)")

		(var private:dict = "battleResultsStructuredEntity.dataComponent.data.personal")
		(var gameData:dict = "battleResultsStructuredEntity.dataComponent.data.game_data")

		(var isWinner:bool = "private.team_id == gameData.winner_team_id")
		(var tasks:array = "gameData.tasksSorted ?: []")

		(var operationStatusIDS:str = "isWinner ? 'IDS_PVE_OPERATION_RESULTS_DONE' : 'IDS_PVE_OPERATION_RESULTS_UNDONE'")
		(var iconPath:str = "isWinner ? 'url:../pve/result_screen_bg/pve_victory.png' : 'url:../pve/result_screen_bg/pve_loss.png'")
		(var isSmallScreen:bool = "stageHeight < 900")
	)

	(style (align = "center"))

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
		(style
			(bind width "isSmallScreen ? 250px : 300px")
			(bind height "isSmallScreen ? 250px : 300px")
			(marginTop = "{720:SXS, 1080:XL}")
			(marginBottom = "XS")
		)

		(block
			(class $FullsizeAbsolute)
			(style
				(hitTest = false)
				(scaleX = 1.2)
				(scaleY = 1.2)
				(pivotX = 50%)
				(pivotY = 50%)
				(marginLeft = 50%)
				(marginTop = 50%)
				(backgroundImage = 'url:../animations/spine/round_smoke/round_smoke.skel')
				(backgroundSize = "fill")
			)
		)

		(block
			(class $Fullsize)
			(style
				(backgroundImage = "iconPath")
				(backgroundSize = "fill")
			)
		)
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1.5)
		(style (marginBottom = "LS"))
		(tf
			(bind class "isSmallScreen ? '$TextDefaultBold40NM' : '$TextDefaultBold46NM'")
			(bind text "operationStatusIDS")
		)
	)

	(scrollArea
		(style
			(width = 600px)
			(height = 100%)
		)

		(macro DEFAULT_VERTICAL_SCROLL_PARAMS
			_singleStep = "160px"
		)

		(content
			(style
				(width = 100%)
				(vgap = "SXS")
			)

			(controller $Repeat renderer='TaskItemScenarioContentForResult'
				(bind count "tasks.length")
				(args
					_taskData = "tasks[$index]"
				)
			)
		)
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
		(style
			(width = 100%)
			(align = "center")
			(marginTop = "LM")
			(marginBottom = "LM")
		)
		(element DefaultButton
			_name = 'btn_cancel'
			_label = 'IDS_NEXT_BUTTON'
			_size = "isSmallScreen ? SIZE.MEDIUM : SIZE.LARGE"
			_width = 180px
			_focusIndex = 0
			_defaultFocused = "true"
		)
	)
)

(def element TaskItemScenarioContentForResult (_taskData:dict)
	(macro DEFAULT_MODAL_WINDOW_SCOPE_EVENTS)
	(scope
		(var isPrimaryTask:bool = "_taskData.category == SC.Battle.PVE_TASK_CATEGORY.PRIMARY")

		(var isTaskSuccess:bool = "_taskData.status == SC.Battle.PVE_TASK_STATUS.SUCCESS")

		(var taskCategory:str = 	"isPrimaryTask ? 'main' : 'secondary'")
		(var taskStatusStr:str = 	"isTaskSuccess ? 'done' : 'failure'")

		(var isDefaultIcon:bool = "_taskData.bulletIcon == SC.Battle.PVE_TASK_BULLET_ICON.DEFAULT")

		(var taskIcon:str = "	isDefaultIcon && isPrimaryTask 	? 'main_task_' + taskStatusStr
																: taskCategory + '_task_' + SCENARIO_TASK_ICON[_taskData.bulletIcon]")

		(var taskIconCT:dict = "	isDefaultIcon && isPrimaryTask 	? CT_NONE :
									isTaskSuccess 					? CT_ALLY
																	: CT_ENEMY")

		(var progressText:str = "_taskData.type == SC.Battle.PVE_TASK_TYPE.DIGIT 		? '(' + _taskData.currentValue + '/' + _taskData.targetValue + ')' :
								 _taskData.type == SC.Battle.PVE_TASK_TYPE.DIGIT_SINGLE ? '(' + _taskData.currentValue + ')'
																						: ''")

		(var taskDuration:number = "_taskData.type == SC.Battle.PVE_TASK_TYPE.TIMER 			? _taskData.closeTime - _taskData.startTime :
								 	_taskData.type == SC.Battle.PVE_TASK_TYPE.REVERSED_TIMER 	? _taskData.currentValue
								 																: 0")
	)
	(style (width = 100%))

	(macro DEFAULT_MODAL_WINDOW_ANIMATION_EXPRESSION "1.5 + 1.2 * $index")

	(element TaskItemScenarioContentInTab
		_taskIcon 		= "taskIcon"
		_isTaskFailure 	= "!isTaskSuccess"
		_taskIds 		= "_taskData.text"
		_progressText 	= "progressText"
		_countdownText 	= "taskDuration > 0 ? formatTime(taskDuration, 'mm:ss', true) : ''"
		_taskIconCT 	= "taskIconCT"
	)
)