
(def element CrewCategoryReward (_size:number = "SC.Ui_styles.SIZE.SMALL", _rarity:number = "SC.Common.UNIFIED_ITEM_RARITY.COMMON")
	(scope
		(var size:number = "isIn(_size, [SC.Ui_styles.SIZE.EXTRA_LARGE, SC.Ui_styles.SIZE.LARGE]) ? SC.Ui_styles.SIZE.EXTRA_LARGE : SC.Ui_styles.SIZE.SMALL")
		(var portraitBorderSize:number = "size == SC.Ui_styles.SIZE.SMALL ? XXS : XS")
		(var baseUrl:str = '../crew_commander/backgrounds/crew_category_portrait.png')
	)

	(element CrewPortraitWithBGR
		_baseUrl =			"baseUrl"
		_rarity =			"_rarity"
		_portraitWidth =	"CREW_PORTRAIT[size].width"
		_portraitHeight =	"CREW_PORTRAIT[size].height"
		_borderSize =		"portraitBorderSize"
	)
)