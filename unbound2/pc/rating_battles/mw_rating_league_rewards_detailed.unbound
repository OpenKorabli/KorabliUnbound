(def constant MW_RATING_DETAILED_REWARDS_INFO {
	ENTERANCE:	{
		title:	'IDS_RATING_BATTLES_LEAGUE_ENTERANCE_REWARDS_TITLE',
		info:	[
			'IDS_RATING_BATTLES_LEAGUE_ENTERANCE_REWARDS_INFO_0'
		]
	},
	VICTORY:	{
		title:	'IDS_RATING_BATTLES_LEAGUE_VICTORY_REWARDS_TITLE',
		info:	[
			'IDS_RATING_BATTLES_LEAGUE_VICTORY_REWARDS_INFO_0',
			'IDS_RATING_BATTLES_LEAGUE_VICTORY_REWARDS_INFO_1'
		]
	}
})

(def element ModalWindowRatingDetailedRewardsData (_selectedLeague:number = 0)
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)
	(scope
		(event evSelectLeague)

		(var selectedLeague:number =	"_selectedLeague"	watch=false)
		(bind selectedLeague			"$event.value"		init=false	(event "evSelectLeague"))

		(var isSmallResolution:bool = "stageHeight < 800")
	)

	(name = 'ModalWindowRatingDetailedRewardsData')
	(class $Fullsize)
	(style (align = "center|middle"))

	(block
		(style (width = 1024px))

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)

			(style
				(marginBottom = "{ 720: LM, 1080: XL }")
				(width = 100%)
			)

			(element ModalWindowShortHeader
				_header = 'IDS_RATING_BATTLES_LEAGUE_REWARDS_TITLE'
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 1.5)

			(style
				(width = 100%)
				(marginBottom = "{ 720: L, 1080: LM }")
			)

			(element RatingRewardsDescriptiveParagraph
				_title = "MW_RATING_DETAILED_REWARDS_INFO['ENTERANCE'].title"
				_info = "MW_RATING_DETAILED_REWARDS_INFO['ENTERANCE'].info"
				_isSmallResolution = "isSmallResolution"
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)

			(style
				(width = 100%)
				(marginBottom = "{ 720: LM, 1080: XL }")
			)

			(element RatingRewardsDescriptiveParagraph
				_title = "MW_RATING_DETAILED_REWARDS_INFO['VICTORY'].title"
				_info = "MW_RATING_DETAILED_REWARDS_INFO['VICTORY'].info"
				_isSmallResolution = "isSmallResolution"
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 3)

			(style
				(width = 100%)
				(marginBottom = "{ 720: MS, 1080: LS }")
			)

			(element MAIN_TAB_BUTTONS_BLOCK
				(element MainTabButton
					_label =			"'IDS_RATING_BATTLES_LEAGUE_' + SC.Common.RATING_BATTLES_LEAGUES.VALUE_TO_NAME[SC.Common.RATING_BATTLES_LEAGUES.IRON]"
					_width =			"MAIN_TAB_BUTTON_WIDTH.MEDIUM"
					_isSelected =		"selectedLeague == SC.Common.RATING_BATTLES_LEAGUES.IRON"
					_dispatchedEv =		'evSelectLeague'
					_dispatchParams =	"{ value: SC.Common.RATING_BATTLES_LEAGUES.IRON }"
				)

				(element MainTabButton
					_label =			"'IDS_RATING_BATTLES_LEAGUE_' + SC.Common.RATING_BATTLES_LEAGUES.VALUE_TO_NAME[SC.Common.RATING_BATTLES_LEAGUES.BRONZE]"
					_width =			"MAIN_TAB_BUTTON_WIDTH.MEDIUM"
					_isSelected =		"selectedLeague == SC.Common.RATING_BATTLES_LEAGUES.BRONZE"
					_dispatchedEv =		'evSelectLeague'
					_dispatchParams =	"{ value: SC.Common.RATING_BATTLES_LEAGUES.BRONZE }"
				)

				(element MainTabButton
					_label =			"'IDS_RATING_BATTLES_LEAGUE_' + SC.Common.RATING_BATTLES_LEAGUES.VALUE_TO_NAME[SC.Common.RATING_BATTLES_LEAGUES.SILVER]"
					_width =			"MAIN_TAB_BUTTON_WIDTH.MEDIUM"
					_isSelected =		"selectedLeague == SC.Common.RATING_BATTLES_LEAGUES.SILVER"
					_dispatchedEv =		'evSelectLeague'
					_dispatchParams =	"{ value: SC.Common.RATING_BATTLES_LEAGUES.SILVER }"
				)

				(element MainTabButton
					_label =			"'IDS_RATING_BATTLES_LEAGUE_' + SC.Common.RATING_BATTLES_LEAGUES.VALUE_TO_NAME[SC.Common.RATING_BATTLES_LEAGUES.GOLD]"
					_width =			"MAIN_TAB_BUTTON_WIDTH.MEDIUM"
					_isSelected =		"selectedLeague == SC.Common.RATING_BATTLES_LEAGUES.GOLD"
					_dispatchedEv =		'evSelectLeague'
					_dispatchParams =	"{ value: SC.Common.RATING_BATTLES_LEAGUES.GOLD }"
				)

				(element MainTabButton
					_label =			"'IDS_RATING_BATTLES_LEAGUE_' + SC.Common.RATING_BATTLES_LEAGUES.VALUE_TO_NAME[SC.Common.RATING_BATTLES_LEAGUES.PLATINUM]"
					_width =			"MAIN_TAB_BUTTON_WIDTH.MEDIUM"
					_isSelected =		"selectedLeague == SC.Common.RATING_BATTLES_LEAGUES.PLATINUM"
					_dispatchedEv =		'evSelectLeague'
					_dispatchParams =	"{ value: SC.Common.RATING_BATTLES_LEAGUES.PLATINUM }"
				)
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 4)
			(macro DETAILED_CARD_ELEMENTS_APPEAR_ANIMATION_BY_ID
				_id = "selectedLeague"
				_positionY = 1
			)

			(style (width = 100%))

			(element RatingLeagueRewardLimitsTable
				_selectedLeague = "selectedLeague"
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 4.5)

			(style
				(width = 100%)
				(marginBottom = "M")
			)

			(element HorizontalDividerTwoPx)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 5)

			(style
				(align = "center")
				(width = 100%)
			)

			(element DefaultButton
				_name =				'btn_close'
				_label =			'IDS_CLOSE_BTN'
				_width =			160px
				_defaultFocused =	true
				_focusIndex =		0
			)
		)
	)
)

(def element RatingRewardsDescriptiveParagraph (_title:str, _info:array, _isSmallResolution:bool = false)
	(style (width = 100%))

	(tf
		(bind class "_isSmallResolution ? '$TextDefaultBold26NM' : '$TextDefaultBold30NM'")

		(style
			(width = 100%)
			(marginBottom = "MS")
			(alpha = "TA")
		)

		(bind text "_title")
	)

	(block
		(style
			(width = 100%)
			(vgap = "M")
		)

		(controller $Repeat renderer='RepeatParagraphItemNM'
			(bind count "_info.length")
			(args
				_paragraphText =	"_info[$index]"
				_width =			100%
				_alpha =			"TC"
				_size =				"SIZE.MEDIUM"
			)
		)
	)
)

(def element RatingLeagueRewardLimitsTable (_selectedLeague:number)
	(scope
		(var ratingBattlesLeagueRewards:dhCollection = "getCollectionByPath(CC.ratingBattlesLeagueReward, 'byLeague.' + _selectedLeague)")
	)
	(style
		(width = 1032px)
		(height = "{ 720: 160px, 1080: 176px}")  
	)
	(scrollArea
		(class $Fullsize)

		(macro DEFAULT_VERTICAL_SCROLL_PARAMS)

		(content
			(style
				(width = 1024px)
				(flow = "tile_horizontal")
				(hgap = "LS")
				(vgap = "M")
			)

			(controller $Repeat renderer='RatingLeagueRewardLimitsTableRow'
				(bind items "ratingBattlesLeagueRewards")
				(args
					_ratingBattlesLeagueRewardEntity = "$item"
				)
			)
		)
	)
)

(def element RatingLeagueRewardLimitsTableRow (_ratingBattlesLeagueRewardEntity:dhEntity)
	(scope
		(var ratingBattlesLeagueReward:dhComponent = "_ratingBattlesLeagueRewardEntity.ratingBattlesLeagueReward")
		(var claimedRewardsCount:number = "ratingBattlesLeagueReward.claimedCount ?: 0" (event "ratingBattlesLeagueReward.evClaimedCountChanged"))
		(var rewardsLimit:number = "ratingBattlesLeagueReward.limit")

		(struct resourceRewardSubtype = CORRECT_REWARD_RESOURCE_SUBNAME(_subtype = "ratingBattlesLeagueReward.subType"))

		(var isLootbox:bool = "ratingBattlesLeagueReward.type == SC.Common.RATING_REWARD_TYPE.LOOTBOX")
		(var headerText:str = "isLootbox	? subst('IDS_LOOTBOX_PARAMETERIZED', [], { _lootboxName: tr('IDS_REWARD_LOOTBOX_' + ratingBattlesLeagueReward.subType + '_TITLE_QUOTES') })
											: 'IDS_REWARD_' + resourceRewardSubtype.value + '_TITLE'")
		(var isReceived:bool = "claimedRewardsCount >= rewardsLimit")
	)

	(style
		(flow = "horizontal")
		(width = 492px)
		(height = 16px)
		(align = "middle")
		(bind alpha "isReceived ? 0.65 : 1")
		(macro DESATURATION_DEFAULT
			_isNotDesaturated = "!isReceived"
		)
	)

	(block
		(style (width = 100%))
		(tf
			(class $TextDefaultNM)
			(style
				(width = 100%)
				(alpha = "TA")
			)
			(bind text "headerText")
		)
	)

	(tf
		(class $TextDefaultBoldNM)
		(style (alpha = "TA"))
		(bind text "subst(	'IDS_SUBST_RATING_BATTLES_LEAGUE_REWARDS_PROGRESS', [],
							{	_currentValue: formatSeparator(claimedRewardsCount),
								_maxValue: formatSeparator(rewardsLimit)})")
	)

	(block
		(bind visible "!isLootbox")

		(style (marginLeft = "S"))

		(controller $Instance renderer = 'Currency'
			(bind enabled "!isLootbox")
			(args
				_currency = "resourceRewardSubtype.value"
			)
		)
	)
)
