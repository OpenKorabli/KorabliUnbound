(def element ModalWindowSnowflakesPremiumClaimConfirmed ()
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)
	(scope
		(event evStartHideDelayed)
	)
	(name = 'ModalWindowSnowflakesPremiumClaimConfirmed')

	(bindcall externalCall 'sound.playSetSoundDirect' "['battlepass_upgrade_bonus', 'start']" on='addedToStage')
	(bindcall externalCall 'inputMapping.onRequest' "['closeSimpleAnimatedModal', { }]" (event "evStartHideDelayed"))

	(element SimpleAnimatedContent
		_bgImage = 'url:../reward_icons/medium/snowflake.png'
		_title = "toUpper(tr('IDS_SNOWFLAKES_SIMPLE_REWARDS_CLAIM_TITLE'))"
		_status = 'IDS_SNOWFLAKES_SIMPLE_REWARDS_CLAIM_STATUS'
	)
)