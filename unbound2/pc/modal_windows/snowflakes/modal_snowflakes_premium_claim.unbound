(def element ModalWindowSnowflakesPremiumClaim ()
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)
	(scope
		(struct snowflakesPremium = PULL_PRICE(_entityId = "'SNOWFLAKES_PREMIUM'" _actionId = "SC.Common.PRICE_ACTION.BUY"))


		(var accountResourceComponent:dhComponent =	"getSingleComponent(CC.accountResource)")
		(var accountCurrencyAmount:number = "accountResourceComponent[snowflakesPremium.info.currency] ?: 0"
			(event "accountResourceComponent.evChangedGold")
			(event "accountResourceComponent.evChangedCredit")
			(event "accountResourceComponent.evChangedFreeXP")
			(event "accountResourceComponent.evChangedEliteXP")
		)

		(var isDeficit:bool = "accountCurrencyAmount < snowflakesPremium.info.finalPrice")

		(var isWarningVisible:bool = "getCollectionByPath(CC.ownShip, 'shipsHaveSnowflakes.filtered.sorted').length <= 10 && !isDeficit")
	)
	(style (align = "center|middle"))

	(block
		(style
			(width = "SNOWFLAKES_CONFIRMATION_CONTENT_WIDTH")
			(align = "center")
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)

			(element ModalWindowShortHeader
				_header = 'IDS_CONFIRMATION'
				_hasDivider = false
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 1.5)
			(element CurrenciesPanel
				_width = "SNOWFLAKES_CONFIRMATION_CONTENT_WIDTH"
				_priceInfo = "[
					{
						currency: snowflakesPremium.info.currency,
						finalPrice: -snowflakesPremium.info.finalPrice
					}
				]"
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2.5)
			(style (marginBottom = "MS"))
			(block
				(style
					(position = "absolute")
					(width = 460px)
					(height = 460px)
					(left = -110px)
					(top = -100px)
					(backgroundSize = "fill")
					(backgroundImage = 'url:../animations/spine/battlepass/bp_icon_smoke/bp_icon_smoke.skel')
				)
				(controller $Spine)
			)

			(block
				(style
					(width = 240px)
					(height = 240px)
					(backgroundImage = 'url:../reward_icons/medium/snowflake.png')
				)
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 3.5)
			(style (marginBottom = "MS"))
			(tf
				(class $TextDefaultBold18NM)
				(style (alpha = "TA"))
				(bind text "toUpper(tr('IDS_SNOWFLAKES_SIMPLE_REWARDS_CLAIM_TITLE'))")
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 4)
			(style
				(width = 100%)
				(marginBottom = "LS")
			)
			(tf
				(class $TextDefault18NM)
				(style
					(width = 100%)
					(textAlign = "center")
					(alpha = "TA")
					(leading = -1)
				)
				(htmlText = 'IDS_SNOWFLAKES_SIMPLE_REWARDS_CLAIM_REWARDS_TEXT')
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 4.2)
			(bind visible "isWarningVisible")

			(style
				(width = 100%)
				(marginBottom = "L")
				(borderRadius = "XS")
			)

			(block
				(class $FullsizeAbsolute)
				(style
					(backgroundColor = "SC.Ui_styles.SERVICE_COLORS.WHITE")
					(borderRadius = "XS")
					(alpha = 0.05)
				)
			)

			(block
				(bind visible "isWarningVisible")
				(style
					(width = 100%)
					(padding = "M")
				)
				(controller $Instance renderer='StatusLine'
					(bind enabled "isWarningVisible")
					(args
						_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.WARNING"
						_text = 'IDS_SNOWFLAKES_SIMPLE_REWARDS_CLAIM_REWARDS_WARNING'
						_width = 100%
					)
				)
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 4.2)
			(style
				(width = 100%)
				(marginBottom = "MS")
			)
			(element HorizontalDividerTwoPx)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 4.5)
			(style (marginBottom = "MS"))
			(element ModalWindowSystemPurchaseItemPriceAndInfo
				_isDeficit = "isDeficit"
				_deficit = "snowflakesPremium.info.finalPrice - accountCurrencyAmount"
				_questionString = 'IDS_QUESTION_DO_PURCHASE_FOR'
				_priceInfo = "{
					finalPrice: snowflakesPremium.info.finalPrice,
					currency: snowflakesPremium.info.currency
				}"
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 5)
			(element ModalWindowSystemPurchaseItemYesNoCloseButtons
				_customOkBtnName = 'btn_confirm_snowflakes_premium_purchase'
				_customNoBtnName = 'btn_cancel_snowflakes_premium_purchase'
				_isDeficit = "isDeficit"
				_okMethods = "[
					{
						type: 'inputMapping.onAction',
						name: 'SSEProxyCommonUSS.buySnowflakesPremium',
						args: {}
					},
					{
						type: 'inputMapping.onRequest',
						name: 'showSnowflakesPremiumClaimConfirmedMW',
						args: {}
					}
				]"
			)
		)
	)
)
