(def constant SNOWFLAKE_SORT_TYPES_LIST "
	[	'IDS_SORT_BY_LEVEL_CAPITALIZED',
		'IDS_SORT_BY_NATION_CAPITALIZED',
		'IDS_SORT_BY_SHIP_TYPE_CAPITALIZED',
		'IDS_SORT_BY_LAST_BATTLE_TIME_CAPITALIZED']
")

(def constant SNOWFLAKES_SHIP_ROW_HEIGHT 40px)


(def struct PULL_SNOWFLAKES_COMMON_INFO ()
	(var bonusTagSeasonEntity:dhEntity = "getSingleEntity(CC.bonusTagSeason, 'snowflakeSeasonCollection')")
	(var bonusTagSeason:dhComponent = "bonusTagSeasonEntity.bonusTagSeason")
	(var isSnowflakesPremiumSeasonActive:bool = "bonusTagSeasonEntity.hasComponent(CC.priceComponent)")
	(var hasSnowflakesPremium:bool = "bonusTagSeason.hasSnowflakesPremium" (event "bonusTagSeason.evChanged"))
	(var bonusSnowflakesCount:number = "bonusTagSeason.bonusSnowflakes ?: 0" (event "bonusTagSeason.evChanged"))
	(var bannerState:number = "bonusTagSeason.bannerState ?: SC.Ui_common.SNOWFLAKES_STATE.DISABLED" (event "bonusTagSeason.evBannerStateChanged"))
	(var isClaimAvailable:bool = "isSnowflakesPremiumSeasonActive && !hasSnowflakesPremium")

	
	(var minShipsCount:number = "bonusTagSeason.minShipsCount ?: 0" (event "bonusTagSeason.evBannerStateChanged"))
)

(def struct PULL_SNOWFLAKES_FILTER_INFO (_snowflakesFilterId:number = 0)
	(var component:dhComponent = "getEntity(_snowflakesFilterId).snowflakesFilter")
	(var isEnabled:bool = "component.enabled" (event "component.evEnabledChanged"))
	(var isSelected:bool = "component.selected" (event "component.evSelectedChanged"))
)

(def struct PULL_SNOWFLAKES_STATUS_DATA (_minShipsCount:number = 0)
	(var data:dict = "{
		SC.Ui_common.SNOWFLAKES_STATE.ACTIVE: {
			status: '',
			description: 'IDS_SNOWFLAKES_STATUS_ACTIVE_DESCRIPTION'
		},
		SC.Ui_common.SNOWFLAKES_STATE.NOT_ENOUGH_BONUSES: {
			status: 'IDS_SNOWFLAKES_STATUS_NOT_ENOUGH_BONUSES',
			description: 'IDS_SNOWFLAKES_STATUS_NOT_ENOUGH_BONUSES_DESCRIPTION'
		},
		SC.Ui_common.SNOWFLAKES_STATE.NOT_ENOUGH_SHIPS: {
			status: 'IDS_SNOWFLAKES_STATUS_NOT_ENOUGH_SHIPS',
			description: subst('IDS_SNOWFLAKES_STATUS_NOT_ENOUGH_SHIPS_DESCRIPTION', [], {_minShipsCount: toString(_minShipsCount)}, _minShipsCount)
		},
		SC.Ui_common.SNOWFLAKES_STATE.DISABLED: {
			status: 'IDS_SNOWFLAKES_STATUS_EMPTY',
			description: 'IDS_SNOWFLAKES_STATUS_EMPTY_DESCRIPTION'
		}
	}")
)


(def element ModalWindowSnowflakesTakeBonuses ()
	(macro MODAL_WINDOW_INIT)

	(scope
		(event ItemChooser_sortTypeChanged) 
		(event evScrollToBegin)

		(struct snowflakes = PULL_SNOWFLAKES_COMMON_INFO())
		(var shipSnowflakesList:dhCollection = "getCollectionByPath(CC.ownShip, 'shipsHaveSnowflakes.filtered.sorted')")
		(var bonusTagsFinishTime:number = "snowflakes.bonusTagSeason.finishTime ?: 0" (event "snowflakes.bonusTagSeason.evChanged"))
		(var snowflakesBackground:str = "snowflakes.bonusTagSeason.background" (event "snowflakes.bonusTagSeason.evChanged"))
		(var rewardsWithProgress:array = "snowflakes.bonusTagSeason.rewardsWithProgress ?: []" (event "snowflakes.bonusTagSeason.evChanged"))
		(var isEmptyContent:bool = "shipSnowflakesList.length == 0 ||
									snowflakes.bannerState == SC.Ui_common.SNOWFLAKES_STATE.DISABLED")

		(struct activeTip = PULL_ACTIVE_GUIDING_TIP())
		(struct checkedTipId = SAFE_CHECK_ACTIVE_TIP_ID(
			_tipId = "activeTip.tipId"
			_validValues = "[
					SC.Context_guiding_tip.TIP_TYPE.BONUS_SNOWFLAKES_COUNTER,
					SC.Context_guiding_tip.TIP_TYPE.BONUS_SNOWFLAKES_SHIPS_LIST,
					SC.Context_guiding_tip.TIP_TYPE.BONUS_SNOWFLAKES_REWARDS,
					SC.Context_guiding_tip.TIP_TYPE.BONUS_SNOWFLAKES_COUNTER_REPEAT,
					SC.Context_guiding_tip.TIP_TYPE.BONUS_SNOWFLAKES_SHIPS_LIST_REPEAT,
					SC.Context_guiding_tip.TIP_TYPE.BONUS_SNOWFLAKES_REWARDS_REPEAT
				]"
			)
		)
	)

	(bindcall externalCall
		"'inputMapping.onAction'"
		"['resortBonusTagShipsCollections', { sortOrder: $event.selectedIndex, sortReverse: $event.direction}]"
		watch=false
		(event "ItemChooser_sortTypeChanged")
	)

	(block
		(class $FullsizeAbsolute)

		(element ModalWindowAnimatedBackground
			_selectedCategory = "snowflakesBackground ?: 'snowflakes_premium'"
			_type = "snowflakesBackground ? SC.Ui_styles.ANIMATED_BG.ALMANAC_AND_SNOWFLAKES : SC.Ui_styles.ANIMATED_BG.DEFAULT"
			_hideTime = 0.2
			_hideDelay = 0.2
		)
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
		(style
			(width = 100%)
			(marginBottom = "{720:M, 1080:LM}")
		)
		(element ModalWindowHeaderFullSize
			_windowName = 'IDS_SNOWFLAKES_COMMON_TITLE'
		)
	)

	(block
		(class $Fullsize)
		(style
			(paddingLeft = "{1280:MS, 1920:XL}")
			(paddingRight = "{1280:MS, 1920:XL}")
			(paddingBottom = "{720:L, 1080:XLM}")
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
			(style
				(position = "absolute")
				(right = 0px)
			)

			(controller $Instance renderer='SnowflakesPremiumClaimButton'
				(bind enabled "!isEmptyContent && snowflakes.isClaimAvailable")
				(args
					_status = "snowflakes.bannerState"
					_minShipsCount = "snowflakes.minShipsCount"
				)
			)

			(controller $Instance renderer='SnowflakesSimpleClaimBought'
				(bind enabled "!snowflakes.isClaimAvailable")
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 3)
			(style
				(position = "absolute")
				(right = 0px)
				(bottom = 0px)
				(width = 500px)
			)

			(hblock
				(style
					(width = 100%)
					(marginBottom = "M")
					(align = "middle")
				)

				(element StatusLine
					_width = 100%
					_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.DATE"
					_text = "subst('IDS_SUBST_SNOWFLAKES_DATE_FINISH_COLON', [], {date: formatTime(bonusTagsFinishTime, 'dd.MM.yy', '', true)})"
				)

				(element DefaultButton
					_name = 'snowflakes_rules'
					_size = "SIZE.SMALL"
					_type = "SC.Ui_styles.BUTTON_TYPE.SECONDARY"
					_width = 115px
					_label = 'IDS_SNOWFLAKES_RULES_LINK_TEXT'
					_focusIndex = 4
					_methods = "[
						{
							type: 'inputMapping.onRequest',
							name: 'showSnowflakeRules',
							args: { _rulesType: 'SNOWFLAKES' }
						}
					]"
				)
			)

			(block
				(style (width = 100%))

				(element SnowflakesShipsListBg)

				(block
					(style
						(width = 100%)
						(padding = "MS")
					)

					(tf
						(class $TextDefaultBold22NM)
						(style
							(marginBottom = "M")
							(alpha = "TA")
						)
						(text = 'IDS_SNOWFLAKES_TOTAL_COLLECTED')
					)

					(block
						(style
							(width = 100%)
							(gap = "SXS")
						)
						(controller $Repeat renderer='SnowflakesRewardsListItem'
							(bind count "rewardsWithProgress.length")
							(args
								_rewardInfo = "rewardsWithProgress[$index]"
							)
						)
					)
				)

				(controller $Instance renderer='GuidingTipHub'
					(bind enabled "isIn(checkedTipId.value, [	SC.Context_guiding_tip.TIP_TYPE.BONUS_SNOWFLAKES_REWARDS,
																SC.Context_guiding_tip.TIP_TYPE.BONUS_SNOWFLAKES_REWARDS_REPEAT])")
					(args
						_tipId = "checkedTipId.value"
						_tipPositioning = "TIP_POSITION_LEFT"
						_pointerOffset = 36px
						_offsetX = "L"
						_modalWindowName = "SC.Ui_windows.MODAL.SNOWFLAKES"
						_hasFinishButton = true
					)
				)
			)
		)

		(block
			(style
				(width = 526px)
				(height = 100%)
			)

			(block
				(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
				(style
					(width = 100%)
					(marginBottom = "S")
				)

				(element SnowflakesShipsListBg)

				(block
					(style
						(width = 100%)
						(padding = "[{720:M, 1080:L}]")
					)
					(element SnowflakesStatusInfo
						_status = "snowflakes.bannerState"
						_currentValue = "snowflakes.bonusSnowflakesCount"
						_minShipsCount = "snowflakes.minShipsCount"
					)
				)
				(controller $Instance renderer='GuidingTipHub'
					(bind enabled "isIn(checkedTipId.value, [	SC.Context_guiding_tip.TIP_TYPE.BONUS_SNOWFLAKES_COUNTER,
																SC.Context_guiding_tip.TIP_TYPE.BONUS_SNOWFLAKES_COUNTER_REPEAT])")
					(args
						_tipId = "checkedTipId.value"
						_tipPositioning = "TIP_POSITION_RIGHT"
						_hasNextButton = true
						_pointerOffset = -36px
						_offsetX = "L"
						_modalWindowName = "SC.Ui_windows.MODAL.SNOWFLAKES"
					)
				)
			)

			(block
				(macro DEFAULT_MODAL_WINDOW_ANIMATION 3)
				(class $Fullsize)
				(controller $Instance renderer='SnowflakesShipSelectPanel'
					(bind enabled "!isEmptyContent")
				)
				(controller $Instance renderer='GuidingTipHub'
					(bind enabled "isIn(checkedTipId.value, [	SC.Context_guiding_tip.TIP_TYPE.BONUS_SNOWFLAKES_SHIPS_LIST,
																SC.Context_guiding_tip.TIP_TYPE.BONUS_SNOWFLAKES_SHIPS_LIST_REPEAT])")
					(args
						_tipId = "checkedTipId.value"
						_tipPositioning = "TIP_POSITION_RIGHT"
						_hasNextButton = true
						_pointerOffset = -36px
						_offsetX = "L"
						_modalWindowName = "SC.Ui_windows.MODAL.SNOWFLAKES"
					)
				)
			)
		)
	)
)

(def element SnowflakesPremiumClaimButton (_status:number = 0)
	(scope
		(struct snowflakesPremium = PULL_PRICE(_entityId = "'SNOWFLAKES_PREMIUM'" _actionId = "SC.Common.PRICE_ACTION.BUY"))
		(var accountResourceComponent:dhComponent =	"getSingleComponent(CC.accountResource)")
		(var accountCurrencyAmount:number = "accountResourceComponent[snowflakesPremium.info.currency] ?: 0"
			(event "accountResourceComponent.evChangedGold")
			(event "accountResourceComponent.evChangedCredit")
			(event "accountResourceComponent.evChangedFreeXP")
			(event "accountResourceComponent.evChangedEliteXP")
		)

		(var isDeficit:bool = "accountCurrencyAmount < snowflakesPremium.info.finalPrice")
		(var isWarningReason:bool = "_status == SC.Ui_common.SNOWFLAKES_STATE.NOT_ENOUGH_SHIPS && !isDeficit")
		(var isButtonEnabled:bool = "_status != SC.Ui_common.SNOWFLAKES_STATE.NOT_ENOUGH_SHIPS && !isDeficit")
	)
	(style
		(flow = "horizontal")
		(align = "middle")
	)

	(controller $Tooltip
		(renderer = 'SimpleStatusTooltip')
		(bind enabled "isWarningReason")
		(args
			_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.ATTENTION"
			_text = "	_status == SC.Ui_common.SNOWFLAKES_STATE.NOT_ENOUGH_SHIPS	? 'IDS_SNOWFLAKES_STATUS_NOT_ENOUGH_SHIPS'
																					: 'IDS_SNOWFLAKES_STATUS_EMPTY'"
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR)
	)

	(controller $Tooltip
		(renderer = 'SnowflakesPremiumResourceDeficitTooltip')
		(bind enabled "isDeficit")
		(args
			_priceInfo = "{
				finalPrice: snowflakesPremium.info.finalPrice,
				accountCurrencyAmount: accountCurrencyAmount,
				currency: snowflakesPremium.info.currency
			}"
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR)
	)

	(block
		(bind visible "isButtonEnabled")
		(style
			(hitTest = false)
			(position = "absolute")
			(top = -80px)
			(left = -82px)
			(width = 250px)
			(height = 250px)
			(backgroundImage = 'url:../animations/spine/rewards/reward_states/available.skel')
			(backgroundSize = "cover")
		)
		(controller $Spine)
	)

	(block
		(bind visible "isButtonEnabled")
		(style
			(hitTest = false)
			(width = 80px)
			(height = 80px)
			(marginRight = -40px)
			(backgroundImage = 'url:../reward_icons/snowflake.png')
			(backgroundSize = "cover")
			(zindex = 1)
		)
	)

	(block
		(style (zindex = 0))
		(block
			(bind visible "isButtonEnabled")
			(class $FullsizeAbsolute)
			(style
				(hitTest = false)
				(backgroundSize = "cover")
				(backgroundImage = 'url:../animations/spine/battlepass/button_purchase/glow.skel')
			)
			(controller $Spine)
		)

		(element DefaultButton
			_name = 'simple_rewards_claim_btn'
			_label = 'IDS_SNOWFLAKES_SIMPLE_REWARDS_CLAIM_BUTTON'
			_width = 300px
			_focusIndex = 3
			_size = "SIZE.LARGE"
			_type = "SC.Ui_styles.BUTTON_TYPE.SECONDARY"
			_enabled = "isButtonEnabled"
			_methods = "[
				{
					type: 'inputMapping.onRequest',
					name: 'showSnowflakesPremiumClaimMW',
					args: { }
				}
			]"
		)
	)
)

(def element SnowflakesPremiumResourceDeficitTooltip (_priceInfo:dict = {})
	(style (width = 350px))

	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TooltipSystemHeaderSubheaderText
			_headerText = 'IDS_NOT_ENOUGH_FUNDS'
		)
		(element TooltipSystemHorizontalDivider)

		(element TooltipSystemStatusLine
			_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.ATTENTION"
			_text = 'IDS_NOT_ENOUGH_FUNDS'
		)
		(element TooltipSystemHorizontalDivider)
		(element TOOLTIP_SYSTEM_ELEMENTS_GROUP
			(element TOOLTIP_SYSTEM_GROUP_ELEMENT
				(element PriceTagWithLabel
					_width = 100%
					_label = 'IDS_COST'
					_priceInfo = "{finalPrice: _priceInfo.finalPrice, currency: _priceInfo.currency}"
				)
			)
			(element TOOLTIP_SYSTEM_GROUP_ELEMENT
				(element PriceTagWithDeficitAndLabelRow
					_priceInfo = "{ finalPrice: _priceInfo.finalPrice - _priceInfo.accountCurrencyAmount, currency: _priceInfo.currency }"
					_title = 'IDS_NOT_ENOUGH'
				)
			)
		)
	)
)

(def element SnowflakesShipsListBg ()
	(class $FullsizeAbsolute)

	(block
		(class $Fullsize)
		(element BlurMapRoundedWithLayerContrastPanel)
	)

	(block
		(class $FullsizeAbsolute)
		(style
			(backgroundColor = "SC.Ui_styles.SERVICE_COLORS.WHITE")
			(borderRadius = "XS")
			(alpha = 0.05)
		)
	)
)


(def element SnowflakesSimpleClaimBought ()
	(style (width = 500px))

	(element SnowflakesShipsListBg)

	(block
		(style
			(width = 100%)
			(padding = "MS")
		)

		(tf
			(class $TextDefaultBold22NM)
			(style
				(width = 100%)
				(marginBottom = "M")
				(alpha = "TA")
			)
			(text = 'IDS_SNOWFLAKES_SIMPLE_REWARDS_CLAIM_BOUGHT_TITLE')
		)

		(tf
			(class $TextDefaultNM)
			(style
				(width = 100%)
				(alpha = "TA")
			)
			(text = 'IDS_SNOWFLAKES_SIMPLE_REWARDS_CLAIM_BOUGHT_TEXT')
		)
	)
)


(def element SnowflakesCounter (	_title:str = '',
									_currentValue:number = 0,
									_maxValue:number = 0,
									_isDividedCounter:bool = false,
									_isWarningStatus:bool = false)
	(style
		(width = 100%)
		(flow = "horizontal")
	)

	(tf
		(class $TextDefaultBold22NM)
		(style
			(width = 100%)
			(alpha = "TA")
		)
		(bind text "_title")
	)

	(tf
		(class $TextDefaultBold22NM)
		(style
			(bind textColor "_isWarningStatus	? SC.Ui_styles.SERVICE_COLORS.ORANGE
												: SC.Ui_styles.SERVICE_COLORS.WHITE")
			(bind alpha "_isWarningStatus ? 1 : TA")
		)
		(bind text "formatSeparator(_currentValue)")
	)

	(tf
		(bind visible "_isDividedCounter")
		(class $TextDefault22NM)
		(style (alpha = "TS"))
		(bind text "' /' + formatSeparator(_maxValue)")
	)
)

(def element SnowflakesStatusInfo (	_currentValue:number = 0,
									_status:number = 0,
									_minShipsCount:number = 0)
	(scope
		(struct status = PULL_SNOWFLAKES_STATUS_DATA(_minShipsCount="_minShipsCount"))
		(var isWarningStatus:bool = "_status != SC.Ui_common.SNOWFLAKES_STATE.ACTIVE")
	)
	(style (width = 100%))

	(block
		(style
			(width = 100%)
			(marginBottom = "M")
		)

		(controller $Instance renderer='SnowflakesCounter'
			(bind enabled "_status != SC.Ui_common.SNOWFLAKES_STATE.DISABLED")
			(args
				_title = 'IDS_SNOWFLAKES_COUNTER'
				_currentValue = "_currentValue"
				_isWarningStatus = "isWarningStatus"
			)
		)
	)

	(block
		(style (bind marginBottom "isWarningStatus ? M : 0px"))
		(controller $Instance renderer='StatusLine'
			(bind enabled "isWarningStatus")
			(args
				_text = "status.data[_status].status"
				_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.ATTENTION"
			)
		)
	)

	(tf
		(class $TextDefaultNM)
		(style
			(width = 100%)
			(alpha = "TA")
		)
		(bind text "status.data[_status].description")
	)
)

(def element SnowflakeRewardsFromShips (_rewards:array)
	(style
		(width = 100%)
		(vgap = "XS")
	)

	(tf
		(class $TextDefault18NM)
		(style (alpha = "TA"))
		(text = 'IDS_SNOWFLAKES_TAKE_BONUSES_REWARDS_COLON')
	)

	(hblock
		(controller $Repeat renderer='RewardItemAdapter'
			(bind count "_rewards.length")
			(args
				_entityId = "_rewards[$index]"
			)
		)
	)
)

(def element SnowflakesRewardsListItem (_rewardInfo:array = [])
	(scope
		(var isCompleted: bool = "_rewardInfo[1] == _rewardInfo[2]")
	)

	(style
		(width = 100%)
		(flow = "horizontal")
		(bind alpha "isCompleted ? TS : TA")
	)

	(element RewardTitle
		_rewardEntityId = "_rewardInfo[0]"
		_fontClass = '$TextDefaultNM'
		_isAutoSized = false
	)

	(tf
		(class $TextDefaultBoldNM)
		(bind text "formatSeparator(_rewardInfo[1])")
	)

	(tf
		(class $TextDefaultNM)
		(bind text "' /' + formatSeparator(_rewardInfo[2])")
	)
)

(def element SnowflakesShipSelectPanel ()
	(scope
		(event evScrollToBegin)

		(struct sortOrderTypePref = GET_PREF_NUMBER(_option="'ui.snowflakes.sorting.snowflakesSortType'") )
		(struct sortOrderDirectionPref = GET_PREF_BOOL(_option="'ui.snowflakes.sorting.snowflakesSortDirection'"))

		(struct snowflakes = PULL_SNOWFLAKES_COMMON_INFO())
		(var isAplliedFilterVisible:bool = "toBool(snowflakes.bonusTagSeason.filterTag)" (event "snowflakes.bonusTagSeason.evChanged"))

		
		(var rewards:array = "snowflakes.bonusTagSeasonEntity.rewardsStack.rewards" (event "snowflakes.bonusTagSeasonEntity.rewardsStack.evChanged"))

		(var playerShips:dhCollection = "getCollection(CC.ownShip)")
		(var shipSnowflakesList:dhCollection = "getCollectionByPath(CC.ownShip, 'shipsHaveSnowflakes.filtered.sorted')")
		(var selectedShips:dhCollection = "getCollectionByPath(CC.ownShip, 'shipsHaveSnowflakes.selected')")

		(var isMaxBonusesPicked:bool = "selectedShips.length == snowflakes.bonusSnowflakesCount")
		(var isAnyBonusesPicked:bool = "selectedShips.length > 0")

		(var hasNotEnoughShips:bool = "playerShips.length < snowflakes.minShipsCount")
		(var hasNotEnoughBonuses:bool = "snowflakes.bonusSnowflakesCount > 0")
		(var hasRewardsToShow:bool = "hasNotEnoughBonuses && isAnyBonusesPicked")
		(var hasShipsToSelect:bool = "hasNotEnoughBonuses && !isAnyBonusesPicked")

		(var isInfotipVisible:bool = false)

		(struct activeTip = PULL_ACTIVE_GUIDING_TIP())
		(struct checkedTipId = SAFE_CHECK_ACTIVE_TIP_ID(
			_tipId = "activeTip.tipId"
			_validValues = "[
					SC.Context_guiding_tip.TIP_TYPE.BONUS_SNOWFLAKES_AUTOCHOICE,
					SC.Context_guiding_tip.TIP_TYPE.BONUS_SNOWFLAKES_AUTOCHOICE_REPEAT
				]"
			)
		)
	)
	(dispatch evScrollToBegin (bind enabled "isMaxBonusesPicked") (bind trigger "isMaxBonusesPicked"))

	(class $Fullsize)

	(block
		(class $FullsizeAbsolute)
		(element SnowflakesShipsListBg)
	)

	(block
		(class $Fullsize)
		(style
			(padding = "[{720:M, 1080:L}]")
			(bind hitTest "hasNotEnoughBonuses")
			(bind alpha "hasNotEnoughBonuses ? 1 : 0.5")
		)

		(element SnowflakesCounter
			_isDividedCounter = true
			_title = 'IDS_SNOWFLAKES_SHIPS_LIST_COUNTER'
			_currentValue = "selectedShips.length"
			_maxValue = "snowflakes.bonusSnowflakesCount"
		)

		(tf
			(class $TextDefaultNM)
			(style
				(width = 100%)
				(marginTop = "M")
				(alpha = "TA")
			)
			(text = 'IDS_SNOWFLAKES_SHIPS_LIST_COUNTER_DESCRIPTION')
		)

		(hblock
			(style
				(width = 100%)
				(marginTop = "{720:S, 1080:MS}")
				(marginBottom = "S")
			)

			(hblock
				(style
					(width = 100%)
					(height = "CAROUSEL_APPLIED_FILTER_HEIGHT")
				)

				(block
					(style
						(marginTop = "XS")
						(marginRight = "XXS")
					)
					(element ImageButton
						_name = 'SnowflakesFiltersButton'
						_width = 26px
						_height = 24px
						_mouseDown = "isInfotipVisible"
						_backgroundImage = 'url:../service_kit/buttons/context/filter.png'
					)

					(controller $Tooltip
						(renderer = 'SimpleStatusTooltip')
						(args
							_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.MOUSE_LEFT"
							_text = 'IDS_TOOLTIP_CAROUSEL_FILTERS'
						)
						(macro DEFAULT_TOOLTIP_BEHAVIOUR "0")
					)

					(controller $Tooltip
						(renderer = 'SnowflakesFiltersInfotip')
						(cache = true)
						(macro CAROUSEL_INFOTIP_BEHAVIOUR "1")
						(screenBoundsOffset = "XS")

						(bind isInfotipVisible "true" init=false watch=false on='evStartShow')
						(bind isInfotipVisible "false" init=false watch=false on='evHide')
					)
				)

				(block
					(controller $Instance renderer='AppliedSnowflakeFilters'
						(bind enabled "isAplliedFilterVisible")
					)
				)
			)

			(block
				(style
					(marginLeft = "M")
					(marginTop = "XS")
				)

				(element ImageButton
					_name = "'snowflakesSortOrder_' + (sortOrderDirectionPref.value ? 'up' : 'down')"
					_width = 24px
					_height = 24px
					_backgroundImage = "sortOrderDirectionPref.value	? 'url:../service_kit/buttons/icons/sort_up.png'
																		: 'url:../service_kit/buttons/icons/sort_down.png'"
					_methods = "[
						{
							type: 'inputMapping.onAction',
							name: 'resortBonusTagShipsCollections',
							args: {
								sortOrder: sortOrderTypePref.value,
								sortReverse: !sortOrderDirectionPref.value
							}
						}
					]"
				)

				(controller $Tooltip
					(renderer='SimpleStatusTooltip')
					(args
						_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.MOUSE_LEFT"
						_text = 'IDS_HINT_SHIP_FILTERING_SORT_SET_REVERSE'
					)
					(macro DEFAULT_TOOLTIP_BEHAVIOUR)
				)
			)

			(element ItemChooser
				_name = 'snowflakes_itemChooser'
				_items = "SNOWFLAKE_SORT_TYPES_LIST"
				_listItemRenderer = 'TextListItemRenderer'
				_curIndex = "sortOrderTypePref.value"
				_itemChooserTooltipText = 'IDS_HINT_SHIP_CAROUSEL_SORT'
				_dropDownWidth = 185px
				_onItemSelectedEvent = 'sortTypeChanged'
				_curDirection = "sortOrderDirectionPref.value"
			)
		)

		(scrollArea
			(class $Fullsize)

			(macro DEFAULT_VERTICAL_SCROLL_PARAMS
				_singleStep = "SNOWFLAKES_SHIP_ROW_HEIGHT"
				_wheelScrollAcceleration = "0.95"
				_isContrastScrollBar = "true"
			)

			(scrollPerItem = true)
			(repeatController = 'snowflakesShipRowSelectableElement')

			(content
				(class $Fullsize)
				(style
					(flow = "tile_horizontal")
					(gap = "S")
				)

				(controller $DynamicRepeat renderer='SelectShipForSnowflakeReward' name='snowflakeShipController'
					(bind count "shipSnowflakesList.length" (event "shipSnowflakesList.evAdded") (event "shipSnowflakesList.evRemoved"))
					(args
						_shipId = "shipSnowflakesList.getEntityAtIndex($index).ship.id"
						_isMaxBonusesPicked = "isMaxBonusesPicked"
						_isNotEnoughShips = "hasNotEnoughShips"
					)
					(itemWidth = 224px)
					(itemHeight = "SNOWFLAKES_SHIP_ROW_HEIGHT")
					(itemOffset = "SNOWFLAKES_SHIP_ROW_HEIGHT")
				)
			)
			(bindcall scrollToBegin maxAnimatedDistance=100 (event "evScrollToBegin"))
		)

		(block
			(style
				(width = 100%)
				(marginTop = "{720:S, 1080:MS}")
				(marginBottom = "{720:S, 1080:MS}")
			)
			(element HorizontalDividerTwoPx)
		)

		(block
			(controller $Instance renderer='SnowflakeRewardsFromShips'
				(bind enabled "hasRewardsToShow && !hasNotEnoughShips")
				(args
					_rewards = "rewards"
				)
			)

			(controller $Instance renderer='StatusLine'
				(bind enabled "hasShipsToSelect")
				(args
					_text = 'IDS_SNOWFLAKES_STATUS_NO_SELECTED_SHIPS'
				)
			)
		)

		(hblock
			(style (marginTop = "{720:S, 1080:MS}"))

			(block
				(style (marginRight = "M"))

				(controller $Tooltip
					(renderer ='SimpleStatusTooltip')
					(args
						_text = "hasNotEnoughBonuses && isMaxBonusesPicked	? 'IDS_SNOWFLAKES_TOOLTIP_DESELECT_ALL_SHIPS'
																			: 'IDS_SNOWFLAKES_SELECT_SEVERAL_SHIPS'"
					)
					(macro DEFAULT_TOOLTIP_BEHAVIOUR)
				)

				(element DefaultButton
					_name = "isMaxBonusesPicked ? 'shipsChoiceBtn_unistallAll' : 'shipsChoiceBtn_autoselect'"
					_width = 160px
					_focusIndex = 2
					_type = "SC.Ui_styles.BUTTON_TYPE.SECONDARY"
					_label = "isMaxBonusesPicked ? 'IDS_SNOWFLAKES_UNINSTALL_ALL' : 'IDS_SNOWFLAKES_AUTOSELECT'"
					_enabled = "snowflakes.bannerState == SC.Ui_common.SNOWFLAKES_STATE.ACTIVE"
					_methods = "[
						{
							type: 'inputMapping.onAction',
							name: 'selectFirstShips',
							args: {selectionState: !isMaxBonusesPicked}
						}
					]"
				)

				(controller $Instance renderer='GuidingTipHub'
					(bind enabled "isIn(checkedTipId.value, [	SC.Context_guiding_tip.TIP_TYPE.BONUS_SNOWFLAKES_AUTOCHOICE,
																SC.Context_guiding_tip.TIP_TYPE.BONUS_SNOWFLAKES_AUTOCHOICE_REPEAT])")
					(args
						_tipId = "checkedTipId.value"
						_tipPositioning = "TIP_POSITION_RIGHT"
						_hasNextButton = true
						_pointerOffset = -36px
						_offsetX = "L"
						_modalWindowName = "SC.Ui_windows.MODAL.SNOWFLAKES"
					)
				)
			)

			(element DefaultButton
				_isGUIEventLocked = true
				_defaultFocused = true
				_focusIndex = 1
				_width = 160px
				_label = 'IDS_SNOWFLAKES_TAKE_BONUSES_BUTTON'
				_enabled = "isAnyBonusesPicked && !hasNotEnoughShips"
				_methods = "[
					{
						type: 'inputMapping.onRequest',
						name: 'snowflakesConfirmChoice',
						args: {}
					},
					{
						type: 'inputMapping.onAction',
						name: 'takeSelectedBonuses',
						args: {}
					}
				]"
			)

		)
	)
)

(def element SnowflakesRewardsShipStatusTooltip (_paragraphs:array)
	(style (width = "DEFAULT_TOOLTIP_WIDTH"))

	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TooltipSystemStatusMultiparagraph
			_unifiedStatus		= "SC.Ui_styles.UNIFIED_STATUS.MOUSE_LEFT"
			_paragraphs			= "_paragraphs"
		)
	)
)

(def element SelectShipForSnowflakeReward (	_shipId:number,
											_isMaxBonusesPicked:bool = false,
											_isNotEnoughShips:bool = false,
											_isViewOnly:bool=false)
	(scope
		(var shipEntity:dhEntity = "getPrimaryEntity(CC.ship, _shipId)")
		(var isSnowflakeShipSelected:bool =	"shipEntity.ship.isSelectedForSnowflakes" (event "shipEntity.ship.evIsSelectedForSnowflakesChanged"))

		(var bonusTagIndex:number =		"shipEntity.ship.bonusTags.length == 1 ? 0 : 1")
		(var bonusTagEntityId:number =	"shipEntity.ship.bonusTags[bonusTagIndex]")
		(var bonusTagEntity:dhEntity =	"getEntity(bonusTagEntityId)")
		(var rewards:array =			"bonusTagEntity.bonusTag.rewards")
	)

	(style
		(width = 224px)
		(height = "SNOWFLAKES_SHIP_ROW_HEIGHT")
	)

	(controller $Tooltip
		(renderer = 'SnowflakesRewardsTooltip')
		(args
			_rewards =			"rewards"
			_isSelected =		"isSnowflakeShipSelected"
			_isConfirmAction =	"_isViewOnly"
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR)
	)

	(element ShipRowSelectableElement
		_hasMouseInstructions = false
		_rowHeight = "SNOWFLAKES_SHIP_ROW_HEIGHT"
		_width = '100%'
		_shipId = "_shipId"
		_isInactive = "_isMaxBonusesPicked && !isSnowflakeShipSelected || _isNotEnoughShips"
		_isSelected = "isSnowflakeShipSelected"
		_rewards = "rewards"
		_isViewOnly = "_isViewOnly"
		_methods = "[
			{
				type: _isViewOnly ? '' : 'inputMapping.onAction',
				name: 'changeSelection',
				args: {
					shipId: _shipId,
					selectionState: !isSnowflakeShipSelected
				}
			}
		]"
	)
)

(def element SnowflakesFiltersInfotip ()
	(scope
		(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND_SCOPE)
		(var snowflakesFilters:dhCollection = "getCollection(CC.snowflakesFilter)")
	)
	(macro HIDE_UI_ON_SHIPOVERVIEW)
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND_MARKUP _isInfotip="true")
	(name = 'SnowflakesFilterInfotip')

	(element INFOTIP_SYSTEM_DEFAULT_CONTAINER _isAutoSize=true
		(style
			(width = 150px)
			(paddingLeft = "SXS")
			(paddingRight = "SXS")
			(paddingBottom = "SXS")
			(align = "center")
		)
		(block
			(style
				(align = "middle")
				(height = 30px)
				(marginTop = "S")
				(marginBottom = "S")
			)

			(tf
				(class $TextDefaultBold18NM)
				(style (alpha = "TA"))
				(text = 'IDS_SNOWFLAKES_FILTERS')
			)
		)

		(block
			(style
				(width = 100%)
				(paddingTop = "M")
				(paddingBottom = "M")
				(vgap = "S")
				(align = "center")
				(borderRadius = "XS")
				(backgroundColor = "SC.Ui_styles.SERVICE_COLORS.INNER_PANEL")
			)

			(controller $Repeat renderer='SnoflakesFilterItem'
				(bind count "snowflakesFilters.length")
				(args
					_snowflakesFilterId = "snowflakesFilters.getEntityAtIndex($index).id"
				)
			)
		)
	)
)

(def element SnoflakesFilterItem (_snowflakesFilterId:number = 0)
	(scope
		(struct snowflakesFilter = PULL_SNOWFLAKES_FILTER_INFO(_snowflakesFilterId="_snowflakesFilterId"))
	)

	(element ImageRadioButton
		_name = "'snowflakesFilterItem_' + $index"
		_size = "SIZE.LARGE"
		_renderElement = 'SnowflakesFilterText'
		_renderArgs = "{_shipLevelsGroup: snowflakesFilter.component.type}"
		_enabled = "snowflakesFilter.isEnabled"
		_selected = "snowflakesFilter.isSelected"
		_methods = "snowflakesFilter.isEnabled	?	[{
														type: 'inputMapping.onAction',
														name: 'snowflakesFilterUpdated',
														args: {groupType: snowflakesFilter.component.type}
													}]
												:	[]"
	)

	(controller $Tooltip
		(renderer ='SnoflakesFilterItemTooltip')
		(args
			_snowflakesFilterId = "_snowflakesFilterId"
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR)
	)
)

(def element SnowflakesFilterText (_params:dict)
	(tf
		(class $TextDefault18NM)
		(style (alpha = "TA"))
		(bind text "_params._shipLevelsGroup")
	)
)

(def element SnoflakesFilterItemTooltip (_snowflakesFilterId:number = 0)
	(scope
		(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND_SCOPE)

		(struct snowflakesFilter = PULL_SNOWFLAKES_FILTER_INFO(_snowflakesFilterId = "_snowflakesFilterId"))
	)

	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND_MARKUP)
	(style (width = "DEFAULT_TOOLTIP_WIDTH"))

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TooltipSystemHeaderSubheaderText
			_headerText = "subst('IDS_SUBST_SNOWFLAKES_FILTER_ITEM_TOOLTIP_TITLE', [], {_shipLevel: snowflakesFilter.component.type})"
		)
		(element TooltipSystemHorizontalDivider)

		(element TooltipSystemRewardsDHList
			_rewardsTitle = 'IDS_SNOWFLAKES_FILTER_ITEM_TOOLTIP_REWARDS_TITLE'
			_rewards = "snowflakesFilter.component.rewards"
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider'
				(bind enabled "snowflakesFilter.isEnabled")
			)
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemStatusLine'
				(bind enabled "snowflakesFilter.isEnabled")
				(args
					_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.MOUSE_LEFT"
					_text = "snowflakesFilter.isSelected	? 'IDS_SNOWFLAKES_FILTER_ITEM_TOOLTIP_MOUSE_INSTRUCTION_DESELECT'
															: 'IDS_SNOWFLAKES_FILTER_ITEM_TOOLTIP_MOUSE_INSTRUCTION_SELECT'"
				)
			)
		)
	)
)
