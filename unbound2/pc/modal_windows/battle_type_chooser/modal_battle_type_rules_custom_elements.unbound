(def element DeathmatchShipWinPointsContainer (_args:dict)
	(scope
		(var winPointItems:array = "_args._winPointItems")
	)

	(style (align = "center"))

	(tf
		(class $TextDefaultBold18NM)
		(style (alpha = "TC"))
		(text = 'IDS_ENEMY_DESTROY')
	)

	(hblock
		(style (hgap = "SXS"))

		(controller $Repeat renderer='DeathmatchShipWinPointsItem'
			(bind items "winPointItems")
			(args
				_winPointItem = "$item"
			)
		)
	)
)

(def element DeathmatchShipWinPointsItem (_winPointItem:dict)
	(style
		(align = "center")
		(width = 38px)
	)

	(block
		(style
			(width = 28px)
			(height = 27px)
			(marginTop = "S")
			(marginBottom = "SXS")
			(marginLeft = "XS")
			(backgroundImage = "'swf:../battle_hud/markers/ship_svg/ship_svg.swf:' + toLower(_winPointItem._shipType) + '_enemy'")
		)
	)

	(tf
		(class $TextDefaultBold18NM)
		(style
			(width = 100%)
			(textAlign = "center")
			(marginTop = "-XS")
			(alpha = "TA")
		)
		(text = "subst('IDS_MODAL_WINDOW_PCVE035_BATTLE_RULES_WIN_POINTS', [], {_winPoints: _winPointItem._winPoints})")
	)
)
