(def element ModalWindowArcEventFinish ()
	(macro MODAL_WINDOW_INIT)
	(scope
		(var arcFinalStats:dhComponent = "getSingleComponent(CC.arcFinalStats)")
		(var sides:number = "arcFinalStats.sidesCount ?: 0")
		(var totalTeamsJoined:number = "arcFinalStats.totalTeamsJoined ?: 0")
		(var totalTaskDone:number = "arcFinalStats.totalTaskDone ?: 0")
		(var totalExp:number = "arcFinalStats.totalExp ?: 0")
		(var totalRewardsAchieved:number = "arcFinalStats.totalRewardsAchieved ?: 0")
		(var taskLeaderboardByPercent:number = "arcFinalStats.taskLeaderboardByPercent ?: 0")
		(var expLeaderboardByPercent:number = "arcFinalStats.expLeaderboardByPercent ?: 0")
		(var rewardsLeaderboardByPercent:number = "arcFinalStats.rewardsLeaderboardByPercent ?: 0")

		(var stats:array = "[
				{
					type: 'tasks',
					value: totalTaskDone,
					efficiency: taskLeaderboardByPercent
				},
				{
					type: 'exp',
					value: totalExp,
					efficiency: expLeaderboardByPercent
				},
				{
					type: 'rewards',
					value: totalRewardsAchieved,
					efficiency: rewardsLeaderboardByPercent
				}
			]"
		)

		(var isTwoSidedBattle:bool = "sides == RVR_SIDE_INFO_MAP.TWO_SIDES")
		(var selectedAnimationCategory:str = "isTwoSidedBattle ? 'three_kingdoms' : 'main'")
		(var selectedAnimationType:number = "isTwoSidedBattle ? SC.Ui_styles.ANIMATED_BG.SSE : SC.Ui_styles.ANIMATED_BG.ARC_EVENT")
	)
	(bindcall externalCall "'inputMapping.onAction'" "['VSEventProxyUSS.finalScreenShown', {}]" init=true watch=false on='addedToStage')

	(name = 'ModalWindowArcEventFinish')
	(style (align = "center"))

	(block
		(class $FullsizeAbsolute)

		(element ModalWindowAnimatedBackground
			_selectedCategory = "selectedAnimationCategory"
			_type = "selectedAnimationType"
			_hideTime = 0.2
			_hideDelay = 0.2
		)
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
		(style (width = 100%))
		(element ModalWindowHeaderFullSize
			_windowName = 'IDS_ARC_EVENT_COMMON_EVENT_TITLE'
			_backButtonText = 'IDS_RETURN_FROM_MODAL_WINDOW_BUTTON'
			_paddingRight = "M"
			_paddingLeft = "M"
			_methods = "[
				{
					type: 'inputMapping.onRequest',
					name: 'goToPort',
					args: {}
				}
			]"
		)
	)

	(block
		(style
			(width = 1248px)
			(marginTop = "{720:XL, 1080:XXL}")
			(paddingLeft = "M")
			(paddingRight = "M")
			(paddingBottom = "M")
			(align = "center")
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
			(style
				(marginBottom = "{720:L, 1080:LM}")
				(align = "center")
			)

			(tf
				(class $TextDefaultBold40NM)
				(style
					(marginBottom = "{720:M, 1080:MS}")
					(alpha = "TA")
				)
				(text = 'IDS_ARC_EVENT_FINAL_TITLE')
			)

			(tf
				(class $TextDefault20NM)
				(style
					(textAlign = "center")
					(alpha = "TC")
				)
				(bind text "subst('IDS_SUBST_ARC_EVENT_FINAL_SUBTITLE', [], { _teamsJoined: totalTeamsJoined }, totalTeamsJoined )")
			)
		)

		(hblock
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 3)
			(style
				(marginBottom = "{720:L, 1080:LM}")
				(hgap = "{1280:L, 1920:LM}")
			)
			(controller $Repeat renderer='ArcEventFinishStatCardRenderer'
				(bind count "stats.length")
				(args
					_efficiency = "stats[$index].efficiency"
					_type = "stats[$index].type"
					_value = "stats[$index].value"
				)
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 4)
			(tf
				(class $TextDefault20NM)
				(style
					(width = 368px)
					(textAlign = "center")
					(alpha = "TC")
				)
				(text = 'IDS_ARC_EVENT_FINAL_FOOTER')
			)
		)
	)
)

(def element ArcEventFinishStatCardRenderer (_efficiency:number = 0, _type:str = '', _value:number = 0)
	(scope
		(var efficiency:number = "100 - _efficiency")
		(var efficiencyText:str = "	_efficiency <= 10	? subst('IDS_SUBST_ARC_EVENT_COMMON_LEADERBOARD_TOP', [], { _percentRate: _efficiency }) :
									_efficiency == 100	? 'IDS_ARC_EVENT_COMMON_LEADERBOARD_BOTTOM'
														: subst('IDS_SUBST_ARC_EVENT_COMMON_LEADERBOARD_MID', [], { _percentRate: efficiency })")
	)
	(element MetaEventResultCard
		_bgImage = "'url:../events/arc_event/event_results/icon_arc_event_final_stat_' + _type + '.png'"
		_title = "'IDS_ARC_EVENT_FINAL_STAT_TYPE_' + _type"
		_value = "_value"
		_text = "efficiencyText"
	)
)
