(def element ModalWindowArcEventLore ()
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)
	(scope
		(var arcEventEntity:dhEntity = "getSingleEntity(CC.arcEvent)")
		(var finishTime:number = "arcEventEntity.arcEvent.finishTime ?: 0" (event "arcEventEntity.arcEvent.evChanged"))

		(struct serverTime = SERVER_TIME())
		(struct eventFinishTime = COUNTDOWN(_time = "finishTime" _serverTime = "serverTime.value" _format = "'HIGHEST,WITH_DAYS'"))
		(var isEventEnded:bool = "serverTime.value >= finishTime")

		(var loreTextItems:array = "[
			{
				paragraphText: [	'IDS_MODAL_WINDOW_ARC_EVENT_LORE_PARAGRAPH_1_TEXT_1',
									'IDS_MODAL_WINDOW_ARC_EVENT_LORE_PARAGRAPH_1_TEXT_2']
			},
			{
				paragraphText: [	'IDS_MODAL_WINDOW_ARC_EVENT_LORE_PARAGRAPH_2_TEXT_1',
									'IDS_MODAL_WINDOW_ARC_EVENT_LORE_PARAGRAPH_2_TEXT_2',
									'IDS_MODAL_WINDOW_ARC_EVENT_LORE_PARAGRAPH_2_TEXT_3',
									'IDS_MODAL_WINDOW_ARC_EVENT_LORE_PARAGRAPH_2_TEXT_4']
			},
			{
				paragraphText: [	'IDS_MODAL_WINDOW_ARC_EVENT_LORE_PARAGRAPH_3_TEXT_1',
									'IDS_MODAL_WINDOW_ARC_EVENT_LORE_PARAGRAPH_3_TEXT_2',
									'IDS_MODAL_WINDOW_ARC_EVENT_LORE_PARAGRAPH_3_TEXT_3']
			},
			{
				paragraphText: [	'IDS_MODAL_WINDOW_ARC_EVENT_LORE_PARAGRAPH_4_TEXT_1',
									'IDS_MODAL_WINDOW_ARC_EVENT_LORE_PARAGRAPH_4_TEXT_2']
			}
		]")
	)
	(name = 'ModalWindowArcEventLore')
	(style (align = "center"))
	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
		(style
			(width = 100%)
			(marginBottom = "{720:MS, 1080:XLM}")
		)
		(element ModalWindowHeaderFullSize
			_windowName = 'IDS_ARC_EVENT_COMMON_EVENT_TITLE'
			_backButtonText = 'IDS_RETURN_FROM_MODAL_WINDOW_BUTTON'
			_paddingRight = "M"
			_paddingLeft = "M"
			_methods = "[
				{
					type: 'inputMapping.onRequest',
					name: 'arcEventCloseLore',
					args: {}
				}
			]"
		)
	)

	(scrollArea
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
		(style
			(width = 730px)
			(height = 100%)
		)

		(macro DEFAULT_VERTICAL_SCROLL_PARAMS
			_singleStep = "60px"
			_isDrag = "false"
			_wheelScrollAcceleration = "0.8"
			_maxScrollingAnimatedDistance = "280"
		)

		(repeatController = 'arcEventLoreTextItem')

		(content
			(style (width = 100%))

			(block
				(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
				(style
					(width = 100%)
					(height = 380px)
					(marginBottom = "L")
					(backgroundImage = 'url:../events/arc_event/lore/lore_main.png')
				)
			)

			(block
				(macro DEFAULT_MODAL_WINDOW_ANIMATION 2.5)
				(style
					(width = 100%)
					(marginBottom = "{720:MS, 1080:L}")
					(paddingLeft = "L")
					(paddingRight = "MS")
				)

				(tf
					(bind class "stageHeight > 800 ? '$TextDefaultBold28NM' : '$TextDefaultBold26NM'")
					(style
						(width = 100%)
						(alpha = "TA")
					)
					(text = 'IDS_MODAL_WINDOW_ARC_EVENT_LORE_HEADER')
				)

				(block
					(style (bind marginTop "!isEventEnded ? M : 0px"))
					(controller $Instance renderer='StatusLine'
						(bind enabled "!isEventEnded")
						(args
							_text = "subst('IDS_ARC_EVENT_MAIN_SCREEN_EVENT_ENDS_IN', [], { _timeLeft: eventFinishTime.value })"
							_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.DATE"
						)
					)
				)
			)

			(block
				(macro DEFAULT_MODAL_WINDOW_ANIMATION 3)
				(style
					(width = 100%)
					(marginBottom = "MS")
					(paddingLeft = "L")
					(paddingRight = "MS")
				)

				(controller $Repeat renderer='ArcEventLoreTextItem' name='arcEventLoreTextItem'
					(bind count "loreTextItems.length")
					(args
						_paragraphTextList = "loreTextItems[$index].paragraphText"
					)
				)
			)
		)
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 4)
		(style
			(marginTop = "{720:MS, 1080:LM}")
			(marginBottom = "{720:M, 1080:L}")
		)
		(element DefaultButton
			_width = 140px
			_label = 'IDS_CLOSE_UPPER_CASE'
			_focusIndex = 0
			_defaultFocused = true
			_name = 'btn_cancel'
		)
	)
)

(def element ArcEventLoreTextItem (_paragraphTextList:array = [])
	(style
		(width = 100%)
		(bind marginTop "$index ? L : 0")
	)
	(tf
		(class $TextDefaultBold20NM)
		(style
			(width = 100%)
			(marginBottom = "MS")
			(alpha = "TA")
		)
		(bind text "'IDS_MODAL_WINDOW_ARC_EVENT_LORE_SUBHEADER_' + ($index+1)")
	)
	(block
		(style
			(width = 100%)
			(vgap = "MS")
		)
		(controller $Repeat renderer='RepeatParagraphItemNM'
			(bind count "_paragraphTextList.length")
			(args
				_paragraphText = "_paragraphTextList[$index]"
				_width = "100%"
			)
		)
	)
)
