(def element ModalWindowArcEventChooseSide ()
	(macro MODAL_WINDOW_INIT)
	(scope
		(event evRollOverSideOneCard)
		(event evRollOverSideTwoCard)

		(event evEnableSideOne)
		(event evEnableSideTwo)

		(event evSelectDifficultyLevel)

		(var arcEventEntity:dhEntity = "getSingleEntity(CC.arcEvent)")
		(var sides:number = "arcEventEntity.arcEventConfig.sidesCount ?: 0")

		(var playerArcEventInfoEntity:dhEntity = "getSingleEntity(CC.playerArcEventInfo)")
		(var chosenSidesMap:dict = "playerArcEventInfoEntity.playerArcEventInfo.chosenSidesMap ?: {}" (event "playerArcEventInfoEntity.playerArcEventInfo.evChosenSidesMapChanged"))
		(var isTwoSidedBattle:bool = "sides == RVR_SIDE_INFO_MAP.TWO_SIDES")
		(var selectedAnimationCategory:str = "isTwoSidedBattle ? 'choose_side_dong_kou' : 'choose_side'")

		(struct qualityGraphicsPref = GET_PREF_STR(_option="'graphics.preset'"))
		(var qualityGraphics:str = "qualityGraphicsPref.value")
		(var isStatic:bool = "qualityGraphics == SC.Ui_prefs.GRAPHICS_PRESET.LOW || qualityGraphics == SC.Ui_prefs.GRAPHICS_PRESET.MINIMUM")

		(var isAnimationOneEnabled:bool = "isTwoSidedBattle && $event ? $event.state : false" (event "evEnableSideOne"))
		(var isAnimationTwoEnabled:bool = "isTwoSidedBattle && $event ? $event.state : false" (event "evEnableSideTwo"))

		(var selectedSideId:number = "DEFAULT_DIFFICULTY_LEVEL")
		(bind selectedSideId "$event.sideId" init=false (event "evSelectDifficultyLevel"))
	)

	(dispatch evRollOverSideOne args="$event" dir="EventDirection.DOWN" (bind enabled "!isStatic") (event "evRollOverSideOneCard"))
	(dispatch evRollOverSideTwo args="$event" dir="EventDirection.DOWN" (bind enabled "!isStatic") (event "evRollOverSideTwoCard"))

	(dispatch evEnableSideOne delay=0.1 args="{ state: true }" (event "startShow"))
	(dispatch evEnableSideTwo delay=0.2 args="{ state: true }" (event "startShow"))

	(style (align = "center"))
	(name = 'ModalWindowArcEventChooseSide')

	(block
		(class $FullsizeAbsolute)

		(element ModalWindowAnimatedBackground
			_selectedCategory = "selectedAnimationCategory"
			_type = "SC.Ui_styles.ANIMATED_BG.ARC_EVENT"
			_hideTime = 0.2
			_hideDelay = 0.2
		)
	)

	(block
		(class $FullsizeAbsolute)
		(style
			(alpha = 0)
			(backgroundImage = 'url:../bg/animated/profile/effects/rating/mist.skel')
		)
		(controller $Spine
			(bindcall pause init=true (bind enabled "isStatic"))
			(bindcall resume (bind enabled "!isStatic"))
		)

		(macro DEFAULT_CONTROL_STATE_ANIMATION_CT "CT_ARC_EVENT_LEVEL[selectedSideId]")

		(controller $Animation
			(bindcall play
				duration = 0.2
				to = "{ alpha: 1 }"
				(event "startShow")
			)
			(bindcall play
				duration = 0.2
				delay = 0.25
				to = "{ alpha: 0 }"
				action="kill"
				(event "startHide")
			)
		)
	)

	(block
		(class $FullsizeAbsolute)

		(style (alpha = 0))

		(controller $Animation
			(bindcall play  duration=0.3
							from = "{ alpha: 0 }"
							to = "{ alpha: 1 }"
							(bind trigger "isAnimationOneEnabled")
			)
			(bindcall play  duration=0.2
							delay=0.1
							from = "{ alpha: 1 }"
							to = "{ alpha: 0 }"
							action="kill"
							(event "startHide")
			)
		)

		(controller $Instance renderer='SideOneAnimationHolder'
			(bind enabled "isAnimationOneEnabled")
			(args
				_isStatic = "isStatic"
			)
		)
	)

	(block
		(class $FullsizeAbsolute)

		(style
			(align = "right")
			(alpha = 0)
		)

		(controller $Animation
			(bindcall play  duration=0.3
							from = "{ alpha: 0 }"
							to = "{ alpha: 1 }"
							(bind trigger "isAnimationTwoEnabled")
			)
			(bindcall play  duration=0.2
							delay=0.1
							from = "{ alpha: 1 }"
							to = "{ alpha: 0 }"
							action="kill"
							(event "startHide")
			)
		)

		(controller $Instance renderer='SideTwoAnimationHolder'
			(bind enabled "isAnimationTwoEnabled")
			(args
				_isStatic = "isStatic"
			)
		)
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
		(style
			(width = 100%)
			(marginBottom = "{720:M, 1080:XLM}")
		)
		(element ModalWindowHeaderFullSize
			_windowName = 'IDS_ARC_EVENT_COMMON_EVENT_TITLE'
			_backButtonText = 'IDS_RETURN_FROM_MODAL_WINDOW_BUTTON'
			_paddingRight = "M"
			_paddingLeft = "M"
			_methods = "[
				{
					type: 'inputMapping.onRequest',
					name: 'goToPort',
					args: {}
				}
			]"
		)
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
		(style
			(width = 512px)
			(marginBottom = "{720:XLM, 1080:XXL}")
		)
		(tf
			(class $TextDefault22NM)
			(style
				(width = 100%)
				(textAlign = "center")
				(alpha = "TC")
			)
			(text = 'IDS_ARC_EVENT_CHOOSE_SIDE_DESCRIPTION')
		)
	)

	(block
		(style (marginBottom = "{720:L, 1080:XL}"))

		(hblock
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 0)
			(style
				(hgap = "MS")
				(marginBottom = "{720:MS, 1080:LS}")
			)

			(controller $Repeat renderer='ArcEventSideSelectionCard'
				(bind count "sides")
				(args
					_chosenSidesMap = "chosenSidesMap"
					_isStatic = "isStatic"
					_difficultyLevel = "$index+1"
					_selectedSideId = "selectedSideId"
				)
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
			(style (width = 100%))
			(element ArcEventDifficultyLevelRewards
				_sideId = "selectedSideId"
			)
		)
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 3)
		(class $MiddleAlignedAbsolutely)
		(style (bottom = "{720:S, 1080:XLL}"))
		(element DefaultButton
			_width = 154px
			_label = 'IDS_ARC_EVENT_CHOOSE_SIDE_RULES_LINK_TEXT'
			_type = "SC.Ui_styles.BUTTON_TYPE.SECONDARY"
			_enabled = true
			_defaultFocused = true
			_focusIndex = 1
			_methods = "[	{	type: 'inputMapping.onRequest',
								name: 'arcEventShowLore',
								args: { }}]"
		)
	)
)

(def element SideOneAnimationHolder (_isStatic:bool = false)
	(scope
		(event evRollOverSideOne)
	)

	(style
		(height = 100%)
		(width = { 1280:1200px, 1920:1700px })




	)





)

(def element SideTwoAnimationHolder (_isStatic:bool = false)
	(scope
		(event evRollOverSideTwo)
	)

	(style
		(height = 100%)
		(width = { 1280:1200px, 1920:1700px })




	)





)

(def element ArcEventSideSelectionCard (	_chosenSidesMap:dict = {},
											_isStatic:bool = false,
											_difficultyLevel:number = "DEFAULT_DIFFICULTY_LEVEL",
											_selectedSideId:number = "DEFAULT_DIFFICULTY_LEVEL")
	(scope
		(event evEnableHitTest)
		(event evCardRollOver)
		(event evCardRollOut)

		(struct mouseHandler = MOUSE_HANDLER())

		(var arcEventEntity:dhEntity = "getSingleEntity(CC.arcEvent)")
		(var sides:number = "arcEventEntity.arcEventConfig.sidesCount ?: 0")

		(var isLoaded:bool = false)
		(bind isLoaded "true" init=false on='evEnableHitTest')

		(var animationName:str = "SIDE_TO_ANIMATION_NAME_MAP[$index]")
		(var eventName:str = "	animationName == CHOOSE_SIDE_ANIMATION_NAME.SIDE_TWO	? 'evRollOverSideTwoCard' :
								animationName == CHOOSE_SIDE_ANIMATION_NAME.SIDE_ONE	? 'evRollOverSideOneCard'
																						: ''")

		(var isSelected:bool = "_selectedSideId == $index")
		(var state:number = "	isSelected				? SC.Ui_styles.BUTTON_STATE.SELECTED :
								mouseHandler.mouseDown	? SC.Ui_styles.BUTTON_STATE.DOWN :
								mouseHandler.rollOver	? SC.Ui_styles.BUTTON_STATE.OVER
														: SC.Ui_styles.BUTTON_STATE.UP")
		(var alphaBg:number = "ARC_EVENT_CARD_BG_ALPHA[state]")
		(var alphaSelected:number = "isSelected ? 1 : 0")
	)
	(name = "'arcEventSideSelectionCard_' + $index")

	(macro STRUCT_MOUSE_DISPATCHER
		_mouseHandler = "mouseHandler"
	)

	(macro STRUCT_SOUND_HANDLER
		_mouseHandler = "mouseHandler"
		_soundSet = "'quest_item'"
	)

	(dispatch evSelectDifficultyLevel dir="EventDirection.UP" args="{sideId: $index}" on='leftClick')

	(dispatch
		"eventName"
		args="{ animationName: animationName }"
		dir="EventDirection.UP"
		(bind enabled "!_isStatic")
		(event "evCardRollOver")
	)

	(dispatch
		"eventName"
		args="{ animationName: CHOOSE_SIDE_ANIMATION_NAME.DEFAULT }"
		dir="EventDirection.UP"
		(bind enabled "!_isStatic")
		(event "evCardRollOut")
	)

	(style
		(bind hitTest "isLoaded")
		(width = 320px)
		(height = 260px)
		(borderRadius = "S")
		(align = "center")
		(alpha = 0)
		(macro DESATURATION_DEFAULT "isSelected || mouseHandler.rollOver")
	)

	(controller $Animation
		(bindcall play
			delay		= "0.3 + 0.1*$index"
			duration	= 0.15
			from		= "{ alpha: 0, top: 10 }"
			to			= "{ alpha: 1, top: 0 }"
			on = 'addedToStage'
		)
		(dispatch evEnableHitTest args="{}" init=false on=evAnimEnded)
	)

	(block
		(style
			(position = "absolute")
			(top = -50px)
			(left = -50px)
			(width = 420px)
			(height = 360px)
			(backgroundImage = 'url:../events/arc_event/bg_select.png')
			(alpha = "alphaSelected")
		)
		(bind colorTransform "CT_ARC_EVENT_LEVEL[$index]")

		(macro DEFAULT_CONTROL_STATE_ANIMATION_ALPHA
			_duration = "0.15"
			_trigger = "isSelected"
			_alpha = "alphaSelected"
		)
	)

	(block
		(class $FullsizeAbsolute)

		(block
			(class $FullsizeAbsolute)
			(style
				(backgroundImage = 'url:../events/arc_event/rounded_frame.png')
				(scale9grid = 8)
				(alpha = "alphaBg")
			)

			(macro DEFAULT_CONTROL_STATE_ANIMATION_ALPHA
				_duration = "0.15"
				_trigger = "state"
				_alpha = "alphaBg"
			)
		)

		(block
			(class $FullsizeAbsolute)
			(style
				(bind visualOffsetY "isSelected ? 0% : 25%")
				(bottom = 0px)
				(backgroundImage = 'url:../animations/spine/rating_battles/bg_card_smoke.skel')
				(backgroundSize = "fill")
				(alpha = "alphaBg")
			)
			(bind colorTransform "CT_ARC_EVENT_LEVEL[$index]")
			(controller $Spine)

			(macro DEFAULT_CONTROL_STATE_ANIMATION_ALPHA
				_duration = "0.15"
				_trigger = "state"
				_alpha = "alphaBg"
			)
		)

		(block
			(class $FullsizeAbsolute)
			(style
				(backgroundColor = "NO_COLOR")
				(borderRadius = "S")
			)
			(isMask = true)
		)
	)

	(block
		(class $MiddleAlignedAbsolutely)
		(style
			(top = -125px)
			(width = 250px)
			(height = 250px)
			(backgroundImage = 'url:../animations/spine/battlepass/bp_icon_smoke/bp_icon_smoke.skel')
			(backgroundSize = "fill")
			(alpha = "alphaSelected")
		)
		(bind colorTransform "CT_ARC_EVENT_LEVEL[$index]")
		(controller $Spine)

		(macro DEFAULT_CONTROL_STATE_ANIMATION_ALPHA
			_duration = "0.15"
			_trigger = "state"
			_alpha = "alphaSelected"
		)
	)

	(block
		(style
			(marginTop = -70px)
			(marginBottom  = "MS")
			(align = "middle|center")
		)

		(element ArcEventSideStereotype
			_sideId = "$index"
			_size = "SIZE.MEDIUM"
			_isChooseSideMW = true
		)
	)

	(block
		(style
			(width = 100%)
			(align = "center")
			(paddingLeft = "L")
			(paddingRight = "L")
			(paddingBottom = "L")
		)

		(hblock
			(style (marginBottom = "MS"))
			(controller $Repeat renderer='ComplexityLevelItem'
				(count = "sides")
				(args
					_isFilled = "$index + 1 <= _difficultyLevel"
				)
			)
		)

		(element HorizontalDividerTwoPx)

		(tf
			(class $TextDefaultNM)
			(style
				(width = 100%)
				(marginTop = "MS")
				(textAlign = "center")
				(alpha = "TC")
			)
			(bind text "'IDS_ARC_EVENT_COMMON_SIDE_DESCRIPTION_' + $index")
		)
	)

	(controller $Tooltip
		(renderer = 'ArcEventSideSelectionCardTooltip')
		(args
			_sideId = "$index"
			_chosenSidesMap = "_chosenSidesMap"
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR)
	)
)

(def element ArcEventDifficultyLevelRewards (_sideId:number = "DEFAULT_DIFFICULTY_LEVEL")
	(scope
		(var progressWithRewards:dhComponent = "getPrimaryComponent(CC.progressWithRewards, 'personal' + _sideId)")
		(var rewardsStackID:number = "progressWithRewards.rewardsStackID" (event "progressWithRewards.evChanged"))
		(var rewardsStackEntity:dhEntity = "getEntity(rewardsStackID)")
		(var rewards:array = "rewardsStackEntity.rewardsStack.rewards" (event "rewardsStackEntity.rewardsStack.evChanged"))

		(var personalProgressArray:array = "progressWithRewards.pointsArray" (event "progressWithRewards.evChanged"))
		(var maxProgress:number = "personalProgressArray[personalProgressArray.length - 1] ?: 0")
	)
	(style
		(width = 100%)
		(flow = "horizontal")
	)

	(block
		(style (width = 100%))

		(tf
			(class $TextDefaultNM)
			(style
				(marginBottom = "S")
				(alpha = "TA")
			)
			(text = 'IDS_REWARDS')
		)

		(htile
			(style
				(width = 100%)
				(gap = "{720:XS, 1080:MS}")
			)
			(controller $Repeat renderer='RewardItemAdapter'
				(bind count "rewards.length")
				(args
					_entityId = "rewards[$index]"
					_iconRightMargin = 0px
				)
			)
		)
	)

	(block
		(style
			(width = 320px)
			(marginLeft = "MS")
		)

		(tf
			(class $TextDefaultNM)
			(style
				(marginBottom = "MS")
				(leading = 4)
				(styleSheet = '.bold { font-weight: bold; font-size: 22px }')
				(multiline = true)
				(alpha = "TA")
			)
			(bind htmlText "subst('IDS_ARC_EVENT_DIFFICULTY_LEVEL_SCORES', [], {_score: formatSeparator(maxProgress)}, maxProgress)")
		)

		(element DefaultButton
			_width = 240px
			_size = "SIZE.LARGE"
			_label = 'IDS_ARC_EVENT_CHOOSE_SIDE_BUTTON'
			_name = 'btn_set_off_on'
			_enabled = true
			_defaultFocused = true
			_focusIndex = 1
			_methods = "[
				{
					type: 'inputMapping.onRequest',
					name: 'arcEventConfirmSide',
					args: { _sideId: _sideId }
				}
			]"
		)
	)
)

(def element ArcEventSideSelectionCardTooltip (_sideId:number = 0, _chosenSidesMap:dict = {})
	(scope
		(var isChosen:bool = "_chosenSidesMap[_sideId][0]")
		(var isMainRewardReceived:bool = "_chosenSidesMap[_sideId][1]")
	)
	(style (width = 340px))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)
	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TooltipSystemHeaderSubheaderText
			_headerText = "'IDS_ARC_EVENT_COMMON_SIDE_' + _sideId"
		)
		(element TooltipSystemHorizontalDivider)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemStatusLine'
				(bind enabled "isChosen")
				(args
					_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.CHECK"
					_text = 'IDS_ARC_EVENT_PLAYED_FOR_SIDE'
				)
			)
		)
		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider'
				(bind enabled "isChosen")
			)
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemStatusLine'
				(bind enabled "isMainRewardReceived")
				(args
					_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.CHECK"
					_text = 'IDS_ARC_EVENT_LOYALTY_REWARD_REACHED'
				)
			)
		)
		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider'
				(bind enabled "isMainRewardReceived")
			)
		)

		(element TooltipSystemStatusLine
			_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.MOUSE_LEFT"
			_text = "'IDS_ARC_EVENT_CHOOSE_SIDE_MOUSE_INSTRUCTION_' + _sideId"
		)
	)
)

