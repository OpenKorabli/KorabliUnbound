(def element ModalWindowArcEventConfirmSide (_sideId:number = 0)
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)
	(scope
		(var arcEventEntity:dhEntity = "getSingleEntity(CC.arcEvent)")
		(var sides:number = "arcEventEntity.arcEventConfig.sidesCount ?: 0")
	)
	(name = 'ModalWindowArcEventConfirmSide')
	(class $Fullsize)
	(style (align = "center|middle"))

	(block
		(style
			(width = 500px)
			(align = "center")
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 0)
			(style
				(width = 100%)
				(marginBottom = "L")
			)
			(element ModalWindowShortHeader
				_header = 'IDS_CONFIRMATION'
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
			(style (marginBottom = "M"))

			(element ArcEventSideStereotype
				_sideId = "_sideId"
				_size = "SC.Ui_styles.SIZE.MEDIUM"
				_isChooseSideMW = true
			)
		)

		(hblock
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 1.5)
			(style (marginBottom = "MS"))

			(controller $Repeat renderer='ComplexityLevelItem'
				(count = "sides")
				(args
					_isFilled = "$index <= _sideId"
				)
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
			(style
				(width = 100%)
				(marginBottom = "LM")
			)
			(tf
				(class $TextDefault18NM)
				(style
					(width = 100%)
					(marginBottom = "LM")
					(textAlign = "center")
					(alpha = "TC")
				)
				(bind text "'IDS_ARC_EVENT_COMMON_SIDE_DESCRIPTION_' + _sideId")
			)

			(element HorizontalDividerTwoPx)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2.5)
			(style (marginBottom = "MS"))
			(tf
				(class $TextDefault22NM)
				(style (alpha = "TA"))
				(text = 'IDS_ARC_EVENT_CONFIRM_SIDE_CALL_TO_ACTION')
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 3)
			(style (marginBottom = "MS"))
			(element ModalWindowSystemYesNoButtons
				_btnOkName = 'btn_ok'
				_btnOkWidth = 154px
				_btnOkMethods = "[
					{
						type: 'inputMapping.onAction',
						name: 'VSEventProxyUSS.chooseSide',
						args: { sideId: _sideId }
					},
					{
						type: 'inputMapping.onRequest',
						name: 'arcEventShowMainScreen',
						args: { sideId: _sideId }
					}
				]"
				_btnNoWidth = 154px
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 4)
			(element StatusLine
				_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.INFO"
				_text = 'IDS_ARC_EVENT_CHANGE_SIDE_IN_NEXT_SPRINT'
			)
		)
	)
)
