(def element ModalWindowBuyLinkDecal (_decalId:number, _isBuyAction:bool)
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)

	(scope
		(macro PULL_SHIP_ID)
	)

	(block
		(class $EyeLevelAligned)
		(style (width = "MODAL_WINDOW_EXTERIOR_BUY_WIDTH"))

		
		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
			(style (width = 100%))

			(element ModalWindowShortHeader
				_header = "_isBuyAction ? 'IDS_MODAL_WINDOW_BUY_DECAL_HEADER' : 'IDS_MODAL_WINDOW_LINK_DECAL_HEADER'"
				_hasDivider = "!_isBuyAction"
			)
		)

		
		(block
			(style
				(align = "center")
				(width = 100%)
			)

			(controller $Instance
				(bind renderer "_isBuyAction ? 'ModalDecalPurchaseInstall' : 'ModalDecalLink'")
				(args
					_decalId = "_decalId"
					_viewedShipId = "viewedShipId"
				)
			)
		)
	)
)

(def element ModalDecalPurchaseInstall (_decalId:number)
	(macro DEFAULT_MODAL_WINDOW_SCOPE_EVENTS)

	(scope
		(var decalComponent:dhComponent =	"getPrimaryComponent(CC.exteriorDecal, _decalId)")
		(var decalName:str =				"decalComponent.index")
		(var headerIconPath:str =			"'img://gui/exteriors/decals_dds_scale/' + decalName + '.dds'")

		(struct decalPrice = PULL_PRICE(_entityId = "_decalId" _actionId = "SC.Common.PRICE_ACTION.BUY"))

		(var accountResource:dhComponent =	"getSingleComponent(CC.accountResource)")

		(var finalDecalPriceInfo:dict = "decalPrice.info")
		(var priceDeficit:number = "finalDecalPriceInfo.finalPrice - accountResource[finalDecalPriceInfo.currency]" (event "accountResource.evChangedGold") (event "accountResource.evChangedCredit"))
		(var isDeficit:bool = "priceDeficit > 0")
	)

	(style
		(align = "center")
		(width = 100%)
	)

	
	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)

		(style (width = 100%))

		(element CurrenciesPanel
			_priceInfo =	"[{ finalPrice: -finalDecalPriceInfo.finalPrice, currency: finalDecalPriceInfo.currency }]"
			_width = "		MODAL_WINDOW_EXTERIOR_BUY_WIDTH"
		)
	)

	
	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1.5)
		(style
			(align = "center")
			(width = 100%)
			(paddingLeft = "SXS")
			(paddingRight = "SXS")
			(marginBottom = "S")
		)

		(controller $Tooltip
			(renderer = 'DecalTooltip')
			(args
				_id = "_decalId"
				_noMouseInstructions = true
			)
			(macro DEFAULT_TOOLTIP_BEHAVIOUR)
		)

		(element ModalWindowSystemExpendableIconWithHeaderAndSubheader
			_imageUrl =			"headerIconPath"
			_imageWidth =		80px
			_imageHeight =		80px
			_headerIconType =	"MODAL_WINDOW_SYSTEM_PURCHASABLE_ITEM_ICON.DECAL"
			_maxWidth =			"MODAL_WINDOW_EXTERIOR_BUY_WIDTH"
			_headerText =		"'IDS_DECAL_' + decalName + '_NAME'"
			_subheaderText =	'IDS_EXTERIOR_TYPE_DECAL'
			_unifiedStatus =	"SC.Ui_styles.UNIFIED_STATUS.DEFAULT"
			_data =				"{ imageUrl: headerIconPath }"
		)
	)

	
	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1.5)
		(style
			(width = 100%)
			(marginBottom = "MS")
		)

		(element HorizontalDividerTwoPx)
	)

	
	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
		(style
			(width = 100%)
			(marginBottom = "MS")
		)

		(element ModalWindowSystemPurchaseItemPriceAndInfo
			_priceInfo =					"finalDecalPriceInfo"
			_questionString =				'IDS_MODAL_WINDOW_BUY_AND_LINK_DECAL_TO'
			_additionalInfoUnifiedStatus =	"SC.Ui_styles.UNIFIED_STATUS.INFO"
			_additionalInfoStr =			'IDS_MODAL_WINDOW_BUY_DECAL_INFO'
			_statusLineWidth =				365px
			_isDeficit =					"isDeficit"
			_deficit =						"priceDeficit"
			_isWarningText =				"isDeficit"
		)
	)

	
	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 2.5)
		(style
			(align = "center")
			(width = 100%)
		)

		(element ModalWindowSystemPurchaseItemYesNoCloseButtons
			_isDeficit =	"isDeficit"
			_okMethods =	"[{ type: 'inputMapping.onAction', name: SC.Ui_methods.EXTERIOR_DECALS.PURCHASE_AND_INSTALL, args: { decalId: _decalId } }]"
		)
	)
)

(def element ModalDecalLink (_viewedShipId:number, _decalId:number)
	(macro DEFAULT_MODAL_WINDOW_SCOPE_EVENTS)

	(scope
		(var decalComponent:dhComponent =	"getPrimaryComponent(CC.exteriorDecal, _decalId)")
		(var decalName:str =				"decalComponent.index")
		(var headerIconPath:str =			"'img://gui/exteriors/decals_dds_scale/' + decalName + '.dds'")
	)

	(style
		(align = "center")
		(width = 100%)
	)

	
	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1.5)
		(style
			(align = "center")
			(width = 100%)
			(marginBottom = "S")
			(marginTop = "S")
		)

		(element ModalWindowSystemExpendableIconWithHeaderAndSubheader
			_imageUrl =			"headerIconPath"
			_imageWidth =		80px
			_imageHeight =		80px
			_headerIconType =	"MODAL_WINDOW_SYSTEM_PURCHASABLE_ITEM_ICON.DECAL"
			_maxWidth =			"MODAL_WINDOW_EXTERIOR_BUY_WIDTH"
			_headerText =		"'IDS_DECAL_' + decalName + '_NAME'"
			_subheaderText =	'IDS_EXTERIOR_TYPE_DECAL'
			_unifiedStatus =	"SC.Ui_styles.UNIFIED_STATUS.DEFAULT"
			_data =				"{ imageUrl: headerIconPath }"
		)

		(controller $Tooltip
			(renderer = 'DecalTooltip')
			(args
				_id = "_decalId"
				_noMouseInstructions = true
				_isReward = true
			)
			(macro DEFAULT_TOOLTIP_BEHAVIOUR)
		)
	)

	
	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1.5)
		(style
			(width = 100%)
			(marginBottom = "MS")
		)

		(element HorizontalDividerTwoPx)
	)

	
	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
		(style
			(align = "center|middle")
			(width = 100%)
			(marginBottom = "MS")
		)

		(element LinkToShipWithQuestion
			_questionText =					'IDS_MODAL_WINDOW_LINK_DECAL_TO'
			_shipId =						"_viewedShipId"
			_additionalInfoUnifiedStatus =	"SC.Ui_styles.UNIFIED_STATUS.INFO"
			_additionalInfoStr =			"!decalComponent.canBuy ? 'IDS_MODAL_WINDOW_LINK_DECAL_UNIQUE_INFO' : 'IDS_MODAL_WINDOW_LINK_DECAL_INFO'"
			_statusLineWidth =				365px
		)
	)

	
	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 2.5)
		(style
			(align = "center")
			(width = 100%)
		)

		(element ModalWindowSystemPurchaseItemYesNoCloseButtons
			_okMethods =	"[{ type: 'inputMapping.onAction', name: SC.Ui_methods.EXTERIOR_DECALS.INSTALL, args: { decalId: _decalId } }]"
		)
	)
)

(def element LinkToShipWithQuestion (_questionText:str, _shipId:number, _additionalInfoUnifiedStatus:str='', _additionalInfoStr:str='', _statusLineWidth:number="auto")
	(style
		(align = "center")
		(width = 100%)
	)

	(hblock
		(style (bind marginBottom "_additionalInfoStr ? M : 0px"))

		(tf
			(class $TextDefault26NM)
			(style
				(marginRight = "S")
				(alpha = "TA")
			)
			(bind text "_questionText")
		)

		(element ShipLineItemNM
			_shipId = "_shipId"
			_fontClass = '$TextDefaultBold26NM'
			_withFlag = true
		)

		(tf
			(class $TextDefault26NM)
			(style
				(marginLeft = "S")
				(alpha = "TA")
			)
			(text = 'IDS_QUESTION')
		)
	)

	(controller $Instance renderer='StatusLine'
		(bind enabled "!_additionalInfoStr.empty")
		(args
			_unifiedStatus =	"_additionalInfoUnifiedStatus"
			_text =				"_additionalInfoStr"
			_textClass =		'$TextDefault18NM'
			_width =			"_statusLineWidth"
		)
	)
)