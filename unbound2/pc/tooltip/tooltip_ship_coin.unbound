(def constant SHIP_COINS_TO_LEVEL "{
	SC.Common.CURRENCIES.SHIP_COIN_7: 7,
	SC.Common.CURRENCIES.SHIP_COIN_8: 8,
	SC.Common.CURRENCIES.SHIP_COIN_9: 9,
	SC.Common.CURRENCIES.SHIP_COIN_10: 10
}")

(def constant SHIP_LEVEL_TO_SHIP_COINS "{
	7: SC.Common.CURRENCIES.SHIP_COIN_7,
	8: SC.Common.CURRENCIES.SHIP_COIN_8,
	9: SC.Common.CURRENCIES.SHIP_COIN_9,
	10: SC.Common.CURRENCIES.SHIP_COIN_10
}")

(def constant SHIP_COINS_ALL "[
	SC.Common.CURRENCIES.SHIP_COIN_7,
	SC.Common.CURRENCIES.SHIP_COIN_8,
	SC.Common.CURRENCIES.SHIP_COIN_9,
	SC.Common.CURRENCIES.SHIP_COIN_10
]")

(def constant SHIP_COINS_LEVELS_ALL "[
	SHIP_COINS_TO_LEVEL[SC.Common.CURRENCIES.SHIP_COIN_7],
	SHIP_COINS_TO_LEVEL[SC.Common.CURRENCIES.SHIP_COIN_8],
	SHIP_COINS_TO_LEVEL[SC.Common.CURRENCIES.SHIP_COIN_9],
	SHIP_COINS_TO_LEVEL[SC.Common.CURRENCIES.SHIP_COIN_10]
]")


(def element ShipCoinTooltip ()
	(scope
		(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND_SCOPE)
	)
	(style (width = 340px))

	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND_MARKUP)
	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TooltipSystemHeaderWithIconAndText
			_imageUrl = 'url:../reward_icons/shipcoin.png'
			_imageWidth = 80px
			_imageHeight = 80px
			_headerText = 'IDS_CURRENCY_SHIPCOIN'
			_subheaderText = 'IDS_CURRENCY_SUBTYPE'
		)
		(element TooltipSystemHorizontalDivider)

		(block
			(style
				(width = 100%)
				(vgap = "SXS")
			)
			(macro TOOLTIP_SYSTEM_INNER_PANEL_BACKGROUND)
			(controller $Repeat renderer='ShipCoinTooltipItem'
				(count = "SHIP_COINS_ALL.length")
				(args
					_currency = "SHIP_COINS_ALL[$index]"
				)
			)
		)
		(element TooltipSystemHorizontalDivider)

		(element TOOLTIP_SYSTEM_ELEMENTS_GROUP
			(element TOOLTIP_SYSTEM_GROUP_ELEMENT
				(element TooltipSystemSecondaryHeaderText
					_headerText = 'IDS_CURRENCY_EXPLANATION_TITLE'
				)
			)
			(element TOOLTIP_SYSTEM_GROUP_ELEMENT
				(element TooltipSystemDescriptionText
					_descriptionText = 'IDS_CURRENCY_SHIPCOIN_SPEND_DESCRIPTION'
				)
			)
		)

		(element TooltipSystemHorizontalDivider)
		(element TOOLTIP_SYSTEM_ELEMENTS_GROUP
			(element TOOLTIP_SYSTEM_GROUP_ELEMENT
				(element TooltipSystemSecondaryHeaderText
					_headerText = 'IDS_CURRENCY_HOW_TO_GET_TITLE'
				)
			)
			(element TOOLTIP_SYSTEM_GROUP_ELEMENT
				(element TooltipSystemDescriptionText
					_descriptionText = 'IDS_CURRENCY_SHIPCOIN_GET_DESCRIPTION'
				)
			)
		)
	)
)
(def element ShipCoinTooltipItem (_currency:str)
	(scope
		(var accountResourceComponent:dhComponent = "getSingleComponent(CC.accountResource)")
		(var accountResourcePrice:number = "accountResourceComponent[_currency] ?: 0" (event "accountResourceComponent.evChangedShipcoin"))
	)
	(style (width = 100%))
	(element TooltipSystemCounterLine
		_title = "subst('IDS_CURRENCY_SHIPCOIN_LEVEL_SHORT_TITLE', [],
						{_level: shipLevelsToRoman(SHIP_COINS_TO_LEVEL[_currency])}, SHIP_COINS_TO_LEVEL[_currency])"
		_count = "accountResourcePrice"
	)
)
