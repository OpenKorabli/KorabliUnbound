(def element SimpleLockPlug (_text:str, _size:number="SIZE.MEDIUM")
	(scope
		(var fontClass:str = "	_size == SIZE.LARGE		?	'$TextDefaultBold20NM' :
								_size == SIZE.MEDIUM	?	'$TextDefaultBold18NM'
														:	'$TextDefaultBold14NM'")
	)

	(style
		(align = "center")
		(width = 100%)
		(marginTop = "M")
		(marginBottom = "M")
	)

	(tf
		(bind class "fontClass")
		(style
			(textAlign = "center")
			(maxWidth = 480px)
			(textColor = "SC.Ui_styles.SERVICE_COLORS.ORANGE")
		)
		(bind text "toUpper(tr(_text))")
	)
)

(def element DockTabLockedPlug (_text:str, _size:number="SIZE.MEDIUM")
	(name = 'info_block')

	(style
		(width = 500px)
		(minHeight = 32px)
	)

	(block
		(class $FullsizeAbsolute)
		(style (borderRadius = "S"))
		(element BlurMap
			_blurType = "BLUR_TYPE.BOX"
		)
	)

	(element SimpleLockPlug
		_text = "_text"
		_size = "_size"
	)
)

(def element DockTabWarningPlug (_text:str, _size:number="SIZE.MEDIUM")
	(scope
		(var fontClass:str = "	_size == SIZE.LARGE		?	'$TextDefaultBold26NM' :
								_size == SIZE.MEDIUM	?	'$TextDefaultBold22NM'
														:	'$TextDefaultBold20NM'")
	)

	(style
		(align = "center|middle")
		(maxWidth = 600px)
	)

	(block
		(class $FullsizeAbsolute)
		(style
			(scale9grid = 4)
			(backgroundImage = 'url:../ship_mastery/league_bg.png')
		)
	)

	(tf
		(bind class "fontClass")
		(style
			(maxWidth = 100%)
			(margin = "L")
			(textAlign = "center")
			(textColor = "SC.Ui_styles.SERVICE_COLORS.ORANGE")
		)
		(bind text "toUpper(tr(_text))")
	)
)