
(def constant TABLE_DIVIDER_WIDTH 1px)

(def constant COLUMN_DIVISIONS_WIDTH 39px)
(def constant COLUMN_PLACE_WIDTH 32px)
(def constant COLUMN_PLAYER_WIDTH 168px)
(def constant COLUMN_PLAYER_WIDTH_ONE_TEAM 427px)
(def constant COLUMN_SHIP_WIDTH 168px)
(def constant COLUMN_SHIP_WIDTH_ONE_TEAM 400px)
(def constant COLUMN_FRAGS_WIDTH 42px)
(def constant COLUMN_ASSIST_WIDTH 42px)
(def constant COLUMN_SCORE_WIDTH 42px)
(def constant COLUMN_EMOJI_WIDTH 52px)
(def constant KEY_TARGET_ICON_SIZE 19px)

(def constant HALF_TABLE_WIDTH "COLUMN_DIVISIONS_WIDTH + COLUMN_PLAYER_WIDTH + COLUMN_SHIP_WIDTH + COLUMN_FRAGS_WIDTH + COLUMN_ASSIST_WIDTH + COLUMN_EMOJI_WIDTH")
(def constant TABLE_WIDTH "HALF_TABLE_WIDTH * 2 + TABLE_DIVIDER_WIDTH")
(def constant LINE_HEIGHT 32px)

(def constant C_DARK_PANEL 0x27000000)
(def constant C_ENEMY_HEADER 0x77F25755)
(def constant C_ALLY_HEADER 0x775EDABB)
(def constant C_EVENT_HEADER 0x777E5DA3)
(def constant CT_DIVISION "{ redMultiplier:1, greenMultiplier:0.81, blueMultiplier:0.44 }")

(def constant CAN_DRUM_AMMO [
	'ap',
	'cs',
	'he',
	'ss',
	'ap_sec',
	'cs_sec',
	'he_sec',
	'ss_sec',
])


(def css $LineBackgroundStyle ()
	(position = "absolute")
	(height = "LINE_HEIGHT")
	(width = 100%)
)

(def element TeamBattlePage (	_isDynamicDivisionsEnabled:bool,
								_isBattleLoading:bool,
								_isBattleStats:bool)
	(scope
		(var customElementsVisibilityComponent:dhComponent = "getSingleComponent(CC.customElementsVisibility)")
		(var disabledElements:number = "customElementsVisibilityComponent.disabledElements" (event "customElementsVisibilityComponent.evChanged"))
		(var isOnlyTeam:bool = "(disabledElements & SC.Battle.CUSTOM_BATTLE_ELEMENTS.TEAM_STRUCTURE_RIGHT) > 0")

		(var battleInfoComponent:dhComponent = "getSingleComponent(CC.battleInfo)")
	)

	(name = 'team_battle_page')

	
	(block
		(bind visible "!_isBattleStats")
		(class $FullsizeAbsolute)
		(element BlurMapWithLayerContrastPanel)
	)

	(hblock
		(bind name "_isBattleStats ? 'TeamBattleStatsID' : 'TeamBattleLoading'")

		(hblock
			(class $FullsizeAbsolute)
			(style
				(hitTest = false)
				(paddingTop = "LINE_HEIGHT")
			)

			(block
				(style
					(height = 100%)
					(backgroundColor = "C_DARK")
					(alpha = 0.15)
					(bind width "isOnlyTeam ? TABLE_WIDTH : HALF_TABLE_WIDTH")
				)
			)

			(block
				(bind visible "!isOnlyTeam")
				(style
					(width = "HALF_TABLE_WIDTH")
					(height = 100%)
					(backgroundColor = "C_DARK")
					(alpha = 0.15)
					(marginLeft = 1px)
				)
			)
		)

		(element UIListTeamStructure
			_isBattleLoading 			= "_isBattleLoading"
			_isBattleStats 				= "_isBattleStats"
			_isDynamicDivisionsEnabled 	= "_isDynamicDivisionsEnabled"
			_isOnlyTeam 				= "isOnlyTeam"
		)

		
		(block
			(bind visible "!isOnlyTeam")
			(style
				(width = "TABLE_DIVIDER_WIDTH")
				(height = 100%)
			)
		)

		(block
			(controller $Instance renderer='UIListTeamStructure'
				(bind enabled "!isOnlyTeam")
				(args
					_isBattleLoading 	= "_isBattleLoading"
					_isBattleStats 		= "_isBattleStats"
					_isFogOfWar 		= "battleInfoComponent.isFogOfWar"
					_isReversed 		= true
				)
			)
		)
	)
)

(def element UIListTeamStructure (	_isBattleStats:bool,
									_isBattleLoading:bool,
									_isFogOfWar:bool,
									_isDynamicDivisionsEnabled:bool = false,
									_isOnlyTeam:bool = false,
									_isReversed:bool = false)
	(scope
		(var avatarCollection:dhCollection = "getCollectionByPath(CC.avatar, 'team.' + (_isReversed ? 'enemy.byTeamsSortedAlive.0' : 'ally.sortedAlive'))")

		(var challengeParticipantCollection:dhCollection = "getCollectionByPath(CC.challengeParticipant, 'sortedByWonPosition')")
		(var challengeEntity:dhEntity = "getSingleEntity(CC.challenge)")
		(var isChallenge:bool = "challengeEntity != null")

		(var deathmatchPlayerCollection:dhCollection = "getCollectionByPath(CC.deathmatchPlayer, 'sortedByPlace')")
		(var isDeathmatch:bool = "toBool(deathmatchPlayerCollection.length)")
	)

	(style (bind width "_isOnlyTeam ? TABLE_WIDTH : HALF_TABLE_WIDTH"))

	(element UIListTeamStructureHeader
		_isBattleStats 	= "_isBattleStats"
		_isChallenge 	= "isChallenge"
		_isDeathmatch 	= "isDeathmatch"
		_isReversed 	= "_isReversed"
	)

	(block
		(style (width = 100%))

		(controller $Repeat renderer='UIListTeamStructureItem'
			(bind items "	isDeathmatch 	? deathmatchPlayerCollection :
							isChallenge 	? challengeParticipantCollection
											: avatarCollection"
			)
			(args
				_avatarEntity 				= "$item"
				_isBattleLoading 			= "_isBattleLoading"
				_isBattleStats 				= "_isBattleStats"
				_isDynamicDivisionsEnabled 	= "_isDynamicDivisionsEnabled"
				_isOnlyTeam 				= "_isOnlyTeam"
				_isChallenge 				= "isChallenge"
				_isFogOfWar 				= "_isFogOfWar"
				_isReversed 				= "_isReversed"
			)
		)
	)
)

(def element UIListTeamStructureHeader (_isBattleStats:bool = false,
										_isChallenge:bool = false,
										_isDeathmatch:bool = false,
										_isReversed:bool = false)
	(scope
		(struct teamName = GET_TEAM_NAME(_isParticipants="_isChallenge || _isDeathmatch"))
	)

	(style
		(flow = "_isReversed ? reverse_horizontal : horizontal")
		(width = 100%)
		(height = "LINE_HEIGHT")
		(bind backgroundColor "	_isDeathmatch 	? C_EVENT_HEADER :
								_isReversed 	? C_ENEMY_HEADER
												: C_ALLY_HEADER"
		)
	)

	
	(block
		(style
			(align = "_isReversed ? right : left")
			(width = 100%)
			(paddingTop = 10px)
			(paddingLeft = "_isReversed ? 0px : MS")
			(paddingRight = "_isReversed ? MS : 0px")
		)

		(tf
			(class $TextDefaultBold18NM)
			(style (alpha = "TA"))
			(bind text "_isReversed ? teamName.bravoTeamName : teamName.alphaTeamName")
		)
	)

	
	(block
		(bind visible "_isBattleStats")

		(style
			(flow = "_isReversed ? reverse_horizontal : horizontal")
			(height = 100%)
		)

		
		(block
			(bind visible "!_isChallenge && !_isDeathmatch")

			(style
				(width = "COLUMN_ASSIST_WIDTH")
				(height = 100%)
				(align = "middle|center")
			)

			(block
				(style
					(width = 21px)
					(height = 21px)
					(backgroundImage = 'swf:../service_kit/battle_results_svg/battle_results_svg.swf:icon_stat_assist')
				)
			)
		)

		
		(block
			(bind visible "_isDeathmatch")

			(style
				(width = "COLUMN_SCORE_WIDTH")
				(height = 100%)
				(align = "middle|center")
			)

			(block
				(style
					(width = 21px)
					(height = 21px)
					(backgroundImage = 'swf:../service_kit/battle_results_svg/battle_results_svg.swf:deathmatch_score')
				)
			)
		)

		
		(block
			(bind visible "!_isChallenge")

			(style
				(width = "COLUMN_FRAGS_WIDTH")
				(height = 100%)
				(align = "middle|center")
			)

			(block
				(style
					(width = 21px)
					(height = 21px)
					(backgroundImage = 'swf:../service_kit/battle_results_svg/battle_results_svg.swf:icon_stat_frag')
				)
			)
		)

		
		(block
			(style
				(width = "COLUMN_EMOJI_WIDTH")
				(height = 100%)
				(align = "_isReversed ? middle|left : middle|right")
				(paddingRight = "_isReversed ? 0px : 6px")
				(paddingLeft = "_isReversed ? 6px : 0px")
			)

			(block
				(style
					(width = 21px)
					(height = 21px)
					(backgroundImage = 'swf:../service_kit/battle_results_svg/battle_results_svg.swf:icon_emoji')
				)
			)
		)
	)
)

(def element UIListTeamStructureItem (	_avatarEntity:dhEntity,
										_isBattleLoading:bool,
										_isBattleStats:bool,
										_isDynamicDivisionsEnabled:bool,
										_isFogOfWar:bool,
										_isOnlyTeam:bool,
										_isReversed:bool = false)
	(scope
		(event evContextMenuShowed)
		(event evContextMenuHidden)
		(event evMenuItemClicked)
		(event evBattleStatsHidden)
		(event evEmojiSelectorRollOver)
		(event evEmojiSelectorRollOut)
		(event evAvatarSelected)

		(struct mouseHandler = MOUSE_HANDLER())

		(struct avatarDataStruct = AVATAR_DATA_SCOPE(_avatarEntity="_avatarEntity"))
		(struct divisionMemberStruct = DIVISION_MEMBER_SCOPE(_avatarEntity="_avatarEntity"))
		(struct playerClanStruct = PLAYER_CLAN_SCOPE(_avatarEntity="_avatarEntity"))
		(struct playerVoiceStateStruct = PLAYER_VOICE_STATE(_pureName="avatarDataStruct.pureName"))
		(struct shipDataStruct = SHIP_DATA_SCOPE(_shipId="avatarDataStruct.shipId"))
		(struct shipDetectionStruct = PULL_INFO_ABOUT_SHIP_DETECTION(
			_entityId = "avatarDataStruct.entityId"
			_isFogOfWar = "_isFogOfWar"
		))

		(var selectedShipInfoComponent:dhComponent = "getSingleComponent(CC.selectedShipInfo)")
		(var selectedAvatarId:number = "selectedShipInfoComponent.selectedAvatarId" (event "selectedShipInfoComponent.evChanged"))

		(var isSelected:bool = "avatarDataStruct.id == selectedAvatarId")

		(var relation:number = "_avatarEntity.relation.value" (event "_avatarEntity.relation.evChanged"))
		(var isSelf:bool = "relation == SC.Battle.DIPLOMACY_RELATIONS.SELF")

		(var selfPlayerEntity:dhEntity = "getSingleEntity(CC.accountSelf)")
		(var selfDivisionId:number = "selfPlayerEntity.divisionMember.divisionId" (event "selfPlayerEntity.divisionMember.evDivisionChanged"))

		(var preBattlePlayerSimpleCollection:dhCollection = "getCollection(CC.preBattlePlayerSimple)")
		(var preBattlePlayerSimpleEntity:dhEntity = "getPrimaryEntity(CC.preBattlePlayerSimple, avatarDataStruct.id)" autoUpdate=false (event "preBattlePlayerSimpleCollection.evAdded"))
		(var isInvited:bool = "preBattlePlayerSimpleEntity.hasComponent(CC.playerInvitedToPrebattleInfo)")

		(struct sseFeature = FEATURES(_state="SC.Common.ACCOUNT_FEATURE.ACTIONS_USE"))
		(var rawKeyTargetValue:dhComponent = "_avatarEntity.keyTargetMarkerBattle")
		(var isKeyTargetVisible:bool = "rawKeyTargetValue && sseFeature.state != 'locked'")

		(var challengeParticipant:dhComponent = "_avatarEntity.challengeParticipant")
		(var isChallengeParticipant:bool = "challengeParticipant != null")
		(var wonPosition:number = "challengeParticipant.wonPosition ?: 0" (event "challengeParticipant.evWonPositionChanged"))

		(var battleInfoComponent:dhComponent = "getSingleComponent(CC.battleInfo)")
		(var battleType:str = "battleInfoComponent.battleType")

		(var deathmatchPlayerComponent:dhComponent = "_avatarEntity.deathmatchPlayer")
		(var isDeathmatchPlayer:bool = "deathmatchPlayerComponent != null")
		(var deathmatchScore:number = "deathmatchPlayerComponent.score" (event "deathmatchPlayerComponent.evScoreChanged"))

		(var isShipMasteryVisible:bool = "avatarDataStruct.masteryRank && (isIn(battleType, SC.Common.BATTLE_TYPES.MASTERY_RANK_AVAILABLE) || isDeathmatchPlayer)")

		(struct playerColorStruct = PULL_PLAYER_COLOR(
			_isSelf = "isSelf"
			_isAbuser = "avatarDataStruct.isAbuser"
			_isInSameDivision = "divisionMemberStruct.isInSameDivision"
		))
		(var playerStatsAndFragsColor:number = "!isSelf && divisionMemberStruct.isInSameDivision 	? SC.Ui_styles.SERVICE_COLORS.YELLOW
																									: SC.Ui_styles.SERVICE_COLORS.WHITE"
		)
		(var playerShipColor:number = "avatarDataStruct.isAlive && !isSelf && divisionMemberStruct.isInSameDivision ? SC.Ui_styles.SERVICE_COLORS.YELLOW
																													: SC.Ui_styles.SERVICE_COLORS.WHITE"
		)
		(var alphaOfShip:number = "avatarDataStruct.isAlive ? playerColorStruct.value == SC.Ui_styles.SERVICE_COLORS.WHITE 	? TA
																															: 1
															: TS"
		)
		(var alphaOfPlayerName:number = "!_isReversed && avatarDataStruct.isAbuser && !divisionMemberStruct.isInSameDivision ? 1 : alphaOfShip")

		(struct playerComplainPraiseData = PULL_PLAYER_COMPLAIN_PRAISE_DATA(
			_battleType = "battleType"
			_isComplaintsAvailable = true
			_isReplayPlaying = "battleInfoComponent.isReplayPlaying"
		))
		(var isEmojiDisabledReason:bool = "toBool(playerComplainPraiseData.reactionsDisabledReason)")

		(var emojiByOwnerCollection:dhCollection = "getCollectionByPath(CC.emoji, 'byOwnerId')")
		(var emojiByOwnerIdCollection:dhCollection = "emojiByOwnerCollection.child(avatarDataStruct.playerEntityDbId)")
		(var firstEmojiComponent:dhComponent = "emojiByOwnerIdCollection.firstEntity.emoji")

		(var emojiPlayerInfoComponent:dhComponent = "getPrimaryEntity(CC.accountSimple, avatarDataStruct.playerEntityDbId).emojiPlayerInfo")
		(var emojiTotalCount:number = "emojiPlayerInfoComponent.totalCount ?: 0" (event "emojiPlayerInfoComponent.evTotalCountChanged"))

		(var isAvatarSelectionEnabled:bool = true)
		(bind isAvatarSelectionEnabled "false" init=false (event "evEmojiSelectorRollOver"))
		(bind isAvatarSelectionEnabled "true" init=false (event "evEmojiSelectorRollOut"))
	)

	(bind visible "!avatarDataStruct.hidden")

	(macro STRUCT_MOUSE_DISPATCHER
		_mouseHandler = "mouseHandler"
	)

	(dispatch evAvatarSelected on='leftClick' (bind enabled "isAvatarSelectionEnabled"))
	(bindcall externalCall 'direct.action'
		"['action.onAvatarSelected', {selectedAvatarId: avatarDataStruct.id}]"
		init = false
		watch = false
		(bind trigger "_isReversed && shipDetectionStruct.isDetectionInfoHidden")
		(event "evAvatarSelected")
	)

	(style
		(height = "LINE_HEIGHT")
		(width = 100%)
	)

	
	(block
		(class $LineBackgroundStyle)
		(style
			(bind backgroundColor "isSelf ? SC.Ui_styles.SERVICE_COLORS.WHITE : C_DARK")
			(bind alpha "isSelf 					? 0.17 :
						!avatarDataStruct.isAlive 	? 0.15
													: 0"
			)
		)
	)

	
	(block
		(class $LineBackgroundStyle)
		(style
			(backgroundColor = "SC.Ui_styles.SERVICE_COLORS.WHITE")
			(alpha = 0)
		)
		(controller $Animation
			(bindcall play
				duration = 0.02
				from = {alpha: 0}
				to = {alpha: 0.05}
				action = "killAndContinue"
				reverse = "!mouseHandler.rollOver"
				(bind trigger "mouseHandler.rollOver")
			)
		)

		(controller $Tooltip
			(renderer = 'BattlePlayerTooltip')
			(args
				_playerEntity 	= "_avatarEntity"
				_isInStats 		= true
				_isBot 			= "avatarDataStruct.isBot"
				_isSelected 	= "isSelected"
				_checkForAbuse 	= "!_isReversed"
			)
			(macro DEFAULT_TOOLTIP_BEHAVIOUR)
		)

		(controller $Tooltip
			(renderer = 'ContextMenuPlayer')
			(bind enabled "!isSelf")
			(args
				_playerEntity 	= "_avatarEntity"
				_selfPlayer 	= "selfPlayerEntity"
			)
			(macro DEFAULT_MENU_BEHAVIOUR
				_priority = "1"
			)
			(macro TOOLTIP_HIDE_ON_EVENT
				_evHide = "evMenuItemClicked"
			)
			(macro TOOLTIP_HIDE_ON_EVENT
				_evHide = "evBattleStatsHidden"
			)
			(dispatch evContextMenuShowed dir="EventDirection.DOWN" on='evStartShow')
			(dispatch evContextMenuHidden dir="EventDirection.DOWN" on='evHide')
		)
	)

	
	(block
		(bind visible "isSelected")
		(class $LineBackgroundStyle)
		(style
			(hitTest = false)
			(alpha = 0.4)
			(backgroundImage = 'url:../service_kit/frames/one_pixel_frame.png')
			(scale9grid = 2)
		)
	)

	(block
		(class $Fullsize)
		(style (flow = "_isReversed ? reverse_horizontal : horizontal"))

		
		(block
			(bind visible "!isDeathmatchPlayer")
			(style
				(hitTest = false)
				(flow = "_isReversed ? reverse_horizontal : horizontal")
				(align = "middle")
				(width = "COLUMN_DIVISIONS_WIDTH")
				(height = 100%)
				
			)

			(element UIListVoiceTextChatIcons
				_playerId 				= "avatarDataStruct.id"
				_selfPlayerDivisionId 	= "selfDivisionId"
				_isInSameDivision 		= "divisionMemberStruct.isInSameDivision"
				_isSpeaking 			= "playerVoiceStateStruct.isSpeaking"
				_isVoiceChatMuted 		= "playerVoiceStateStruct.isMuted"
				_isInVoiceChat 			= "playerVoiceStateStruct.playerVoiceStateComponent != null"
			)

			
			(block
				(bind visible "divisionMemberStruct.division > 0 && !divisionMemberStruct.divisionHidden")
				(style
					(width = 19px)
					(height = 19px)
					(marginTop = "XXS")
					(bind backgroundImage "	divisionMemberStruct.isDivisionCommander && divisionMemberStruct.isInSameDivision 	? 'swf:../service_kit/divisions_icons_svg/divisions_icons_svg.swf:division_your_commander' :
											divisionMemberStruct.isInSameDivision 												? 'swf:../service_kit/divisions_icons_svg/divisions_icons_svg.swf:division_your_' + DIVISION_LETTERS_ARRAY[divisionMemberStruct.divisionSign]
																																: 'swf:../service_kit/divisions_icons_svg/divisions_icons_svg.swf:division_another_' + DIVISION_LETTERS_ARRAY[divisionMemberStruct.divisionSign]"
					)
				)
			)

			
			(block
				(bind visible "divisionMemberStruct.division == 0 && !isSelf && _isDynamicDivisionsEnabled && isInvited")
				(style
					(width = 19px)
					(height = 19px)
					(marginTop = "XXS")
					(backgroundImage = 'swf:../service_kit/divisions_icons_svg/divisions_icons_svg.swf:division_invited')
				)
			)
		)

		
		(block
			(bind visible "isDeathmatchPlayer")
			(style
				(hitTest = false)
				(width = "COLUMN_PLACE_WIDTH")
				(height = 100%)
				(align = "center|middle")
				(marginRight = "COLUMN_DIVISIONS_WIDTH - COLUMN_PLACE_WIDTH")
				
			)

			(block
				(bind visible "_isBattleStats")
				(class $FullsizeAbsolute)
				(style
					(alpha = 0.1)
					(backgroundColor = "SC.Ui_styles.SERVICE_COLORS.BLACK")
				)
			)

			(tf
				(bind visible "_isBattleStats && $index <= 2")
				(class $TextDefaultBold20NM)
				(bind text "$index + 1")
			)
		)

		
		(hblock
			(bind name "'player_tab_name_' + avatarDataStruct.name")

			(style
				(hitTest = false)
				(height = 100%)
				(align = "center|middle")
				(paddingLeft = "XS")
				(paddingRight = "XS")
				(bind width "_isOnlyTeam ? COLUMN_PLAYER_WIDTH_ONE_TEAM : COLUMN_PLAYER_WIDTH")
				(bind alpha "alphaOfPlayerName")
				
			)

			(element PlayerNameAndClanTag
				_isSelf 			= "isSelf"
				_isAbuser 			= "!_isReversed && avatarDataStruct.isAbuser"  
				_isInSameDivision 	= "divisionMemberStruct.isInSameDivision"
				_playerName 		= "avatarDataStruct.pureName"
				_clanTag 			= "playerClanStruct.clanTag"
				_isBot 				= "avatarDataStruct.isBot"
				_isTextBold 		= "isSelf || isSelected"
				_isDead 			= "!avatarDataStruct.isAlive"
			)
		)

		
		(hblock
			(style
				(hitTest = false)
				(height = 100%)
				(align = "middle")
				(paddingLeft = "XS")
				(bind width "_isOnlyTeam 	? _isBattleLoading 	? COLUMN_SHIP_WIDTH_ONE_TEAM + COLUMN_EMOJI_WIDTH + COLUMN_ASSIST_WIDTH
																: COLUMN_SHIP_WIDTH_ONE_TEAM
											: _isBattleLoading 	? COLUMN_SHIP_WIDTH + COLUMN_EMOJI_WIDTH + COLUMN_ASSIST_WIDTH
																: COLUMN_SHIP_WIDTH"
				)
				
			)

			
			(block
				(style
					(width = "KEY_TARGET_ICON_SIZE")
					(height = 100%)
					(align = "middle")
					(marginRight = "XS")
				)
				(controller $Instance renderer='KeyTargetIcon'
					(bind enabled "isKeyTargetVisible")
				)
			)

			
			(block
				(bind name "'mastery_icon_' + avatarDataStruct.pureName")

				(style
					(height = 100%)
					(width = 19px)
					(align = "middle")
					(marginRight = "XXS")
					(bind alpha "avatarDataStruct.isAlive ? 1 : 0.45")
				)

				(controller $Instance renderer='ShipMasteryIcon'
					(bind enabled "isShipMasteryVisible && (!_isReversed || !shipDetectionStruct.isDetectionInfoHidden)")
					(args
						_rank = "avatarDataStruct.masteryRank"
					)
				)
			)

			(element ShipIconAndLevelAndName
				_shipIDS 				= "shipDataStruct.shipIDS"
				_shipLevelRome 			= "shipDataStruct.shipLevelRome"
				_shipLevelIcon 			= "shipDataStruct.shipLevelIcon"
				_shipType 				= "avatarDataStruct.subType ? toLower(avatarDataStruct.subType): ''"
				_name 					= "avatarDataStruct.name"
				_isSelf 				= "isSelf"
				_isDead 				= "!avatarDataStruct.isAlive"
				_isInSameDivision 		= "divisionMemberStruct.isInSameDivision"
				_alpha 					= "alphaOfShip"
				_playerShipColor 		= "playerShipColor"
				_isShipHidedByFogOfWar 	= "_isReversed && shipDetectionStruct.isDetectionInfoHidden"
			)
		)

		(block 
			(style (width = 100%))
		)

		
		(block
			(bind visible "!_isBattleLoading && !isDeathmatchPlayer")
			(style
				(hitTest = false)
				(width = "COLUMN_ASSIST_WIDTH")
				(height = 100%)
				(align = "middle|center")
				
			)

			(tf
				(bind visible "_isBattleStats && avatarDataStruct.assistsCount != 0 && (!_isReversed || !shipDetectionStruct.isDetectionInfoHidden)")
				(bind class "isSelected || isSelf ? '$TextDefaultBoldNM' : '$TextDefaultNM'")
				(style
					(alpha = "TA")
					(bind textColor "playerStatsAndFragsColor")
				)
				(bind text "avatarDataStruct.assistsCount")
			)
		)

		
		(block
			(bind visible "_isBattleStats && isDeathmatchPlayer")

			(style
				(hitTest = false)
				(width = "COLUMN_SCORE_WIDTH")
				(height = 100%)
				(align = "middle|center")
				
			)

			(tf
				(bind visible "deathmatchScore != 0")
				(bind class "isSelected || isSelf ? '$TextDefaultBoldNM' : '$TextDefaultNM'")
				(style
					(alpha = "TA")
					(bind textColor "playerStatsAndFragsColor")
				)
				(bind text "deathmatchScore")
			)
		)

		
		(block
			(bind name "'player_tab_state_' + avatarDataStruct.name")
			(style
				(hitTest = false)
				(width = "COLUMN_FRAGS_WIDTH")
				(height = 100%)
				
			)

			(controller $Instance renderer='LoadingIndicatorAndFrags'
				(bind enabled "!isChallengeParticipant")
				(args
					_isBattleLoading 		= "_isBattleLoading"
					_isBattleStats 			= "_isBattleStats"
					_isReady 				= "avatarDataStruct.isReady"
					_fragsCount 			= "avatarDataStruct.fragsCount"
					_isSelected 			= "isSelected"
					_playerShipColor 		= "playerStatsAndFragsColor"
					_isSelf 				= "isSelf"
					_playerNameColor 		= "playerColorStruct.value"
					_isShipHidedByFogOfWar 	= "_isReversed && shipDetectionStruct.isDetectionInfoHidden"
				)
			)

			(controller $Instance renderer='WonPosition'
				(bind enabled "isChallengeParticipant")
				(args
					_wonPosition = "wonPosition"
				)
			)
		)

		
		(block
			(bind visible "!_isBattleLoading")

			(style
				(flow = "_isReversed ? reverse_horizontal : horizontal")
				(width = "COLUMN_EMOJI_WIDTH")
				(height = 100%)
				(align = "_isReversed ? middle|left : middle|right")
				
			)

			
			(tf
				(bind visible "emojiTotalCount > 1")

				(class $TextDefaultBold14NM)
				(style
					(hitTest = false)
					(width = 20px)
					(textAlign = "_isReversed ? left : right")
					(alpha = "TA")
				)
				(bind text "emojiTotalCount")
			)

			(block
				(dispatch evEmojiSelectorRollOver on='rollOver')
				(dispatch evEmojiSelectorRollOut on='rollOut')

				(style
					(width = 32px)
					(height = 100%)
					(align = "center|middle")
				)

				(controller $Instance renderer='EmojiSelector'
					(bind enabled "!isSelf && !_isBattleLoading && (!isEmojiDisabledReason || (isEmojiDisabledReason && firstEmojiComponent != null))")
					(args
						_ownerId 					= "avatarDataStruct.playerEntityDbId"
						_reactionsDisabledReason 	= "playerComplainPraiseData.reactionsDisabledReason"
						_evaluationLimits 			= "playerComplainPraiseData.evaluationLimits"
						_emojiByOwnerIdCollection 	= "emojiByOwnerIdCollection"
					)
				)

				(controller $Instance renderer='EmojiSelfSummaryItem'
					(bind enabled "isSelf && !_isBattleLoading && firstEmojiComponent != null")
					(args
						_emojiByOwnerIdCollection = "emojiByOwnerIdCollection"
					)
				)
			)
		)
	)
)


(def element KeyTargetIcon ()
	(style
		(width = "KEY_TARGET_ICON_SIZE")
		(height = "KEY_TARGET_ICON_SIZE")
		(backgroundImage = 'swf:../service_kit/markers_svg/markers_svg.swf:key_target')
	)
)

(def element WonPosition (_wonPosition:number)
	(style
		(height = 100%)
		(align = "middle|center")
	)
	(block
		(style
			(width = 19px)
			(height = 19px)
			(bind backgroundImage "'swf:../service_kit/won_position_svg/won_position_svg.swf:place' + _wonPosition")
		)
	)
)

(def element LoadingIndicatorAndFrags (	_isBattleLoading:bool, _isBattleStats:bool, _isReady:bool, _fragsCount:number, _isSelected:bool,
										_playerShipColor:number="SC.Ui_styles.SERVICE_COLORS.WHITE", _isSelf:bool=false, _isShipHidedByFogOfWar:bool = false)
	(class $Fullsize)
	(style (align = "middle|center"))
	(block
		(bind visible "_isBattleLoading")
		(style
			(width = 10px)
			(height = 10px)
			(align = "middle|center")
			(bind backgroundImage "'swf:../service_kit/markers_svg/markers_svg.swf:' + (_isReady ? 'online' : 'offline')")
		)
	)
	(block
		(bind visible "_isBattleStats && _fragsCount != 0 && !_isShipHidedByFogOfWar")
		(style (width = 100%))
		(tf
			(bind class "_isSelected || _isSelf ? '$TextDefaultBoldNM' : '$TextDefaultNM'")
			(style
				(textAlign = "center")
				(width = 100%)
				(marginText = 0)
				(wordWrap = false)
				(bind textColor "_playerShipColor")
				(alpha = "TA")
			)
			(bind text "_fragsCount")
		)
	)
)

(def element ShipIconAndLevelAndName (	_shipIDS:str,
										_shipLevelRome:str,
										_shipLevelIcon:str,
										_shipType:str,
										_name:str,
										_isDead:bool=false,
										_alpha:number="TA",
										_isSelf:bool=false,
										_playerShipColor:number="SC.Ui_styles.SERVICE_COLORS.WHITE",
										_isInSameDivision:bool=false,
										_isShipHidedByFogOfWar:bool=false,
										_showShipIcon:bool=true
										)
	(scope 
		(var markerColorName:str = "_isDead							? '_sunk' :
									_isInSameDivision && !_isSelf	? '_division'
																	: ''")
		(var iconName:str = "_shipType + markerColorName")
	)

	(style
		(width = 100%)
		(flow = "horizontal")
		(align = "middle")
	)

	
	(block
		(bind visible "!_isShipHidedByFogOfWar && _showShipIcon")
		(bind name "'ship_icon_' + _name")
		(style
			(bind backgroundImage "'swf:../service_kit/ship_classes_svg/ship_classes_svg.swf:icon_default_' + iconName")
			(width = "SHIP_ICON_SIZE.WIDTH")
			(height = "SHIP_ICON_SIZE.HEIGHT")
		)
	)

	
	(hblock
		(bind visible "!_isShipHidedByFogOfWar")
		(style
			(width = 100%)
			(marginRight = "XS")
			(align = "middle")
		)

		(block
			(bind visible "!_shipLevelIcon.length")
			(style
				(marginLeft = "XS")
				(bind alpha  "_alpha")
			)
			(tf
				(class $TextDefaultBoldNM)
				(style (bind textColor "_playerShipColor"))
				(bind text "_shipLevelRome + ' '")
			)
		)

		(block
			(bind visible "_shipLevelIcon.length > 0")
			(style
				(bind alpha "_alpha") 
				(marginTop = -5px)
				(marginBottom = -4px)
			)
			(element LevelIconNM
				_colorTransform = "_isInSameDivision && !_isSelf ? CT_DIVISION : CT_NONE"
			)
		)

		(tf
			(bind name "'player_tab_ship_' + _name")

			(class $TextDefaultBoldNM)
			(style
				(width = 100%)
				(wordWrap = false)
				(letterSpacing = 0)
				(marginTextLeft = 1)
				(elideMode = true)
				(bind alpha "_alpha")
				(bind textColor "_playerShipColor")
			)
			(bind text "toUpper(tr(_shipIDS))")
		)
	)

	
	(block
		(bind visible "_isShipHidedByFogOfWar")
		(class $Fullsize)
		(style
			(marginLeft = "XS")
			(marginRight = "XS")
			(align = "middle")
			(alpha = "TS")
		)
		(tf
			(class $TextDefaultNM)
			(style
				(width = 100%)
				(textAlign = "left")
				(wordWrap = false)
				(letterSpacing = 0)
				(marginTextLeft = 1)
			)
			(text = 'IDS_FOG_OF_WAR_FOR_NOTDETECTED_SHIP')
		)
	)
)

(def element UIListVoiceTextChatIcons (	_playerId:number = 0,
										_selfPlayerDivisionId:number = 0,
										_isSpeaking:bool = false,
										_isVoiceChatMuted:bool = false,
										_isInVoiceChat:bool = false,
										_isInSameDivision:bool = false)
	(scope
		(var playerEntity:dhEntity = "getPrimaryEntity(CC.avatar, _playerId)")
		(var pureName:str = "				playerEntity.avatar.pureName")
		(var isPlayerMessagesMuted:bool = "	playerEntity.avatar.mute" (event "playerEntity.avatar.evMuteChanged"))
		(var relation:number = "			playerEntity.relation.value" (event "playerEntity.relation.evChanged"))
		(var isIgnored:bool = "				playerEntity.contact.isIgnored" (event "playerEntity.contact.evIsIgnoredChanged"))
		(var isSelf:bool = "relation == 0")

		(struct voiceChatEnabledPref = GET_PREF_BOOL(_option="'sound.voice.chat.enabled'"))

		(var battleInfoComponent:dhComponent = "getSingleComponent(CC.battleInfo)")
		(var battleType:str = "battleInfoComponent.battleType")
		(var isClanBattle:bool = "battleType == SC.Common.BATTLE_TYPES.CLAN_BATTLE")
		(var isChatAvailableBattle:bool = "battleType in SC.Common.BATTLE_TYPES.CHAT_AVAILABLE")

		(var playerCanBeInChat:bool = "voiceChatEnabledPref.value && (isClanBattle || isChatAvailableBattle && _isInSameDivision)")
		(var selfCanBeInChat:bool = "isSelf && (isClanBattle || isChatAvailableBattle && _selfPlayerDivisionId)")
		(var canBeInChat:bool = "playerCanBeInChat || selfCanBeInChat")
		(var state:str = "	!_isInVoiceChat		? 'disabled' :
							_isVoiceChatMuted	? 'muted' :
							_isSpeaking			? 'speak'
												: ''")
		(var isVoiceAndTextTriggered:bool = "canBeInChat && (isPlayerMessagesMuted || isIgnored) && (_isSpeaking || _isVoiceChatMuted || !_isInVoiceChat)")
		(var isTextChatIconVisible:bool = "isPlayerMessagesMuted || isIgnored")
	)

	(bind name "isPlayerMessagesMuted ? 'mute_' + pureName : 'not_mute_' + pureName")

	(style
		(height = 100%)
		(width = 19px)
	)

	
	
	
	
	
	
	
	
	

	
	
	
	
	
	
	
	
	
	
	
	

	(block
		(style
			(position = "absolute")
			(left = 1px)
		)

		(controller $Animation
			(bindcall play duration=0.15 from={top: 7} to={top: 13} easing="Easing.quad_out" action="killAll" reverse="!isVoiceAndTextTriggered" init=true (bind trigger "isVoiceAndTextTriggered"))
		)

		(block
			(style
				(width = 19px)
				(height = 19px)
				(backgroundImage = "'swf:../service_kit/chat_channels_svg/chat_channels_svg.swf:text_chat_muted'")
				(alpha = "isTextChatIconVisible ? 1 : 0")
			)
			(controller $Animation
				(bindcall play duration=0.1 from={alpha: 0} to={alpha: 1} easing="Easing.quad_out" action="killAll" reverse="!isTextChatIconVisible" (bind trigger "isTextChatIconVisible"))
			)
		)
	)
)


(def element ShipInfoOnTeamBattlePage (_isBattleStats:bool)
	(scope
		(var selectedShipInfoComponent:dhComponent = "getSingleComponent(CC.selectedShipInfo)")
		(var selectedAvatarId:number = "selectedShipInfoComponent.selectedAvatarId" (event "selectedShipInfoComponent.evChanged"))
		(var selectedAvatarEntity:dhEntity = "getPrimaryEntity(CC.avatar, selectedAvatarId)")

		(struct avatarDataStruct = AVATAR_DATA_SCOPE(_avatarEntity="selectedAvatarEntity"))
		(struct playerClanStruct = PLAYER_CLAN_SCOPE(_avatarEntity="selectedAvatarEntity"))
		(struct shipDataStruct = SHIP_DATA_SCOPE(_shipId="avatarDataStruct.shipId"))

		(var relation:number = "selectedAvatarEntity.relation.value" (event "selectedAvatarEntity.relation.evChanged"))
		(var isEnemy:bool = "relation == SC.Battle.PLAYER_RELATION.ENEMY")

		(var battleInfoComponent:dhComponent = "getSingleComponent(CC.battleInfo)")
		(var isViewShipInfoDisabled:bool = "battleInfoComponent.isViewShipInfoDisabled ?: false")
		(var battleType:str = "battleInfoComponent.battleType ?: ''")
		(var isViewEnemyShipInfoDisabled:bool = "isViewShipInfoDisabled && isEnemy")
		(var isFogOfWar:bool = "battleInfoComponent.isFogOfWar ?: false")
		(var isDeathmatch:bool = "battleInfoComponent.gameModeId == SC.Battle.GAME_MODE.DEATHMATCH")
		(struct shipDetectionStruct = PULL_INFO_ABOUT_SHIP_DETECTION(
			_entityId = "avatarDataStruct.entityId"
			_isFogOfWar = "isFogOfWar"
		))

		(var specratorStateComponent:dhComponent = "getSingleComponent(CC.spectatorState)")
		(var spectatorState:number = "specratorStateComponent.state" (event "specratorStateComponent.evStateChanged"))

		(var isShipInfoVisible:bool = "(!shipDetectionStruct.isDetectionInfoHidden && !isViewEnemyShipInfoDisabled) || spectatorState == SC.Common.SPECTATOR_STATE.TRAINING_SPECTATOR")
		(var reasonOfEmptyContainer:str = "	shipDetectionStruct.isDetectionInfoHidden && isViewEnemyShipInfoDisabled 	? 'IDS_FOG_OF_WAR_AND_VIEW_SHIP_INFO_DISABLED' :
											isViewEnemyShipInfoDisabled													? 'IDS_VIEW_SHIP_INFO_DISABLED' :
											shipDetectionStruct.isDetectionInfoHidden									? 'IDS_FOG_OF_WAR_TIPS'
																														: ''"
		)

		(var isShipMasteryVisible:bool = "avatarDataStruct.masteryRank && (isIn(battleType, SC.Common.BATTLE_TYPES.MASTERY_RANK_AVAILABLE) || isDeathmatch)")

		(var shipTTX:dhStruct = "selectedShipInfoComponent.shipTTX" (event "selectedShipInfoComponent.evChanged"))
		(var hasAtbaArtillery:bool = "toBool(shipTTX.artillery.atba)")
		(var hasAirDefense:bool = "toBool(shipTTX.airDefense.averageAura.maxDist)")

		(var shipRole:str = "shipDataStruct.shipComponent.shipRole ?: ''")
		(var hasShipRole:bool = "!shipRole.empty")
	)

	(name = 'tooltip_ship_info')

	(bind visible "selectedAvatarId > 0")

	
	(block
		(bind visible "!_isBattleStats")
		(class $FullsizeAbsolute)
		(element BlurMapWithLayerContrastPanel)
	)
	
	(style
		(flow = "horizontal")
		(height = 185px)
	)

	
	(hblock
		(style
			(width = "HALF_TABLE_WIDTH")
			(height = 100%)
			(backgroundColor = "C_DARK_PANEL")
		)

		(block
			(style
				(height = 100%)
				(width = 6px)
				(bind backgroundColor "	isDeathmatch 	? C_EVENT_HEADER :
										isEnemy 		? C_ENEMY_HEADER
														: C_ALLY_HEADER"
				)
			)
		)

		(block
			(style
				(height = 100%)
				(align = "middle")
				(paddingLeft = "S")
				(paddingRight = "SXS")
			)

			(block
				(style
					(scaleX = 0.8)
					(scaleY = 0.8)
				)
				(element PlayerDogTag
					_playerId = "avatarDataStruct.playerEntityDbId"
					_size =	 "DOG_TAG_SIZE.MEDIUM"
				)
			)
		)

		(block
			(class $Fullsize)
			(style
				(paddingRight = "M")
				(paddingTop = "M")
				(paddingBottom = "M")
			)

			(block
				(style (width = 100%))

				(block
					(style
						(width = 100%)
						(alpha = "TA")
					)
					(element PlayerNameAndClanTag
						_playerName = "avatarDataStruct.pureName"
						_clanTag 	= "playerClanStruct.clanTag"
						_isBot 		= "avatarDataStruct.isBot"
						_isTextBold = true
						_fontSize 	= 18
					)
				)

				(hblock
					(bind visible "!shipDetectionStruct.isDetectionInfoHidden")
					(style
						(width = 100%)
						(marginTop = "S")
						(align = "middle")
					)

					(block
						(style (bind marginRight "isShipMasteryVisible ? 6px : 0"))

						(controller $Instance renderer='ShipMasteryIcon'
							(bind enabled "isShipMasteryVisible")
							(args
								_rank = "avatarDataStruct.masteryRank"
							)
						)
					)

					(element NationFlagsTiny
						_shipCountry = "shipDataStruct.flagName"
					)

					(block
						(class $Fullsize)
						(style (paddingLeft = "XXS"))

						(element ShipIconAndLevelAndName
							_shipIDS 		= "shipDataStruct.shipIDS"
							_shipLevelRome 	= "shipDataStruct.shipLevelRome"
							_shipLevelIcon 	= "shipDataStruct.shipLevelIcon"
							_shipType 		= "avatarDataStruct.subType ? toLower(avatarDataStruct.subType): ''"
							_name 			= "avatarDataStruct.name"
						)
					)
				)

				(block
					(bind visible "hasShipRole")
					(style
						(width = 100%)
						(marginTop = "S")
					)

					(controller $Tooltip
						(bind enabled "hasShipRole")
						(renderer = 'HeaderDescriptionInstructionTooltip')
						(args
							_headerText = "'IDS_SHIP_ROLE_' + shipRole"
							_descriptionText = "'IDS_SHIP_ROLE_' + shipRole + '_DESC'"
						)
						(macro DEFAULT_TOOLTIP_BEHAVIOUR)
					)

					(controller $Instance renderer='ShipRole'
						(bind enabled "hasShipRole")
						(args
							_shipRole = "shipRole"
							_textAlpha = "TC"
						)
					)
				)
			)

			(block
				(style
					(width = 100%)
					(paddingTop = "SXS")
					(paddingBottom = "XS")
					(paddingLeft = "-XS")
					(paddingRight = "-XS")
				)
				(element HorizontalDividerTwoPx)
			)

			(tf
				(bind visible "!isShipInfoVisible")
				(name = 'lbl_reason_of_empty_container')
				(class $TextDefaultNM)
				(style
					(marginTop = "S")
					(width = 100%)
					(alpha = "TS")
				)
				(bind text "reasonOfEmptyContainer")
			)

			(block
				(bind visible "isShipInfoVisible")
				(style (width = 100%))

				(block
					(name = 'visibility')
					(style (width = 100%))
					(controller $Tooltip
						(renderer='ShipInfoParamVisibilityTooltip')
						(args _visibilityTTX = "shipTTX.visibility")
						(macro DEFAULT_TOOLTIP_BEHAVIOUR)
					)
					(element ShipParameterNumber
						_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_BY_SHIP'
						_value = "shipTTX.visibility.visibilityByShip.normal"
						_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
					)
				)

				(block
					(name = 'AtbaArtillery')
					(bind visible "hasAtbaArtillery")
					(style (width = 100%))
					(controller $Tooltip
						(bind enabled "hasAtbaArtillery")
						(renderer='ShipInfoParamAtbaTooltip')
						(args _atbaArray= "shipTTX.artillery.atba")
						(macro DEFAULT_TOOLTIP_BEHAVIOUR)
					)
					(controller $Instance renderer='ShipParameterNumber'
						(bind enabled "hasAtbaArtillery")
						(args
							_title = 'IDS_SHIP_PARAM_ATBA_GUN'
							_value = "shipTTX.artillery.atbaMaxDist"
							_valueConfig = "VALUE_CONFIG.KILOMETER"
						)
					)
				)

				(block
					(name = 'AirDefense')
					(bind visible "hasAirDefense")
					(style (width = 100%))
					(controller $Tooltip
						(bind enabled "hasAirDefense")
						(renderer='ShipInfoParamAirDefenseTooltip')
						(args _airDefenseTTX = "shipTTX.airDefense")
						(macro DEFAULT_TOOLTIP_BEHAVIOUR)
					)
					(controller $Instance renderer='ShipParameterNumber'
						(bind enabled "hasAirDefense")
						(args
							_title = 'IDS_SHIP_PARAM_AIR_DEFENSE'
							_value = "shipTTX.airDefense.averageAura.maxDist"
							_valueConfig = "VALUE_CONFIG.KILOMETER"
						)
					)
				)
			)
		)
	)

	
	(block 
		(style
			(width = 1px)
			(height = 100%)
		))

	
	(block
		(style
			(width = "HALF_TABLE_WIDTH")
			(height = 100%)
		)

		
		(block
			(bind visible "isShipInfoVisible")
			(name = 'lbl_visible_ship_info')
			(class $Fullsize)

			(controller $Instance
				(bind enabled "isShipInfoVisible")
				(bind renderer "avatarDataStruct.subType == SC.Common.SHIP_TYPE.AIRCARRIER	? 'ShipEquipmentOnTeamBattlePageAirCarrier'
																							: 'ShipEquipmentOnTeamBattlePageDefault'")
				(args
					_selectedAvatarId = "selectedAvatarId"
				)
			)
		)

		
		(block
			(bind visible "!isShipInfoVisible")
			(class $Fullsize)
			(style
				(align = "right")
				(backgroundColor = "C_DARK_PANEL")
			)

			(block
				(style
					(backgroundSize = "autosize")
					(backgroundImage = 'url:../bg/shipinfo_bg_ship_undetected.png')
				)
			)
		)
	)
)

(def element ShipInfoParamAtbaTooltip (_atbaArray:array)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TooltipSystemHeaderSubheaderText _headerText='IDS_SHIP_PARAM_ATBA_GUN')
		(block
			(style (width = 100%))
			(controller $Repeat
				(renderer = 'ShipInfoAtbaTTX')
				(bind count "_atbaArray.length")
				(args _atbaGunTTX = "_atbaArray[$index]")
			)
		)
	)
)

(def element ShipInfoAtbaTTX (_atbaGunTTX:dhStruct)
	(scope
		(var ammoTTX:dhStruct = "	_atbaGunTTX.ammoHE	? _atbaGunTTX.ammoHE :
									_atbaGunTTX.ammoCS	? _atbaGunTTX.ammoCS :
									_atbaGunTTX.ammoAP	? _atbaGunTTX.ammoAP
														: null"
		)
		(var title:str = "	_atbaGunTTX.ammoHE 	? 'IDS_SHIP_PARAM_AMMO_HE_FULL_NAME' :
							_atbaGunTTX.ammoCS 	? 'IDS_SHIP_PARAM_AMMO_CS_FULL_NAME' :
							_atbaGunTTX.ammoAP 	? 'IDS_SHIP_PARAM_AMMO_AP_FULL_NAME'
												: ''"
		)
	)
	(style (width = 100%))

	(element TTX_AMMO_ROW
		_title="title"
		_ammoTTX="ammoTTX"
	)
	(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
		(element TOOLTIP_SYSTEM_PARAMS_BLOCK
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_ARTILLERY_MAX_DAMAGE'
				_value = "ammoTTX.damage"
			)
			(block
				(style (width = 100%))
				(controller $Instance renderer='ShipParameterPercent'
					(bind enabled "_atbaGunTTX.ammoHE != null")
					(args
						_title = 'IDS_SHIP_PARAM_ARTILLERY_BURN_PROB'
						_value = "ammoTTX.burnChance"
						_valueConfig = "VALUE_CONFIG.PERCENT_FLOAT"
						_zeroValueHidden = true
					)
				)
			)
		)
	)
)

(def element ShipInfoParamAirDefenseTooltip (_airDefenseTTX:dhStruct)
	(scope
		(var airDefenseAuras:array = "_airDefenseTTX.auras")
	)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TooltipSystemHeaderSubheaderText
			_headerText = 'IDS_SHIP_PARAM_AIR_DEFENSE'
		)
		(element TooltipSystemHorizontalDivider)
		(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
			(element TOOLTIP_SYSTEM_PARAMS_BLOCK
				(block
					(style (width = 100%))
					(controller $Repeat
						(renderer = 'ShipInfoAirDefenseTTX')
						(bind count "airDefenseAuras.length")
						(args
							_airDefenseAura = "airDefenseAuras[$index]"
						)
					)
				)
			)
		)
	)
)

(def element ShipInfoAirDefenseTTX (_airDefenseAura:dict)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = "'IDS_SHIP_PARAM_AA_AVERAGE_DAMAGE_' + _airDefenseAura.type"
		_value = "_airDefenseAura.damage"
	)
)

(def element ShipInfoParamVisibilityTooltip (_visibilityTTX:dhStruct)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TooltipSystemHeaderSubheaderText
			_headerText = 'IDS_SHIP_PARAM_VISIBILITY_DIST_BY_SHIP'
		)
		(element TooltipSystemHorizontalDivider)
		(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
			(element TOOLTIP_SYSTEM_PARAMS_BLOCK
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_BY_ARTILLERY_IN_SMOKE'
					_value = "_visibilityTTX.visibilityByShip.smoke"
					_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
					_zeroValueHidden = true
				)
				(element ShipParameterRange
					_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_FROM_DEPTH'
					_valueMin = "_visibilityTTX.visibilityFromDepth.min"
					_valueMax = "_visibilityTTX.visibilityFromDepth.max"
					_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_BY_PLANE'
					_value = "_visibilityTTX.visibilityByPlane.normal"
					_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
				)
			)
		)
	)
)

(def element ShipEquipmentOnTeamBattlePageDefault (_selectedAvatarId:number)
	(scope
		(event evSelectAircarrierAmmo)

		(var ammoBySelectedAvatar:dhCollection = "getCollectionByPath(CC.visualSlotData, 'byAvatarId.' + _selectedAvatarId)")

		(var byAvatarIdAndSquadronOwnerPath:str = "'byAvatarIdAndSquadronOwner.' + _selectedAvatarId + '_' + DEFAULT_SQUADRON_OWNER_ID")
		(var consumableBySelectedAvatar:dhCollection = "getCollectionByPath(CC.battleConsumable, byAvatarIdAndSquadronOwnerPath)")
	)
	(class $Fullsize)
	(style (backgroundColor = "C_DARK_PANEL"))

	(block
		(class $Fullsize)
		(style
			(marginLeft = 10px)
			(align = "middle")
		)

		(hblock
			(controller $Repeat renderer='ShipEquipmentOnTeamBattlePageItem'
				(bind items "ammoBySelectedAvatar")
				(args
					_slotEntity = "$item"
				)
			)
		)

		(hblock
			(style (marginTop = 25px))

			(controller $Repeat renderer='ShipEquipmentOnTeamBattlePageItem'
				(bind items "consumableBySelectedAvatar")
				(args
					_slotEntity = "$item"
				)
			)
		)
	)
)

(def element ShipEquipmentOnTeamBattlePageAirCarrier (_selectedAvatarId:number)
	(scope
		(event evSelectAircarrierAmmo)

		(var visualSlotDataCollection:dhCollection = "getCollection(CC.visualSlotData)")
		(var ammoBySelectedAvatar:dhCollection = "visualSlotDataCollection.getChildByPath('byAvatarId.' + _selectedAvatarId)" )

		(var selectedSquadronType:str = 	"ammoBySelectedAvatar.firstEntity.visualSlotData.squadType ?: ''")
		(var selectedSquadronIndex:number = "ammoBySelectedAvatar.firstEntity.visualSlotData.squadId ?: 0")

		(bind selectedSquadronType 	"$event._selectedSquadronType" 	init=false (event "evSelectAircarrierAmmo"))
		(bind selectedSquadronIndex "$event._selectedSquadronIndex" init=false (event "evSelectAircarrierAmmo"))

		(var selectedSquadronAmmoCollection:dhCollection = "visualSlotDataCollection.getChildByPath('byAvatarIdAndSquadType.' + _selectedAvatarId + '_' + selectedSquadronType)")
		(var consumableBySelectedAvatar:dhCollection = "getCollectionByPath(CC.battleConsumable, 'byAvatarIdAndSquadronOwner.' + _selectedAvatarId + '_' + selectedSquadronIndex)")
	)

	(class $Fullsize)

	(block
		(style
			(width = 100%)
			(height = 92px)
			(backgroundColor = "C_DARK_PANEL")
		)

		(hblock
			(style
				(marginLeft = 10px)
				(marginTop = 20px)
			)

			(controller $Repeat renderer='ShipEquipmentOnTeamBattlePageItemWithTab'
				(bind items "ammoBySelectedAvatar")
				(args
					_isSelected = "selectedSquadronType == $item.visualSlotData.squadType"
					_weaponSlotEntity = "$item"
				)
			)
		)
	)

	(element BattlePageTableDivider)

	(hblock
		(style
			(width = 100%)
			(height = 92px)
			(backgroundColor = "C_DARK_PANEL")
		)

		(block
			(class $FullsizeAbsolute)
			(style (backgroundColor = "SC.Ui_styles.SERVICE_COLORS.INNER_PANEL"))
		)

		(hblock
			(style
				(marginLeft = 10px)
				(marginTop = 12px)
			)

			(hblock
				(controller $Repeat renderer='ShipEquipmentOnTeamBattlePageItem'
					(bind items "selectedSquadronAmmoCollection")
					(args
						_slotEntity = "$item"
					)
				)
			)
			(hblock
				(controller $Repeat renderer='ShipEquipmentOnTeamBattlePageItem'
					(bind items "consumableBySelectedAvatar")
					(args
						_slotEntity = "$item"
					)
				)
			)
		)
	)
)

(def element BattlePageTableDivider ()
	(style
		(width = 100%)
		(height = 1px)
		(alpha = 0.05)
	)
)

(def element ShipEquipmentOnTeamBattlePageItemWithTab (_weaponSlotEntity:dhEntity, _isSelected:bool=false)
	(scope
		(struct mouseHandler = MOUSE_HANDLER())

		(var state:number = "	_isSelected 			? SC.Ui_styles.BUTTON_STATE.SELECTED :
								mouseHandler.mouseDown 	? SC.Ui_styles.BUTTON_STATE.DOWN :
								mouseHandler.rollOver	? SC.Ui_styles.BUTTON_STATE.OVER
														: SC.Ui_styles.BUTTON_STATE.UP"
		)



		(var lineAlphaDict:dict = "{SC.Ui_styles.BUTTON_STATE.DISABLED	: 0.1,
									SC.Ui_styles.BUTTON_STATE.SELECTED	: 0.8,
									SC.Ui_styles.BUTTON_STATE.DOWN		: 0.3,
									SC.Ui_styles.BUTTON_STATE.OVER		: 0.5,
									SC.Ui_styles.BUTTON_STATE.UP		: 0.2}")

		(var lineAlpha:number = "lineAlphaDict[state]")

		(var isSlotInteractive:bool = "_weaponSlotEntity.visualSlotData.weaponType == SC.Ships.SHIP_WEAPON_TYPES.AIRPLANES")

		(var isTabClickable:bool = "!_isSelected && isSlotInteractive")
	)

	(style (backgroundColor = "NO_COLOR"))

	(macro STRUCT_MOUSE_DISPATCHER
		_mouseHandler = "mouseHandler"
	)
	(macro STRUCT_SOUND_HANDLER
		_enabled 		= "isTabClickable"
		_mouseHandler 	= "mouseHandler"
		_soundSet 		= "'button_tab'"
	)

	(dispatch evSelectAircarrierAmmo
		args = "{_selectedSquadronType: _weaponSlotEntity.visualSlotData.squadType, _selectedSquadronIndex: _weaponSlotEntity.visualSlotData.squadId}"
		dir = "EventDirection.UP"
		(event "mouseHandler.evClicked")
		(bind enabled "isTabClickable")
	)

	(element ShipEquipmentOnTeamBattlePageItem
		_slotEntity = "_weaponSlotEntity"
	)

	
	(block
		(bind visible "isSlotInteractive")
		(style
			(position = "absolute")
			(alpha = "lineAlpha")
			(width = 100%)
			(bottom = -13px)
			(height = 1px)
			(backgroundColor = 0xFFFFFFFF)
		)

		(macro DEFAULT_CONTROL_STATE_ANIMATION_ALPHA
			_trigger 	= "state"
			_alpha 		= "lineAlpha"
		)
	)
)

(def element ShipEquipmentOnTeamBattlePageItem (_slotEntity:dhEntity)
	(scope
		(event evWeaponItemClicked)

		(var equipmentSlotComponent:dhComponent = "_slotEntity.visualSlotData ?: _slotEntity.battleConsumable")
		(var paramsDescriptor:str = "_slotEntity.hasComponent(CC.visualSlotData) ? equipmentSlotComponent.id : ''")

		(var numConsumablesBaseValue:number = "equipmentSlotComponent.consNumBaseValue")
		(var consumableName:str = "equipmentSlotComponent.ident")
		(var consumePostfix:str = "numConsumablesBaseValue == 0 ? '_empty' : ''")
		(var iconPath:str = "consumableName ? 'img://gui/consumables_dds_scale/' + consumableName + consumePostfix + '.dds' : equipmentSlotComponent.iconPath")
		(var weaponType:number = "equipmentSlotComponent.weaponType != null ? equipmentSlotComponent.weaponType : SC.Ships.SHIP_WEAPON_TYPES.NONE")

		(var selectedShipInfoComponent:dhComponent = "getSingleComponent(CC.selectedShipInfo)")
		(var shipTTX:dhStruct = "selectedShipInfoComponent.shipTTX" (event "selectedShipInfoComponent.evChanged"))
		(var isSecondaryArtilleryWithFireMode:bool = "weaponType == SC.Ships.SHIP_WEAPON_TYPES.SECONDARY_ARTILLERY && toBool(shipTTX.secondaryArtillery.drumFireMode)")
		(var isChargeableDrum:bool = "shipTTX.artillery.drumFireMode.isChargeable.value")
		(var isSwitchableDrum:bool = "shipTTX.artillery.drumFireMode.isSwitchable.value")
		(var isShowDrumMode:bool = "(shipTTX.artillery.drumFireMode && (isChargeableDrum || !isSwitchableDrum)) || isSecondaryArtilleryWithFireMode")
		(var showSlot:bool = "equipmentSlotComponent.id != SC.Ships.SHIP_INFO_WEAPON_TYPE.VALUE_TO_NAME[SC.Ships.SHIP_INFO_WEAPON_TYPE.FIRE_MODE] || isSwitchableDrum")
	)
	(bind name "consumableName ?: 'weapon_' + paramsDescriptor")
	(bind visible "showSlot")
	(style
		(marginLeft = 3px)
		(marginRight = 3px)
		(width = "SLOT_SIZE")
		(height = "SLOT_SIZE")
	)

	(controller $Tooltip
		(renderer = 'ShipEquipmentOnTeamBattlePageItemTooltip')
		(args
			_slotEntity = "_slotEntity"
			_isShowDrumMode = "isShowDrumMode"
			_isZeroConsumables = "numConsumablesBaseValue == 0"
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR)
	)
	(block
		(class $FullsizeAbsolute)
		(style
			(backgroundSize = "fill")
			(bind backgroundImage "iconPath")
		)
	)
	(block
		(bind visible "isShowDrumMode && isIn(paramsDescriptor, CAN_DRUM_AMMO)")
		(class $FullsizeAbsolute)
		(style
			(hitTest = false)
			(backgroundSize = "fill")
			(backgroundImage = 'img://gui/consumables_dds_scale/drumMode_indicator.dds')
		)
	)
)

(def element ShipEquipmentOnTeamBattlePageItemTooltip (_slotEntity:dhEntity, _isShowDrumMode:bool, _isZeroConsumables:bool)
	(scope
		(var selectedShipInfoComponent:dhComponent = "getSingleComponent(CC.selectedShipInfo)")
		(var selectedAvatarId:number = "selectedShipInfoComponent.selectedAvatarId" (event "selectedShipInfoComponent.evChanged"))
		(var shipTTX:dhStruct = "selectedShipInfoComponent.shipTTX" (event "selectedShipInfoComponent.evChanged"))

		(var equipmentSlotComponent:dhComponent = "_slotEntity.visualSlotData ?: _slotEntity.battleConsumable")
		(var paramsDescriptor:str = "_slotEntity.hasComponent(CC.visualSlotData) ? equipmentSlotComponent.id : ''")
		(var title:str = 			"equipmentSlotComponent.title")
		(var subheader:str = 		"equipmentSlotComponent.subheader")
		(var iconPath:str = 		"equipmentSlotComponent.iconPath")
		(var weaponType:number = 	"equipmentSlotComponent.weaponType != null ? equipmentSlotComponent.weaponType : SC.Ships.SHIP_WEAPON_TYPES.NONE")

		(var attributesComponent:dhComponent = "_slotEntity.attributes")
		(var attributesNegative:array = "attributesComponent.negative 	?: []" (event "attributesComponent.evChanged"))
		(var attributesNeutral:array = 	"attributesComponent.neutral	?: []"	(event "attributesComponent.evChanged"))
		(var attributesPositive:array = "attributesComponent.positive 	?: []" (event "attributesComponent.evChanged"))
	)

	(style (width = 340px))

	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TooltipSystemHeaderWithIconAndText
			_imageUrl 		= "iconPath"
			_imageWidth 	= "SLOT_SIZE"
			_imageHeight 	= "SLOT_SIZE"
			_headerText 	= "title"
			_subheaderText 	= "subheader"
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider' (bind enabled "_isZeroConsumables"))
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemStatusLine'
				(bind enabled "_isZeroConsumables")
				(args
					_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.ATTENTION"
					_text = 'IDS_ZERO_CONSUMABLES_INFO'
				)
			)
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider'
				(bind enabled "paramsDescriptor")
			)
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='AmmoParametersAdapterInBattlePage'
				(bind enabled "paramsDescriptor")
				(args
					_ttxDescriptor = "paramsDescriptor"
					_shipTTX = "shipTTX"
					_avatarId = "selectedAvatarId"
				)
			)
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='WeaponTooltipBurstFire'
				(bind enabled "_isShowDrumMode && isIn(paramsDescriptor, CAN_DRUM_AMMO)")
				(args
					_weaponType = "weaponType"
					_prefix 	= 'ForBattleTab'
				)
			)
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider' (bind enabled "!paramsDescriptor"))
		)
		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemParamsModifiersList'
				(bind enabled "!paramsDescriptor")
				
				(args
					_attributesPositive =	"attributesPositive"
					_attributesNeutral =	"attributesNeutral"
					_attributesNegative =	"attributesNegative"
				)
			)
		)
	)
)
