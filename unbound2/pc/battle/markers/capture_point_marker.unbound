(def constant CAPTURE_POINT_ANIM_DURATION 0.25)
(def constant CAPTURE_POINT_FX_ANIM_DURATION 0.15)
(def constant CAPTURE_POINT_ASSETS_PATH 'swf:../battle_hud/markers/capture_point_svg/capture_point_svg.swf:')
(def constant CAPTURE_POINT_LABEL_COLORS {
	RED: 0xFF3300,
	GREEN: 0x4CE8AA,
	WHITE: 0xFFFFFF,
	BLACK: 0x081225
})

(def element WorldCapturePointMarker (_markerEntity:gfx)
	(scope
		(macro SCOPE_HIGHLIGHT_MARKER_ON_WORLD_MOUSE_OVER)
		(macro GET_MARKER_ENTITY_COMPONENT 'capturePoint')
		(var showIconInWorld:bool = "capturePointComponent.showIconInWorld" (event "capturePointComponent.evShowIconInWorldChanged"))
	)
	
	(block
		(style
			(position = "absolute")
			(bottom = 36px)
		)
		(element TargetAnimationItem "_markerEntity")
	)

	(block
		(style
			(marginLeft = -50%)
			(marginTop = -50%)
			(pivotX = 50%)
			(pivotY = 50%)
		)
		(macro EFFECT_HIGHLIGHT_MARKER_ON_MOUSE_OVER)

		(controller $Instance renderer='CapturePointIndicator'
			(bind enabled "showIconInWorld")
			(args
				_markerEntity = "getEntity(_markerEntity.id)" 
			)
		)
	)
)

(def element CapturePointIndicator (_markerEntity:dhEntity, _isBattleStatsElement:bool=false)
	(scope
		(var timerComponent:dhComponent = "getSingleComponent(CC.battleTimer)")
		(var currentTime:number = "timerComponent.battleTime" (event "timerComponent.evBattleTimeChanged"))

		(var capturePointComponent:dhComponent = 	"_markerEntity.capturePoint")
		(var progressComponent:dhComponent = 		"_markerEntity.progress")
		(var relationComponent:dhComponent = 		"_markerEntity.relation")

		(var battleInfoComponent:dhComponent =	"getSingleComponent(CC.battleInfo)")
		(var battleTypeGPName:str =				"battleInfoComponent.battleTypeGameParamsName ?: ''")
		(var isWaffentrager:bool =				"battleTypeGPName == 'PCVE030'")

		(var relationIndex:number = "relationComponent ? relationComponent.value : SC.Battle.PLAYER_RELATION.NEUTRAL" (event "relationComponent.evChanged"))
		(var relation:str = "SC.Battle.PLAYER_RELATION.NAMES[SC.Battle.PLAYER_RELATION.VALUE_TO_NAME[relationIndex]]")

		(var capturePointLabel:str = 		"capturePointComponent.label ?: ''")
		(var pointType:number = 			"capturePointComponent.type ?: 0")
		(var isVisible:bool = 				"capturePointComponent.visible" 				(event "capturePointComponent.evVisibleChanged"))
		(var iconId:number = 				"capturePointComponent.iconId ?: 0" 			(event "capturePointComponent.evIconChanged"))
		(var invaderRelation:number = 		"capturePointComponent.invaderRelation ?: 0" 	(event "capturePointComponent.evInvaderChanged"))
		(var capturePointTimerName:str = 	"capturePointComponent.timerName ?: ''" 		(event "_markerEntity.evAdded"))
		(var bothInside:bool = 				"capturePointComponent.bothInside" 				(event "capturePointComponent.evBothInsideChanged"))
		(var isCapturePointActive:bool = 	"toBool(capturePointComponent.active)" 			(event "capturePointComponent.evActiveChanged"))

		(var isFlagPoint:bool = "isIn(pointType, [SC.Battle.CONTROL_POINT_TYPE.BASE_WITH_POINTS, SC.Battle.CONTROL_POINT_TYPE.BASE])")

		(var captureProgress:number = "progressComponent.value ?: 0" (event "progressComponent.evChanged"))
		(var isCaptured:bool = "captureProgress == 0")

		(var linkedTimerTaskEntity:dhEntity = "_isBattleStatsElement ? getPrimaryEntity(CC.task, capturePointTimerName) : null")
		(var timeoutComponent:dhComponent = "linkedTimerTaskEntity.timeout")
		(var linkedTimerValue:number = "timeoutComponent.time ?: 0" (event "timeoutComponent.evTimeChanged") (event "timeoutComponent.evRunningChanged"))
		(var timeLeftToCapturePointActivation:number = "linkedTimerValue > currentTime ? linkedTimerValue - currentTime : 0")

		
		(var barRelation:number = "isCaptured ? relationIndex : invaderRelation")
		(var isAlly:bool = 		"relationIndex == SC.Battle.PLAYER_RELATION.ALLY")
		(var isEnemy:bool = 	"relationIndex == SC.Battle.PLAYER_RELATION.ENEMY")
		(var isNeutral:bool = 	"relationIndex == SC.Battle.PLAYER_RELATION.NEUTRAL")

		
		(var isCaptureInProgress:bool = "bothInside || captureProgress > 0" (event "progressComponent.evChanged") (event "capturePointComponent.evBothInsideChanged"))
		(var progressInvertion:number = "isNeutral ? 1 : -1")
		(var indicatorProgress:number = "isCaptureInProgress	? captureProgress == 0  ? 360
																						: 360 * captureProgress * progressInvertion
																: 0")

		
		(var capturedBarSymbol:str = "isAlly ? 'capture_point_progressbar_ally' : 'capture_point_progressbar_enemy'")
		(var capturedBarPath:str = "CAPTURE_POINT_ASSETS_PATH + capturedBarSymbol")

		(var invaderBarSymbol:str = "isCaptureInProgress	?	barRelation == SC.Battle.PLAYER_RELATION.ALLY	? 'capture_point_progressbar_ally'
																												: 'capture_point_progressbar_enemy'
															: ''")
		(var invaderBarPath:str = "invaderBarSymbol ? CAPTURE_POINT_ASSETS_PATH + invaderBarSymbol : ''")

		(var labelTextColorTransform:dict = "	isAlly		? TWO_TEAMS_COLOR_TRANSFORMS['ally'] :
												isEnemy		? TWO_TEAMS_COLOR_TRANSFORMS['enemy']
															: TWO_TEAMS_COLOR_TRANSFORMS['white'] ")

		(var startCaptureRotation:number = "isNeutral ? 45 : -45")
		(var pointRelationHistory:number = "relationIndex" watch=false init=false)
		(bind pointRelationHistory "relationIndex" watch=false init=false (bind enabled "isCaptureInProgress"))
		(var endingCaptureRotation:number = "	pointRelationHistory == SC.Battle.PLAYER_RELATION.NEUTRAL	?	isNeutral	? 45
																															: -45 :
												pointRelationHistory == SC.Battle.PLAYER_RELATION.ALLY		?	isAlly		? -45
																															: 45
																											:	isEnemy		? -45
																															: 45")
		(var customElementsVisibilityComponent:dhComponent = "getSingleComponent(CC.customElementsVisibility)")
		(var customisedElements:number = "customElementsVisibilityComponent.customisedElements" (event "customElementsVisibilityComponent.evChanged"))
		(var isAntistandardCustomization:bool = "(customisedElements & SC.Battle.CUSTOM_BATTLE_ELEMENTS.ANTISTANDARD) > 0")

		(var isTimerVisible:bool = "!isCapturePointActive && timeLeftToCapturePointActivation > 0")
		(var isPointVisible:bool = "!isTimerVisible && (!_isBattleStatsElement || isWaffentrager || isCapturePointActive || isAntistandardCustomization)")
	)
	
	
	

	(bind visible "isVisible || linkedTimerValue > 0")

	(block
		(style
			(align = "center|middle")
			(width = 40px)
			(height = 40px)
			(pivotX = 50%)
			(pivotY = 50%)
			(rotation = 0)
			(bind alpha "isCapturePointActive || (isAntistandardCustomization && !isTimerVisible) ? 1 : 0.5")
		)

		(controller $Animation
			(bindcall play
				duration = "CAPTURE_POINT_ANIM_DURATION"
				to = "{ rotation: startCaptureRotation }"
				on = 'addedToStage'
				(bind enabled "isCaptureInProgress")
			)

			(bindcall play
				duration = "CAPTURE_POINT_ANIM_DURATION"
				from = "{ rotation: endingCaptureRotation }"
				to = "{ rotation: 0 }"
				on = 'addedToStage'
				(bind enabled "!isCaptureInProgress")
			)
		)

		
		
		
		(block
			(style
				(width = 28px)
				(height = 28px)
				(bind backgroundImage "CAPTURE_POINT_ASSETS_PATH + 'capture_point_frame'")
			)

			
			
			
			(block
				(class $FullsizeAbsolute)
				(bind visible "!isNeutral")
				(style (bind backgroundImage "capturedBarPath"))
			)

			
			
			
			(block
				(class $FullsizeAbsolute)
				(style (align = "center|middle"))

				(block
					(controller $Sector
						(radius = 23)
						(bind arc "indicatorProgress")
						(bind offset "isNeutral ? -135 : -45")
					)
					(isMask = true)
				)

				(block
					(class $FullsizeAbsolute)
					(style (bind backgroundImage "invaderBarPath"))
				)
			)

			(block
				(class $FullsizeAbsolute)
				(style
					(alpha = 0)
					(bind backgroundImage "CAPTURE_POINT_ASSETS_PATH + 'capture_point_contest'")
				)

				(controller $Animation
					(bindcall play
						repeatCount = -1
						keyframes = "[	{ time: 0.01, to:{ alpha: 0 }},
										{ time: 0.35, to:{ alpha: 1 }},
										{ time: 0.45, to:{ alpha: 1.1 }},
										{ time: 1.05, to:{ alpha: 0 }}]"
						on = 'addedToStage'
						(bind enabled "bothInside")
					)

					(bindcall play
						duration = 0.25
						to = "{ alpha: 0 }"
						action = "killAll"
						on = 'addedToStage'
						(bind enabled "!bothInside")
					)
				)
			)
		)
	)

	
	
	
	(block
		(bind visible "isPointVisible")

		(class $MiddleVHAbsolutely)

		(style
			(width = 28px)
			(height = 28px)
		)

		(block
			(bind visible "isWaffentrager")
			(class $FullsizeAbsolute)
			(style (bind backgroundImage "CAPTURE_POINT_ASSETS_PATH + 'waffentrager'"))
			(bind colorTransform "labelTextColorTransform")
		)

		(block
			(bind visible "!isWaffentrager")
			(class $FullsizeAbsolute)

			(block
				(bind visible "!isFlagPoint && !iconId")
				(class $FullsizeAbsolute)
				(style (bind backgroundImage "CAPTURE_POINT_ASSETS_PATH + 'capture_point_' + toLower(capturePointLabel) + '_outline'"))
				(block
					(class $Fullsize)
					(style (bind backgroundImage "CAPTURE_POINT_ASSETS_PATH + 'capture_point_' + toLower(capturePointLabel)"))
					(bind colorTransform "labelTextColorTransform")
				)
			)

			(block
				(bind visible "!isFlagPoint && iconId")
				(class $FullsizeAbsolute)
				(block
					(class $Fullsize)
					(style (bind backgroundImage "CAPTURE_POINT_ASSETS_PATH + 'capture_point_' + toLower(SC.Battle.CONTROL_POINT_ICON.VALUE_TO_NAME[iconId])"))
					(bind colorTransform "labelTextColorTransform")
				)
			)

			(block
				(bind visible "isFlagPoint")
				(style
					(width = 28px)
					(height = 28px)
					(bind backgroundImage "CAPTURE_POINT_ASSETS_PATH + 'capture_base_flag_' + relation")
				)
			)
		)
	)

	(block
		(style
			(position = "absolute")
			(height = 100%)
		)
		(controller $Instance renderer='CapturePointIndicatorTimer'
			(bind enabled "_isBattleStatsElement && isTimerVisible")
			(args
				_text = "countdownFormat(timeLeftToCapturePointActivation, 0, true, true)"
			)
		)
	)
)

(def element CapturePointIndicatorTimer (_text:str)
	(style
		(position = "absolute")
		(align = "middle")
		(width = 40px)
		(height = 100%)
		(paddingLeft = 3px)
		(backgroundColor = "NO_COLOR")
	)

	(controller $Tooltip
		(renderer = 'SimpleStatusTooltip')
		(args
			_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.DEFAULT"
			_text = 'IDS_TIME_TILL_CAPTURE_POINT_ACTIVATION'
		)

		(align = "bottom|center")
		(position = "border")
		(offset = [0, 6])
		(screenBoundsOffset = 10px)

		(macro SIMPLE_TOOLTIP_ANIMATION)
	)

	(tf
		(class $TextDefaultBoldNM)
		(bind text "_text")
	)
)