(def element WorldAttentionMarker (_markerEntity:gfx)
	(scope
		(var cameraComponent:dhComponent = "getSingleComponent(CC.camera)")
		(var isTactical:bool = "cameraComponent.isTactical" (event "cameraComponent.evTacticalStateChanged"))
	)

	(alpha = "isTactical ? 1 : 0")

	(controller $Animation
		(bindcall play
			duration = 0.3
			delay = 0.05
			from = "{ alpha: 0 }"
			to = "{ alpha: 1 }"
			reverse = "!isTactical"
			(bind trigger "isTactical")
		)
	)

	(element AttentionMarker
		_markerEntity = "getEntity(_markerEntity.id)"  
		_markerType	= 'world'
	)
)