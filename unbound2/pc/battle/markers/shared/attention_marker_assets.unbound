(def constant CIRCLE_EFFECT_COUNT 3)

(def constant WORLD_ATTENTION_DOT_RADIUS 3)
(def constant WORLD_ATTENTION_EFFECT_SIZE 18)

(def constant MAP_ATTENTION_DOT_RADIUS 2)
(def constant MAP_ATTENTION_EFFECT_SIZE 18)

(def constant MARKER_CONFIG_MAP {
	'world'		: {effectSize: "WORLD_ATTENTION_EFFECT_SIZE", dotSize: "WORLD_ATTENTION_DOT_RADIUS"},
	'minimap'	: {effectSize: "MAP_ATTENTION_EFFECT_SIZE", dotSize: "MAP_ATTENTION_DOT_RADIUS"}
})


(def element AttentionMarker (_markerEntity:dhEntity, _markerType:str)
	(scope
		(var dotAlpha:number = 0)

		(var targetEntity:dhEntity = "getEntity(_markerEntity.minimapAttentionPoint.avatarId)")

		(var relationComponent:dhComponent = "targetEntity.relation")

		(var isSelf:bool = 		"relationComponent.value == SC.Battle.PLAYER_RELATION.SELF" 				(event "relationComponent.evChanged"))
		(var relationName:str = "toLower(SC.Battle.PLAYER_RELATION.VALUE_TO_NAME[relationComponent.value])" (event "relationComponent.evChanged"))

		(var isReversedAnim:bool = "!isSelf")

		(var timeToLiveComponent:dhComponent = "_markerEntity.timeToLive")
		(var lifeTime:number = 	"timeToLiveComponent.lifeTime ?: 1")
		(var deathTime:number = "timeToLiveComponent.deathTime ?: 1")

		(var dotRadius:number = "MARKER_CONFIG_MAP[_markerType].dotSize" watch=false)

		(var markerColorTransform:dict = "relationName 	? TWO_TEAMS_COLOR_TRANSFORMS[relationName]
														: TWO_TEAMS_COLOR_TRANSFORMS['white']")

		(controller $Animation
			(bindcall play
				duration = "SHORT_ATTENTION_DURATION / CIRCLE_EFFECT_COUNT"
				to = "{ dotRadius: MARKER_CONFIG_MAP[_markerType].dotSize, dotAlpha: 1 }"
				watch = false
				on = 'addedToStage'
			)
			(bindcall play
				delay = "lifeTime + deathTime - SHORT_ATTENTION_DURATION"
				duration = "deathTime"
				to = "{ dotAlpha: 0 }"
				watch = false
				(bind enabled "dotAlpha == 1")
			)
		)
	)

	(macro ATTENTION_CIRCLE_FX
		_beginRadius = "dotRadius"
		_endRadius = "MARKER_CONFIG_MAP[_markerType].effectSize"
		_duration = "SHORT_ATTENTION_DURATION"
		_isReversed = "isReversedAnim"
	)

	(block
		(style
			(position = "absolute")
			(bind alpha "dotAlpha")
		)
		(bind colorTransform "markerColorTransform")

		(controller $Sector
			(arc = 360)
			(color = "SC.Ui_styles.SERVICE_COLORS.WHITE")
			(bind radius "dotRadius")
		)
	)
)

(def macro ATTENTION_CIRCLE_FX (_beginRadius:expression, _endRadius:expression, _duration:expression, _isReversed:expression)
	(scope
		(var customAlpha:number = 0)
		(var customAlphaSecond:number = 0)

		(var customRad:number = 		"_isReversed ? _beginRadius : _endRadius" watch=false)
		(var customRadSecond:number = 	"_isReversed ? _beginRadius : _endRadius" watch=false)

		(controller $Animation
			(play
				duration = "_duration"
				repeatCount = 4
				from = "{ customRad: 0, customAlpha: 1 }"
				to = "{ customRad: _endRadius, customAlpha: 0 }"
				reverse = "_isReversed"
			)
			(play
				duration = "_duration"
				delay = "_duration/2"
				repeatCount = 3
				from = "{ customRadSecond: 0, customAlphaSecond: 1 }"
				to = "{ customRadSecond: _endRadius, customAlphaSecond: 0 }"
				reverse = "_isReversed"
			)
		)
	)

	(block
		(style
			(position = "absolute")
			(alpha = 0)
			(bind alpha "customAlpha")
		)
		(bind colorTransform "markerColorTransform")

		(controller $Sector
			(arc = 360)
			(radius = 0)
			(alphas = [0, 0.5, 0])
			(ratios = [175, 215, 255])
			(colors = [0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF])
			(bind radius "customRad")
		)
	)
	(block
		(style
			(position = "absolute")
			(alpha = 0)
			(bind alpha "customAlphaSecond")
		)
		(bind colorTransform "markerColorTransform")

		(controller $Sector
			(arc = 360)
			(radius = 0)
			(alphas = [0, 0.75, 0])
			(ratios = [175, 215, 255])
			(colors = [0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF])
			(bind radius "customRadSecond")
		)
	)
)