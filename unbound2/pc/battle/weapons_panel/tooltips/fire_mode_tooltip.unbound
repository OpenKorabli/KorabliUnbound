(def element FireModeTooltipParams (_weaponType:number, _ownerId:number=-1)
	(scope
		(var selfVehicleComponent:dhComponent = "getSingleComponent(CC.selfVehicle)")
		(var shipTTX:dhStruct = "selfVehicleComponent.shipTTX")

		(var comparison:dhComponent = "getSingleComponent(CC.comparison)")
		(var panelTTX:dhStruct = "comparison.panelTTX" (event "comparison.evPanelTTXChanged"))

		(var currentTTX:dhStruct = "shipTTX ?: panelTTX")
		(var isSecondaryArtillery:bool = "_weaponType == SC.Ships.SHIP_WEAPON_TYPES.SECONDARY_ARTILLERY")
		(var drumFireModeTTX:dhStruct = "isSecondaryArtillery 	? currentTTX.secondaryArtillery.drumFireMode
																: currentTTX.artillery.drumFireMode"
		)

		(var shotDelay:dict = "drumFireModeTTX.shotDelay ?: DEFAULT_TTX_VALUE")
		(var numShots:dict = "drumFireModeTTX.numShots ?: DEFAULT_TTX_VALUE")

	)
	(style
		(width = 340px)
		(paddingLeft = "-M")
		(paddingRight = "M")
	)

	(block
		(class $TooltipModuleParamsContainer)
		(block
			(style (width = 100%))
			(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
				(element TOOLTIP_SYSTEM_PARAMS_BLOCK
					(element ShipParameterNumber
						_title = 'IDS_SHIP_PARAM_DRUM_FIRE_SALVO_SHOT_DELAY'
						_value = "shotDelay"
						_alternativeValueKey = "_ownerId + '_' + (isSecondaryArtillery ? SC.Battle.PARAMETER.reloadTimeShot_SecondaryBurstFire : SC.Battle.PARAMETER.reloadTimeShot_BurstFire)"
						_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
						_zeroValueHidden = true
					)
					(element ShipParameterNumber
						_title = 'IDS_SHIP_PARAM_DRUM_FIRE_SALVO_COUNT'
						_value = "numShots"
						_zeroValueHidden = true
					)
				)
			)
		)
	)
)

(def element FireModeTooltipParamsForBattleTab (_weaponType:number)
	(scope
		(var selectedShipInfoComponent:dhComponent = "getSingleComponent(CC.selectedShipInfo)")
		(var shipTTX:dhStruct = "selectedShipInfoComponent.shipTTX" (event "selectedShipInfoComponent.evChanged"))
		(var drumFireModeTTX:dhStruct = "_weaponType == SC.Ships.SHIP_WEAPON_TYPES.ARTILLERY ? shipTTX.artillery.drumFireMode
																							 : shipTTX.secondaryArtillery.drumFireMode"
		)

		(var shotDelay:dict = "drumFireModeTTX.shotDelay ?: DEFAULT_TTX_VALUE")
		(var numShots:dict = "drumFireModeTTX.numShots ?: DEFAULT_TTX_VALUE")
	)

	(style
		(width = 340px)
		(paddingLeft = "-M")
		(paddingRight = "M")
	)

	(block
		(class $TooltipModuleParamsContainer)
		(block
			(style (width = 100%))
			(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
				(element TOOLTIP_SYSTEM_PARAMS_BLOCK
					(element ShipParameterNumber
						_title = 'IDS_SHIP_PARAM_DRUM_FIRE_SALVO_SHOT_DELAY'
						_value = "shotDelay"
						_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
						_zeroValueHidden = true
					)
					(element ShipParameterNumber
						_title = 'IDS_SHIP_PARAM_DRUM_FIRE_SALVO_COUNT'
						_value = "numShots"
						_zeroValueHidden = true
					)
				)
			)
		)
	)
)
