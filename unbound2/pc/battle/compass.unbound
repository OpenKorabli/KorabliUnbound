(def constant GUN_ROTATOR_RADIUS 80)
(def constant COMPASS_SIZE 200px)

(def constant SHIP_DOLL_AIR_DEFENSE "{
	R_MAX: 98.5,
	R_MIN: 63,
	R_DELTA: 35.5,  # R_MAX - R_MIN
	COLOR_ACTIVATING: C_ACTIVE,
	COLOR_DEACTIVATING: C_RELOAD,
	COLOR_COOLDOWN: C_RELOAD,
	COLOR_BLINK: SC.Ui_styles.SERVICE_COLORS.WHITE,
	COLOR_OFF : 0xFFE5E5E5,
	ALPHA: 0.2,
	COOLDOWN_ALPHA: 0.2,
	BLINK_ALPHA: 1,
	ALPHA_BORDER: 0.6,

	TEXT_COUNTDOWN_RADIUS: 42,
	TEXT_STRENGTH_RADIUS: 42
}")

(def constant GUN_DOLL_WIDTH 26px)
(def constant GUN_DOLL_HEIGHT 82px)
(def constant GUN_DOLL_ROWS 7)
(def constant GUN_DOLL_COLS 3)

(def css $ShipDollGunText ()
	(extends $FontFamilyDefault)
	(extends $FontColorBlack)
	(extends $TextMouseDisable)

	(fontSize = 10)
	(marginTextLeft = -4px)
	(marginTextRight = -3px)
	(marginTextTop = -7px)
	(marginTextBottom = -6px)
)

(def element CompassContainer ()
	(scope
		(var healthComponent:dhComponent = "getSingleEntity(CC.playerAvatar).health")
		(var isAlive:bool = "healthComponent.isAlive" (event "healthComponent.evIsAliveChanged"))

		(var customElementsVisibilityComponent:dhComponent = "getSingleComponent(CC.customElementsVisibility)")
		(var customisedElements:number = "customElementsVisibilityComponent.customisedElements" (event "customElementsVisibilityComponent.evChanged"))
		(var isDreadnoughtCustomization:bool = "(customisedElements & SC.Battle.CUSTOM_BATTLE_ELEMENTS.DREADNOUGHT) > 0")

		(var cameraComponent:dhComponent = "getSingleComponent(CC.camera)")
		(var observedAvatarId:number = "cameraComponent ? cameraComponent.observedPlayerId
														: INVALID_OBSERVED_AVATAR_ID" (event "cameraComponent.evObservedPlayerIdChanged"))

		(var playerAvatarComponent:dhComponent = "getSingleEntity(CC.playerAvatar).avatar")
		(var playerAvatarId:number = "playerAvatarComponent ? playerAvatarComponent.id : INVALID_PLAYER_AVATAR_ID")
		(var isSelfObserved:bool = "playerAvatarId == observedAvatarId")
	)

	(class $FullsizeAbsolute)
	(style (align = "bottom|left"))

	(block
		(style
			(position = "absolute")
			(bottom = 240px)
			(left = 20px)
		)

		(controller $Instance renderer='CompassContainerInstance'
			(bind enabled "(isAlive || isSelfObserved) && !isDreadnoughtCustomization")
			(args
				_isSelfObserved = "isSelfObserved"
			)
		)
	)

	(hblock
		(bind visible "isAlive")
		(style
			(position = "absolute")
			(align = "middle")
			(bottom = "S")
			(left = "S")
		)

		(element HotkeyIndicator
			_commandId 	= "Cmd.CMD_SHIP_PARAMS"
			_fxOnDown 	= true
		)

		(tf
			(class $TextDefaultBold14NM)
			(style
				(marginLeft = "S")
				(marginRight = "MS")
				(marginTop = "XXS")
				(alpha = "TC")
			)
			(text = "toUpper(tr('IDS_SHIP_PARAMS_HOTKEY_SHORT'))")
		)

		(block
			(controller $Instance renderer='AutopilotIndicator' $autoPerfTestGroup='header'
				(bind enabled "isAlive")
			)
		)
	)
)

(def element ShipDollDepthChargesMarker (_depthChargeEntity:dhEntity)
	(scope
		(var markerComponent:dhComponent = "getSingleComponent(CC.depthChargeMarker)")

		(var cameraComponent:dhComponent = "getSingleComponent(CC.camera)")
		(var altVision:bool = "cameraComponent.altVision" (event "cameraComponent.evAltVisionChanged"))

		(var state:number = "_depthChargeEntity.gun.state ?: 0" (event "_depthChargeEntity.gun.evStateChanged"))
		(var isReloading:bool = "state in SC.Weapons.GUN_STATE.RELOADING_STATES")
	)

	(bind visible "altVision")

	(style
		(position = "absolute")
		(left = "-COMPASS_SIZE / 2")
		(top = "-COMPASS_SIZE / 2")
		(bind backgroundImage "'swf:../battle_hud/doll_depth_charge_pattern/doll_depth_charge_pattern.swf:' + markerComponent.pattern")
	)

	(bind colorTransform "isReloading ? CT_RELOAD : CT_ACTIVE")
)

(def element CompassContainerInstance (_isSelfObserved:bool)
	(scope
		(var healthComponent:dhComponent = "getSingleEntity(CC.playerAvatar).health")
		(var isAlive:bool = "healthComponent.isAlive" (event "healthComponent.evIsAliveChanged"))

		(var aircarrierComponent:dhComponent = "getSingleComponent(CC.aircarrier)")
		(var controlledSquadronId:number = "aircarrierComponent != null ? aircarrierComponent.controlledSquadronId : DEFAULT_SQUADRON_ID" (event "aircarrierComponent.evControlledSquadronIdChanged"))

		(var airDefensiveFireAura:dhComponent = "getSingleComponent(CC.airDefensiveFireAura)")
		(var hasAA:bool = "airDefensiveFireAura.near || airDefensiveFireAura.middle || airDefensiveFireAura.far")

		(var isShipDollVisible:bool = "controlledSquadronId != DEFAULT_SQUADRON_ID || isAlive || _isSelfObserved")

		
		(var battleStateComponent:dhComponent = "getSingleComponent(CC.battleState)")
		(var battleState:number = "battleStateComponent.battleState" (event "battleStateComponent.evBattleStateChanged"))
		(var isBattleInProgress:bool = "battleState in SC.Common.CLIENT_BATTLE_STATE.IN_BATTLE")

		(var isRotatorEnabled:bool = "isAlive && isBattleInProgress")
	)
	(style
		(position = "absolute")
		(width = "COMPASS_SIZE")
		(height = "COMPASS_SIZE")
	)

	(element Compass)

	(block
		(class $FullsizeAbsolute)

		(controller $Instance renderer='ShipDollAirDefenseSectors'
			(bind enabled "hasAA && isAlive")
		)
	)

	(block
		(style
			(position = "absolute")
			(top = 100px)
			(left = 100px)
		)

		(controller $Instance renderer='ShipDoll'
			(bind enabled "isShipDollVisible")
		)
	)

	(block
		(class $FullsizeAbsolute)
		(element Frustum)
	)

	(block
		(bind visible "controlledSquadronId == DEFAULT_SQUADRON_ID")
		(style (position = "absolute"))

		(controller $Instance renderer='GunsRotator'
			(bind enabled "isRotatorEnabled")
		)
	)

	(block
		(bind visible "controlledSquadronId == DEFAULT_SQUADRON_ID")
		(style (position = "absolute"))

		(controller $Instance renderer='CrosshairRotatorLock'
			(bind enabled "isRotatorEnabled")
		)
	)
)

(def element Compass ()
	(scope
		(var compassComponent:dhComponent = "getSingleComponent(CC.compass)")
		(var compassRotation:number = "compassComponent.compassRotation" (event "compassComponent.evCompassRotationChanged"))

		(var battleInfoComponent:dhComponent = "getSingleComponent(CC.battleInfo)")
		(var gameModeId:number = "battleInfoComponent.gameModeId")
		(var compassBackground:str = "gameModeId == SC.Battle.GAME_MODE.PORTAL_2021 || gameModeId == SC.Battle.GAME_MODE.TEAM_BATTLE_ROYALE_2021 ? 'url:../events/halloween20/event_compass.png' : 'bitmap:compass_bg'")
	)
	(class $FullsizeAbsolute)
	(style
		(pivotX = 50%)
		(pivotY = 50%)
		(marginLeft = 50%)
		(marginTop = 50%)
		(alpha = 1.6)
		(backgroundImage = "compassBackground")
		(bind rotation "compassRotation")
	)
)

(def element Frustum ()
	(scope
		(var cameraComponent:dhComponent = "getSingleComponent(CC.camera)")
		(var frustumAngle:number = "cameraComponent.frustumAngle" (event "cameraComponent.evFrustumAngleChanged"))
		(var frustumAngleInGrad:number = "radToGrad(frustumAngle)")
	)

	(class $Fullsize)
	(style
		(alpha = 0.5)
		(backgroundImage = 'swf:../battle_hud/new_doll_svg/new_doll_svg.swf:frustum')
	)

	(block
		(class $FullsizeAbsolute)

		(style
			(left = 50%)
			(top = 50%)
			(bind rotation "270 - (frustumAngleInGrad / 2)")
		)

		(controller $Sector
			(radius = "COMPASS_SIZE / 2 - 1")
			(bind arc "frustumAngleInGrad")
		)
		(isMask = true)
	)
)

(def element ShipDoll ()
	(scope
		(var compassComponent:dhComponent = "getSingleComponent(CC.compass)")
		(var shipDollRotation:number = "compassComponent.shipDollRotation" (event "compassComponent.evShipDollRotationChanged"))

		(var weapons:dhCollection = "getCollection(CC.weapon)")
		(var weaponsLength:number = "weapons.length ?: 0")

		(var playerAvatarComponent:dhComponent = "getSingleEntity(CC.playerAvatar).avatar")
		(var depthCharges:dhCollection = "getCollectionByPath(CC.gun, 'byWeaponType.' + SC.Ships.SHIP_WEAPON_TYPES.DEPTH_CHARGES)")

		(var shipType:str = "playerAvatarComponent.ship.ref.ship.subtype ?: ''" (event "playerAvatarComponent.evShipRefChanged"))
		(var isAircarrier:bool = 	"shipType == ShipTypes.AIRCARRIER")
		(var isSubmarine:bool = 	"shipType == ShipTypes.SUBMARINE")

		
		(var aircarrierComponent:dhComponent = "getSingleComponent(CC.aircarrier)")
		(var activeSquadronIndex:number = "aircarrierComponent != null ? aircarrierComponent.activeSquadronIndex : DEFAULT_SQUADRON_OWNER_ID" (event "aircarrierComponent.evStateChanged"))
		(var controlledSquadronId:number = "aircarrierComponent != null ? aircarrierComponent.controlledSquadronId : DEFAULT_SQUADRON_ID" (event "aircarrierComponent.evControlledSquadronIdChanged"))

		(var ownSquadronEntity:dhEntity = "getPrimaryEntity(CC.ownSquadron, activeSquadronIndex)")
		(var subColName:str = "'bySquadron.' + (ownSquadronEntity ? ownSquadronEntity.squadron.id : -1)" (event "aircarrierComponent.evStateChanged"))
		(var ammoType:number = "ownSquadronEntity ? ownSquadronEntity.plane.ammoType : SC.Common.PLANE_AMMO_TYPES.NONE")
		(var isMissile:bool = "ammoType == SC.Common.PLANE_AMMO_TYPES.MISSILE")

		(var hpCollection:dhCollection = "getCollectionByPath(CC.aircraft, subColName)")
		(var hpCount:number = "hpCollection.length ?: 0")
		(var attackerSize:number = "ownSquadronEntity.ownSquadron.attackerSize ?: 0")
		(var numAttackers:number = "attackerSize ? ceil(hpCount/attackerSize) : 1")

		
		(var dollIcon:str = "	isMissile													? 'url:../battle_hud/missiles/compass_silhouette.png' :
								controlledSquadronId != DEFAULT_SQUADRON_ID && hpCount > 0	? subst('symbol:mc_compass_planes_doll_%d', [numAttackers]) :
								isAircarrier												? 'symbol:compass_aircraftcarrier_doll' :
								isSubmarine													? 'symbol:compass_submarine_doll'
																							: 'symbol:compass_default_doll'"
		)

		(var squadronCameraMode:str = "aircarrierComponent.squadronCameraMode" (event "aircarrierComponent.evSquadronCameraModeChanged"))
		(var lastLookSquadronCamera:bool = "squadronCameraMode == SquadronCameraModes.SQUADRON_DEAD || squadronCameraMode == SquadronCameraModes.LAST_SQUADRON_ATTACKED")
	)
	(bind visible "!lastLookSquadronCamera")

	(style
		(bind rotation "shipDollRotation")
		(bind width "isMissile ? 64px : 0px")
		(bind height "isMissile ? 107px : 0px")
		(bind pivotX "isMissile ? 50% : 0px")
		(bind pivotY "isMissile ? 50% : 0px")
		(bind visualOffsetX "isMissile ? -50% : 0px")
		(bind visualOffsetY "isMissile ? -50% : 0px")
		(bind backgroundImage "dollIcon")
	)

	(block
		(style (position = "absolute"))

		
		(controller $Repeat renderer='ShipDollGunsList'
			(bind enabled "controlledSquadronId == DEFAULT_SQUADRON_ID")
			(bind count "weaponsLength")
			(args
				_weaponEntity = "weapons[$index]"
			)
		)
	)

	(controller $Instance renderer='ShipDollDepthChargesMarker'
		(bind enabled "depthCharges.length > 0")
		(args
			_depthChargeEntity = "depthCharges.getEntityAtIndex(0)"
		)
	)
)

(def element ShipDollGunsList (_weaponEntity:dhEntity)
	(scope
		
		(var selfVehicleEntity:dhEntity = "getSingleEntity(CC.selfVehicle)")
		(var isSubmarine:bool = "selfVehicleEntity.hasComponent(CC.submarine)")

		(var weaponComponent:dhComponent = "_weaponEntity.weapon")
		(var weaponType:number = "weaponComponent ? weaponComponent.type : SC.Ships.SHIP_WEAPON_TYPES.NONE")
		(var gunGroupsCount:number = "weaponComponent.groupsCount")
		(var isGrouped:bool = "gunGroupsCount > 0 && isSubmarine")

		(var gunCollection:dhCollection = "getCollectionByPath(CC.gun,'byWeaponType.' + weaponType)")
		(var isEnabled:bool = "isIn(weaponType, SC.Ships.SHIP_WEAPON_TYPES.SHOW_SHIP_DOLL)")
	)

	(controller $Repeat renderer='GunsGroupShipDollItems'
		(bind enabled "selfVehicleEntity && weaponComponent && isGrouped")
		(bind count "gunGroupsCount")
		(args
			_weaponType = "weaponType"
		)
	)

	(controller $Repeat renderer='ShipDollGun'
		(bind enabled "selfVehicleEntity && weaponComponent && !isGrouped && isEnabled")
		(bind count "gunCollection.length")
		(args
			_weaponEntity = "_weaponEntity"
			_gunEntity = "gunCollection.getEntityAtIndex($index)"
		)
	)
)

(def element GunsGroupShipDollItems (_weaponType:number)
	(scope
		(var weaponEntity:dhEntity = "getPrimaryEntity(CC.weapon, _weaponType)")
		(var gunGroupComponent:dhComponent = "getPrimaryCompositeEntity(CC.gunsGroup, _weaponType, $index).gunsGroup")
		(var mostReadyGunEntity:dhEntity = "getEntity(gunGroupComponent.mostReadyGunId)" (event "gunGroupComponent.evMostReadyGunIdChanged"))
	)
	(element ShipDollGun
		_weaponEntity = "weaponEntity"
		_gunEntity = "mostReadyGunEntity"
	)
)

(def element ShipDollGun (_weaponEntity:dhEntity, _gunEntity:dhEntity)
	(scope
		
		(var compassComponent:dhComponent = "getSingleComponent(CC.compass)")

		(var gunComponent:dhComponent = 		"_gunEntity.gun")
		(var gunTargetComponent:dhComponent = 	"_gunEntity.gunTarget")

		
		(var weaponControllerComponent:dhComponent = "getSingleComponent(CC.weaponController)")
		(var selectedWeapon:number = "weaponControllerComponent.selectedWeapon" (event "weaponControllerComponent.evSelectedWeaponChanged"))

		(var weaponComponent:dhComponent = "_weaponEntity.weapon")
		(var weaponType:number = "weaponComponent.type")

		(var weaponIsSelected:bool = "weaponControllerComponent != null && selectedWeapon == weaponType")

		
		(var battleStateComponent:dhComponent = "getSingleComponent(CC.battleState)")
		(var battleState:number = "battleStateComponent.battleState" (event "battleStateComponent.evBattleStateChanged"))
		(var isBattleInProgress:bool = "battleState in SC.Common.CLIENT_BATTLE_STATE.IN_BATTLE")

		
		(var gunX:number = "GUN_DOLL_WIDTH / (GUN_DOLL_COLS - 1) * (GUN_DOLL_COLS - 1 - gunComponent.y) - 13")
		(var gunY:number = "GUN_DOLL_HEIGHT / (GUN_DOLL_ROWS - 1) * gunComponent.x - 34")

		(var shipDollRotation:number = "compassComponent.shipDollRotation ?: 0" (event "compassComponent.evShipDollRotationChanged"))

		
		(var azimuth:number = 	"gunTargetComponent.azimuth" 	(event "gunTargetComponent.evAzimuthChanged"))
		(var offset:number = 	"gunTargetComponent.offset" 	(event "gunTargetComponent.evOffsetChanged"))

		
		(var angle:number = "-gradToRad(shipDollRotation) - azimuth + offset")
		(var targetX:number = "(cos(angle) * GUN_ROTATOR_RADIUS + gunY)")
		(var targetY:number = "(sin(angle) * GUN_ROTATOR_RADIUS - gunX)")
		(var gunRotation:number = "radToGrad(atan2(targetY, targetX))")


		
		(var state:number = "gunComponent.state ?: 0" (event "gunComponent.evStateChanged"))

		(var isReloading:bool = "state in SC.Weapons.GUN_STATE.RELOADING_STATES")
		(var isCrit:bool = 		"state in SC.Weapons.GUN_STATE.CRITICAL_STATES")

		(var cantAim:bool = 	"gunTargetComponent.invalid" 	(event "gunTargetComponent.evInvalidChanged"))
		(var isAiming:bool = 	"!gunTargetComponent.rotated" 	(event "gunTargetComponent.evRotatedChanged"))
	)

	(style
		(position = "absolute")
		(width = 44px)
		(height = 44px)
		(bind rotation "gunRotation")
		(bind left "gunX")
		(bind top "gunY")
		(bind alpha "(cantAim || !weaponIsSelected || !isBattleInProgress) && !isCrit ? 0.5 : 1")
	)
	(element ShipDollGunItem
		_weaponType = 		"weaponType"
		_gunEntity = 		"_gunEntity"
		_isCrit = 			"isCrit"
		_isReloading = 		"isReloading"
		_cantAim = 			"cantAim"
		_isAiming = 		"isAiming"
		_textRotation = 	"-gunRotation - shipDollRotation"
		_weaponIsSelected = "weaponIsSelected"
	)
)

(def element ShipDollGunItem (	_weaponType:number,
								_gunEntity:dhEntity,
								_isCrit:bool,
								_isReloading:bool,
								_cantAim:bool,
								_isAiming:bool,
								_textRotation:number,
								_weaponIsSelected:bool)
	(scope
		(var groupModifierComponent:dhComponent = 	"_gunEntity.groupModifier")
		(var gunComponent:dhComponent = 			"_gunEntity.gun")

		(var positionId:number = "	_gunEntity == null 				? 0 :
									groupModifierComponent == null 	? gunComponent.position
								 									: groupModifierComponent.groupID + 1")

		
		(var battleStateComponent:dhComponent = "getSingleComponent(CC.battleState)")
		(var battleState:number = "battleStateComponent.battleState" (event "battleStateComponent.evBattleStateChanged"))
		(var isBattleInProgress:bool = "battleState in SC.Common.CLIENT_BATTLE_STATE.IN_BATTLE")


		(var gunIconName:str = "(	_weaponType == SC.Ships.SHIP_WEAPON_TYPES.ARTILLERY				? 'main_gun' :
									_weaponType == SC.Ships.SHIP_WEAPON_TYPES.SECONDARY_ARTILLERY	? 'sec_artillery' :
									_weaponType == SC.Ships.SHIP_WEAPON_TYPES.CHARGE_LASER			? 'main_gun'
																									: 'torpedo_base')")

		(var gunIconPath:str = "'swf:../battle_hud/doll_guns_svg/doll_guns_svg.swf:' + gunIconName")

		(var colorDiff:dict = "	!_weaponIsSelected && !_isCrit									? CT_GUN_STATES['disabled'] :
								_isCrit															? CT_GUN_STATES['crit'] :
								_isReloading || _cantAim || _isAiming || !isBattleInProgress	? CT_GUN_STATES['preparing']
																								: CT_GUN_STATES['ready']")
	)

	(class $FullsizeAbsolute)

	(block
		(class $FullsizeAbsolute)
		(style
			(width = 44px)
			(height = 44px)
			(pivotX = 50%)
			(pivotY = 50%)
			(bind backgroundImage "gunIconPath")
		)
		(bind colorTransform "colorDiff")
	)

	(block
		(class $FullsizeAbsolute)
		(style (bind rotation "round(_textRotation)"))

		(block
			(class $FullsizeAbsolute)
			(style
				(top = -50%)
				(left = -50%)
				(align = "center|middle")
			)

			(tf
				(bind class "_isCrit ? '$FontColorDefault' : '$None'")
				(class $ShipDollGunText)
				(bind text "positionId")
			)
		)
	)
)

(def element GunsRotator ()
	(scope
		(var weaponCollection:dhCollection = "getCollection(CC.weapon)")
	)

	(style
		(position = "absolute")
		(top = 100px)
		(left = 100px)
	)

	(controller $Repeat renderer='GunsRotatorList'
		(bind count "weaponCollection.length")
		(args
			_weaponEntity = "weaponCollection.getEntityAtIndex($index)"
		)
	)
)


(def element CrosshairRotatorLock ()
	(scope
		(var crosshairEntity:dhEntity = "getSingleEntity(CC.crosshair)")
		(var aimLockComponent:dhComponent = "crosshairEntity.aimLock")
		(var isAlive:bool = "crosshairEntity.health.isAlive" (event "crosshairEntity.health.evKilled"))
		(var lockRelativeShipYaw:number = "aimLockComponent ? radToGrad(aimLockComponent.lockRelativeShipYaw) : 0" (event "aimLockComponent.evLockRelativeShipYawChanged"))
		(var angleLock:bool = "aimLockComponent.angleLock" (event "aimLockComponent.evAngleLockChanged"))
		(var sectorLock:bool = "aimLockComponent.sectorLock" (event "aimLockComponent.evSectorLockChanged"))
		(var observeLock:bool = "aimLockComponent.observeLock" (event "aimLockComponent.evObserveLockChanged"))

		(var compassComponent:dhComponent = "getSingleComponent(CC.compass)")
		(var compassRotation:number = "compassComponent.compassRotation" (event "compassComponent.evCompassRotationChanged"))

		(var isVisible:bool = "isAlive && (angleLock || sectorLock || observeLock)")
	)
	(style
		(position = "absolute")
		(top = 100px)
		(left = 100px)
		(bind rotation "lockRelativeShipYaw + compassRotation" (bind enabled "isVisible && lockRelativeShipYaw != 0"))
	)

	(block
		(style
			(position = "absolute")
			(bottom = "GUN_ROTATOR_RADIUS")
			(width = 15px)
			(height = 15px)
			(pivotX = 50%)
			(pivotY = 50%)
			(backgroundImage = 'url:../battle_hud/weapons_panel/guns/crosshair_rotator_lock.png')
			(alpha = "isVisible ? 1 : 0")
			(bind rotation "-(lockRelativeShipYaw + compassRotation)" (bind enabled "isVisible && lockRelativeShipYaw != 0"))
		)
		(controller $Animation
			(bindcall play
				duration = 0.2
				from = { alpha: 0, scaleX: 1.5, scaleY: 1.5 }
				to = { alpha: 1, scaleX: 1, scaleY: 1 }
				action = "kill"
				(bind enabled "isVisible")
			)
			(bindcall play
				duration = 0.2
				to = { alpha: 0, scaleX: 1.5, scaleY:1.5 }
				action = "kill"
				(bind enabled "!isVisible")
			)
		)
	)
)

(def element GunsRotatorList (_weaponEntity:dhEntity)
	(scope
		(var weaponComponent:dhComponent = "_weaponEntity.weapon")

		(var weaponType:number = 		"weaponComponent.type")
		(var gunGroupsCount:number = 	"weaponComponent.groupsCount")

		(var isGrouped:bool = "gunGroupsCount > 0")

		(var gunCollection:dhCollection = "getCollectionByPath(CC.gun,'byWeaponType.' + weaponType)")
		(var gunCollectionLength:number = "gunCollection.length")

		(var weaponControllerComponent:dhComponent = "getSingleComponent(CC.weaponController)")
		(var selectedWeapon:number = "weaponControllerComponent.selectedWeapon" (event "weaponControllerComponent.evSelectedWeaponChanged"))
		(var weaponIsSelected:bool = "weaponControllerComponent != null && selectedWeapon == weaponType")

		(var isEnabled:bool = "weaponIsSelected && isIn(weaponType, SC.Ships.SHIP_WEAPON_TYPES.SHOW_SHIP_DOLL)")
	)
	(bind visible "isEnabled")
	(style (position = "absolute"))

	(controller $Repeat renderer='GunsGroupRotatorItems'
		(bind enabled "isGrouped")
		(bind count "gunGroupsCount")
		(args
			_weaponType = "weaponType"
		)
	)

	
	(block
		(controller $Repeat renderer='GunsRotatorItem'
			(bind enabled "!isGrouped")
			(bind count "gunCollectionLength")
			(args
				_gunEntity = "gunCollection.getEntityAtIndex($index)"
				_isAimPoint = false
			)
		)
	)

	
	(controller $Repeat renderer='GunsRotatorItem'
		(bind enabled "!isGrouped")
		(bind count "gunCollectionLength")
		(args
			_gunEntity = "gunCollection.getEntityAtIndex($index)"
			_isAimPoint = true
		)
	)
)

(def element GunsGroupRotatorItems (_weaponType:number)
	(scope
		(var gunGroupComponent:dhComponent = "getPrimaryCompositeEntity(CC.gunsGroup, _weaponType, $index).gunsGroup")
		(var mostReadyGunEntity:dhEntity = "getEntity(gunGroupComponent.mostReadyGunId)" (event "gunGroupComponent.evMostReadyGunIdChanged"))
	)
	
	(element GunsRotatorItem
		_gunEntity = "mostReadyGunEntity"
		_isAimPoint = false
	)

	
	(element GunsRotatorItem
		_gunEntity = "mostReadyGunEntity"
		_isAimPoint = true
	)
)

(def element GunsRotatorItem (_gunEntity:dhEntity, _isAimPoint:bool)
	(scope
		(var gunTargetComponent:dhComponent = "_gunEntity.gunTarget")

		(var offset:number = 	"gunTargetComponent.offset ?: 0" 	(event "gunTargetComponent.evOffsetChanged"))
		(var azimuth:number = 	"gunTargetComponent.azimuth ?: 0" 	(event "gunTargetComponent.evAzimuthChanged"))
	)
	(style (bind rotation "360 - radToGrad(azimuth) + radToGrad(offset)"))

	(element GunsRotatorItemRenderer
		_gunEntity = "_gunEntity"
		_isAimPoint = "_isAimPoint"
	)
)

(def element GunsRotatorItemRenderer (_gunEntity:dhEntity, _isAimPoint:bool)
	(scope
		(var gunComponent:dhComponent = 		"_gunEntity.gun")
		(var gunTargetComponent:dhComponent = 	"_gunEntity.gunTarget")

		(var state:number = "gunComponent.state ?: 0" (event "gunComponent.evStateChanged"))

		(var isCrit:bool = 		"state in SC.Weapons.GUN_STATE.CRITICAL_STATES")
		(var isReloading:bool = "state in SC.Weapons.GUN_STATE.RELOADING_STATES")

		(var cantAim:bool = 	"gunTargetComponent.invalid" 	(event "gunTargetComponent.evInvalidChanged"))
		(var isAiming:bool = 	"!gunTargetComponent.rotated" 	(event "gunTargetComponent.evRotatedChanged"))

		(var isVisible:bool = "isAiming || isCrit")
		(var aimIndicatorIconName:str = "	isCrit								? 'crit' :
											isReloading || cantAim || isAiming	? 'preparing'
																				: 'ready'"
		)
		(var aimIndicatorIconPath:str = "'swf:../battle_hud/doll_aim_indicator_svg/doll_aim_indicator_svg.swf:' + aimIndicatorIconName")

		(var cameraComponent:dhComponent = "getSingleComponent(CC.camera)")
		(var altVision:bool = "cameraComponent.altVision" (event "cameraComponent.evAltVisionChanged"))
		(var depthChargeMarkerVisible:bool = "getSingleComponent(CC.depthChargeMarker) != null && altVision")
	)

	(bind visible "(isVisible && !_isAimPoint) || (!isVisible && _isAimPoint)")
	(style
		(position = "absolute")
		(bottom = "GUN_ROTATOR_RADIUS")
		(visualOffsetY = -3px) 
		(visualOffsetX = -3px) 
		(bind alpha "cantAim || depthChargeMarkerVisible ? 0.5 : 1")
		(bind backgroundImage "aimIndicatorIconPath")
	)
)

(def element ShipDollAirDefenseSectors ()
	(scope
		(var sectorsCollection:dhCollection = "getCollection(CC.airDefenseSector)")
		(var compassComponent:dhComponent = "getSingleComponent(CC.compass)")
		(var shipDollRotation:number = "compassComponent.shipDollRotation" (event "compassComponent.evShipDollRotationChanged"))

		(var aircarrierComponent:dhComponent = "getSingleComponent(CC.aircarrier)")
		(var squadronCameraMode:str = "aircarrierComponent.squadronCameraMode" (event "aircarrierComponent.evSquadronCameraModeChanged"))
		(var controlledSquadronId:number = "aircarrierComponent.controlledSquadronId ?: DEFAULT_SQUADRON_ID" (event "aircarrierComponent.evControlledSquadronIdChanged"))
		(var lastLookSquadronCamera:bool = "squadronCameraMode == SquadronCameraModes.SQUADRON_DEAD || squadronCameraMode == SquadronCameraModes.LAST_SQUADRON_ATTACKED")
	)

	(bind visible "controlledSquadronId == DEFAULT_SQUADRON_ID && !lastLookSquadronCamera")

	(style
		(position = "absolute")
		(top = 50%)
		(left = 50%)
		(bind rotation "shipDollRotation - 90")
	)

	
	(controller $Repeat renderer='AirDefenseSectorRenderer'
		(bind items "sectorsCollection")
		(args
			_sectorEntity = "$item"
			_textRotation = "-shipDollRotation + 90"
		)
	)

	
	(controller $Repeat renderer='AirDefenseSectorBorderRenderer'
		(bind items "sectorsCollection")
		(args
			_sectorEntity = "$item"
		)
	)
)

(def element AirDefenseSectorBorderRenderer (_sectorEntity:dhEntity)
	(scope
		(var airDefenseSectorComponent:dhComponent = "_sectorEntity.airDefenseSector")
		(var arc:number = "airDefenseSectorComponent.arc")
		(var angle:number = "airDefenseSectorComponent.angle")

		(var sectorState:number = "airDefenseSectorComponent.state" (event "airDefenseSectorComponent.evStateChanged"))
		(var isDefaultState:bool = "sectorState == SC.Battle.AIR_DEFENSE_SECTOR_STATE.DEFAULT")
		(var isActivatingState:bool = "sectorState == SC.Battle.AIR_DEFENSE_SECTOR_STATE.ACTIVATING")
		(var isDeactivatingState:bool = "sectorState == SC.Battle.AIR_DEFENSE_SECTOR_STATE.DEACTIVATING")
		(var isCooldownState:bool = "sectorState == SC.Battle.AIR_DEFENSE_SECTOR_STATE.COOLDOWN")

		(var atbaComponent:dhComponent = "getSingleComponent(CC.shipATBA)")
		(var isAtbaSwitchedOn:bool = "atbaComponent.enabled" (event "atbaComponent.evEnabledChanged"))

		(var sectorColor:number = "isAtbaSwitchedOn ? 	isActivatingState 	? SHIP_DOLL_AIR_DEFENSE.COLOR_ACTIVATING :
														isCooldownState 	? SHIP_DOLL_AIR_DEFENSE.COLOR_COOLDOWN :
														isDefaultState 		? SHIP_DOLL_AIR_DEFENSE.COLOR_COOLDOWN
																			: SHIP_DOLL_AIR_DEFENSE.COLOR_DEACTIVATING
													: SHIP_DOLL_AIR_DEFENSE.COLOR_OFF"
		)

		(var borderColor:number = "isAtbaSwitchedOn ? 	isActivatingState 	? SHIP_DOLL_AIR_DEFENSE.COLOR_ACTIVATING :
														isCooldownState 	? SHIP_DOLL_AIR_DEFENSE.COLOR_COOLDOWN :
														isDefaultState 		? SHIP_DOLL_AIR_DEFENSE.COLOR_COOLDOWN
																			: SHIP_DOLL_AIR_DEFENSE.COLOR_ACTIVATING
													: SHIP_DOLL_AIR_DEFENSE.COLOR_OFF"
		)

		(var sectorRadius:number = "SHIP_DOLL_AIR_DEFENSE.R_MIN")

		(var animComponent:dhComponent = "_sectorEntity.airDefenseSectorAnimation")
		(controller $Animation
			
			(bindcall play
				duration = "_sectorEntity.countDown.duration"
				from = "{sectorRadius: isActivatingState || isCooldownState ? SHIP_DOLL_AIR_DEFENSE.R_MIN : SHIP_DOLL_AIR_DEFENSE.R_MAX - SHIP_DOLL_AIR_DEFENSE.R_DELTA * animComponent.percentFrom}"
				to = "{sectorRadius: isActivatingState || isCooldownState ? SHIP_DOLL_AIR_DEFENSE.R_MIN : SHIP_DOLL_AIR_DEFENSE.R_MAX - SHIP_DOLL_AIR_DEFENSE.R_DELTA * animComponent.percentTo}"
				watch = false
				(bind enabled "isCooldownState")
				(event "animComponent.evStartAnimation")
			)
		)
	)

	(bind visible "!isCooldownState")

	(alpha = "isDefaultState ? 0 : SHIP_DOLL_AIR_DEFENSE.ALPHA_BORDER")

	
	(controller $Animation
		(bindcall play
			duration = 0.2
			from = {alpha: 0}
			to = "{alpha: isDefaultState ? 0 : SHIP_DOLL_AIR_DEFENSE.ALPHA_BORDER}"
			action = "killAll"
			(bind trigger "isDefaultState")
		)
	)

	(block
		(style (bind rotation "angle - 90"))

		(block
			(style
				(position = "absolute")
				(bottom = "SHIP_DOLL_AIR_DEFENSE.R_MIN")
				(left = -1px)
				(width = 2px)
				(height = "SHIP_DOLL_AIR_DEFENSE.R_DELTA")

				(bind backgroundColor "borderColor")
			)
		)
	)

	
	(block
		(bind visible "!isDeactivatingState")

		(class $FullsizeAbsolute)

		(controller $Sector
			(bind offset "angle")
			(bind color "sectorColor")
			(bind arc "arc")
			(bind radius "sectorRadius + 2")
			(bind innerRadius "sectorRadius")
		)
	)
)


(def element AirDefenseSectorRenderer (_sectorEntity:dhEntity, _textRotation:number=0)
	(scope
		(struct isAliveStruct = IS_ALIVE())

		(var airDefenseSectorComponent:dhComponent = "_sectorEntity.airDefenseSector")
		(var arc:number = "airDefenseSectorComponent.arc")
		(var angle:number = "airDefenseSectorComponent.angle")
		(var wasPrior:bool = "airDefenseSectorComponent.wasPrior" (event "airDefenseSectorComponent.evWasPriorChanged"))

		(var sectorState:number = "airDefenseSectorComponent.state" (event "airDefenseSectorComponent.evStateChanged"))
		(var isCooldownState:bool = "sectorState == SC.Battle.AIR_DEFENSE_SECTOR_STATE.COOLDOWN")
		(var isActivatingState:bool = "sectorState == SC.Battle.AIR_DEFENSE_SECTOR_STATE.ACTIVATING")
		(var isDeactivatingState:bool = "sectorState == SC.Battle.AIR_DEFENSE_SECTOR_STATE.DEACTIVATING")
		(var isDefaultState:bool = "sectorState == SC.Battle.AIR_DEFENSE_SECTOR_STATE.DEFAULT")

		(var atbaComponent:dhComponent = "getSingleComponent(CC.shipATBA)")
		(var isAtbaSwitchedOn:bool = "atbaComponent.enabled" (event "atbaComponent.evEnabledChanged"))

		(var sectorColor:number = "isAtbaSwitchedOn ? 	isActivatingState 	? SHIP_DOLL_AIR_DEFENSE.COLOR_ACTIVATING :
														isCooldownState 	? SHIP_DOLL_AIR_DEFENSE.COLOR_COOLDOWN
																			: SHIP_DOLL_AIR_DEFENSE.COLOR_DEACTIVATING
													: SHIP_DOLL_AIR_DEFENSE.COLOR_OFF"
		)
		(var sectorRadius:number = "isCooldownState ? SHIP_DOLL_AIR_DEFENSE.R_MAX : 1" watch=false)

		(var textRotationLocal:number = "round(angle + arc / 2 + 90)")

		(var animComponent:dhComponent = "_sectorEntity.airDefenseSectorAnimation")
		(var timerComponent:dhComponent = "getSingleComponent(CC.timer)")
		(var countDownComponent:dhComponent = "_sectorEntity.countDown")

		(var timeLeft:number = "isCooldownState ? countDownComponent 	? countDownComponent.endTime - timerComponent.currentTime
																		: 0
												: animComponent.allPhasesEndTime - timerComponent.currentTime"
												(event "timerComponent.evFrequent")
		)
		(var timeLeftDigits:number = "timeLeft < 10 ? 1 : 0")

		(var strength:number = 1)
		(var strengthPercent:number = "isCooldownState || isDefaultState ? 100 : round(strength * 100)")

		(var cameraComponent:dhComponent = "getSingleComponent(CC.camera)")
		(var isAltVision:bool = "cameraComponent.altVision" (event "cameraComponent.evAltVisionChanged"))

		(controller $Animation
			
			(bindcall play
				duration = "countDownComponent.remain"
				from = "{
					sectorRadius: SHIP_DOLL_AIR_DEFENSE.R_MIN + SHIP_DOLL_AIR_DEFENSE.R_DELTA * (animComponent.percentFrom + ((animComponent.percentTo - animComponent.percentFrom) * (countDownComponent.duration - countDownComponent.remain) / countDownComponent.duration)),
					strength: animComponent.valueFrom + ((animComponent.valueTo - animComponent.valueFrom) * (countDownComponent.duration - countDownComponent.remain) / countDownComponent.duration)
				}"
				to = "{
					sectorRadius: SHIP_DOLL_AIR_DEFENSE.R_MIN + SHIP_DOLL_AIR_DEFENSE.R_DELTA * animComponent.percentTo,
					strength: animComponent.valueTo
				}"
				watch = false
				init = "animComponent.isAnimationStarted"
				(event "animComponent.evStartAnimation")
			)
		)
	)

	(class $FullsizeAbsolute)

	(block
		(alpha = "isDefaultState ? 0 : 1")

		
		(controller $Animation
			(bindcall play
				duration = 0.6
				from = {alpha: 0}
				to = {alpha: 1}
				(bind enabled "isCooldownState")
			)
			(bindcall play
				duration = 0.3
				from = {alpha: 0}
				to = {alpha: 1}
				action = "kill"
				(bind enabled "isActivatingState || isDeactivatingState")
			)
			(bindcall play
				duration = 0.6
				to = {alpha: 0}
				action = "kill"
				(bind enabled "isDefaultState")
			)
		)

		(block
			(bind visible "isActivatingState || isCooldownState || isDefaultState")

			(class $FullsizeAbsolute)
			(bind alpha "isCooldownState ? SHIP_DOLL_AIR_DEFENSE.COOLDOWN_ALPHA : SHIP_DOLL_AIR_DEFENSE.ALPHA")

			
			(controller $Sector
				(innerRadius = "SHIP_DOLL_AIR_DEFENSE.R_MIN")
				(bind offset "angle")
				(bind color "sectorColor")
				(bind arc "arc")
				(bind radius "sectorRadius")
			)
		)
	)

	
	(block
		(bind visible "!isDeactivatingState")

		(class $FullsizeAbsolute)
		(alpha = 0)

		
		(controller $Animation
			(bindcall play
				duration = 0.6
				from = "{alpha: 0.6}"
				to = "{alpha: 0}"
				(event "animComponent.evStartBlink")
			)
		)

		(controller $Sector
			(color = "SHIP_DOLL_AIR_DEFENSE.COLOR_BLINK")
			(radius = "SHIP_DOLL_AIR_DEFENSE.R_MAX")
			(innerRadius = "SHIP_DOLL_AIR_DEFENSE.R_MIN")
			(bind offset "angle")
			(bind arc "arc")
		)
	)

	(block
		(class $FullsizeAbsolute)

		(style (bind rotation "textRotationLocal"))

		
		(block
			(bind visible "!isAltVision && (isActivatingState || (isCooldownState && wasPrior))")

			(class $FullsizeAbsolute)
			(style
				(align = "center|middle")
				(bottom = "SHIP_DOLL_AIR_DEFENSE.TEXT_COUNTDOWN_RADIUS")
				(bind rotation "_textRotation - textRotationLocal")
			)
			(alpha = "isDefaultState ? 0 : 1")

			
			(controller $Animation
				(bindcall play
					duration = 0.3
					from = {alpha: 0}
					to = {alpha: 1}
					action = "kill"
					(bind enabled "isCooldownState")
				)
				(bindcall play
					duration = 0.3
					from = {alpha: 0}
					to = {alpha: 1}
					action = "kill"
					(bind enabled "isActivatingState || isDeactivatingState")
				)
				(bindcall play
					duration = 0.3
					to = {alpha: 0}
					action = "kill"
					(bind enabled "isDefaultState")
				)
			)

			(tf
				(class $TextDefaultBoldNM)
				(style
					(bind textColor "isAtbaSwitchedOn 	? isCooldownState 	? C_WARNING
																			: C_ACTIVE
														: C_NEUTRAL"
					)
				)
				(bind text "countdownFormat(timeLeft, timeLeftDigits, false)")
			)
		)

		
		(block
			(bind visible "isAltVision && isAliveStruct.isAlive")

			(class $FullsizeAbsolute)
			(style
				(align = "center|middle")
				(bottom = "SHIP_DOLL_AIR_DEFENSE.TEXT_STRENGTH_RADIUS")
				(bind rotation "_textRotation - textRotationLocal")
			)

			(tf
				(class $TextDefaultBoldNM)
				(style (textColor = "C_NEUTRAL"))
				(bind text "subst('%d%',[strengthPercent])")
			)
		)
	)
)
