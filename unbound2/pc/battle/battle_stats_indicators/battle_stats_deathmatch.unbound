(def constant CT_DEATHMACTH_DANGEROUS_TARGET "{redOffset: -4, greenOffset: -158, blueOffset: -175,  alphaMultiplier: 1.45}")

(def element DeathmatchStatsContainer (_battleState:number)
	(scope
		(event evShowFogForDangerousTarget)
		(event evStopFogForDangerousTarget)

		(var selfAvatarEntity:dhEntity = "getSingleEntity(CC.playerAvatar)")
		(var deathmatchPlayerComponent:dhComponent = "selfAvatarEntity.deathmatchPlayer")
		(var selfPlace:number = "deathmatchPlayerComponent.place" (event "deathmatchPlayerComponent.evPlaceChanged"))
		(var selfScore:number = "deathmatchPlayerComponent.score" (event "deathmatchPlayerComponent.evScoreChanged"))

		(var killstreakScenarioTagEntity:dhEntity = "getPrimaryCompositeEntity(CC.scenarioTag, selfAvatarEntity.id, SC.Battle.SCENARIO_TAG_VALUE.X2)")
		(var isKillStreak:bool = "killstreakScenarioTagEntity != null")
	)

	(dispatch evShowFogForDangerousTarget (bind enabled "isKillStreak") (bind trigger "killstreakScenarioTagEntity"))
	(dispatch evShowFogForDangerousTarget on='addedToStage' (bind enabled "isKillStreak"))

	(dispatch evStopFogForDangerousTarget (bind enabled "!isKillStreak") (bind trigger "killstreakScenarioTagEntity"))
	(dispatch evStopFogForDangerousTarget on='addedToStage' (bind enabled "!isKillStreak"))

	(style
		(flow = "horizontal")
		(align = "bottom")
	)

	(block
		(style
			(position = "absolute")
			(height = 300px)
			(width = 500px)
			(marginTop = -125px)
			(marginLeft = -86px)
			(backgroundSize = "fill")
			(backgroundImage = 'url:../animations/spine/deathmatch/dangerous_target.skel')
			(alpha = 0)
		)
		(controller $Spine
			(bindcall play sequence="{name:'animation'}" (event "evShowFogForDangerousTarget"))
			(bindcall stop (event "evStopFogForDangerousTarget"))
		)
		(colorTransform = "CT_DEATHMACTH_DANGEROUS_TARGET")

		(controller $Animation
			(bindcall play
				to = "{ alpha: isKillStreak ? 1 : 0 }"
				duration = 0.2
				delay = "isKillStreak ? 0.2 : 0"
				(event "evShowFogForDangerousTarget")
				(event "evStopFogForDangerousTarget")
			)
		)
	)

	(block
		(class $FullsizeAbsolute)
		(style (backgroundImage = 'url:../battle_hud/battle_stats/deathmatch/battle_stats_background.png'))
	)


	(element DeathmatchStatsPlace
		_place = "selfPlace"
	)

	(element DeathmatchStatsScore
		_score = "selfScore"
	)

	(element DeathmatchStatsBattleTimer
		_isBattleStarted = "_battleState == SC.Common.CLIENT_BATTLE_STATE.STARTED"
	)
)

(def element DeathmatchStatsPlace (_place:number)
	(style
		(flow = "horizontal")
		(align = "center|middle")
		(width = 82px)
		(height = 44px)
	)

	(tf
		(class $TextDefaultBold20NM)
		(style (marginLeft = "XS"))

		(bind text "subst('IDS_DEATHMATCH_SCORE_IN_STATS', [], { _position: _place })")
	)
)

(def element DeathmatchStatsScore (_score:number)
	(style
		(align = "middle|center")
		(width = 108px)
		(height = 61px)
	)

	(tf
		(class $TextDefaultBoldNM)
		(style (marginBottom = "SXS"))
		(text = 'IDS_BATTLE_STATS_YOUR_SCORE')
	)

	(tf
		(class $TextDefaultBold26NM)
		(style (marginLeft = "XS"))
		(bind text "_score")
	)
)

(def element DeathmatchStatsBattleTimer (_isBattleStarted:bool)
	(scope
		(var timerEntity:dhEntity = "getSingleEntity(CC.battleTimer)")

		(var battleTimerComponent:dhComponent = "timerEntity.battleTimer")
		(var battleTime:number = "battleTimerComponent.battleTime ?: 0" (event "battleTimerComponent.evBattleTimeChanged"))

		(var battleInfoComponent:dhComponent = "timerEntity.battleInfo")
		(var battleTimeLeft:number = "battleInfoComponent.duration * 60 - battleTime" watch=false)
		(bind battleTimeLeft "battleInfoComponent.duration * 60 - battleTime" (bind enabled "_isBattleStarted"))
	)

	(style
		(align = "middle|center")
		(width = 82px)
		(height = 44px)
	)

	(tf
		(class $TextDefaultBold20NM)
		(style
			(marginTop = 1px)
			(bind textColor "battleTimeLeft < MIN_TIME_LEFT ? C_WARNING
															: SC.Ui_styles.SERVICE_COLORS.WHITE"
			)
		)

		(bind text "countdownFormat(battleTimeLeft, 0, true)")
	)
)
