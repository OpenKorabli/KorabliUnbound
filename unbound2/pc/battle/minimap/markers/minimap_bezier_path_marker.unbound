(def element MapPathMarker (_markerEntity:dhEntity, _scaleRatio:number)
	(scope
		(var minimapComponent:dhComponent = "getSingleComponent(CC.minimap)")
		(var angleToRotate:number = "minimapComponent.rotationAngleDeg ?: 0" (event "minimapComponent.evRotationAngleDegChanged"))

		(var minimapBezierPathComponent:dhComponent = "_markerEntity.minimapBezierPath")

		(var minimapPath:array = "minimapBezierPathComponent.path" (event "minimapBezierPathComponent.evPathChanged"))

		(var missionIndex:number = 		"_markerEntity.scenarioMissionParticipant.index")
		(var relation:number = 			"_markerEntity.relation.value" 	(event "_markerEntity.relation.evChanged"))
		(var missionProgress:number = 	"_markerEntity.progress.value" 	(event "_markerEntity.progress.evChanged"))

		(var posX:number = "_scaleRatio * minimapPath[0].x")
		(var posY:number = "_scaleRatio * minimapPath[0].y")

		(var isOvered:bool = false)
		(bind isOvered "!isOvered" init=false watch=false (event "minimapBezierPathComponent.evBlink"))

		(var allyNumberPointsCollection:dhCollection = 	"getCollectionByPath(CC.minimapBezierPath, 'byTeam.' + SC.Battle.PLAYER_RELATION.ALLY)")
		(var enemyNumberPointsCollection:dhCollection = "getCollectionByPath(CC.minimapBezierPath, 'byTeam.' + SC.Battle.PLAYER_RELATION.ENEMY)")

		(var isNumberPointVisible:bool = "allyNumberPointsCollection.length > 1 || enemyNumberPointsCollection.length > 1")

		(var customElementsVisibilityComponent:dhComponent = "getSingleComponent(CC.customElementsVisibility)")
		(var customisedElements:number = "customElementsVisibilityComponent.customisedElements" (event "customElementsVisibilityComponent.evChanged"))
		(var isSpaceAprilCustomization:bool = "(customisedElements & SC.Battle.CUSTOM_BATTLE_ELEMENTS.SPACE_APRIL) > 0")
	)

	(block
		(style
			(position = "absolute")
			(height = 1px)
			(width = 1px)
			(backgroundColor = "NO_COLOR")
		)
		(controller $Instance renderer='MapPathLine'
			(bind enabled "missionProgress != 1")
			(args
				_markerEntity = "_markerEntity"
				_isOvered = "isOvered"
				_scaleRatio = "_scaleRatio"
				_isNumberPointVisible = "isNumberPointVisible"
			)
		)
	)

	(block
		(bind visible "isNumberPointVisible")
		(style
			(position = "absolute")
			(width = 1px)
			(height = 1px)
			(align = "center|middle")
			(bind left "posX")
			(bind top "posY")
			(bind rotation "-angleToRotate")
		)
		(controller $Instance renderer='MapPathStartMarker'
			(bind enabled "missionProgress != 1 && !isSpaceAprilCustomization")
			(args
				_missionIndex = "missionIndex"
				_relation = "relation"
				_isOvered = "isOvered"
				_isMinimap = true
			)
		)
	)
)

(def element MapPathStartMarker (_missionIndex:number, _isOvered:bool)
	(style
		(width = 1px)
		(height = 1px)
		(align = "center|middle")
	)

	(controller $Animation
		(bindcall play
			from = { scaleX: 1.00, scaleY: 1.00 }
			to = { scaleX: 1.15, scaleY: 1.15 }
			duration = 0.15
			easing = "Easing.cubic_in"
			reverse = "!_isOvered"
			action = "killAndContinue"
			(bind trigger "_isOvered")
		)
	)

	(block
		(style
			(width = 24px)
			(height = 24px)
			(bind backgroundImage "'swf:../battle_hud/markers/scenario_markers_map_svg/scenario_markers_map_svg.swf:scenario_marker_map_svg_convoy_' + (_missionIndex + 1)")
		)
	)
)

(def element MapPathLine (_markerEntity:dhEntity, _isOvered:bool, _scaleRatio:number, _isNumberPointVisible:bool=true)
	(scope
		(var lineThickness:number = 1)
		(var lineAlpha:number = 0.3)
		(var scaleX:number = 1)
		(var scaleY:number = 1)

		(var missionProgress:number = 			"_markerEntity.progress.value" (event "_markerEntity.progress.evChanged"))
		(var minimapPathComponent:dhComponent = "_markerEntity.minimapBezierPath")

		(var minimapPath:array = "minimapPathComponent.path" (event "minimapPathComponent.evPathChanged"))

		(var posX:number = "_scaleRatio * minimapPath[0].x")
		(var posY:number = "_scaleRatio * minimapPath[0].y")

		(controller $Animation
			(bindcall play
				from = { lineThickness: 1, lineAlpha: 0.3, scaleX: 1.00, scaleY: 1.00 }
				to = { lineThickness: 2, lineAlpha: 1, scaleX: 1.15, scaleY: 1.15 }
				duration = 0.15
				easing = "Easing.cubic_in"
				reverse = "!_isOvered"
				action = "killAndContinue"
				(bind trigger "_isOvered")
			)
		)
	)

	(block 
		(bind visible "_isNumberPointVisible")
		(style
			(position = "absolute")
			(width = 1px)
			(height = 1px)
			(align = "center|middle")
			(bind left "posX")
			(bind top "posY")
			(bind scaleX "scaleX")
			(bind scaleY "scaleY")
		)
		(controller $Sector
			(arc = 360)
			(radius = 1000)
			(innerRadius = 6)
			(color = "SC.Ui_styles.SERVICE_COLORS.WHITE")
		)
		(isMask = true)
	)

	(mc 'lesta.libs.unbound2.MinimapBezierDrawer'
		(useMask = true)

		(bind lineThickness "lineThickness")
		(bind scaleRatio "_scaleRatio")
		(bind color "minimapPathComponent.color")
		(bind lineAlpha "lineAlpha + 0.4")
		(bind lineProgress "missionProgress")

		(bindcall drawPathByCoords "minimapPath" init=true)
	)

	(mc 'lesta.libs.unbound2.MinimapBezierDrawer'
		(lineThickness = 1)
		(lineAlpha = 0.3)
		(useMask = false)

		(bind scaleRatio "_scaleRatio")
		(bind color "minimapPathComponent.color")

		(bindcall drawPathByCoords "minimapPath" init=true)
	)
)