
(def element MapMinefieldMarker (_markerEntity:dhEntity)
	(scope
		(var minefieldComponent:dhComponent = "_markerEntity.minefield")
		(var isMinefieldActive:bool = "minefieldComponent.isActive" (event "minefieldComponent.evIsActiveChanged"))
		(var isMinefieldVisible:bool = "minefieldComponent.isVisible" (event "minefieldComponent.evIsVisibleChanged"))

		(var circleRadius:number = "_markerEntity.circle.radius" (event "_markerEntity.circle.evRadiusChanged"))

		(var relationStr:str = "toLower(SC.Battle.PLAYER_RELATION.VALUE_TO_NAME[_markerEntity.relation.value])" (event "_markerEntity.relation.evChanged"))

		
		(var healthComponent:dhComponent = "getSingleEntity(CC.playerAvatar).health")
		(var isPlayerAlive:bool = "healthComponent.isAlive" (event "healthComponent.evIsAliveChanged"))
		(var selectedMouseHandlerComponent:dhComponent = "_markerEntity.selectedMouseHandler")
		(var minimapOptionComponent:dhComponent = "getPrimaryEntity(CC.minimapOption, SC.Battle.MINIMAP_OPTION.mouseCommandsEnabled).minimapOption")
		(var isMouseCommandsEnabled:bool = "minimapOptionComponent.value > 0" (event "minimapOptionComponent.evValueChanged"))
		(var isMouseOverMarker:bool = "isPlayerAlive && isMouseCommandsEnabled && selectedMouseHandlerComponent != null")
	)

	(bind visible "isMinefieldVisible")

	(style
		(position = "absolute")
		(bind scaleX "circleRadius")
		(bind scaleY "circleRadius")
	)
	(bind colorTransform "isMouseOverMarker ? SHIP_HP_TRANSFORM_COLORS.WHITE : CT_NONE")

	(block
		(controller $Sector
			(arc = 360)
			(lineThickness = 8)
			(dashLength = 45)
			(spacing = 45)
			(radius = "MINIMAP_ASSETS_SIZE")
			(innerRadius = "MINIMAP_ASSETS_SIZE")
			(bind lineAlpha "isMinefieldActive ? 0.8 : 0.5")
			(bind lineColor "TWO_TEAMS_COLOR[relationStr]")
		)
	)

	(block
		(bind visible "isMinefieldActive")
		(style (alpha = 0.3))
		(controller $Sector
			(arc = 360)
			(radius = "MINIMAP_MINEFIELD_SIZE")
			(bind color "TWO_TEAMS_COLOR[relationStr]")
		)
	)
)