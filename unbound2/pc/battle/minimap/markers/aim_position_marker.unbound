(def element MapAimPositionMarker (_markerEntity:dhEntity, _mapScale:number, _scaleRatio:number, _isLoading:bool=false)
	(scope
		(var aimPositionComponent:dhComponent = "_markerEntity.aimPosition")
		(var mapPositionComponent:dhComponent = "_markerEntity.mapPosition")

		(var offset:number = 		"aimPositionComponent.offset ?: 0" 	(event "evEnterFrame"))
		(var position:dhStruct = 	"mapPositionComponent.position")

		(var posX:number = "position.x ?: 0" (event "evEnterFrame"))
		(var posY:number = "position.y ?: 0" (event "evEnterFrame"))

		(var isVisible:bool = "!_isLoading && aimPositionComponent.visible && position != null" (event "aimPositionComponent.evChanged"))

		(var yaw:number = "mapPositionComponent.yaw != null ? radToGrad(mapPositionComponent.yaw) : 0" (event "evEnterFrame"))

		(var rangesAlphaComponent:dhComponent = "getPrimaryEntity(CC.minimapOption, SC.Battle.MINIMAP_OPTION.rangesAlpha).minimapOption")
		(var rangesAlpha:number = "rangesAlphaComponent.value * 0.01" (event "rangesAlphaComponent.evValueChanged"))

		(var positionX:number = "posX * _scaleRatio" watch=false)
		(var positionY:number = "posY * _scaleRatio" watch=false)

		(bind positionX "posX * _scaleRatio" watch=false init=false (bind trigger "_scaleRatio"))
		(bind positionY "posY * _scaleRatio" watch=false init=false (bind trigger "_scaleRatio"))

		(controller $Animation
			(bindcall play
				duration = 0.07
				to = "{ positionX: posX * _scaleRatio }"
				watch = false
				(bind trigger "posX")
				(bind enabled "isVisible")
			)
			(bindcall play
				duration = 0.07
				to = "{ positionY: posY * _scaleRatio }"
				watch = false
				(bind trigger "posY")
				(bind enabled "isVisible")
			)
		)
	)
	(bind visible "isVisible")

	(style
		(position = "absolute")

		(bind alpha "rangesAlpha")
		(bind left "positionX")
		(bind top "positionY - offset")
		(bind scaleX "_mapScale")
		(bind scaleY "_mapScale")
		(bind rotation "yaw")
	)

	(controller $Sector
		(arc = 360)
		(radius = 2)
		(lineAlpha = 0.8)
		(lineThickness = 0.2)
		(lineColor = "SC.Ui_styles.SERVICE_COLORS.WHITE")
	)
)
