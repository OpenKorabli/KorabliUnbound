
(def constant PLANE_TYPE_TO_STR [
	'scout',
	'bomber',
	'torpedo',
	'fighter',
	'skip',
	'minebomber',
	'emptybomber',
	'auxiliary',
	'auxiliary',
])

(def element MapSquadronMarker (_markerEntity:dhEntity, _mapScale:number, _itemScale:number)
	(scope
		(var planeComponent:dhComponent = "_markerEntity.plane")

		(var planeTypeInt:number = "planeComponent.planeType")
		(var isMissile:bool = "planeComponent.ammoType == SC.Common.PLANE_AMMO_TYPES.MISSILE")

		(var markerYaw:number = "_markerEntity.mapPosition.yaw != null ? radToGrad(_markerEntity.mapPosition.yaw) : 0" (event "evEnterFrame"))

		(var aircarrierComponent:dhComponent = "getSingleComponent(CC.aircarrier)")

		(var controlledSquadronId:number = "aircarrierComponent ? aircarrierComponent.controlledSquadronId
																: DEFAULT_SQUADRON_ID" (event "aircarrierComponent.evControlledSquadronIdChanged"))

		(var isControllingSquadron:bool = "controlledSquadronId != DEFAULT_SQUADRON_ID")
		(var isCurrentSquadronControlled:bool = "controlledSquadronId == _markerEntity.squadron.id")

		(var markerElement:str = "planeTypeInt == SC.Battle.PLANES_TYPES.AIRSHIP ? 'MapMarkerAirShipIcon' : 'MapMarkerSquadronIcon'")

		(var minimapComponent:dhComponent = "getSingleComponent(CC.minimap)")
		(var angleToRotate:number = "minimapComponent && !isControllingSquadron ? minimapComponent.rotationAngleDeg : 0" (event "minimapComponent.evRotationAngleDegChanged"))

		(var isEnabled:bool = "isCurrentSquadronControlled || !isMissile")

		
		(var healthComponent:dhComponent = "getSingleEntity(CC.playerAvatar).health")
		(var isPlayerAlive:bool = "healthComponent.isAlive" (event "healthComponent.evIsAliveChanged"))
		(var selectedMouseHandlerComponent:dhComponent = "_markerEntity.selectedMouseHandler")
		(var minimapOptionComponent:dhComponent = "getPrimaryEntity(CC.minimapOption, SC.Battle.MINIMAP_OPTION.mouseCommandsEnabled).minimapOption")
		(var isMouseCommandsEnabled:bool = "minimapOptionComponent.value > 0" (event "minimapOptionComponent.evValueChanged"))
		(var isMouseOverMarker:bool = "isPlayerAlive && isMouseCommandsEnabled && selectedMouseHandlerComponent != null")
	)
	(style (bind rotation "-angleToRotate"))

	(controller $Instance renderer='MapMarkerRanges'
		(bind enabled "isEnabled")
		(args
			_entity 	= "_markerEntity"
			_mapScale 	= "_mapScale"
		)
	)

	(block
		(style
			(bind scaleX "_itemScale / _mapScale")
			(bind scaleY "_itemScale / _mapScale")
		)
		(bind colorTransform "isMouseOverMarker ? SHIP_HP_TRANSFORM_COLORS.WHITE : CT_NONE")

		(controller $Instance
			(bind renderer "markerElement")
			(bind enabled "_markerEntity != null && isEnabled")
			(args
				_markerEntity = "_markerEntity"
				_rotation = "markerYaw")
		)
	)
)

(def element MapMarkerAirShipIcon (_markerEntity:dhEntity)
	(scope
		(var relationStr:str = "toLower(SC.Battle.PLAYER_RELATION.VALUE_TO_NAME[_markerEntity.relation.value])" (event "_markerEntity.relation.evChanged"))
		(var markerIcon:str = "'swf:../battle_hud/markers/convoy_airships_svg/convoy_airships_svg.swf:marker_' + relationStr")
	)
	(style
		(position = "absolute")
		(width = 14px)
		(height = 14px)
		(pivotX = 50%)
		(pivotY = 50%)
		(bind backgroundImage "markerIcon")
	)
)

(def element MapMarkerSquadronIcon (_markerEntity:dhEntity, _rotation:number)
	(scope
		(var planeComponent:dhComponent = 		"_markerEntity.plane")
		(var relationComponent:dhComponent = 	"_markerEntity.relation")

		(var planeTypeInt:number = 	"planeComponent.planeType")
		(var ammoType:number = 		"planeComponent.ammoType")
		(var isModified:bool = 		"planeComponent.isModified")
		(var isSmokePlane:bool = 	"planeComponent.isSmokePlane")
		(var isSpyPlane:bool = 		"planeComponent.isSpyPlane")
		(var isConsumable:bool = 	"planeComponent.isConsumable && !planeComponent.isAirSupport")

		(var postfix:str = "isModified		? '_upgrade' :
							isSmokePlane	? '_smoker' :
							isSpyPlane 		? '_spy'
											: ''"
		)

		(var ammoTypeName:str = "SC.Common.PLANE_AMMO_TYPES.VALUE_TO_NAME[ammoType]")

		(var ammoPostfix:str = "ammoTypeName in SC.Common.PLANE_AMMO_TYPES.SHORT_NAMES && !isConsumable ? SC.Common.PLANE_AMMO_TYPES.SHORT_NAMES[ammoTypeName] : ''")

		(var isSelf:bool = "relationComponent.value == SC.Battle.DIPLOMACY_RELATIONS.SELF" (event "relationComponent.evChanged"))
		(var relationName:str = "SC.Battle.PLAYER_RELATION.NAMES[SC.Battle.PLAYER_RELATION.VALUE_TO_NAME[relationComponent.value]]" (event "relationComponent.evChanged"))

		(var aircarrierComponent:dhComponent = "getSingleComponent(CC.aircarrier)")

		(var controlledSquadronId:number = "aircarrierComponent ? aircarrierComponent.controlledSquadronId
																: DEFAULT_SQUADRON_ID" (event "aircarrierComponent.evControlledSquadronIdChanged"))

		(var isCurrentSquadronControlled:bool = "controlledSquadronId == _markerEntity.squadron.id")

		(var planeTypeName:str = "PLANE_TYPE_TO_STR[planeTypeInt]")
		(var planeFullName:str = "planeTypeName + ammoPostfix + postfix + '_' + relationName")
		(var planeSubName:str = "	isConsumable				? 'consumables_' :
									planeComponent.isAirSupport	? 'airsupport_'
																: ''")
		(var markerIconPath:str = "'swf:../battle_hud/markers/minimap/plane_svg/plane_svg.swf:' + planeSubName + planeFullName")
	)

	(style
		(position = "absolute")
		(width = 20px)
		(height = 20px)
		(bind rotation "isSelf && isCurrentSquadronControlled ? _rotation : 0")
	)

	(block
		(bind visible "isCurrentSquadronControlled")
		(style
			(width = 16px)
			(height = 20px)
			(backgroundImage = 'swf:../battle_hud/markers/minimap/ship/ship_self_svg/ship_self_svg.swf:alive')
		)
	)
	(block
		(bind name "'minimapPlane_' + planeTypeName")
		(bind visible "!isCurrentSquadronControlled")
		(style
			(position = "absolute")
			(width = 20px)
			(height = 20px)
			(visualOffsetX = -50%)
			(visualOffsetY = -50%)
			(bind backgroundImage "markerIconPath")
		)
	)
)
