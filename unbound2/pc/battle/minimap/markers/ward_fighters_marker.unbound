(def element MapWardFightersMarker (_markerEntity:dhEntity)
	(scope
		(var circleRadius:number = "_markerEntity.circle.radius ?: 0" (event "_markerEntity.circle.evRadiusChanged"))
		(var relationStr:str = "toLower(SC.Battle.PLAYER_RELATION.VALUE_TO_NAME[_markerEntity.relation.value])" (event "_markerEntity.relation.evChanged"))
	)

	(style
		(alpha = 0)
		(bind scaleX "circleRadius")
		(bind scaleY "circleRadius")
	)

	(controller $Animation
		(bindcall play
			duration = 0.3
			to = { alpha: 0.18 }
			easing = "Easing.quint_in"
			action = "kill"
			on = 'addedToStage'
		)
		(bindcall play
			duration = 0.3
			to = { alpha: 0 }
			easing = "Easing.quint_in"
			action = "kill"
			(event "_markerEntity.interactiveZone.evHide")
		)
	)

	(controller $Sector
		(arc = 360)
		(radius = "MINIMAP_ASSETS_SIZE")
		(bind color "TWO_TEAMS_COLOR[relationStr]")
	)
)