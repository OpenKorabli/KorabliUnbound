(def element MapMarkerItem (_markerEntity:dhEntity,
							_mapScale:number,
							_itemScale:number,
							_scaleRatio:number,
							_markerSettingsMap:array = "MINIMAP_MARKERS_SETTINGS",
							_isLoading:bool = false)
	(scope
		(event evMarkerUpdate)

		(var markerScale:number = "_itemScale / _mapScale")

		(var mapPositionComponent:dhComponent = "_markerEntity.mapPosition")

		(var posX:number = "mapPositionComponent ? _scaleRatio * mapPositionComponent.position.x : 0" init=false watch=false (event "evMarkerUpdate"))
		(var posY:number = "mapPositionComponent ? _scaleRatio * mapPositionComponent.position.y : 0" init=false watch=false (event "evMarkerUpdate"))

		(var targetComponent:dhComponent = "_markerEntity.target")
		(var targetFlags:number = 	"targetComponent.flags ?: 0" 				(event "targetComponent.evChanged") (event "targetComponent.evFlagsChanged"))

		(var posZ:number = 			"_markerEntity.minimapMarker.zindex ?: 0" 	(event "_markerEntity.minimapMarker.evZindexChanged"))
		(var mapVisible:bool = 		"_markerEntity.visibility.mapVisible" 		(event "_markerEntity.visibility.evChanged"))

		(var type:number = 			"_markerEntity.entityType ? _markerEntity.entityType.value : -1")

		(var markerSettings:dict = "type != -1 ? _markerSettingsMap[type] : STUB_MINIMAP_MARKER_SETTINGS")

		(var markerUpdatePos:bool =	"!markerSettings.disableUpdatePos")
		(var rotateBack:bool = 		"markerSettings.rotateBack")
		(var hideOnDeath:bool = 	"markerSettings.hideOnDeath")

		(var isTargetLocked:bool = "(targetFlags & LOCKABLE_WEAPONS) > 0")

		(var minimapComponent:dhComponent = "getSingleComponent(CC.minimap)")
		(var angleToRotate:number = "minimapComponent.rotationAngleDeg" (event "minimapComponent.evRotationAngleDegChanged"))

		(var scenarioTagCollection:dhCollection = "getCollectionByPath(CC.scenarioTag, 'byOwnerId.' + _markerEntity.id)")
		(var scenarioTagCollectionLen:number = "scenarioTagCollection.length")

		(var healthComponent:dhComponent = "getSingleEntity(CC.playerAvatar).health")
		(var isAlive:bool = "healthComponent.isAlive" (event "healthComponent.evIsAliveChanged"))
	)
	(dispatch evMarkerUpdate args={} (event "evEnterFrame") (bind enabled "markerUpdatePos"))

	(bind visible "isAlive" (bind enabled "hideOnDeath"))

	(style
		(position = "absolute")
		(bind zindex "posZ")
		(bind left "posX")
		(bind top "posY")
		(bind scaleX "markerUpdatePos ? _mapScale : 1")
		(bind scaleY "markerUpdatePos ? _mapScale : 1")
		(bind rotation "-angleToRotate" (bind enabled "rotateBack"))
	)

	
	(block
		(style
			(bind scaleX "markerScale")
			(bind scaleY "markerScale")
		)

		(controller $Instance renderer = 'MapMarkerScenarioTag'
			(bind enabled "scenarioTagCollectionLen > 0")
			(args
				_markerEntity = "_markerEntity"
				_scenarioTagCollection = "scenarioTagCollection"
			)
		)
	)

	
	(block
		(style (position = "absolute"))
		(controller $FxInstance renderer='MapMarkerItemQCAnim' lifetime="QUICK_COMMAND_ANIM_LIFETIME"
			(bindcall create (event "_markerEntity.quickCommand.evPlay"))
			(args
				_type = "$event[1]"
				_relation = "_markerEntity.relation.value"
			)
		)
	)

	
	(block
		(controller $Instance
			(bind renderer "markerSettings.markerRenderer")
			(args
				_markerEntity = "_markerEntity"
				_mapScale = "_mapScale"
				_itemScale = "_itemScale"
				_scaleRatio = "_scaleRatio"
				_isLoading = "_isLoading"
			)
		)
	)

	
	(block
		(style
			(position = "absolute")
			(bind scaleX "markerScale")
			(bind scaleY "markerScale")
		)

		(controller $Instance renderer = 'MapMarkerItemAimTargetLock'
			(bind enabled "isTargetLocked && mapVisible")
		)
	)
)

(def element MapMarkerItemQCAnim (_type:str, _relation:number)
	(scope
		(var isAnimEnabler:bool = "isIn(_type, ['Target_CMD', 'Submarine_Ping_CMD'])")

		(var radiusAnimated:number = 15)
		(var lineAlphaAnimated:number = 0)

		(controller $Animation
			(play
				duration	= 1
				repeatCount = 6
				from		= "{ radiusAnimated: 15, lineAlphaAnimated: 0 }"
				to			= "{ radiusAnimated: 4, lineAlphaAnimated: 1 }"
				reverse		= "!isAnimEnabler"
			)
		)
	)
	(style (position = "absolute"))

	(controller $Sector
		(arc = 360)
		(lineThickness = 1.25)

		(bind radius "radiusAnimated")
		(bind innerRadius "radiusAnimated")

		(bind lineAlpha "lineAlphaAnimated")
		(bind lineColor "TWO_TEAMS_COLOR[toLower(SC.Battle.PLAYER_RELATION.VALUE_TO_NAME[_relation])]")
	)
)

(def element MapMarkerItemAimTargetLock ()
	(style
		(position = "absolute")
		(alpha = 0)
		(backgroundImage = 'symbol:minimap_target_lock')
	)

	(controller $Animation
		(play
			duration = 0.2
			from = 	{ scaleX: 2, scaleY: 2, alpha: 0 }
			to = 	{ scaleX: 1, scaleY: 1, alpha: 0.5 }
		)
	)
)

(def element MapMarkerRanges (_entity:dhEntity, _mapScale:number)
	(scope
		(var minimapRangesCollection:dhCollection = "getCollectionByPath(CC.minimapRange, 'byEntity.' + _entity.id + '.active.sorted')")
		(var minimapRangesLen:number = "minimapRangesCollection.length")
	)
	(controller $Repeat renderer='MapMarkerItemRange'
		(bind count "minimapRangesLen")
		(args
			_ownerEntity 	= "_entity"
			_mapScale 		= "_mapScale"
			_rangeCount		= "minimapRangesLen"
			_rangeEntity 	= "minimapRangesCollection.getEntityAtIndex($index)"
		)
	)
)

(def macro RANGE_CIRCLE (_rangeSettings:expression, _rangeRadius:expression)
	(block
		(style
			(bind scaleX "_rangeRadius")
			(bind scaleY "_rangeRadius")
		)

		(block
			(bind visible "!_rangeSettings.drawFilled")
			(controller $Sector
				(arc = 360)
				(lineAlpha = 1)

				(radius = "MINIMAP_ASSETS_SIZE")
				(innerRadius = "MINIMAP_ASSETS_SIZE")

				(bind lineColor 	"_rangeSettings.color")
				(bind lineThickness "_rangeSettings.lineThickness")
				(bind dashLength 	"_rangeSettings.dashLength")
				(bind spacing 		"_rangeSettings.spacing")
				(bind drawDotted 	"_rangeSettings.drawDotted")
			)
		)

		(block
			(bind visible "_rangeSettings.drawFilled")
			(style (alpha = 0.1))
			(controller $Sector
				(arc = 360)
				(radius = "MINIMAP_ASSETS_SIZE")
				(bind color "_rangeSettings.drawFilled ? _rangeSettings.color : NO_COLOR")
			)
		)
	)
)

(def element MapMarkerItemRange (_ownerEntity:dhEntity, _mapScale:number, _rangeEntity:dhEntity, _rangeCount:number)
	(scope
		(var rangesTextScale:number = "_mapScale > 1 ? 1 / _mapScale : 1")

		(var minimapRangeComponent:dhComponent = 	"_rangeEntity.minimapRange")
		(var circleComponent:dhComponent = 			"_rangeEntity.circle")
		(var parameterComponent:dhComponent = 		"_rangeEntity.parameter")

		(var parameterKey:str = 	"minimapRangeComponent.parameterKey")
		(var isConsumable:bool = 	"minimapRangeComponent.isConsumable")
		(var isActive:bool = 		"minimapRangeComponent.isActive || isConsumable" (event "minimapRangeComponent.evIsActiveChanged"))

		(var rangeSettings:dict = "MINIMAP_RANGES_SETTINGS[parameterKey]")

		(var minimapComponent:dhComponent = "getSingleComponent(CC.minimap)")
		(var angleToRotate:number = "minimapComponent.rotationAngleDeg" (event "minimapComponent.evRotationAngleDegChanged"))

		(var rangesAlphaComponent:dhComponent = 			"getPrimaryEntity(CC.minimapOption, SC.Battle.MINIMAP_OPTION.rangesAlpha).minimapOption")
		(var distanceDisplayEnabledComponent:dhComponent = 	"getPrimaryEntity(CC.minimapOption, SC.Battle.MINIMAP_OPTION.distanceDisplayEnabled).minimapOption")
		(var rangeOptionsEnabledComponent:dhComponent = 	"getPrimaryEntity(CC.minimapOption, rangeSettings.optionName).minimapOption")

		(var rangesAlpha:number = "rangesAlphaComponent.value * 0.01" (event "rangesAlphaComponent.evValueChanged"))
		(var distanceDisplayEnabled:bool = "distanceDisplayEnabledComponent.value > 0" (event "distanceDisplayEnabledComponent.evValueChanged"))
		(var rangeOptionsEnabled:bool = "rangeOptionsEnabledComponent ? rangeOptionsEnabledComponent.value > 0 : rangeSettings.forceEnabled" (event "rangeOptionsEnabledComponent.evValueChanged"))

		(var rangeEnabled:bool = "rangeOptionsEnabled || rangeSettings.forceEnabled")

		(var range:number = "circleComponent.radius" (event "circleComponent.evRadiusChanged"))
		(var rangeRadius:number = "range" watch=false)
		(controller $Animation
			(bindcall play  duration = 0.3
							easing = "Easing.line"
							to = "{ rangeRadius: range }"
							watch = false
							(bind trigger "range")
							(bind enabled "rangeEnabled")
			)
		)

		
		(var rangeCurrentValue:number = "parameterComponent.currentValue" (event "parameterComponent.evChanged"))
		(var rangeValue:str = "formatFloatingPoint(round(rangeCurrentValue * 10) / 10, 1)")

		(var mapPositionComoponent:dhComponent = "_ownerEntity.mapPosition")

		(var position:dhStruct = "mapPositionComoponent.position")
		(var posX:number = "position.x")
		(var posY:number = "position.y")

		(var cameraComponent:dhComponent = "getSingleComponent(CC.camera)")
		(var altVision:bool = "cameraComponent.altVision" (event "cameraComponent.evAltVisionChanged"))

		(var offsetAngle:number = "RANGES_TEXT_ANGLE / _rangeCount" watch=false)
		(var rangeRotation:number = "(distanceDisplayEnabled || altVision) && mapPositionComoponent != null ? (offsetAngle * (0 - _rangeCount / 2 + $index)) + atan2(0.5 - posY, 0.5 - posX) : 0")
	)
	(bind name "parameterKey")
	(bind visible "rangeEnabled && rangeRadius > 0")
	
	(block
		(style (bind alpha "rangesAlpha")) 

		(block
			(style (alpha = "isActive ? 1 : 0.65")) 

			(controller $Animation
				(bindcall play
					duration = 0.6
					from = "{ alpha: 0.65 }"
					to = "{ alpha: 1 }"
					reverse = "!isActive"
					(event "minimapRangeComponent.evIsActiveChanged")
				)
			)

			(macro RANGE_CIRCLE
				_rangeSettings = "rangeSettings"
				_rangeRadius = "rangeRadius"
			)
		)

		(block
			(style
				(position = "absolute")
				(alpha = 0)

				
				(filters
					(dropShadow
						(distance = 0)
						(angle = 90)
						(blurX = 3.5)
						(blurY = 3.5)
						(strength = 1.2)
						(quality = 2)
						(color = "SC.Ui_styles.SERVICE_COLORS.WHITE")
					)
				)
			)

			(controller $Animation
				(bindcall play
					duration = 0.4
					keyframes = "[
					{ percent: 0, 	to: { alpha: 0 }},
					{ percent: 50, 	to: { alpha: 0.65 }},
					{ percent: 100, to: { alpha: 0 }}]"
					(bind enabled "isActive")
					(event "minimapRangeComponent.evIsActiveChanged")
				)
			)

			(macro RANGE_CIRCLE
				_rangeSettings = "rangeSettings"
				_rangeRadius = "rangeRadius"
			)
		)
	)

	
	(block
		(bind visible "distanceDisplayEnabled || altVision")

		(style (bind rotation "radToGrad(rangeRotation)"))

		(block
			(style
				(position = "absolute")
				(bind scaleX "rangesTextScale")
				(bind scaleY "rangesTextScale")
				(bind rotation "-radToGrad(rangeRotation) - angleToRotate")
				(bind left "rangeRadius * MINIMAP_ASSETS_SIZE")
			)

			(tf
				(bind class "rangeSettings.boldText ? '$TextMinimapRangeBold' : '$TextMinimapRange'")
				(style
					(position = "absolute")
					(width = 38px)
					(height = 20px)
					(left = -19px)
					(top = -10px)
					(textAlign = "center")
					(bind textColor "rangeSettings.color")
				)
				(bind text "rangeValue")
			)
		)
	)
)



(def element MapStubMarker ())
