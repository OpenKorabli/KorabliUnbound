(def constant SCENARIO_TAGS_CIRCLE_COLORS "{
	SC.Battle.SCENARIO_TAG_VALUE.ATTACK:		{ color: 0xFFE75153, alpha: 0.36 },
	SC.Battle.SCENARIO_TAG_VALUE.BOSS_ENEMY:	{ color: 0xFFE75153, alpha: 0.36 },
	SC.Battle.SCENARIO_TAG_VALUE.EMPTY:			{ color: SC.Ui_styles.SERVICE_COLORS.BLACK, alpha: 0 },
	SC.Battle.SCENARIO_TAG_VALUE.DEFEND:		{ color: SC.Ui_styles.SERVICE_COLORS.GREEN, alpha: 0.36 },
	SC.Battle.SCENARIO_TAG_VALUE.ESCORT:		{ color: SC.Ui_styles.SERVICE_COLORS.GREEN, alpha: 0.36 },
	SC.Battle.SCENARIO_TAG_VALUE.REPAIR:		{ color: SC.Ui_styles.SERVICE_COLORS.BLACK, alpha: 0 },
	SC.Battle.SCENARIO_TAG_VALUE.BOSS_ALLY:		{ color: SC.Ui_styles.SERVICE_COLORS.GREEN, alpha: 0.36 }
}")

(def element MapScenarioObjectMarker (_markerEntity:dhEntity, _mapScale:number, _itemScale:number)
	(scope
		(var scenarioObjectComponent:dhComponent = "_markerEntity.scenarioObject")

		(struct scenarioObjectView = SCENARIO_OBJECT_VIEW(	_scenarioObjectViewComponent="scenarioObjectComponent"
															_relationComponent="_markerEntity.relation"))
	)

	(style
		(position = "absolute")
		(width = 0px)
		(height = 0px)

		(bind scaleX "_itemScale / _mapScale")
		(bind scaleY "_itemScale / _mapScale")
	)

	(block
		(style
			(position = "absolute")
			(width = 24px)
			(height = 24px)
			(pivotX = 50%)
			(pivotY = 50%)

			(scaleX = 0)
			(scaleY = 0)
			(alpha = 0)

			(bind backgroundImage "'swf:../battle_hud/markers/scenario_markers_map_svg/scenario_markers_map_svg.swf:scenario_marker_map_svg_' + toLower(SC.Battle.SCENARIO_MARKER_VALUE.VALUE_TO_NAME[scenarioObjectView.value])")
		)

		(controller $Animation
			(bindcall play
				duration = 0.3
				to = { alpha: 1, scaleX: 1, scaleY: 1 }
				easing = "Easing.quint_in"
				action = "kill"
				on = 'addedToStage'
			)
			(bindcall play
				duration = 0.3
				to = { alpha: 0, scaleX: 0, scaleY: 0 }
				easing = "Easing.quint_in"
				action = "kill"
				(event "scenarioObjectComponent.evHide")
			)
		)
	)
)

(def element MapMarkerScenarioTag (_markerEntity:dhEntity, _scenarioTagCollection:dhCollection)
	(scope
		(var isAlive:bool = "_markerEntity.health.isAlive" (event "_markerEntity.health.evIsAliveChanged"))
		(var firstScenarioTagType:number = "_scenarioTagCollection.firstEntity.scenarioTag.type ?: SC.Battle.SCENARIO_TAG_VALUE.EMPTY")
		(var circleSettings:dict = "SCENARIO_TAGS_CIRCLE_COLORS[firstScenarioTagType]")
	)
	(bind visible "isAlive")

	(style
		(position = "absolute")
		(bind alpha "circleSettings.alpha")
	)

	(block
		(controller $Animation
			(bindcall play
				duration = 0.3
				from = { alpha: 0, scaleX: 0, scaleY: 0 }
				to = { alpha: 1, scaleX: 1, scaleY: 1 }
				easing = "Easing.quint_in"
				on = 'addedToStage'
			)
		)

		(controller $Sector
			(arc = 360)
			(radius = 12)
			(bind color "circleSettings.color")
		)
	)
)