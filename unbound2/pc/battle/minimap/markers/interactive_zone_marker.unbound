(def constant MAP_DROP_ZONE_ICON_SIZE 30)

(def constant INTERACTIVE_ZONE_TYPES_FOR_COLOR_TRANSFORM "[
	SC.Battle.INTERACTIVE_ZONE_TYPES.SUPPORT_BUOY
]")

(def constant INTERACTIVE_ZONES_SETTINGS "[
		{color: 0xFFFFFF, alpha: 0},
		{color: 0xFFFFFF, alpha: 0},
		{color: 0xFFFFFF, alpha: 0},
		{color: 0xFFFFFF, alpha: 0},
		{color: 0xFF0000, alpha: 0.2},
		{color: 0xFFFFFF, alpha: 0.2},
		{color: 0xFFFFFF, alpha: 0.2},
		{color: 0xFFFFFF, alpha: 0.2},
		{color: 0xFF0000, alpha: 0.2}
]")

(def constant COLORED_BY_RELATION_INTERACTIVE_ZONES_SETTINGS "[
		{color: 0xFFFFFF, alpha: 0.2},
		{color: 0x5EDABB, alpha: 0.2},
		{color: 0xF25755, alpha: 0.2}
]")

(def element MapInteractiveZoneMarker (_markerEntity:dhEntity, _mapScale:number, _itemScale:number)
	(scope
		(var markerScale:number = "_itemScale / _mapScale")

		(var interactiveZoneComponent:dhComponent = "_markerEntity.interactiveZone")

		(var type:number = 			"interactiveZoneComponent.type")
		(var visualType:number = 	"interactiveZoneComponent.visualType")

		(var relationValue:number = "_markerEntity.relation.value" 	(event "_markerEntity.relation.evChanged"))
		(var circleRadius:number = 	"_markerEntity.circle.radius" 	(event "_markerEntity.circle.evRadiusChanged"))

		(var isInversed:bool = 		"visualType == SC.Battle.INTERACTIVE_ZONE_VISUAL_TYPE.INVERSED")
		(var circleSettings:dict = 	"visualType == SC.Battle.INTERACTIVE_ZONE_VISUAL_TYPE.FILLED 	? COLORED_BY_RELATION_INTERACTIVE_ZONES_SETTINGS[relationValue]
																									: INTERACTIVE_ZONES_SETTINGS[type]")
	)

	
	
	(block
		(style
			(position = "absolute")

			(bind scaleX "circleRadius")
			(bind scaleY "circleRadius")
			(bind alpha "circleSettings.alpha")
		)

		(block
			(controller $Animation
				(bindcall play
					duration = 0.3
					from = { alpha: 0 }
					to = { alpha: 1 }
					easing = "Easing.quint_in"
					on = 'addedToStage'
				)
				(bindcall play
					duration = 0.3
					to = { alpha: 0 }
					easing = "Easing.quint_in"
					(event "interactiveZoneComponent.evHide")
				)
			)

			(controller $Sector
				(arc = 360)
				(radius = "MINIMAP_ASSETS_SIZE")
				(bind color "isInversed ? C_ENEMY : circleSettings.color")
				(bind innerRadius "isInversed ? 3000 : 0")
			)
		)
	)
	

	
	
	(block
		(style
			(position = "absolute")
			(alpha = 0)
			(scaleX = 0)
			(scaleY = 0)
		)

		(controller $Animation
			(bindcall play
				duration = 0.3
				to = { alpha: 1, scaleX: 1, scaleY: 1 }
				easing = "Easing.quint_in"
				on = 'addedToStage'
			)
			(bindcall play
				duration = 0.3
				to = { alpha: 0, scaleX: 0, scaleY: 0 }
				easing = "Easing.quint_in"
				(event "interactiveZoneComponent.evHide")
			)
		)

		(block
			(style
				(bind scaleX "markerScale")
				(bind scaleY "markerScale")
			)
			(block
				(controller $Instance renderer='MapInteractiveZoneIndicator'
					(bind enabled "type == SC.Battle.INTERACTIVE_ZONE_TYPES.RESOURCE_ZONE")
					(args
						_markerEntity = "_markerEntity"
					)
				)
			)

			(block
				(controller $Instance renderer='MapDropZoneIndicator'
					(bind enabled "isIn(type, [SC.Battle.INTERACTIVE_ZONE_TYPES.DROP_ZONE, SC.Battle.INTERACTIVE_ZONE_TYPES.SUPPORT_BUOY])")
					(args
						_markerEntity = "_markerEntity"
						_relationValue = "relationValue"
					)
				)
			)

			(block
				(bind visible "type == SC.Battle.INTERACTIVE_ZONE_TYPES.PORTAL")
				(block
					(style
						(position = "absolute")
						(pivotX = 50%)
						(pivotY = 50%)
						(width = 24px)
						(height = 24px)
						(backgroundSize = "fill")
						(backgroundImage = 'swf:../battle_hud/markers/scenario_markers_map_svg/scenario_markers_map_svg.swf:scenario_marker_map_svg_portal')
					)
				)
			)
		)
	)
	
)

(def element MapInteractiveZoneIndicator (_markerEntity:dhEntity)
	(scope
		(var resourceHolderComponent:dhComponent = "_markerEntity.resourceHolder")

		(var resourceType:number = 	"resourceHolderComponent.resourceType")
		(var loading:bool = 		"resourceHolderComponent.loading")
		(var resourceName:str = 	"resourceHolderComponent ? toLower(resourceHolderComponent.resourceName) + (loading ? '_gathering' : '_unloading') : null")

		(var enabled:bool = "!isIn(resourceType, SC.Battle.RESOURCE_TYPES.HIDDEN_RESOURCE_ZONES)")
	)
	(bind visible "enabled")

	(style
		(width = 26px)
		(height = 26px)
	)

	(block
		(style
			(position = "absolute")
			(top = -13px)
			(left = -13px)
			(bind backgroundImage "'url:../battle_hud/markers/zone_markers/map/' + resourceName + '.png'" (bind enabled "enabled"))
		)
	)
)

(def element MapDropZoneIndicator (_markerEntity:dhEntity, _relationValue:number="SC.Battle.PLAYER_RELATION.SELF")
	(scope
		(var dropComponent:dhComponent = "_markerEntity.drop" autoUpdate=false (event "_markerEntity.evAdded"))
		(var isActive:bool = "dropComponent.isActive" (event "dropComponent.evIsActiveChanged"))
		(var markerName:str = "isActive ? dropComponent.markerNameActive : dropComponent.markerNameInactive")

		
		(var healthComponent:dhComponent = "getSingleEntity(CC.playerAvatar).health")
		(var isPlayerAlive:bool = "healthComponent.isAlive" (event "healthComponent.evIsAliveChanged"))
		(var selectedMouseHandlerComponent:dhComponent = "_markerEntity.selectedMouseHandler")
		(var minimapOptionComponent:dhComponent = "getPrimaryEntity(CC.minimapOption, SC.Battle.MINIMAP_OPTION.mouseCommandsEnabled).minimapOption")
		(var isMouseCommandsEnabled:bool = "minimapOptionComponent.value > 0" (event "minimapOptionComponent.evValueChanged"))
		(var isMouseOverMarker:bool = "isPlayerAlive && isMouseCommandsEnabled && selectedMouseHandlerComponent != null")
	)

	(style
		(width = "MAP_DROP_ZONE_ICON_SIZE")
		(height = "MAP_DROP_ZONE_ICON_SIZE")
	)

	(bind colorTransform "	!isIn(_markerEntity.interactiveZone.type, INTERACTIVE_ZONE_TYPES_FOR_COLOR_TRANSFORM) 	? CT_NONE :
							isIn(_relationValue, SC.Battle.PLAYER_RELATION.ALLIES) 									? CT_ALLY :
							_relationValue == SC.Battle.PLAYER_RELATION.ENEMY 										? CT_ENEMY
																													: CT_NONE"
	)

	(block
		(style
			(position = "absolute")
			(top = "-MAP_DROP_ZONE_ICON_SIZE / 2")
			(left = "-MAP_DROP_ZONE_ICON_SIZE / 2")
			(width = "MAP_DROP_ZONE_ICON_SIZE")
			(height = "MAP_DROP_ZONE_ICON_SIZE")
			(backgroundSize = "fill")
			(bind backgroundImage "'url:../powerups/drops/icon_marker_' + markerName + '_small.png'")
		)
		(bind colorTransform "isMouseOverMarker ? SHIP_HP_TRANSFORM_COLORS.WHITE : CT_NONE")

		(block
			(style
				(position = "absolute")
				(top = "MAP_DROP_ZONE_ICON_SIZE / 2")
				(left = "MAP_DROP_ZONE_ICON_SIZE / 2")
			)

			(element MapInteractiveZoneTimeoutIndicator
				_timeoutEntity = "_markerEntity"
			)
		)
	)
)

(def element MapInteractiveZoneTimeoutIndicator (_timeoutEntity:dhEntity, _indicatorType:number = "ZONE_TIMEOUT_TYPES.CIRCLE")
	(scope
		(var timeoutComponent:dhComponent = "_timeoutEntity.timeout" autoUpdate=false (event "_timeoutEntity.evAdded"))

		(var totalTime:number = 		"timeoutComponent.total")
		(var timeoutTime:number = 		"timeoutComponent.time"	 	(event "timeoutComponent.evTimeChanged"))
		(var timeoutIsRunning:bool = 	"timeoutComponent.running" 	(event "timeoutComponent.evRunningChanged"))

		(var timerComponent:dhComponent = "getSingleComponent(CC.timer)")
		(var timeLeft:number = "timeoutIsRunning ? ceil(timeoutTime - timerComponent.currentServerTime)
												 : 0" (event "timerComponent.evFrequent"))

		(var isActive:bool = "timeoutIsRunning && timeLeft > 0 && totalTime > 0")
		(var arcRad:number = "floor(MAP_DROP_ZONE_ICON_SIZE/2 - 1)")
		(var arcProgress:number = "isActive > 0 ? 360 * ((totalTime - timeLeft) / totalTime) : 0")
	)
	(bind visible "isActive && _indicatorType == ZONE_TIMEOUT_TYPES.CIRCLE")

	(style
		(position = "absolute")
		(top = 50%)
		(left = 50%)
	)

	(block
		(style (alpha = 0.2))
		(controller $Sector
			(color = "SC.Ui_styles.SERVICE_COLORS.BLACK")
			(arc = 360)

			(bind enabled "_indicatorType == ZONE_TIMEOUT_TYPES.CIRCLE")
			(bind radius "arcRad")
			(bind innerRadius "arcRad - 2")
		)
	)

	(block
		(controller $Sector
			(offset = -90)
			(color = "SC.Ui_styles.SERVICE_COLORS.WHITE")

			(bind enabled "_indicatorType == ZONE_TIMEOUT_TYPES.CIRCLE")
			(bind arc "arcProgress")
			(bind radius "arcRad")
			(bind innerRadius "arcRad - 2")
		)
	)
)