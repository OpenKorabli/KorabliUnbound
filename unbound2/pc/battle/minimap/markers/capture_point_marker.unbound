(def constant CAPTURE_POINTS_SETTINGS
	"
	{
		NEUTRAL: {
			STROKE_COLOR: 0xFFFFFF,
			COLORS: [0xFFFFFF, 0xFFFFFF, 0xFFFFFF],
			ALPHAS: [0.18, 0.13, 0.08],
			RATIOS: [0, 128, 255]
		},
		ALLY: {
			STROKE_COLOR: C_ALLY,
			COLORS: [C_ALLY, C_ALLY, C_ALLY],
			ALPHAS: [0.39, 0.26, 0.21],
			RATIOS: [0, 128, 255]
		},
		ENEMY: {
			STROKE_COLOR: C_ENEMY,
			COLORS: [C_ENEMY, C_ENEMY, C_ENEMY],
			ALPHAS: [0.39, 0.26, 0.21],
			RATIOS: [0, 128, 255]
		}
	}
	"
)

(def element MapCapturePointMarker (_markerEntity:dhEntity, _mapScale:number, _itemScale:number, _scaleRatio:number)
	(scope
		(var circleComponent:dhComponent = "_markerEntity.circle")

		(var circleRadius:number = 		"circleComponent.radius" 		(event "circleComponent.evRadiusChanged"))
		(var circleInnerRadius:number = "circleComponent.innerRadius" 	(event "circleComponent.evInnerRadiusChanged"))

		(var relationIndex:number = "_markerEntity.relation ? _markerEntity.relation.value : SC.Battle.PLAYER_RELATION.NEUTRAL" (event "_markerEntity.relation.evChanged"))
		(var relation:str = "SC.Battle.PLAYER_RELATION.NAMES[SC.Battle.PLAYER_RELATION.VALUE_TO_NAME[relationIndex]]")

		
		(var healthComponent:dhComponent = "getSingleEntity(CC.playerAvatar).health")
		(var isPlayerAlive:bool = "healthComponent.isAlive" (event "healthComponent.evIsAliveChanged"))
		(var selectedMouseHandlerComponent:dhComponent = "_markerEntity.selectedMouseHandler")
		(var minimapOptionComponent:dhComponent = "getPrimaryEntity(CC.minimapOption, SC.Battle.MINIMAP_OPTION.mouseCommandsEnabled).minimapOption")
		(var isMouseCommandsEnabled:bool = "minimapOptionComponent.value > 0" (event "minimapOptionComponent.evValueChanged"))
		(var isMouseOverMarker:bool = "isPlayerAlive && isMouseCommandsEnabled && selectedMouseHandlerComponent != null")
	)

	(style
		(bind scaleX "_itemScale / _mapScale")
		(bind scaleY "_itemScale / _mapScale")
	)

	
	
	(block
		(style (position = "absolute"))
		(controller $Sector
			(arc = 360)
			(lineThickness = 1)
			(lineAlpha = 0.6)

			(bind radius "circleRadius * _scaleRatio")
			(bind innerRadius "circleInnerRadius * _scaleRatio")

			(bind colors 	"CAPTURE_POINTS_SETTINGS[toUpper(relation)].COLORS")
			(bind alphas 	"CAPTURE_POINTS_SETTINGS[toUpper(relation)].ALPHAS")
			(bind ratios 	"CAPTURE_POINTS_SETTINGS[toUpper(relation)].RATIOS")
			(bind lineColor "CAPTURE_POINTS_SETTINGS[toUpper(relation)].STROKE_COLOR")
		)
	)
	

	(block
		(style
			(hitTest = false)
			(marginLeft = -50%)
			(marginTop = -50%)
			(pivotX = 50%)
			(pivotY = 50%)
			(scaleX = 0.6)
			(scaleY = 0.6)
		)
		(bind colorTransform "isMouseOverMarker ? SHIP_HP_TRANSFORM_COLORS.WHITE : CT_NONE")

		(element CapturePointIndicator _markerEntity = "_markerEntity")
	)
)
