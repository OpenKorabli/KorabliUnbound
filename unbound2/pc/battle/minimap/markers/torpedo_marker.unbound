
(def element MapTorpedoMarker (_markerEntity:dhEntity, _mapScale:number, _itemScale:number)
	(scope
		(var markerScale:number = "_itemScale / _mapScale")

		(var type:str = "_markerEntity.torpedo.type" (event "_markerEntity.torpedo.evTypeChanged"))

		(var relationIndex:number = "_markerEntity.relation ? _markerEntity.relation.value
															: SC.Battle.PLAYER_RELATION.NEUTRAL" (event "_markerEntity.relation.evChanged"))

		(var relation:str = "SC.Battle.PLAYER_RELATION.NAMES[SC.Battle.PLAYER_RELATION.VALUE_TO_NAME[relationIndex]]")
		
		(var visibleAsNormal:bool = "isIn(type, SC.Battle.TORPEDO_MARKER_TYPE.GUIDED_TYPES)")

		(var markerIcon:str = "visibleAsNormal	?	'icon_torpedo_' + SC.Battle.TORPEDO_MARKER_TYPE.NORMAL + '_' + relation
												:	'icon_torpedo_' + type + '_' + relation")
	)
	(style
		(bind scaleX "markerScale * 0.75")
		(bind scaleY "markerScale * 0.75")
	)

	(block
		(style
			(backgroundSize = "autosize")
			(bind backgroundImage "'url:../battle_hud/markers/torpedoes/' + markerIcon + '.png'")
		)
	)
)