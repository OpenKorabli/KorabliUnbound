
(def constant TEXT_MARGINE_TOP -12px)

(def element MapVisibilityShipIcon (_shipType:str, _visionState:number)
	(style
		(position = "absolute")
		(bind backgroundImage "'swf:../battle_hud/markers/minimap/ship/ship_default_svg/ship_default_svg.swf:'+ _shipType + '_' + toLower(SC.Battle.SHIP_MARKER_VISION_STATE.VALUE_TO_NAME[_visionState]) +'_visibility'")
	)
)

(def element MapShipMarker (_markerEntity:dhEntity, _mapScale:number, _itemScale:number)
	(scope
		(var isPlayerAvatar:bool = "_markerEntity.hasComponent(CC.playerAvatar)")

		(var vehicleComponent:dhComponent = 	"_markerEntity.vehicle")
		(var relationComponent:dhComponent = 	"_markerEntity.relation")
		(var visibilityComponent:dhComponent = 	"_markerEntity.visibility")

		(var mapVisible:bool = 		"visibilityComponent.mapVisible" 	(event "visibilityComponent.evChanged"))
		(var worldVisible:bool = 	"visibilityComponent.visible" 		(event "visibilityComponent.evChanged"))

		(var isSelf:bool = 	"relationComponent && relationComponent.value == SC.Battle.PLAYER_RELATION.SELF" 	(event "relationComponent.evChanged"))
		(var isEnemy:bool = "relationComponent && relationComponent.value == SC.Battle.PLAYER_RELATION.ENEMY" 	(event "relationComponent.evChanged"))

		(var targetComponent:dhComponent = "_markerEntity.target")
		(var targetFlags:number = 	"targetComponent.flags ?: 0" 				(event "targetComponent.evChanged"))

		(var isAlive:bool = 		"_markerEntity.health.isAlive" 				(event "_markerEntity.health.evIsAliveChanged"))
		(var shipType:str = 		"toLower(_markerEntity.avatar.shipType)" 	(event "_markerEntity.avatar.evShipTypeChanged"))

		(var markerYaw:number = "_markerEntity.mapPosition.yaw != null ? radToGrad(_markerEntity.mapPosition.yaw) : 0" (event "evEnterFrame"))


		(var isTargetLocked:bool = "(targetFlags & LOCKABLE_WEAPONS) > 0")

		(var markerScale:number = "_itemScale / _mapScale")

		(var battleStateComponent:dhComponent = "getSingleComponent(CC.battleState)")
		(var battleState:number = "battleStateComponent.battleState" (event "battleStateComponent.evBattleStateChanged"))
		(var isBattleInProgress:bool = "battleState in SC.Common.CLIENT_BATTLE_STATE.IN_BATTLE")

		(var minimapComponent:dhComponent = "getSingleComponent(CC.minimap)")
		(var angleToRotate:number = "minimapComponent.rotationAngleDeg ?: 0" (event "minimapComponent.evRotationAngleDegChanged"))

		(var rangesAlphaComponent:dhComponent = 			"getPrimaryEntity(CC.minimapOption, SC.Battle.MINIMAP_OPTION.rangesAlpha).minimapOption")
		(var shipNamesDisplayEnabledComponent:dhComponent = "getPrimaryEntity(CC.minimapOption, SC.Battle.MINIMAP_OPTION.shipNamesDisplayEnabled).minimapOption")
		(var shipVisibilityEnabledComponent:dhComponent = 	"getPrimaryEntity(CC.minimapOption, SC.Battle.MINIMAP_OPTION.minimapVisibilityShipEnabled).minimapOption")

		(var rangesAlpha:number = 			"rangesAlphaComponent.value * 0.01" 			(event "rangesAlphaComponent.evValueChanged"))
		(var shipNamesDisplayEnabled:bool = "shipNamesDisplayEnabledComponent.value > 0" 	(event "shipNamesDisplayEnabledComponent.evValueChanged"))
		(var shipVisibilityEnabled:bool = 	"shipVisibilityEnabledComponent.value > 0" 		(event "shipVisibilityEnabledComponent.evValueChanged"))

		(var cameraComponent:dhComponent = "getSingleComponent(CC.camera)")
		(var altVision:bool = "cameraComponent.altVision" (event "cameraComponent.evAltVisionChanged"))


		(var spectatorStateComponent:dhComponent = "getSingleComponent(CC.spectatorState)")
		(var spectatorState:number = "spectatorStateComponent.state" (event "spectatorStateComponent.evStateChanged"))
		(var isSpectatorTrainingMode:bool = "spectatorState == SC.Common.SPECTATOR_STATE.TRAINING_SPECTATOR")

		(var isTeamVisibleInSpectate:bool = "isSpectatorTrainingMode || !isEnemy")

		(var isVisionStateEnabled:bool = "mapVisible && worldVisible && !isSelf && isAlive && isTeamVisibleInSpectate")
		(var visionState:number = "toBool(vehicleComponent.visionState) && isVisionStateEnabled ? vehicleComponent.visionState : SC.Battle.SHIP_MARKER_VISION_STATE.NONE" (event "vehicleComponent.evVisionStateChanged"))

		
		(var healthComponent:dhComponent = "getSingleEntity(CC.playerAvatar).health")
		(var isPlayerAlive:bool = "healthComponent.isAlive" (event "healthComponent.evIsAliveChanged"))
		(var selectedMouseHandlerComponent:dhComponent = "_markerEntity.selectedMouseHandler")
		(var minimapOptionComponent:dhComponent = "getPrimaryEntity(CC.minimapOption, SC.Battle.MINIMAP_OPTION.mouseCommandsEnabled).minimapOption")
		(var isMouseCommandsEnabled:bool = "minimapOptionComponent.value > 0" (event "minimapOptionComponent.evValueChanged"))
		(var isMouseOverMarker:bool = "isPlayerAlive && isMouseCommandsEnabled && selectedMouseHandlerComponent != null")
	)

	(block
		(style
			(position = "absolute")
			(bind alpha "rangesAlpha")
			(bind rotation "markerYaw")
		)
		(controller $Instance renderer = 'MapMarkerDirectionalLine'
			(bind enabled "(isPlayerAvatar || isTargetLocked) && isAlive && mapVisible && isBattleInProgress")
		)
	)

	(block
		(style (position = "absolute"))

		(controller $Instance renderer='MapMarkerRanges'
			(bind enabled "isPlayerAvatar && isAlive")
			(args
				_entity 	= "_markerEntity"
				_mapScale 	= "_mapScale"
			)
		)
	)
	(block
		(style
			(bind rotation "markerYaw")
			(bind scaleX "markerScale")
			(bind scaleY "markerScale")
		)

		(bind colorTransform "isMouseOverMarker ? SHIP_HP_TRANSFORM_COLORS.WHITE : CT_NONE")

		(block
			(controller $Instance renderer='MapVisibilityShipIcon'
				(bind enabled "shipVisibilityEnabled && visionState != SC.Battle.SHIP_MARKER_VISION_STATE.NONE")
				(args
					_shipType 		= "shipType"
					_visionState 	= "visionState"
				)
			)
		)

		(element MapMarkerShipIcon
			_markerEntity = "_markerEntity"
		)
	)

	(block
		(style
			(position = "absolute")
			(pivotY = "TEXT_MARGINE_TOP")
			(bind scaleX "markerScale")
			(bind scaleY "markerScale")
			(bind rotation "-angleToRotate")
		)

		(block
			(controller $Instance renderer = 'MapMarkerShipName'
				(bind enabled "!isPlayerAvatar && isAlive && (shipNamesDisplayEnabled || altVision)")
				(args _markerEntity = "_markerEntity")
			)
		)
	)
)

(def element MapMarkerDirectionalLine ()
	(style
		(position = "absolute")
		(backgroundImage = 'symbol:minimap_direction_line')
	)
)


(def element MapMarkerShipIcon (_markerEntity:dhEntity)
	(scope
		(var customElementsVisibilityComponent:dhComponent = "getSingleComponent(CC.customElementsVisibility)")
		(var enabledElements:number = "customElementsVisibilityComponent.enabledElements" (event "customElementsVisibilityComponent.evChanged"))
		(var isMultyTeamEnabled:bool = "(enabledElements & SC.Battle.CUSTOM_BATTLE_ELEMENTS.MULTYTEAMS) > 0")

		(var isAlive:bool = "_markerEntity.health.isAlive" (event "_markerEntity.health.evIsAliveChanged") (event "_markerEntity.evAdded"))

		(var avatarComponent:dhComponent = 		"_markerEntity.avatar")
		(var relationComponent:dhComponent = 	"_markerEntity.relation")
		(var visibilityComponent:dhComponent = 	"_markerEntity.visibility")

		(var teamId:number = 	"avatarComponent.teamId ?: 0" 	(event "avatarComponent.evTeamIdChanged"))
		(var subType:str = 		"avatarComponent.shipType" 		(event "avatarComponent.evShipTypeChanged"))

		(var shipType:str = "subType ? toLower(subType): ''")

		(var relationName:str = "toLower(SC.Battle.PLAYER_RELATION.VALUE_TO_NAME[relationComponent.value])" (event "relationComponent.evChanged"))

		(var isSelf:bool = 	"relationComponent && relationComponent.value == SC.Battle.PLAYER_RELATION.SELF" 	(event "relationComponent.evChanged"))
		(var isEnemy:bool = "relationComponent && relationComponent.value == SC.Battle.PLAYER_RELATION.ENEMY" 	(event "relationComponent.evChanged"))

		(var worldVisible:bool = 	"visibilityComponent.visible" 		(event "visibilityComponent.evChanged"))
		(var mapVisible:bool = 		"visibilityComponent.mapVisible" 	(event "visibilityComponent.evChanged"))

		(var aircarrierComponent:dhComponent = 	"getSingleComponent(CC.aircarrier)")
		(var cameraComponent:dhComponent = 		"getSingleComponent(CC.camera)")
		(var battleStateComponent:dhComponent = "getSingleComponent(CC.battleState)")

		(var controlledSquadronId:number = 	"aircarrierComponent.controlledSquadronId ?: DEFAULT_SQUADRON_ID" 	(event "aircarrierComponent.evControlledSquadronIdChanged"))
		(var cameraMode:number = 			"cameraComponent.mode" 												(event "cameraComponent.evModeChanged"))
		(var battleState:number = 			"battleStateComponent.battleState" 									(event "battleStateComponent.evBattleStateChanged"))

		(var isShowSelfShipType:bool = "controlledSquadronId != DEFAULT_SQUADRON_ID || cameraMode == SC.Battle.CAMERA_MODE.RTSAIRSUPPORT")

		(var isBattleInProgress:bool = "battleState in SC.Common.CLIENT_BATTLE_STATE.IN_BATTLE")
		(var visibilityPostfix:str = "mapVisible && !(worldVisible) && isBattleInProgress ? '_invisible' : ''")

		(var markerColorTransform:dict =
			"	!isAlive						? TWO_TEAMS_COLOR_TRANSFORMS['white'] :
				!mapVisible && !worldVisible	? TWO_TEAMS_COLOR_TRANSFORMS['white'] :
				!isEnemy						? TWO_TEAMS_COLOR_TRANSFORMS[relationName] :
				isMultyTeamEnabled				? MULTI_TEAMS_COLOR_TRANSFORMS[teamId]
												: TWO_TEAMS_COLOR_TRANSFORMS['enemy']
		")

		(var markerIcon:str = 
			"isAlive	? !mapVisible && !worldVisible	? shipType + '_last_visible'
														: isSelf	? isShowSelfShipType	? 'alive_' + shipType
																							: 'alive'
																	: shipType + visibilityPostfix
						: isSelf	? isShowSelfShipType	? 'dead_' + shipType
															: 'dead'
									: shipType + '_dead'")

		(var markerPath:str = "isSelf 	? 'swf:../battle_hud/markers/minimap/ship/ship_self_svg/ship_self_svg.swf:' + toLower(markerIcon)
										: 'swf:../battle_hud/markers/minimap/ship/ship_default_svg/ship_default_svg.swf:' + toLower(markerIcon)")
	)
	(bind colorTransform "markerColorTransform")
	(bind name "worldVisible ? 'map_marker_ship_' + (_markerEntity.avatar ? _markerEntity.avatar.id : 0) : ''")

	(style (bind backgroundImage "shipType ? markerPath : ''"))
)

(def element MapMarkerShipName (_markerEntity:dhEntity)
	(scope
		(var avatarComponent:dhComponent = 		"_markerEntity.avatar")
		(var relationComponent:dhComponent = 	"_markerEntity.relation")

		(var teamId:number = "avatarComponent.teamId ?: 0" (event "avatarComponent.evTeamIdChanged"))
		(var shipName:str = "avatarComponent.ship.ref.ship.nameUpper ?: ''" (event "avatarComponent.evShipRefChanged"))

		(var isAlly:bool = "relationComponent.value in SC.Battle.PLAYER_RELATION.ALLIES" (event "relationComponent.evChanged"))

		(var customElementsVisibilityComponent:dhComponent = "getSingleComponent(CC.customElementsVisibility)")
		(var enabledElements:number = "customElementsVisibilityComponent.enabledElements" (event "customElementsVisibilityComponent.evChanged"))
		(var isMultyTeamEnabled:bool = "(enabledElements & SC.Battle.CUSTOM_BATTLE_ELEMENTS.MULTYTEAMS) > 0")

		(var colorPresetName:str = "toLower(SC.Battle.PLAYER_RELATION.VALUE_TO_NAME[relationComponent.value])" (event "relationComponent.evChanged"))
	)
	(style
		(width = 100%)
		(align = "center")
	)

	(tf
		(class $TextDefaultBold10NM)
		(bind class "isMultyTeamEnabled && !isAlly	? MULTI_TEAMS_COLOR_CLASSES[teamId]
													: TWO_TEAMS_FONT_COLOR_CLASSES[colorPresetName]")
		(class $FontEnableReadability)
		(bind text "shipName")
	)
)

(def element DiplomacyMapMarkerShipIcon (_markerEntity:gfx)
	(scope
		(var isAlive:bool = "_markerEntity.health.isAlive" (event "_markerEntity.health.evIsAliveChanged") (event "_markerEntity.evAdded"))

		(var worldVisible:bool = "_markerEntity.visibility.visible" (event "_markerEntity.visibility.evChanged"))
		(var diplomacyRelationComponent:gfx = "_markerEntity.diplomacyRelation")
		(var diplomacyRelation:number = "diplomacyRelationComponent.value" (event "diplomacyRelationComponent.evChanged"))

		(var diplomacyRelationSuffix:str = "	diplomacyRelation == SC.Battle.DIPLOMACY_RELATIONS.SELF 	? 'self' :
												diplomacyRelation == SC.Battle.DIPLOMACY_RELATIONS.ALLY 	? 'ally' :
												diplomacyRelation == SC.Battle.DIPLOMACY_RELATIONS.NEUTRAL 	? 'neutral' 
																											: 'enemy'")
		(var visibilityPostfix:str = "!(worldVisible) ? '_invis' : ''")
		
		(var alivePostfix:str = "isAlive ? '_alive' : '_dead'")
		(var isBot:bool = "!_markerEntity || _markerEntity.hasComponent(CC.bot) || (_markerEntity.hasComponent(CC.avatar) && _markerEntity.avatar.isBot)")
		(var botPostfix:str = "diplomacyRelation == SC.Battle.DIPLOMACY_RELATIONS.ENEMY && isBot ? '_bot' : ''")
		(var markerIcon:str = "'symbol:minimap_diplomacy_relation' + (isAlive ? '_' + diplomacyRelationSuffix + botPostfix + alivePostfix + visibilityPostfix
																		: botPostfix + alivePostfix)")
	)

	(block
		(style 
			(bind backgroundImage "markerIcon")
		)
		(bind alpha "worldVisible ? 1 : 0.7")
	)
)
