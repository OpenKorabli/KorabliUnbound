(def element MapCameraMarker (_markerEntity:dhEntity, _isLoading:bool = false)
	(scope
		(var cameraComponent:dhComponent = "_markerEntity.camera")

		(var cameraYaw:number = "cameraComponent.yaw != null ? radToGrad(cameraComponent.yaw) : 0" (event "evEnterFrame"))
		(var cameraFrustumAngle:number = "cameraComponent.frustumAngle != null ? radToGrad(cameraComponent.frustumAngle) : 0" (event "cameraComponent.evFrustumAngleChanged"))

		(var isTacticalCam:bool = 				"cameraComponent.isTactical" 			(event "cameraComponent.evTacticalStateChanged"))
		(var visibilityRangeRadius:number = 	"cameraComponent.visibilityRangePerc" 	(event "cameraComponent.evVisibilityRangeChanged"))
		(var visibilityVectorRadius:number = 	"max(visibilityRangeRadius, 0.5)" 		(event "cameraComponent.evVisibilityRangeChanged"))
	)
	(bind visible "!_isLoading")

	(controller $Animation
		(bindcall play
			duration = 0.15
			to = { alpha: 0 }
			easing = "Easing.cubic_in"
			action = "kill"
			(bind enabled "isTacticalCam")
		)

		(bindcall play
			duration = 0.15
			to = { alpha: 1 }
			easing = "Easing.cubic_out"
			action = "kill"
			(bind enabled "!isTacticalCam")
		)
	)

	(block
		(style
			(position = "absolute")
			(alpha = 0.7)
			(width = 1px)
			(height = 1px)
			(backgroundImage = 'symbol:minimap_frustum_edge_vector')
			(bind rotation "cameraYaw")
		)

		(block
			(style
				(position = "absolute")
				(backgroundImage = 'symbol:minimap_observe_mask')

				(bind scaleX "visibilityVectorRadius * 2")
				(bind scaleY "visibilityVectorRadius * 2")
			)
			(isMask = true)
		)
	)


	(block
		(style
			(alpha = 0.08)
			(bind rotation "cameraYaw - cameraFrustumAngle / 2")
		)

		(block
			(style
				(position = "absolute")
				(backgroundImage = 'symbol:minimap_observe_mask')

				(bind scaleX "visibilityVectorRadius * 2")
				(bind scaleY "visibilityVectorRadius * 2")
			)
			(isMask = true)
		)

		(controller $Sector
			(color = 0x7dffff)
			(offset = -90)
			(radius = 300)
			(bind arc "cameraFrustumAngle")
		)
	)
)