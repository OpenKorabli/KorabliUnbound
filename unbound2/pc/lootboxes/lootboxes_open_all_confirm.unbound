(def element ModalWindowOpenAllLootboxesComfirmation ()
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)
	(scope
		(var lootboxEntity:dhEntity = "getSingleEntity(CC.lootboxInitComponent)")
		(var lootboxStorageComponent:dhComponent = "lootboxEntity.lootboxStorageComponent")
		(var lootboxesInStorage:number = "lootboxStorageComponent.inStorage ?: 0" (event "lootboxStorageComponent.evUpdate"))

		(var lootboxStateEntity:dhEntity = "getSingleEntity(CC.lootboxOpeningState)")
		(var lootboxOpeningState:dhComponent = "lootboxStateEntity.lootboxOpeningState")
		(var minOfLootboxes:number = "min(SC.Common.LOOTBOX_CONSTANTS.MAX_MASS_LOOTBOX_OPEN_AMOUNT, lootboxesInStorage)")
		(var formattedLootboxesCount:str = "formatSeparator(minOfLootboxes, 1, false)")
		(var caption:str = "lootboxesInStorage < SC.Common.LOOTBOX_CONSTANTS.MAX_MASS_LOOTBOX_OPEN_AMOUNT ? 'IDS_OPEN_ALL_LOOTBOXES_CONFIRM' : subst('IDS_SUBST_PL_OPEN_N_CONTAINERS_QUESTION', [], { count: formattedLootboxesCount }, minOfLootboxes)")
	)

	(bindcall externalCall 'sound.playSetSoundDirect' "['window', 'openScreen']" init=false watch=false (event "lootboxOpeningState.evLootboxesOpenStarted"))
	(bindcall externalCall 'inputMapping.onRequest' "['closeConfirmationModal', { }]" (bind trigger "lootboxesInStorage"))

	(name = 'ModalWindowOpenAllLootboxesComfirmation')
	(class $Fullsize)
	(style (align = "center|middle"))

	(block
		(style (width = "DEFAULT_MODAL_WINDOW_WIDTH") (align = "center"))
		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
			(style (width = 100%) (marginBottom = "M"))
			(element ModalWindowShortHeader
				_header = 'IDS_WINDOW_HEADER_CONFIRMATION'
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
			(style (marginBottom = "MS"))
			(tf
				(class $TextDefault26NM)
				(style (alpha = "TA"))
				(bind text "caption")
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 3)
			(style
				(align = "center")
				(width = 100%)
			)

			(element ModalWindowSystemYesNoButtons
				_btnOkName = 'btn_ok'
				_btnOkWidth = 154px
				_btnOkMethods =				"[	{	type: 'inputMapping.onAction',
													name: 'LootboxProxy.openLootboxes',
													args: { }}]"
				_btnNoWidth = 154px
			)
		)
	)
)
