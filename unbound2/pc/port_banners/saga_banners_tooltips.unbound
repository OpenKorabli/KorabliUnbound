(def constant SAGA_BANNERS_TOOLTIP_RENDERERS "{
	'Eteria':	'EteriaBannerTooltip'
}")

(def element EteriaBannerTooltip (_sagaID:str)
	(scope
		(var sagaEntity:dhEntity =				"getPrimaryEntity(CC.saga, _sagaID)")
		(var saga:dhComponent =					"sagaEntity.saga")
		(var areRewardsAvailable:bool =			"saga.rewardsAvailable"		(event "saga.evChanged"))

		(struct sagaTimer = PULL_SAGA_TIMER(_component = "saga"))

		(var unifiedStatus:str =	"sagaTimer.isLastProgressionDay || sagaTimer.isLastRewardsClaimDay && areRewardsAvailable	? SC.Ui_styles.UNIFIED_STATUS.DATE_ATTENTION
								 																								: SC.Ui_styles.UNIFIED_STATUS.DATE")
		(var statusText:str =		"sagaTimer.isFinalStatsTimeReached	? areRewardsAvailable	? subst('IDS_SAGA_TIMER_REWARD_CHOICE_TIME_LEFT', [], { _timeLeft: sagaTimer.countdownRewardsClaimUntil.value }, sagaTimer.countdownRewardsClaimUntil.value)
																								: 'IDS_SAGA_FINISHED'
																		: subst('IDS_SUBST_SAGA_TIMER_TILL_END', [], { _timeLeft: sagaTimer.progressionFinishTime.value })")

		(struct markerData = PULL_MARKER_NEW(_groupName = "SC.Ui_common.CONTENT_MARKER_GROUPS.SAGA_BANNER"))
		(var isRewardMarker:bool = "markerData.markerType == SC.Ui_common.CONTENT_MARKER_TYPE.REWARD")
	)

	(style (width = "BANNER_TOOLTIP_WIDTH"))
	(name = 'EteriaBannerTooltip')

	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)
	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TooltipSystemHeaderSubheaderText
			_headerText = 'IDS_SAGA_MAIN_TITLE_ETERIA'
		)

		(element TooltipSystemHorizontalDivider)

		(block
			(style (width = 100%))

			(controller $Instance renderer='TooltipSystemStatusLine'
				(bind enabled "isRewardMarker")
				(args
					_unifiedStatus =	"SC.Ui_styles.UNIFIED_STATUS.REWARD_AVAILABLE"
					_text =				'IDS_AVAILABLE_REWARD'
				)
			)
		)

		(block
			(style (width = 100%))

			(controller $Instance renderer='TooltipSystemHorizontalDivider'
				(bind enabled "isRewardMarker")
			)
		)

		(element TooltipSystemStatusLine
			_unifiedStatus =	"unifiedStatus"
			_text =				"statusText"
		)

		(element TooltipSystemHorizontalDivider)

		(element TooltipSystemStatusLine
			_unifiedStatus =	"SC.Ui_styles.UNIFIED_STATUS.MOUSE_LEFT"
			_text =				'IDS_SAGA_BANNER_HINT_GO_TO_EVENT'
		)
	)
)