(def constant BP_CONTENT_WIDTH 1116px)
(def constant BP_HEADER_AND_BOTTOM_MIN_HEIGHT 324px)


(def element ModalWindowBattlePurchaseLevels ()
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)
	(macro INPUT_COUNTER_SCOPE_EVENTS)
	(scope
		(var battlePassComponent:dhComponent = "getSingleComponent(CC.battlePass)")

		(struct battlePassPrice = PULL_BATTLEPASS_PRICES(_component="battlePassComponent"))

		(struct battlePassCurrentLevel = PULL_BATTLEPASS_CURRENT_LEVEL())

		(var levelsList:dhCollection = "getCollection(CC.battlePassLevel)")

		(var bpType:number = "battlePassComponent.type" (event "battlePassComponent.evChanged"))
		(var battlePassId:number = "battlePassComponent.id" (event "battlePassComponent.evChanged"))
		(var finishTime:number = "battlePassComponent.finishTime ?: 0" (event "battlePassComponent.evChanged"))

		(var previewRewardsSingleStackId:number = "battlePassComponent.previewRewardsSingleStackId" (event "battlePassComponent.evChanged"))
		(var previewRewardsMultipleStackId:number = "battlePassComponent.previewRewardsMultipleStackId" (event "battlePassComponent.evChanged"))

		(var rewardsSingleStack:dhComponent = "getEntity(previewRewardsSingleStackId).rewardsStack")
		(var rewardsSingle:array = "rewardsSingleStack.rewards ?: []" (event "rewardsSingleStack.evChanged"))
		(var rewardsSingleLen:number = "rewardsSingle.length")

		(var rewardsMultipleStack:dhComponent = "getEntity(previewRewardsMultipleStackId).rewardsStack")
		(var rewardsMultiple:array = "rewardsMultipleStack.rewards ?: []" (event "rewardsMultipleStack.evChanged"))
		(var rewardsMultipleLen:number = "rewardsMultiple.length")

		(var accountResource:dhComponent = "getSingleEntity(CC.accountResource).accountResource")
		(var currentGoldBalance:number = "accountResource.gold ?: 0" (event "accountResource.evChangedGold"))

		(var maxLevel:number = "levelsList.length - battlePassCurrentLevel.level")

		(var levelsToPurchase:number = 1)
		(var isDownBtnEnabled:bool = "toNumber(levelsToPurchase) > 1")
		(var isUpBtnEnabled:bool = "toNumber(levelsToPurchase) < maxLevel")
		(bind levelsToPurchase "levelsToPurchase - 1"			init=false watch=false (event "counterDownBtnClicked"))
		(bind levelsToPurchase "levelsToPurchase + 1"			init=false watch=false (event "counterUpBtnClicked"))
		(bind levelsToPurchase "toNumber($event.value) ?: 1"	init=false watch=false (event "evInputCountChanged"))
		(bind levelsToPurchase "1"								init=false watch=false (event "onTextInputChangeEvent"))

		(var finalPrice:number = "battlePassPrice.levelPrice * toNumber(levelsToPurchase)")
		(var isGoldEnough:bool = "currentGoldBalance >= finalPrice")
		(var deltaGold:number = "finalPrice - currentGoldBalance")

		(var levelsRemaining:number = "levelsList.length - battlePassCurrentLevel.level")
		(var buyGoldRequestParams:dict = "{ url: SC.Ui_windows.GUI_URL.BATTLEPASS_SHOP_IN_GAME,
											params: {	battlepass_type: bpType,
														battlepass_expiration_date: finishTime,
														remaining_level: levelsRemaining,
														total_levels: levelsList.length,
														level_price: battlePassPrice.levelPrice,
														battlepass_price: battlePassPrice.regularPrice,
														battlepass_big_price: battlePassPrice.enhancedPrice}}")

		(struct stageSize = STAGE_SIZE())
		(struct scrollHeight = PULL_BATTLEPASS_REWARDS_SCROLL_HEIGHT(
			_rewardsMultipleLen = "rewardsMultipleLen"
			_rewardsSingleLen = "rewardsSingleLen"
			_stageHeight = "stageSize.height"
		))
	)
	(bindcall externalCall
		"'inputMapping.onAction'"
		"['BattlePassProxyUSS.previewBattlePassLevels', {levelsToPreview: toNumber(levelsToPurchase)}]"
		init=false (bind trigger "battlePassCurrentLevel.level")
	)
	(style (align = "center|middle"))
	(block
		(style
			(width = "BP_CONTENT_WIDTH")
			(align = "center")
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
			(style
				(width = 100%)
				(marginBottom = "{720:SXS, 1080:L}")
			)
			(element ModalWindowShortHeader
				_header = 'IDS_BATTLEPASS_PURCHASE_LEVELS_TITLE'
			)
			(block
				(style
					(position = "absolute")
					(right = 0px)
					(top = "-M")
				)
				(element DockResourcesWidget
					_name = 'goldBalance'
					_currency = "SC.Common.CURRENCIES.GOLD"
					_label = 'IDS_DO_PURCHASE'
					_height = 47
					_methods = "[
						{
							type: 'inputMapping.onAction',
							name: 'navigateTo',
							args: {route: SC.Ui_windows.ROUTE.OVERLAY_BROWSER, data: buyGoldRequestParams}
						}
					]"
				)
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
			(style
				(marginBottom = "{720:M, 1080:L}")
				(align = "middle")
			)
			(hblock
				(tf
					(class $TextDefault18NM)
					(style
						(marginTop = "SXS")
						(marginRight = "SXS")
						(alpha = "TA")
					)
					(text = 'IDS_BATTLEPASS_PURCHASE_LEVELS_TEXT')
				)
				(hblock
					(style
						(width = 88px)
						(height = 40px)
					)
					(element InputCounter
						_isDownBtnEnabled = "isDownBtnEnabled"
						_isUpBtnEnabled = "isUpBtnEnabled"
						_maxNumericValue = "maxLevel ?: 1"
						_inputValue = "levelsToPurchase"
					)
				)
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2.5)
			(style
				(width = 100%)
				(marginBottom = "{720:M, 1080:L}")
			)
			(element HorizontalDividerTwoPx)

			(scrollArea
				(class $Fullsize)
				(style (bind height "scrollHeight.value"))

				(macro DEFAULT_VERTICAL_SCROLL_PARAMS
					_singleStep = "REWARD_DEFAULT_CARD_SIZE"
				)

				(content
					(style
						(width = 100%)
						(paddingTop = "L")
						(paddingBottom = "L")
						(paddingLeft = "LM")
						(paddingRight = "LM")
					)

					(block
						(bind visible "rewardsSingleLen")
						(style (width = 100%))

						(tf
							(class $TextDefault18NM)
							(style
								(marginBottom = "SXS")
								(alpha = "TA")
							)
							(text = 'IDS_BATTLEPASS_PURCHASE_LEVELS_REWARDS_SINGLE')
						)

						(htile
							(style
								(width = 100%)
								(gap = "REWARDS_OFFSET")
							)
							(controller $Repeat renderer='RewardDefaultCard'
								(bind count "rewardsSingleLen")
								(args
									_rewardEntityId = "rewardsSingle[$index]"
								)
							)
						)
					)

					(block
						(bind visible "rewardsMultipleLen")
						(style
							(width = 100%)
							(marginTop = "L")
						)

						(tf
							(class $TextDefault18NM)
							(style
								(marginBottom = "SXS")
								(alpha = "TA")
							)
							(bind text "bpType == SC.Common.BATTLEPASS_TYPES.PAID_ENHANCED	? 'IDS_BATTLEPASS_PURCHASE_LEVELS_REWARDS_MULTIPLE_ALL'
																							: 'IDS_BATTLEPASS_PURCHASE_LEVELS_REWARDS_MULTIPLE_CHOICE'")
						)

						(htile
							(style
								(width = 100%)
								(gap = "REWARDS_OFFSET")
							)
							(controller $Repeat renderer='RewardDefaultCard'
								(bind count "rewardsMultipleLen")
								(args
									_rewardEntityId = "rewardsMultiple[$index]"
								)
							)
						)
					)
				)
			)
			(element HorizontalDividerTwoPx)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 4)
			(style (marginBottom = "MS"))
			(element ModalWindowSystemPurchaseItemPriceAndInfo
				_priceInfo = "{ finalPrice: finalPrice, currency: SC.Common.CURRENCIES.GOLD }"
				_questionString = 'IDS_QUESTION_DO_PURCHASE_FOR'
				_isDeficit = "!isGoldEnough"
				_deficit = "deltaGold"
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 4.5)
			(style (marginBottom = "{720:SXS, 1080:MS}"))
			(element ModalWindowSystemPurchaseItemYesNoCloseButtons
				_isDeficit = "!isGoldEnough"
				_okMethods = "[
					{
						type: 'inputMapping.onAction',
						name: 'BattlePassProxyUSS.buyBattlePassLevels',
						args:	{
									battlePassId: battlePassId,
									amount: levelsToPurchase
								}
					}
				]"
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 5)
			(tf
				(class $TextDefaultNM)
				(style (alpha = "TA"))
				(text = 'IDS_BATTLEPASS_PURCHASE_LEVELS_INFO')
			)
		)
	)
)
