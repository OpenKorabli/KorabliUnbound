(def element ModalWindowBattlePassLevelUp (_battlePassTypeName:str = '')
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)
	(scope
		(event evStartHideDelayed)
		(var bpType:number = "BATTLEPASS_TYPES_PURCHASE[_battlePassTypeName].type")
		(var isBattlePassPaidRegular:bool = "bpType == SC.Common.BATTLEPASS_TYPES.PAID_REGULAR")
		(var bpTypeImage:str = "'url:../sse/battlepass/types/big/' + toLower(SC.Common.BATTLEPASS_TYPES.VALUE_TO_NAME[bpType]) + '.png'")
		(var bpTitle:str = "'IDS_BATTLEPASS_TYPE_' + _battlePassTypeName")
		(var battlePassSoundEffect:str = "isBattlePassPaidRegular ? 'battlepass_upgrade' : 'battlepass_upgrade_bonus'")
	)
	(name = 'ModalWindowBattlePassLevelUp')

	(bindcall externalCall 'sound.playSetSoundDirect' "[battlePassSoundEffect, 'start']" init=false watch=false on='addedToStage')
	(bindcall externalCall 'inputMapping.onRequest' "['closeSimpleAnimatedModal', { }]" (event "evStartHideDelayed"))

	(element SimpleAnimatedContent
		_colorTransform = "CT_BP_PAID_SMOKE"
		_bgImage = "bpTypeImage"
		_title = "bpTitle"
		_status = 'IDS_BATTLEPASS_PURCHASE_STATUS'
	)
)

(def element SimpleAnimatedContent (	_colorTransform:dict = {},
										_bgImage:str = '',
										_title:str = '',
										_status:str = '')
	(macro DEFAULT_MODAL_WINDOW_SCOPE_EVENTS)
	(dispatch evStartHideDelayed dir="EventDirection.UP" delay=2 (event "startShow"))

	(class $Fullsize)
	(style
		(align = "center|middle")
		(flow = "horizontal")
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)

		(block
			(style
				(position = "absolute")
				(width = 400px)
				(height = 400px)
				(left = -90px)
				(top = -90px)
				(backgroundSize = "fill")
				(backgroundImage = 'url:../animations/spine/battlepass/bp_icon_smoke/bp_icon_smoke.skel')
			)
			(bind colorTransform "_colorTransform")
			(controller $Spine)
		)

		(block
			(style
				(width = 200px)
				(height = 200px)
				(marginRight = "MS")
				(backgroundSize = "cover")
				(bind backgroundImage "_bgImage")
			)
		)
	)

	(block
		(style (marginLeft = "L"))

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2.5)
			(tf
				(class $TextDefaultBold30NM)
				(style
					(marginBottom = "MS")
					(alpha = "TA")
				)
				(bind text "_title")
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 4)
			(element StatusLine
				_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.CHECK"
				_text = "_status"
			)
		)
	)
)