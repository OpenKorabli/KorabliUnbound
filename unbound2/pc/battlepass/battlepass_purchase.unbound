(def constant CT_BP_FREE_SMOKE	"{
	redMultiplier: 0,
	greenMultiplier: 0,
	blueMultiplier: 0,
	redOffset: 77.1,
	greenOffset: 179.1,
	blueOffset: 255
}")

(def constant CT_BP_PAID_SMOKE	"{
	redMultiplier: 0,
	greenMultiplier: 0,
	blueMultiplier: 0,
	redOffset: 77.1,
	greenOffset: 179.1,
	blueOffset: 255
}")

(def element ModalWindowBattlePassPurchase ()
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)
	(scope
		(var battlePassComponent:dhComponent = "getSingleComponent(CC.battlePass)")
		(var finishTime:number = "battlePassComponent.finishTime" (event "battlePassComponent.evChanged"))
		(struct battlePassPrice = PULL_BATTLEPASS_PRICES(_component="battlePassComponent"))
		(struct battlePassType = PULL_BATTLEPASS_TYPE(_component = "battlePassComponent"))

		(var battlePassBasicInfo:dict = "{
			SC.Common.BATTLEPASS_TYPES.FREE: {
				paragraphsCount: 2
			},
			SC.Common.BATTLEPASS_TYPES.PAID_REGULAR: {
				paragraphsCount: 3,
				price: battlePassPrice.regularPrice
			},
			SC.Common.BATTLEPASS_TYPES.PAID_ENHANCED: {
				paragraphsCount: 1,
				price: battlePassType.isBonuses	? battlePassPrice.enhancedPrice - battlePassPrice.regularPrice
												: battlePassPrice.enhancedPrice
			}
		}")

		
		(var levelsList:dhCollection = "getCollection(CC.battlePassLevel)")

		(struct battlePassCurrentLevel = PULL_BATTLEPASS_CURRENT_LEVEL())
		(var levelsRemaining:number = "levelsList.length - battlePassCurrentLevel.level")

		(var buyGoldRequestParams:dict = "{ url: SC.Ui_windows.GUI_URL.BATTLEPASS_SHOP_IN_GAME,
											battlepass_type: battlePassType.type,
											battlepass_expiration_date: finishTime,
											remaining_level: levelsRemaining,
											total_levels: levelsList.length,
											level_price: battlePassPrice.levelPrice,
											battlepass_price: battlePassPrice.regularPrice,
											battlepass_big_price: battlePassPrice.enhancedPrice}")
		(var isLargeDimension:bool = "stageWidth > 1400 && stageHeight > 900")
	)
	(name = 'ModalWindowBattlePassPurchase')
	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
		(style (width = 100%))

		(element ModalWindowHeaderFullSize
			_windowName = 'IDS_BATTLEPASS_PURCHASE_TITLE'
			_backButtonText = 'IDS_RETURN_FROM_MODAL_WINDOW_BUTTON'
			_paddingRight = "LM"
			_paddingLeft = "LM"
			_methods = "[	{	type: 'inputMapping.onRequest',
								name: 'closeBattlePassPurchaseModal',
								args: {}}]"
		)
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
		(style
			(position = "absolute")
			(right = "XXL")
			(top = "{ 720:0, 1080:34 }")
		)

		(element DockResourcesWidget
			_name = 'battlePassGoldBalance'
			_currency = "SC.Common.CURRENCIES.GOLD"
			_label = 'IDS_DO_PURCHASE'
			_height = 47
			_methods = "[
				{
					type: 'inputMapping.onAction',
					name: 'navigateTo',
					args: {route: SC.Ui_windows.ROUTE.OVERLAY_BROWSER, data: buyGoldRequestParams}
				}
			]"
		)
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
		(style
			(width = 100%)
			(height = 48px)
			(align = "center|middle")
		)

		(controller $Instance renderer = 'StatusLine'
			(bind enabled "battlePassType.isFree")
			(args
				_text = 'IDS_BATTLEPASS_PURCHASE_SUBTITLE'
			)
		)
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 2.5)
		(style (width = 100%))
		(controller $Instance renderer = 'HorizontalDividerTwoPx'
			(bind enabled "battlePassType.isFree")
		)
	)

	(hblock
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 3)
		(style
			(align = "center")
			(width = 100%)
			(hgap = "{1280:MS, 1920:LS}")
			(marginBottom = "{720:M, 1080:XL}")
			(bind marginTop "isLargeDimension ? XLL : LM")
		)

		(controller $Repeat renderer='BattlePassTypeCard'
			(bind count "SC.Common.BATTLEPASS_TYPES.ALL.length")
			(args
				_bpStaticInfo = "battlePassBasicInfo"
			)
		)
	)

	(hblock
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 4)
		(style
			(width = 100%)
			(marginBottom = "{ 720:M, 1080:XL }")
			(align = "center")
			(hgap = "XLM")
		)

		(element BattlePassPurchaseButton
			_text = 'IDS_BATTLEPASS_PURCHASE_GOLD_TEXT'
			_label = 'IDS_GOLD'
			_name = 'battlepass_buy_gold_button'
			_methods = "[
				{
					type: 'inputMapping.onAction',
					name: 'navigateTo',
					args: {
							route: SC.Ui_windows.ROUTE.OVERLAY_BROWSER,
							data: buyGoldRequestParams
					}
				}
			]"
		)


		(element BattlePassPurchaseButton
			_text = 'IDS_BATTLEPASS_PURCHASE_RUB_TEXT'
			_label = 'IDS_BATTLEPASS_PURCHASE_BUTTON_RUB'
			_name = 'battlepass_buy_for_rub_button'
			_focusIndex = 2
			_methods = "[
				{
					type: 'inputMapping.onAction',
					name: 'navigateTo',
					args: {
							route: SC.Ui_windows.ROUTE.OVERLAY_BROWSER,
							data: { url: SC.Ui_windows.GUI_URL.BATTLEPASS_BUY_FOR_RUBLES}
					}
				}
			]"
		)
	)
)

(def element BattlePassTypeCard (_bpStaticInfo:dict = {})
	(scope
		(struct stageSize = STAGE_SIZE())
		(struct mouseHandler = MOUSE_HANDLER())

		(var battlePassEntity:dhEntity = "getSingleEntity(CC.battlePass)")
		(struct battlePassType = PULL_BATTLEPASS_TYPE(_component = "battlePassEntity.battlePass"))

		(var bpTypeUi:str = "SC.Common.BATTLEPASS_TYPES.VALUE_TO_NAME[$index]")
		(var battlePassTypeName:str = "battlePassType.isPaidRegular ? 'BONUSES' : bpTypeUi")
		(var isCardPaidBig:bool = "$index == SC.Common.BATTLEPASS_TYPES.PAID_ENHANCED")
		(var isBattlePassBonuses:bool = "isCardPaidBig && !battlePassType.isFree")
		(var isCostBlockVisible:bool = "$index > battlePassType.type")

		(var battlePassTitle:str = "isBattlePassBonuses ? 'BONUSES' : bpTypeUi")

		(var accountResourceComponent:dhComponent = "getSingleComponent(CC.accountResource)")
		(var currentGoldBalance:number = "accountResourceComponent.gold" (event "accountResourceComponent.evChangedGold"))
		(var isGoldEnough:bool = "currentGoldBalance >= _bpStaticInfo[$index].price")

		(var isLargeDimension:bool =	"stageSize.width > 1400 && stageSize.height > 900")
		(var bpImageSize:number =		"isLargeDimension ? 256 : 185")
		(var bpImageMargin:number =		"isLargeDimension ? -77 : -LM")
		(var bpIconSmokeSize:number =	"isLargeDimension ? 450 : 300")
		(var bpIconSmokeMargin:number =	"isLargeDimension ? -160 : -XLM")

		(var bpTypeImage:str = "'url:../sse/battlepass/types/big/' + toLower(bpTypeUi) + '.png'")
	)
	(bind name "'BattlePassTypeCard' + $index")

	(macro STRUCT_MOUSE_DISPATCHER
		_mouseHandler = "mouseHandler"
	)

	(style
		(width = {1280:380px, 1920:480px})
		(height = {720:510px, 1080:692px})
		(align = "center")
		(backgroundColor = 0x03FFFFFF)
		(alpha = 0)
	)

	(controller $Animation
		(bindcall play
			delay		= "0.3 + 0.1*$index"
			duration	= 0.15
			from		= "{ alpha: 0, top: 10 }"
			to			= "{ alpha: 1, top: 0 }"
			on = 'addedToStage'
		)
	)

	(block
		(class $FullsizeAbsolute)
		(style
			(backgroundImage = 'url:../service_kit/frames/one_pixel_frame.png')
			(scale9grid = 2)
			(alpha = 0.1)
		)
	)

	(block
		(style
			(hitTest = false)
			(position = "absolute")
			(bottom = 0px)
			(width = 100%)
			(height = 510px)
			(backgroundSize = "fill")
			(backgroundImage = 'url:../animations/spine/battlepass/bp_card_smoke/bp_card_smoke.skel')
		)
		(alpha = 0)

		(controller $Spine)

		(controller $Animation
			(bindcall play
				duration = 0.15
				from = "{ alpha: 0 }"
				to = "{ alpha: 1 }"
				reverse = "!mouseHandler.rollOver"
				(bind trigger "mouseHandler.rollOver")
			)
		)
	)

	(block
		(class $MiddleAlignedAbsolutely)
		(style
			(hitTest = false)
			(backgroundSize = "fill")
			(backgroundImage = 'url:../animations/spine/battlepass/bp_icon_smoke/bp_icon_smoke.skel')
			(bind width "bpIconSmokeSize")
			(bind height "bpIconSmokeSize")
			(bind marginTop "bpIconSmokeMargin")
		)
		(alpha = 0)

		(controller $Spine)

		(controller $Animation
			(bindcall play
				duration = 0.15
				from = "{ alpha: 0 }"
				to = "{ alpha: 1 }"
				reverse = "!mouseHandler.rollOver"
				(bind trigger "mouseHandler.rollOver")
			)
		)
	)

	(block
		(style
			(marginBottom = "MS")
			(backgroundSize = "cover")
			(bind width "bpImageSize")
			(bind height "bpImageSize")
			(bind marginTop "bpImageMargin")
			(bind backgroundImage "bpTypeImage")
		)
	)

	(block
		(class $Fullsize)
		(style
			(paddingBottom = "{720:SXS, 1080:LM}")
			(align = "center")
		)

		(tf
			(class $TextDefaultBold20NM)
			(style
				(marginBottom = "{ 720:SXS, 1080:MS }")
				(textAlign = "center")
				(alpha = "TA")
			)
			(bind text "toUpper(tr('IDS_BATTLEPASS_PURCHASE_TYPE_' +  battlePassTitle))")
		)

		(block
			(style
				(width = 100%)
				(paddingLeft = "{1280:L, 1920: LS}")
				(paddingRight = "{1280:L, 1920: LS}")
			)
			(element HorizontalDividerTwoPx)
		)

		(scrollArea
			(class $Fullsize)
			(style
				(paddingLeft = "{1280:L, 1920: LS}")
				(paddingRight = "{1280:20px, 1920:28px}")
			)
			(macro DEFAULT_VERTICAL_SCROLL_PARAMS
				_scrollAreaShadowTop = "'BattlePassScrollAreaShadowTop'"
				_scrollAreaShadowBottom = "'BattlePassScrollAreaShadowBottom'"
			)

			(content
				(style
					(width = 100%)
					(paddingRight = "SXS")
					(paddingTop = "{ 720:SXS, 1080:MS }")
				)
				(block
					(style
						(width = 100%)
						(vgap =  "SXS")
					)
					(controller $Repeat renderer='BattlePassCardDescription'
						(bind count "_bpStaticInfo[$index].paragraphsCount")
						(args
							_type = "bpTypeUi"
						)
					)
				)

				(block
					(style
						(width = 100%)
						(bind marginTop "isCardPaidBig ? SXS : 0px")
					)
					(controller $Instance renderer='BattlePassBonusesList'
						(bind enabled "isCardPaidBig")
					)
				)
			)
		)

		(block
			(style
				(bind marginTop "!isCostBlockVisible ? M : 0")
				(bind marginBottom "!isCostBlockVisible ? SXS : 0px")
			)
			(controller $Instance renderer='StatusLine'
				(bind enabled "!isCostBlockVisible")
				(args
					_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.CHECK"
					_text = 'IDS_BATTLEPASS_PURCHASE_STATUS'
				)
			)
		)

		(block
			(style
				(bind marginTop "isCostBlockVisible ? M : 0px")
				(bind marginBottom "isCostBlockVisible ? M : 0px")
			)
			(controller $Instance renderer='PriceTagWithLabel'
				(bind enabled "isCostBlockVisible")
				(args
					_label = 'IDS_COST_COLON'
					_labelAlpha = "TC"
					_priceInfo = "{
						finalPrice: _bpStaticInfo[$index].price,
						currency: SC.Common.CURRENCIES.GOLD
					}"
				)
			)
		)


		(block
			(controller $Instance renderer = 'DefaultButton'
				(bind enabled "isCostBlockVisible")
				(args
					_isTransactionBtn = true
					_name = "toLower('purchase_btn_' + battlePassTitle)"
					_width = 166px
					_enabled = "isGoldEnough"
					_defaultFocused = "isCardPaidBig"
					_focusIndex = 0
					_label = 'IDS_BATTLEPASS_PURCHASE_BUTTON_GOLD'
					_methods = "[
						{
							type: 'inputMapping.onRequest',
							name: 'showBattlePassPurchaseConfirm',
							args: { _battlePassTypeName: battlePassTypeName, _battlePassType: $index }
						}
					]"
				)
			)
		)
	)
)

(def element BattlePassCardDescription (_type:str = '')
	(style (width = 100%))
	(tf
		(class $TextDefaultNM)
		(style
			(width = 100%)
			(alpha = "TA")
		)
		(bind text "'IDS_BATTLEPASS_PURCHASE_' + _type + '_TEXT_' + ($index+1)")
	)
)

(def element BattlePassBonusesList ()
	(scope
		(var battlePassBonusesCollection:dhCollection = "getCollection(CC.battlePassBonus)")
		(var bpBonusesPositive:dhCollection = "battlePassBonusesCollection.getChildByPath('byCategory.' + SC.Common.BATTLEPASS_BONUSES_CATEGORIES.POSITIVE + '.sorted')")
		(var bpBonusesRewards:dhCollection = "battlePassBonusesCollection.getChildByPath('byCategory.' + SC.Common.BATTLEPASS_BONUSES_CATEGORIES.PAID_SSE_REWARDS + '.sorted')")
		(var bpBoundRewards:dhCollection = "battlePassBonusesCollection.getChildByPath('byCategory.' + SC.Common.BATTLEPASS_BONUSES_CATEGORIES.BOUND_REWARDS + '.sorted')")

		(var bpBonusesRewardsLen:number = "bpBonusesRewards.length ?: 0")
		(var bpBoundRewardsLen:number = "bpBoundRewards.length ?: 0")

		(var bpBonusesConvertRate:dhCollection = "getCollectionByPath(CC.battlePassBonus, 'byCategory.' + SC.Common.BATTLEPASS_BONUSES_CATEGORIES.GOLD_CONVERT_RATE + '.sorted')")
		(var finalPrice:number = "bpBonusesConvertRate.length ? toNumber(bpBonusesConvertRate[0].battlePassBonus.description.measuredValue) : 0")

		(var battlePass:dhComponent = "getSingleComponent(CC.battlePass)")
		(var hasMultiRewards:bool = "battlePass.hasMultiRewards" (event "battlePass.evChanged"))
	)

	(style (width = 100%))

	(block
		(style
			(width = 100%)
			(paddingRight = "XS")
		)

		(controller $Repeat renderer='ParamsModifierItem'
			(bind count "bpBonusesPositive.length")
			(args
				_category = "AttributeModifiersCategory.POSITIVE"
				_dataItem = "bpBonusesPositive.getEntityAtIndex($index).battlePassBonus.description"
			)
		)
	)

	(block
		(style
			(width = 100%)
			(bind marginBottom "bpBoundRewardsLen ? M : 0")
		)

		(controller $Repeat renderer='BpBonusesRewards'
			(bind count "bpBoundRewardsLen")
			(args
				_reward = "bpBoundRewards.getEntityAtIndex(0).rewardComponent"
			)
		)
	)

	(block
		(style
			(width = 100%)
			(bind marginBottom "bpBonusesConvertRate.length ? 22px : 0")
		)

		(controller $Instance renderer='ConvertRate'
			(bind enabled "bpBonusesConvertRate.length")
			(args
				_width = 100%
				_priceInfoLeft = "{finalPrice: 1, currency: SC.Common.CURRENCIES.GOLD}"
				_priceInfoRight = "{finalPrice: finalPrice, currency: SC.Common.CURRENCIES.CREDITS}"
			)
		)
	)

	(block
		(style (bind marginBottom "hasMultiRewards ? M : 0px"))
		(controller $Instance renderer='BpBonusesMultipleRewards'
			(bind enabled "hasMultiRewards")
		)
	)

	(tf
		(bind visible "bpBonusesRewardsLen")
		(class $TextDefaultBoldNM)
		(style
			(width = 100%)
			(marginBottom = "M")
			(alpha = "TC")
		)
		(text = 'IDS_BATTLEPASS_PURCHASE_PAID_ENHANCED_BONUS_REWARDS')
	)

	(block
		(style
			(width = 100%)
			(bind marginBottom "bpBonusesRewardsLen ? XS : 0px")
			(bind vgap "bpBonusesRewardsLen ? SXS : 0px")
		)

		(controller $Repeat renderer='BpBonusesRewards'
			(bind count "bpBonusesRewardsLen")
			(args
				_reward = "bpBonusesRewards.getEntityAtIndex($index).rewardComponent"
			)
		)
	)
)

(def element BpBonusesRewards (_reward:dhComponent)
	(scope
		(var currency:str = "_reward.subtype == 'clanResource'	?	SC.Common.CURRENCIES.CLAN_RESOURCE
																:	_reward.subtype")
	)
	(style (width = 100%))

	(element PriceTagWithLabel
		_width = 100%
		_label = "'IDS_REWARD_' + _reward.subtype + '_TITLE'"
		_priceInfo = "{ finalPrice: _reward.amount ?: 0, currency: currency}"
	)
)

(def element BpBonusesMultipleRewards ()
	(style
		(flow = "horizontal")
		(backgroundColor = "NO_COLOR")
	)

	(tf
		(class $TextDefaultBoldNM)
		(style (alpha = "TC"))
		(text = 'IDS_BATTLEPASS_PURCHASE_PAID_ENHANCED_BONUS_MULTIPLE_REWARDS')
	)

	(block
		(style
			(width = 22px)
			(height = 22px)
			(marginTop = "-XS")
			(marginLeft = "XS")
			(backgroundImage = 'url:../service_kit/buttons/info_tab_new.png')
		)
	)

	(controller $Tooltip
		(renderer ='SimpleStatusTooltip')
		(args
			_text = 'IDS_BATTLEPASS_PURCHASE_PAID_ENHANCED_BONUS_MULTIPLE_REWARDS_TOOLTIP'
			_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.INFO"
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR)
	)
)

(def element BattlePassScrollAreaShadowTop ()
	(scope
		(struct shadowData = SCROLL_SHADOW_ALPHA_INFO())
	)
	(style
		(hitTest = false)
		(width = 100%)
		(height = 7px)
	)
	(alpha = "shadowData.alpha")

	(macro DEFAULT_CONTROL_STATE_ANIMATION_ALPHA
		_trigger = "shadowData.alpha"
		_alpha = "shadowData.alpha"
	)

	(element ScrollAreaHorizontalShadow
		_isReverse = true
	)
)

(def element BattlePassScrollAreaShadowBottom ()
	(scope
		(struct shadowData = SCROLL_SHADOW_ALPHA_INFO())
	)
	(style
		(hitTest = false)
		(width = 100%)
		(height = 7px)
	)
	(alpha = "shadowData.alpha")

	(macro DEFAULT_CONTROL_STATE_ANIMATION_ALPHA
		_trigger = "shadowData.alpha"
		_alpha = "shadowData.alpha"
	)

	(element ScrollAreaHorizontalShadow)
)

(def element BattlePassPurchaseButton (	_text:str = '',
										_label:str = '',
										_name:str = '',
										_focusIndex:number = 1,
										_methods:array = [])
	(style (flow = "horizontal"))
	(tf
		(class $TextDefaultNM)
		(style
			(marginRight = "L")
			(alpha = "TC")
		)
		(bind text "_text")
	)

	(element DefaultButton
		_width = 180px
		_isTransactionBtn = true
		_type = "SC.Ui_styles.BUTTON_TYPE.ACCENT"
		_focusIndex = "_focusIndex"
		_name = "_name"
		_label = "_label"
		_methods = "_methods"
	)
)