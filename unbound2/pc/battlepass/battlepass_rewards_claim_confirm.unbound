(def element ModalWindowBattlePassRewardsClaimConfirmation ()
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)
	(scope
		(var battlePassComponent:dhComponent = "getSingleComponent(CC.battlePass)")
		(var bpId:number = "battlePassComponent.id" (event "battlePassComponent.evChanged"))
	)
	(style (align = "center|middle"))

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
		(style
			(position = "absolute")
			(right = 21px)
			(top = 15px)
		)
		(element ModalWindowCloseIcon)
	)

	(block
		(style (width = 376px))
		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
			(style
				(width = 100%)
				(marginBottom = "L")
			)
			(element ModalWindowShortHeader
				_header = 'IDS_CONFIRMATION'
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
			(style
				(width = 100%)
				(marginBottom = "M")
			)
			(tf
				(class $TextDefaultNM)
				(style
					(width = 100%)
					(alpha = "TA")
				)
				(text = 'IDS_BATTLEPASS_REWARDS_CLAIM_TEXT')
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2.5)
			(style
				(width = 100%)
				(marginBottom = "L")
				(borderRadius = "XS")
			)

			(block
				(class $FullsizeAbsolute)
				(style
					(backgroundColor = "SC.Ui_styles.SERVICE_COLORS.DARK_BLUE")
					(borderRadius = "XS")
					(alpha = 0.25)
				)
			)

			(block
				(style
					(width = 100%)
					(padding = "M")
				)
				(element StatusLine
					_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.INFO"
					_text = 'IDS_BATTLEPASS_REWARDS_CLAIM_STATUS'
					_width = 100%
				)
			)
		)

		(hblock
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 3)
			(style (gap = "M"))

			(element ModalWindowSystemYesNoButtons
				_btnOkName = 'btn_ok'
				_btnOkLabel = 'IDS_BATTLEPASS_REWARDS_CLAIM_AUTOMATIC'
				_btnNoLabel = 'IDS_BATTLEPASS_REWARDS_CLAIM_MANUAL'
				_btnOkWidth = 180px
				_btnNoWidth = 180px
				_btnOkMethods = "[
					{
						type: 'inputMapping.onAction',
						name: 'BattlePassProxyUSS.claimRewards',
						args: { battlePassId: bpId, isAuto: true }
					}
				]"
				_btnNoMethods = "[
					{
						type: 'inputMapping.onAction',
						name: 'BattlePassProxyUSS.claimRewards',
						args: { battlePassId: bpId, isAuto: false }
					}
				]"
			)
		)
	)

	(hblock
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 4)

		(class $MiddleAlignedAbsolutely)
		(style (bottom = "LM"))

		(element PurchaseBonusesButton
			_name = 'btn_purchase_bonuses_from_multiple_rewards_claim_confirm'
		)
	)
)

(def element PurchaseBonusesButton (_name:str = '')
	(style (flow = "horizontal"))
	(tf
		(class $TextDefaultNM)
		(style
			(width = 300px)
			(marginTop = "S")
			(marginRight = "MS")
			(alpha = "TA")
		)
		(text = 'IDS_BATTLEPASS_REWARDS_CLAIM_BUY_BONUSES_TEXT')
	)

	(element DefaultButton
		_width = 220px
		_name = "_name"
		_size = "SIZE.LARGE"
		_label = 'IDS_BATTLEPASS_PURCHASE_BUTTON_BONUSES'
		_type = "SC.Ui_styles.BUTTON_TYPE.SECONDARY"
		_focusIndex = 1
		_methods = "[
			{
				type: 'inputMapping.onRequest',
				name: 'purchaseBattlePass',
				args: { }
			}
		]"
	)
)
