(def element ModalWindowBattlePassMultipleRewardChoice (_battlePassRewardEntityId:number)
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)
	(scope
		(var battlePassComponent:dhComponent = "getSingleComponent(CC.battlePass)")
		(var bpId:number = "battlePassComponent.id" (event "battlePassComponent.evChanged"))
		(var claimRewardsStackId:number = "battlePassComponent.previewRewardsStack" (event "battlePassComponent.evChanged"))

		(var battlePassReward:dhComponent = "getEntity(_battlePassRewardEntityId).battlePassReward")
		(var rewardEntity:dhEntity = "getEntity(battlePassReward.rewardId)")
	)
	(style (align = "center|middle"))

	(block
		(class $EyeLevelAligned)
		(style
			(width = 384px)
			(align = "center")
		)
		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
			(style (width = 100%))
			(element ModalWindowShortHeader
				_header = 'IDS_BATTLEPASS_REWARDS_CHOICE_CONFIRM_HEADER'
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
			(style (marginBottom = "L"))
			(element RewardBigCard
				_rewardEntityId = "rewardEntity.id"
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 3)
			(element ModalWindowSystemYesNoButtons
				_btnOkName = 'btn_ok'
				_btnOkLabel = 'IDS_TAKE_REWARD'
				_btnNoLabel = 'IDS_CANCEL_ACTION'
				_btnOkWidth = 180px
				_btnNoWidth = 180px
				_btnOkMethods ="[
					{
						type: 'inputMapping.onAction',
						name: 'BattlePassProxyUSS.claimReward',
						args: {
								battlePassId: bpId,
								battlePassRewardEntityId: _battlePassRewardEntityId
						}
					},
					{
						type: 'inputMapping.onRequest',
						name: 'openRewardsModalWithoutAnimation',
						args: {	rewardsEntityId: claimRewardsStackId }
					}
				]"
			)
		)
	)

	(hblock
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 4)

		(class $MiddleAlignedAbsolutely)
		(style (bottom = "LM"))

		(element PurchaseBonusesButton
			_name = 'btn_purchase_bonuses_from_confirm_chosen_multiple_reward_mw'
		)
	)
)