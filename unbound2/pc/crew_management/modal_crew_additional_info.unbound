(def element ModalWindowCrewAdditionalInfo (_crewId: number)
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)

	(scope
		(struct crew = PULL_CREW(_crewId = "_crewId"))
	)

	(style (align = "middle|center"))

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
		(style (width = 100%))
		(element ModalWindowHeaderFullSize
			_windowName =		'IDS_MODAL_WINDOW_CREW_ADDITIONAL_INFO'
			_paddingRight =		"M"
			_paddingLeft =		"M"
		)
	)

	(hblock
		(style
			(align =  "middle|center")
			(height = 100%)
		)
		
		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)

			(element CrewPortraitWithBGR
				_baseUrl = "crew.component.baseUrlHighRes"
				_backgroundUrl = "crew.component.backgroundUrlHighRes"
				_portraitWidth = 590px
				_portraitHeight = 480px
				_hasFrame = false
				_hasBottomGradien = false
			)
		)
		

		
		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)

			(scrollArea
				(style
					(width =	400px)
					(height =	500px)
				)
				(macro DEFAULT_VERTICAL_SCROLL_PARAMS
					_isContrastScrollBar = "true"
				)
				(content
					(class $Fullsize)
					(style (paddingRight = "M"))

					(tf
						(class $TextDefaultBold24NM)
						(style
							(marginBottom = "MS")
							
							(marginTop = "XS")
						)
						(bind text "'IDS_' + crew.component.name")
					)

					(tf
						(class $TextDefault18NM)
						(style
							(width =		100%)
							(alpha =		"TC")
							(multiline =	true)
							(leading =		-1)
							(styleSheet =	'.p_spacing { font-size: 18px; }')
							(marginBottom = "XS")
						)
						(bind htmlText "'IDS_' + crew.component.name + '_DESC'")
					)
				)
			)
			
		)
	)
)
