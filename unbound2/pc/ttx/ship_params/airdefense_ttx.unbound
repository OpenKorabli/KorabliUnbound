(def element AirDefenseTTX (_shipTTX:dhStruct)
	(scope
		(var guns:array = "_shipTTX.airDefense.guns")
		(var bubble:dhStruct = "_shipTTX.airDefense.bubble")
		(var prioritySector:dhStruct = "_shipTTX.airDefense.prioritySector")
	)
	(style (width = 100%))
	(class $TTXSecondaryPanel)

	(element TTX_REPEAT
		_elementName='AirDefenseGunTTX'
		_shipTTX="_shipTTX"
		_array="guns"
	)

	(element TTX_INSTANCE
		_elementName='AirDefenseConstDamageTTX'
		_shipTTX="_shipTTX"
		_value="_shipTTX.airDefense"
	)
	(element TTX_INSTANCE
		_elementName='AirDefenseBubblesTTX'
		_shipTTX="_shipTTX"
		_value="bubble"
	)
	(element TTX_INSTANCE
		_elementName='AirDefensePrioritySectorTTX'
		_shipTTX="_shipTTX"
		_value="prioritySector"
	)

	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_AA_COVERAGE_MID'
		_value = "_shipTTX.airDefense.averageAura.maxDist"
		_valueConfig = "VALUE_CONFIG.KILOMETER"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_AA_COVERAGE_MID'
				_descriptionText = 'IDS_TOOLTIP_AA_MAX_DIST'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
)

(def element AirDefenseGunTTX (_shipTTX:dhStruct, _airDefenseGunTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterGunConfiguration
		_title = 'IDS_SHIP_PARAM_AA'
		_gunTTX = "_airDefenseGunTTX"
		_onNewLine = false

		(controller $Tooltip
			(renderer = 'AirDefenseGunTooltipTTX')
			(args
				_shipTTX = "_shipTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)

		(element ShipParamExcursionButton
			_shipTTX = "_shipTTX"
			_excursionId = "['_AirDefence', $index]"
			_isExcursionOn = "false"
		)
	)
)

(def element AirDefenseGunTooltipTTX (_shipTTX:dhStruct)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW
			_title='IDS_SHIP_PARAM_AA'
			_descr='IDS_TOOLTIP_AA_GUN'
		)
		(element TooltipSystemExcursionMouseInstruction
			_shipTTX = "_shipTTX"
		)
	)
)


(def element AirDefenseConstDamageTTX (_shipTTX:dhStruct, _airDefenseTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_AA_AVERAGE_CONST_DAMAGE'
		_value = "_airDefenseTTX.averageAura.damage"

		(controller $Tooltip
			(renderer = 'AirDefenseConstDamageTooltipTTX')
			(args
				_shipTTX = "_shipTTX"
				_airDefenseTTX = "_airDefenseTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)
	)
)

(def element AirDefenseConstDamageTooltipTTX (_shipTTX:dhStruct, _airDefenseTTX:dhStruct)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW
			_title = 'IDS_SHIP_PARAM_AA_AVERAGE_CONST_DAMAGE'
			_descr = 'IDS_TOOLTIP_AA_AVERAGE_CONST_DAMAGE'
		)

		(element TooltipSystemHorizontalDivider)

		(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
			(element TOOLTIP_SYSTEM_PARAMS_BLOCK
				(element TTX_REPEAT
					_elementName='AirDefenseAuraTTX'
					_shipTTX="_shipTTX"
					_array="_airDefenseTTX.auras"
				)
			)
		)
	)
)

(def element AirDefenseAuraTTX (_shipTTX:dhStruct, _airDefenseAuraTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = "'IDS_SHIP_PARAM_AA_AVERAGE_DAMAGE_' + toUpper(_airDefenseAuraTTX.type)"
		_value = "_airDefenseAuraTTX.damage"
	)
	(element ShipParameterPercent
		_title = "'IDS_SHIP_PARAM_AA_' + toUpper(_airDefenseAuraTTX.type) + '_HITCHANCE'"
		_value = "_airDefenseAuraTTX.hitChance"
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_AA_MAX_DIST'
		_value = "_airDefenseAuraTTX.maxDist"
		_valueConfig = "VALUE_CONFIG.KILOMETER"
	)
)



(def element AirDefenseBubblesTTX (_shipTTX:dhStruct, _bubbleTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_AA_BUBBLE_DAMAGE_IN_A_SECOND'
		_value = "_bubbleTTX.damage"

		(controller $Tooltip
			(renderer = 'BubbleTooltipTTX')
			(args
				_shipTTX = "_shipTTX"
				_bubbleTTX = "_bubbleTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)
	)
)

(def element BubbleTooltipTTX (_shipTTX:dhStruct, _bubbleTTX:dhStruct)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW
			_title = 'IDS_SHIP_PARAM_AA_BUBBLE_DAMAGE_IN_A_SECOND'
			_descr = 'IDS_TOOLTIP_AA_BUBBLE_DAMAGE_IN_A_SECOND'
		)
		(element TooltipSystemHorizontalDivider)
		(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
			(element TOOLTIP_SYSTEM_PARAMS_BLOCK
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_AA_EXPL_COUNT'
					_value = "_bubbleTTX.numBubbles"
				)
				(element ShipParameterPercent
					_title = 'IDS_SHIP_PARAM_AA_BUBBLE_HITCHANCE'
					_value = "_bubbleTTX.hitChance"
				)
				(element ShipParameterRange
					_title = 'IDS_SHIP_PARAM_AA_BUBBLE_RANGE'
					_valueMin = "_bubbleTTX.minDist"
					_valueMax = "_bubbleTTX.maxDist"
					_valueConfig = "VALUE_CONFIG.KILOMETER"
				)
			)
		)
	)
)



(def element AirDefensePrioritySectorTTX (_shipTTX:dhStruct, _prioritySectorTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterPercent
		_title = 'IDS_SHIP_PARAM_AA_MAX_PRIORITY_SECTOR_AMPLIFICATION_TITLE'
		_value = "_prioritySectorTTX.strength"

		(controller $Tooltip
			(renderer = 'AirDefensePrioritySectorTooltipTTX')
			(args
				_shipTTX = "_shipTTX"
				_prioritySectorTTX = "_prioritySectorTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)
	)
)

(def element AirDefensePrioritySectorTooltipTTX (_shipTTX:dhStruct, _prioritySectorTTX:dhStruct)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW
			_title = 'IDS_SHIP_PARAM_AA_MAX_PRIORITY_SECTOR_AMPLIFICATION_TITLE'
			_descr = 'IDS_TOOLTIP_AA_MAX_PRIORITY_SECTOR_AMPLIFICATION'
		)
		(element TooltipSystemHorizontalDivider)
		(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
			(element TOOLTIP_SYSTEM_PARAMS_BLOCK
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_AA_SECTOR_START_DAMAGE'
					_value = "_prioritySectorTTX.startDamage"
					_valueConfig = "VALUE_CONFIG.DEFAULT"
					_zeroValueHidden = true
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_AA_SECTOR_INCREASED_TIME'
					_value = "_prioritySectorTTX.workTime"
					_valueConfig = "VALUE_CONFIG.SECONDS"
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_AA_SECTOR_COOLDOWN'
					_value = "_prioritySectorTTX.prepareTime"
					_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
				)
			)
		)
	)
)
