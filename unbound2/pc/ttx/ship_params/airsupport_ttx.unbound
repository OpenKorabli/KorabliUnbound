				_valueConfig = "VALUE_CONFIG.PERCENT_FLOAT_GREEN"
			)
			(element ShipParameterNumber
				_title = 'IDS_PARAMS_MODIFIER_GMSIDEALRADIUS'
				_value = "_shipTTX.airSupport.scoutAS.gmsIdealRadius"
				_valueConfig = "VALUE_CONFIG.PERCENT_FLOAT_GREEN"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_AIR_SUPPORT_NUM_SQUADRONS'
				_value = "_shipTTX.airSupport.scoutAS.numSquadrons"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_AIR_SUPPORT_NUM_PLANES_IN_CHARGE'
