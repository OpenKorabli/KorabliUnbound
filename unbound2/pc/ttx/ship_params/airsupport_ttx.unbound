(def element AirSupportTTX (_shipTTX:dhStruct)
	(style (width = 100%))
	(class $TTXSecondaryPanel)

	(element TTX_INSTANCE
		_elementName='AirSupportDamageTTXEntry'
		_shipTTX="_shipTTX"
		_value="_shipTTX.airSupport.damageAS"
	)
	(element TTX_INSTANCE
		_elementName='AirSupportSmokeTTXEntry'
		_shipTTX="_shipTTX"
		_value="_shipTTX.airSupport.smokeAS"
	)
	(element TTX_INSTANCE
		_elementName='AirSupportScoutTTXEntry'
		_shipTTX="_shipTTX"
		_value="_shipTTX.airSupport.scoutAS"
	)
	(element TTX_INSTANCE
		_elementName='AirSupportFighterTTXEntry'
		_shipTTX="_shipTTX"
		_value="_shipTTX.airSupport.fighterAS"
	)
	(element TTX_INSTANCE
		_elementName='AirSupportSpyTTXEntry'
		_shipTTX="_shipTTX"
		_value="_shipTTX.airSupport.spyAS"
	)
)

(def element DamageAirSupportTooltipTTX (_shipTTX:dhStruct, _airSupportTTX:dhStruct)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW
			_title = "'IDS_SHIP_PARAM_AIR_SUPPORT_SQUADRONS_' + _airSupportTTX.type"
			_descr = "'IDS_TOOLTIP_AIR_SUPPORT_SQUADRONS_' + _airSupportTTX.type"
		)

		(element TooltipSystemHorizontalDivider)
		(element AirSupportParametersCommonDamage
			_shipTTX="_shipTTX"
			_squadronTTX="_airSupportTTX.bomber"
		)
	)
)

(def element SmokeAirSupportTooltipTTX (_shipTTX:dhStruct, _airSupportTTX:dhStruct)
	(scope
		(var smokeTTX:dhStruct = "_shipTTX.airSupport.smokeAS.smoke")
	)

	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW
			_title = "'IDS_SHIP_PARAM_AIR_SUPPORT_SQUADRONS_' + _airSupportTTX.type"
			_descr = "'IDS_TOOLTIP_AIR_SUPPORT_SQUADRONS_' + _airSupportTTX.type"
		)

		(element TooltipSystemHorizontalDivider)
		(element AirSupportParametersCommonSmoke
			_shipTTX="_shipTTX"
			_squadronTTX="_airSupportTTX.bomber"
			_smokeTTX="smokeTTX"
		)
	)
)

