(def element AirSupportDamageTTXEntry (_shipTTX:dhStruct, _airSupportTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = "_airSupportTTX.bomber	? tr('IDS_SHIP_PARAM_AIR_SUPPORT_SQUADRONS_' + _airSupportTTX.type) + NEW_LINE + tr('IDS_' + _airSupportTTX.bomber.name)
										: ''"
		_value = "_airSupportTTX.numSquadrons"
		_valueConfig = "VALUE_CONFIG.ATTACKERS_COUNT"

		(macro PARAM_APPEAR_ANIMATION)

		(controller $Tooltip
			(renderer = 'DamageAirSupportTooltipTTX')
			(args
				_shipTTX = "_shipTTX"
				_airSupportTTX = "_airSupportTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)
	)
)


