(def element AirSupportParametersCommonDamage (_shipTTX:dhStruct, _squadronTTX:dhStruct)
	(style (width = 100%))
	(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
		(element TOOLTIP_SYSTEM_PARAMS_BLOCK
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_AIR_SUPPORT_RELOAD_TIME'
				_value = "_shipTTX.airSupport.damageAS.reloadTime"
				_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_AIR_SUPPORT_NUM_SQUADRONS'
				_value = "_shipTTX.airSupport.damageAS.numSquadrons"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_AIR_SUPPORT_NUM_PLANES_IN_CHARGE'
				_value = "_squadronTTX.numAttackers
			")
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_AIR_SUPPORT_PLANE_MAX_HEALTH'
				_value = "_squadronTTX.health"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_MAX_DIST'
				_value = "_shipTTX.airSupport.damageAS.maxDist"
				_valueConfig = "VALUE_CONFIG.KILOMETER"
			)
		)
	)

	(element TTX_INSTANCE
		_elementName='BombAPTTX'
		_shipTTX="_shipTTX"
		_value="_squadronTTX.bombAP"
	)
	(element TTX_INSTANCE
		_elementName='BombHETTX'
		_shipTTX="_shipTTX"
		_value="_squadronTTX.bombHE"
	)
	(element TTX_INSTANCE
		_elementName='BombDwTTX'
		_shipTTX="_shipTTX"
		_value="_squadronTTX.bombDW"
	)
	(element TTX_INSTANCE
		_elementName='MineFieldTTX'
		_shipTTX="_shipTTX"
		_value="_squadronTTX.minefield"
	)
)

(def element AirSupportParametersCommonSmoke (_shipTTX:dhStruct, _squadronTTX:dhStruct, _smokeTTX:dhStruct)
	(style (width = 100%))
	(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
