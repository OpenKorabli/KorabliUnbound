(def element BatteryTTX (_shipTTX:dhStruct)
	(style (width = 100%))
	(class $TTXSecondaryPanel)

	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_BATTERY_MAX_CAPACITY'
		_value = "_shipTTX.battery.capacity"
		_valueConfig = "VALUE_CONFIG.UNITS"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_BATTERY_MAX_CAPACITY'
				_descriptionText = 'IDS_TOOLTIP_BATTERY_MAX_CAPACITY'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)

	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_BATTERY_CONSUMPTION_RATE'
		_value = "{value: 1, delta: 0}"
		_valueConfig = "VALUE_CONFIG.UNITS_SECOND_NEGATIVE"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_BATTERY_CONSUMPTION_RATE'
				_descriptionText = 'IDS_TOOLTIP_BATTERY_CONSUMPTION_RATE'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)

	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_BATTERY_REGEN_RATE'
		_value = "_shipTTX.battery.regeneration"
		_valueConfig = "VALUE_CONFIG.UNITS_SECOND"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_BATTERY_REGEN_RATE'
				_descriptionText = 'IDS_TOOLTIP_BATTERY_REGEN_RATE'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
)
