(def element WavesTTX (_shipTTX:dhStruct)
	(style (width = 100%))
	(class $TTXSecondaryPanel)

	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_WAVE_GUN_SHOT_DELAY'
		_value = "_shipTTX.waves.reloadTime"
		_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_WAVE_GUN_SHOT_DELAY'
				_descriptionText = 'IDS_TOOLTIP_WAVE_GUN_SHOT_DELAY'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_WAVE_GUN_MAX_DIST'
		_value = "_shipTTX.waves.maxDist"
		_valueConfig = "VALUE_CONFIG.KILOMETER"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_WAVE_GUN_MAX_DIST'
				_descriptionText = 'IDS_TOOLTIP_WAVE_GUN_MAX_DIST'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
	(element ShipParameterRange
		_title = 'IDS_SHIP_PARAM_WAVE_GUN_SECTOR_WIDTH'
		_valueMin = "_shipTTX.waves.sectorWidthMin"
		_valueMax = "_shipTTX.waves.sectorWidthMax"
		_valueConfig = "VALUE_CONFIG.METER"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_WAVE_GUN_SECTOR_WIDTH'
				_descriptionText = 'IDS_TOOLTIP_WAVE_GUN_SECTOR_WIDTH'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_WAVE_GUN_SPEED'
		_value = "_shipTTX.waves.speed"
		_valueConfig = "VALUE_CONFIG.METER_SECOND"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_WAVE_GUN_SPEED'
				_descriptionText = 'IDS_TOOLTIP_WAVE_GUN_WAVE_SPEED'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
)