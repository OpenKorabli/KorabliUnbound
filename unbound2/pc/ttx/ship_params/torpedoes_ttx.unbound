(def element TorpedoesTTX (_shipTTX:dhStruct)
	(scope
		(var launchers:array = "_shipTTX.torpedoes.launchers")
		(var torpedo:dhStruct = "_shipTTX.torpedoes.torpedo")
		(var torpedoAlt:dhStruct = "_shipTTX.torpedoes.torpedoAlt")
	)
	(style (width = 100%))
	(class $TTXSecondaryPanel)

	(element TTX_REPEAT
		_elementName='TorpedoLauncherTTX'
		_shipTTX="_shipTTX"
		_array="launchers"
	)
	(element TTX_INSTANCE_SELECTOR
		_elementName="torpedoAlt ? 'TorpedoStatsTTX' : 'TorpedoStatsSingleTTX'"
		_shipTTX="_shipTTX"
		_value="_shipTTX.torpedoes"
	)
	(element TTX_INSTANCE
		_elementName='TorpedoCanHitClassesTTX'
		_shipTTX="_shipTTX"
		_value="torpedo"
		_enabled="torpedo && torpedo.canHitClasses.length > 0"
	)
)

(def element TorpedoLauncherTTX (_shipTTX:dhStruct, _torpedoLauncherTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterGunConfiguration
		_title='IDS_SHIP_PARAM_TORPEDO_GUN'
		_gunTTX="_torpedoLauncherTTX"

		(controller $Tooltip
			(renderer = 'TorpedoLauncherTooltipTTX')
			(args
				_shipTTX="_shipTTX"
				_torpedoLauncherTTX = "_torpedoLauncherTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)

		(element ShipParamExcursionButton
			_shipTTX="_shipTTX"
			_excursionId="['_Torpedoes', $index]"
			_isExcursionOn="false")
	)
)

(def element TorpedoLauncherTooltipTTX (_shipTTX:dhStruct, _torpedoLauncherTTX:dhStruct)
	(scope
		(var isGroup:bool = "_shipTTX.torpedoGroups != null")
		(var torpedoes:dhStruct = "isGroup ? _shipTTX.torpedoGroups.groups[0] : _shipTTX.torpedoes")
		(struct paramsNumShots = TORPEDO_PARAMS_NUM_SHOTS(_torpedoes = "torpedoes"))
		(struct torpedoChargeIds = SCOPE_GET_TORPEDO_CHARGE_IDS(nFirstReloadTimeShots = "paramsNumShots.nFirstReloadTimeShots" numShotsValue = "paramsNumShots.numShotsValue"))
	)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW
			_title='IDS_SHIP_PARAM_TORPEDO_GUN'
			_descr='IDS_TOOLTIP_TORPEDO_GUN'
		)
		(element TooltipSystemHorizontalDivider)
		(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
			(element TOOLTIP_SYSTEM_PARAMS_BLOCK
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_ROTATION_TIME'
					_value = "_torpedoLauncherTTX.rotationTime"
					_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_TORPEDOES_TIME_RELOAD'
					_value = "_shipTTX.torpedoes.reloadTime"
					_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
					_zeroValueHidden = true
				)
				(element ShipParameterNumber
					_title = "torpedoChargeIds.firstParamShotDeleyIds"
					_value = "torpedoes.firstReloadTime"
					_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
					_zeroValueHidden = true
				)
				(element ShipParameterNumber
					_title = "torpedoChargeIds.secondParamShotDeleyIds"
					_value = "torpedoes.secondReloadTime"
					_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
					_zeroValueHidden = true
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_TORPEDO_MIN_SWITCH_TIME'
					_value = "_shipTTX.torpedoes.ammoSwitchTime"
					_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
					_zeroValueHidden = true
				)
			)
		)
		(element TTX_INSTANCE
			_elementName='TorpedoDefaultTTX'
			_shipTTX="_shipTTX"
			_value="_shipTTX.torpedoes.torpedo"
		)
		(element TTX_INSTANCE
			_elementName='TorpedoDefaultTTX'
			_shipTTX="_shipTTX"
			_value="_shipTTX.torpedoes.torpedoAlt"
		)
		(element TooltipSystemExcursionMouseInstruction
			_shipTTX="_shipTTX"
		)
	)
)


(def element TorpedoDefaultTTX (_shipTTX:dhStruct, _torpedoTTX:dhStruct)
	(style (width = 100%))
	(element TTX_AMMO_ROW
		_title="'IDS_SHIP_PARAM_' + toUpper(_torpedoTTX.type) + '_AMMO'"
		_ammoTTX="_torpedoTTX"
	)
	(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
		(element TOOLTIP_SYSTEM_PARAMS_BLOCK
			(element ShipParameterClassIcons
				_title = 'IDS_SHIP_PARAM_TORPEDOES_AFFECTED_SHIPS'
				_values = "_torpedoTTX.canHitClasses"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_TORPEDO_MAX_DIST'
				_value = "_torpedoTTX.maxDist"
				_valueConfig = "VALUE_CONFIG.KILOMETER"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_TORPEDO_DAMAGE'
				_value = "_torpedoTTX.damage"
			)
			(element ShipParameterPercent
				_title = 'IDS_SHIP_PARAM_TORPEDO_BURN_PROB'
				_value = "_torpedoTTX.burnChance"
				_valueConfig = "VALUE_CONFIG.PERCENT_FLOAT"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_TORPEDO_SPEED'
				_value = "_torpedoTTX.speed"
				_valueConfig = "VALUE_CONFIG.KNOT"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_TOOLTIP_VISIBILITY'
				_value = "_torpedoTTX.visibility"
				_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
			)
		)
	)
)


