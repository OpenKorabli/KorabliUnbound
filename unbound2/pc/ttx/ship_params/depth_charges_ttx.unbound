(def element DepthChargesTTX (_shipTTX:dhStruct)
	(style (width = 100%))
	(class $TTXSecondaryPanel)

	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_DEPTH_CHARGE_MAX_BOMB_DAMAGE'
		_value = "_shipTTX.depthCharges.damage"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_DEPTH_CHARGE_MAX_BOMB_DAMAGE'
				_descriptionText = 'IDS_TOOLTIP_DEPTH_CHARGE_MAX_BOMB_DAMAGE'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_DEPTH_CHARGE_MAX_PACKS'
		_value = "_shipTTX.depthCharges.numCharges"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_DEPTH_CHARGE_MAX_PACKS'
				_descriptionText = 'IDS_TOOLTIP_DEPTH_CHARGE_MAX_PACKS'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_DEPTH_CHARGE_NUM_BOMBS_IN_PACK'
		_value = "_shipTTX.depthCharges.numBombs"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_DEPTH_CHARGE_NUM_BOMBS_IN_PACK'
				_descriptionText = 'IDS_TOOLTIP_DEPTH_CHARGE_NUM_BOMBS_IN_PACK'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_DEPTH_CHARGE_BLOW_TIME'
		_value = "_shipTTX.depthCharges.timeToBlow"
		_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"

		(macro PARAM_APPEAR_ANIMATION)

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_DEPTH_CHARGE_BLOW_TIME'
				_descriptionText = 'IDS_TOOLTIP_DEPTH_CHARGE_BLOW_TIME'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_DEPTH_CHARGE_RELOAD_TIME'
		_value = "_shipTTX.depthCharges.reloadTime"
		_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_DEPTH_CHARGE_RELOAD_TIME'
				_descriptionText = 'IDS_TOOLTIP_DEPTH_CHARGE_RELOAD_TIME'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
)