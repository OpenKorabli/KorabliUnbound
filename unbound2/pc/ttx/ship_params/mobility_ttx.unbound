(def element MobilityTTX (_shipTTX:dhStruct)
	(style (width = 100%))
	(class $TTXSecondaryPanel)

	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_MAXSPEED'
		_value = "_shipTTX.mobility.speed"
		_valueConfig = "VALUE_CONFIG.KNOT_FLOAT"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_MAXSPEED'
				_descriptionText = 'IDS_TOOLTIP_MAXSPEED'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_TURNINGRADIUS'
		_value = "_shipTTX.mobility.turningRadius"
		_valueConfig = "VALUE_CONFIG.METER_NEGATIVE"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_TURNINGRADIUS'
				_descriptionText = 'IDS_TOOLTIP_TURNINGRADIUS'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_RUDDER_TIME'
		_value = "_shipTTX.mobility.rudderTime"
		_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_RUDDER_TIME'
				_descriptionText = 'IDS_TOOLTIP_RUDDER_TIME'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
)
