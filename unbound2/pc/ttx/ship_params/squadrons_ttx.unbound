(def element SmokeTTX (_shipTTX:dhStruct, _smokeTTX:dhStruct)
	(style (width = 100%))
	(element TTX_INNER_HEADER_ROW
		_title='IDS_SHIP_PARAM_AIR_SUPPORT_SMOKE_PARAMS_TITLE'
	)
	(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
