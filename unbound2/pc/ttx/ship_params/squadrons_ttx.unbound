(def element TTX_SQUADRON_PARAMS (_squadronTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_HEALTH'
		_value = "_squadronTTX.health"
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SQUADRON_SPEED'
		_value = "_squadronTTX.speed"
		_valueConfig="VALUE_CONFIG.KNOT"
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SQUADRON_SPEED_MAX'
		_value = "_squadronTTX.maxSpeed"
		_valueConfig = "VALUE_CONFIG.KNOT"
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SQUADRON_MAX_FORSAGE_AMOUNT'
		_value = "_squadronTTX.forsageTime"
		_valueConfig = "VALUE_CONFIG.SECONDS"
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SQUADRON_FORSAGE_RESTORE_TIME'
		_value = "_squadronTTX.forsageRestore"
		_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
		_zeroValueHidden = true
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SQUADRON_JATO_DURATION'
		_value = "_squadronTTX.jatoDuration"
		_valueConfig = "VALUE_CONFIG.SECONDS"
		_zeroValueHidden = true
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SQUADRON_NUM_ATTACKERS'
		_value = "_squadronTTX.numAttackers"
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SQUADRON_NUM_PLANES'
		_value = "_squadronTTX.numPlanes"
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_HANGARVOLUME'
		_value = "_squadronTTX.hangarVolume"
	)
	(element ShipParameterRepeat
		_title = 'IDS_SHIP_PARAM_SQUADRON_PLANES_RESTORE_RATE'
		_values = "[_squadronTTX.restorePlanes, _squadronTTX.restoreTime]"
		_valueConfigs = "[VALUE_CONFIG.DEFAULT, VALUE_CONFIG.SECONDS_NEGATIVE]"
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SQ_VISIBILITY_DIST_BY_SHIP'
		_value = "_squadronTTX.visibility"
		_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
	)
)

(def element FighterTooltipTTX (_shipTTX:dhStruct, _squadronTTX:dhStruct)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW
			_title='IDS_FIGHTER'
			_descr='IDS_SQUADRON'
		)
		(element TooltipSystemHorizontalDivider)
		(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
			(element TOOLTIP_SYSTEM_PARAMS_BLOCK
				(element TTX_SQUADRON_PARAMS
					_squadronTTX="_squadronTTX"
				)
			)
		)
		(element TTX_INSTANCE
			_elementName='RocketAPTTX'
			_shipTTX="_shipTTX"
			_value="_squadronTTX.rocketAP"
		)
		(element TTX_INSTANCE
			_elementName='RocketHETTX'
			_shipTTX="_shipTTX"
			_value="_squadronTTX.rocketHE"
		)
		(element TooltipSystemExcursionMouseInstruction
			_shipTTX="_shipTTX"
		)
	)
)

