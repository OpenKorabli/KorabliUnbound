			(element ShipParameterNumber
				_title = 'IDS_PARAMS_MODIFIER_LIFETIME'
				_value = "_smokeTTX.lifeTime"
				_valueConfig = "VALUE_CONFIG.SECONDS"
			)
			(element ShipParameterNumber
				_title = 'IDS_PARAMS_MODIFIER_RADIUS'
				_value = "_smokeTTX.radius"
				_valueConfig = "VALUE_CONFIG.KILOMETER"
			)
		)
	)
)
