(def element SquadronsTTX (_shipTTX:dhStruct)
	(style (width = 100%))
	(class $TTXSecondaryPanel)

	(element TTX_INSTANCE
		_elementName='SquadronFighterTTXEntry'
		_shipTTX="_shipTTX"
		_value="_shipTTX.squadrons.fighter"
	)
	(element TTX_INSTANCE
		_elementName='SquadronTorpedoBomberTTXEntry'
		_shipTTX="_shipTTX"
		_value="_shipTTX.squadrons.torpedoBomber"
	)
	(element TTX_INSTANCE
		_elementName='SquadronDiveBomberTTXEntry'
		_shipTTX="_shipTTX"
		_value="_shipTTX.squadrons.diveBomber"
	)
	(element TTX_INSTANCE
		_elementName='SquadronSkipBomberTTXEntry'
		_shipTTX="_shipTTX"
		_value="_shipTTX.squadrons.skipBomber"
	)
	(element TTX_INSTANCE
		_elementName='SquadronMineBomberTTXEntry'
		_shipTTX="_shipTTX"
		_value="_shipTTX.squadrons.mineBomber"
	)

	(element TTX_INSTANCE
		_elementName='SquadronFighterAltTTXEntry'
		_shipTTX="_shipTTX"
		_value="_shipTTX.squadrons.fighterAlt"
	)
	(element TTX_INSTANCE
		_elementName='SquadronTorpedoBomberAltTTXEntry'
		_shipTTX="_shipTTX"
		_value="_shipTTX.squadrons.torpedoBomberAlt"
	)
	(element TTX_INSTANCE
		_elementName='SquadronDiveBomberAltTTXEntry'
		_shipTTX="_shipTTX"
		_value="_shipTTX.squadrons.diveBomberAlt"
	)
	(element TTX_INSTANCE
		_elementName='SquadronSkipBomberAltTTXEntry'
		_shipTTX="_shipTTX"
		_value="_shipTTX.squadrons.skipBomberAlt"
	)
	(element TTX_INSTANCE
		_elementName='SquadronMineBomberAltTTXEntry'
		_shipTTX="_shipTTX"
		_value="_shipTTX.squadrons.mineBomberAlt"
	)
)

(def element SQUADRON_ENTRY (_shipTTX:dhStruct, _squadronTTX:dhStruct, _title:str, _tooltipRenderer:str, _excursionId:array)
	(style (width = 100%))
	(element ShipParameterNumber
		_title="tr(_title) + NEW_LINE + tr(toUpper('IDS_' + _squadronTTX.name))"
		_value="_squadronTTX.numSquadrons"
		_valueConfig="VALUE_CONFIG.ATTACKERS_COUNT"

		(controller $Tooltip
			(renderer="_tooltipRenderer")
			(args "_shipTTX" "_squadronTTX")
			(macro SIMPLE_TOOLTIP_ANIMATION)
			(align="bottom|left")
			(offset=[10, 0])
			(screenBoundsOffset=50)
		)
		(element ShipParamExcursionButton
			_shipTTX="_shipTTX"
			_excursionId="_excursionId"
			_isExcursionOn="false")
	)
)

(def element SquadronFighterTTXEntry (_shipTTX:dhStruct, _squadronTTX:dhStruct)
	(style (width = 100%))
	(element SQUADRON_ENTRY
		_shipTTX="_shipTTX"
		_squadronTTX="_squadronTTX"
		_title='IDS_FIGHTER'
		_tooltipRenderer='FighterTooltipTTX'
		_excursionId="['_Fighter', 0]"
	)
)

