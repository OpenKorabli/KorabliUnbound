(def constant GUARANTEED_UNDERWATER_VISIBILITY "{
	value: 2.0,
	delta: 0
}")

(def element VisibilityTTX (_shipTTX:dhStruct)
	(style (width = 100%))
	(class $TTXSecondaryPanel)

	(element TTX_INSTANCE
		_elementName='VisibilityByShipTTX'
		_shipTTX="_shipTTX"
		_value="_shipTTX.visibility.visibilityByShip"
	)
	(element TTX_INSTANCE
		_elementName='VisibilityDepthTTX'
		_shipTTX="_shipTTX"
		_value="_shipTTX.visibility.visibilityFromDepth"
	)
	(element TTX_INSTANCE
		_elementName='VisibilityByPlaneTTX'
		_shipTTX="_shipTTX"
		_value="_shipTTX.visibility.visibilityByPlane"
	)
	(element TTX_INSTANCE
		_elementName='GuaranteedVisibilityTTX'
		_shipTTX="_shipTTX"
		_value="_shipTTX.visibility.visibilityByShip"
	)
)

(def element VisibilityByShipTTX (_shipTTX:dhStruct, _visibilityByShipTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_BY_SHIP'
		_value = "_visibilityByShipTTX.normal"
		_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"

		(controller $Tooltip
			(renderer = 'VisibilityByShipTooltipTTX')
			(args
				_shipTTX = "_shipTTX"
				_visibilityByShipTTX = "_visibilityByShipTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)
	)
)

(def element VisibilityDepthTTX (_shipTTX:dhStruct, _visibilityFromDepthTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterRange
		_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_FROM_DEPTH'
		_valueMin = "_visibilityFromDepthTTX.min"
		_valueMax = "_visibilityFromDepthTTX.max"
		_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"

		(controller $Tooltip
			(renderer = 'VisibilityDepthTooltipTTX')
			(args
				_shipTTX="_shipTTX"
				_visibilityFromDepthTTX = "_visibilityFromDepthTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)
	)
)

(def element VisibilityByPlaneTTX (_shipTTX:dhStruct, _visibilityByPlaneTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_BY_PLANE'
		_value = "_visibilityByPlaneTTX.normal"
		_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"

		(controller $Tooltip
			(renderer = 'VisibilityByPlaneTooltipTTX')
			(args
				_shipTTX="_shipTTX"
				_visibilityByPlaneTTX = "_visibilityByPlaneTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)
	)
)

(def element GuaranteedVisibilityTTX (_shipTTX:dhStruct, _visibilityByShipTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_GUARANTEED_VISIBILITY'
		_value = "GUARANTEED_UNDERWATER_VISIBILITY"
		_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"

		(controller $Tooltip
			(renderer = 'GuaranteedVisibilityTooltipTTX')
			(args
				_shipTTX="_shipTTX"
				_visibilityByShipTTX = "_visibilityByShipTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)
	)
)

(def element VisibilityByShipTooltipTTX (_shipTTX:dhStruct, _visibilityByShipTTX:dhStruct)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW
			_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_BY_SHIP'
			_descr = "_shipTTX.subtype == ShipTypes.SUBMARINE	? 'IDS_TOOLTIP_VISIBILITY_DIST_BY_SHIP_SUBMARINE'
																: 'IDS_TOOLTIP_VISIBILITY_DIST_BY_SHIP'"
		)
		(element TooltipSystemHorizontalDivider)
		(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
			(element TOOLTIP_SYSTEM_PARAMS_BLOCK
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_BY_SHIP'
					_value = "_visibilityByShipTTX.normal"
					_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_BY_GK'
					_value = "_shipTTX.artillery.mgMaxDist"
					_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
					_zeroValueHidden = true
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_BY_GK_IN_SMOKE'
					_value = "_visibilityByShipTTX.smoke"
					_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
					_zeroValueHidden = true
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_BY_ATBA'
					_value = "_shipTTX.artillery.atbaMaxDist"
					_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
					_zeroValueHidden = true
				)
				(element TTX_INSTANCE
					_elementName='VisibilityByDepthTTX'
					_shipTTX="_shipTTX"
					_value="_visibilityByShipTTX.byDepth"
				)
			)
		)
	)
)

(def element VisibilityByPlaneTooltipTTX (_shipTTX:dhStruct, _visibilityByPlaneTTX:dhStruct)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW
			_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_BY_PLANE'
			_descr = "_shipTTX.subtype == ShipTypes.SUBMARINE	? 'IDS_TOOLTIP_VISIBILITY_DIST_BY_PLANE_SUBMARINE'
																: 'IDS_TOOLTIP_VISIBILITY_DIST_BY_PLANE'"
		)
		(element TooltipSystemHorizontalDivider
			(bind visible "_visibilityByPlaneTTX.byDepth")
		)
		(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
			(bind visible "_visibilityByPlaneTTX.byDepth")
			(element TOOLTIP_SYSTEM_PARAMS_BLOCK
				(element TTX_INSTANCE
					_elementName='VisibilityByDepthTTX'
					_shipTTX="_shipTTX"
					_value="_visibilityByPlaneTTX.byDepth"
				)
			)
		)
	)
)

(def element VisibilityDepthTooltipTTX (_shipTTX:dhStruct, _visibilityFromDepthTTX:dhStruct)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW
			_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_FROM_DEPTH'
			_descr = "_shipTTX.subtype == ShipTypes.SUBMARINE	? 'IDS_TOOLTIP_VISIBILITY_DIST_FROM_DEPTH_SUBMARINE'
																: 'IDS_TOOLTIP_VISIBILITY_DIST_FROM_DEPTH'"
		)
		(element TooltipSystemHorizontalDivider)
		(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
			(element TOOLTIP_SYSTEM_PARAMS_BLOCK
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_FROM_DEPTH_PERISCOPE'
					_value = "_visibilityFromDepthTTX.max"
					_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_FROM_DEPTH_INVULNERABLE'
					_value = "_visibilityFromDepthTTX.min"
					_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
				)
			)
		)
	)
)

(def element GuaranteedVisibilityTooltipTTX (_shipTTX:dhStruct, _visibilityByShipTTX:dhStruct)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW
			_title = 'IDS_SHIP_PARAM_GUARANTEED_VISIBILITY'
			_descr = "_shipTTX.subtype == ShipTypes.SUBMARINE	? 'IDS_TOOLTIP_GUARANTEED_VISIBILITY_SUBMARINE'
																: 'IDS_TOOLTIP_GUARANTEED_VISIBILITY'"
		)
		(controller $Instance layout=true
			(bind enabled "_visibilityByShipTTX.smoke.value > 0")
			(exprs
				(style (width = 100%))
				(element TooltipSystemHorizontalDivider)
				(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
					(element TOOLTIP_SYSTEM_PARAMS_BLOCK
						(element ShipParameterNumber
							_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_BY_GK_IN_SMOKE'
							_value = "_visibilityByShipTTX.smoke"
							_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
						)
					)
				)
			)
		)
	)
)

(def element VisibilityByDepthTTX (_shipTTX:dhStruct, _visibilityByDepthTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_BY_DEPTH_SURFACE'
		_value = "_visibilityByDepthTTX.surface"
		_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
		_zeroValueHidden = true
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_BY_DEPTH_PERISCOPE'
		_value = "_visibilityByDepthTTX.periscope"
		_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
		_zeroValueHidden = true
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_VISIBILITY_DIST_BY_DEPTH_INVULNERABLE'
		_value = "_visibilityByDepthTTX.invulnerable"
		_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
	)
)