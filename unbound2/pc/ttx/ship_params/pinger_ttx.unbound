(def element PingerTTX (_shipTTX:dhStruct)
	(style (width = 100%))
	(class $TTXSecondaryPanel)

	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_WAVE_SHOT_DELAY'
		_value = "_shipTTX.pinger.reloadTime"
		_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_WAVE_SHOT_DELAY'
				_descriptionText = 'IDS_TOOLTIP_WAVE_SHOT_DELAY'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_WAVE_DURATION'
		_value = "_shipTTX.pinger.duration"
		_valueConfig = "VALUE_CONFIG.SECONDS"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_WAVE_DURATION'
				_descriptionText = 'IDS_TOOLTIP_WAVE_DURATION'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_WAVE_SPEED'
		_value = "_shipTTX.pinger.speed"
		_valueConfig = "VALUE_CONFIG.METER_SECOND"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_WAVE_SPEED'
				_descriptionText = 'IDS_TOOLTIP_WAVE_SPEED'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_WAVE_MAX_DIST'
		_value = "_shipTTX.pinger.maxDist"
		_valueConfig = "VALUE_CONFIG.KILOMETER"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_WAVE_MAX_DIST'
				_descriptionText = 'IDS_TOOLTIP_WAVE_MAX_DIST'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
)
