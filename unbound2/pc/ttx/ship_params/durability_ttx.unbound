(def element DurabilityTTX (_shipTTX:dhStruct)
	(style (width = 100%))
	(class $TTXSecondaryPanel)

	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_HEALTH'
		_value = "_shipTTX.durability.health"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_HEALTH'
				_descriptionText = 'IDS_TOOLTIP_HEALTH'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)

	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SHIELDHEALTH'
		_value = "_shipTTX.durability.shieldHealth"
		_zeroValueHidden = true

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_SHIELDHEALTH'
				_descriptionText = 'IDS_TOOLTIP_SHIELDHEALTH'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)

	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_PTZDAMAGEPROB'
		_value = "_shipTTX.durability.ptz"
		_valueConfig = "VALUE_CONFIG.PERCENT"
		_zeroValueHidden = "true"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_PTZDAMAGEPROB'
				_descriptionText = 'IDS_TOOLTIP_PTZDAMAGEPROB'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
)