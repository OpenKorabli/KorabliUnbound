(def element TorpedoGroupsTTX (_shipTTX:dhStruct)
	(scope
		(var groups:array = "_shipTTX.torpedoGroups.groups")
		(var torpedoAlt:dhStruct = "_shipTTX.torpedoGroups.torpedoAlt")
	)
	(style (width = 100%))
	(class $TTXSecondaryPanel)

	(block
		(style (width = 100%))
		(controller $Repeat
			(bind enabled "groups")
			(bind count "groups ? groups.length : 0")
			(bind renderer "'TorpedoGroupTTX'")
			(args
				_shipTTX="_shipTTX"
				_torpedoGroupTTX="groups[$index]"
			)
		)
	)

	(element TTX_INSTANCE_SELECTOR
		_elementName="torpedoAlt ? 'TorpedoStatsTTX' : 'TorpedoStatsSingleTTX'"
		_shipTTX="_shipTTX"
		_value="_shipTTX.torpedoGroups"
	)
)

(def element TorpedoGroupTTX (_shipTTX:dhStruct, _torpedoGroupTTX:dhStruct)
	(scope
		(var isNotSubmarine:bool = "_shipTTX.subtype != ShipTypes.SUBMARINE")
	)
	(style (width = 100%))
	(element ShipParameterGunConfiguration
		_title = "_torpedoGroupTTX.groupName"
		_gunTTX = "_torpedoGroupTTX"

		(controller $Tooltip
			(renderer = 'TorpedoGroupTooltipTTX')
			(args
				_shipTTX = "_shipTTX"
				_torpedoGroupTTX = "_torpedoGroupTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)

		(controller $Instance renderer='ShipParamExcursionButton'
			(bind enabled "isNotSubmarine")
			(args
				_shipTTX="_shipTTX"
				_excursionId="['_Torpedoes', 0]"
			)
		)
	)
)

(def element TorpedoStatsTTX (_shipTTX:dhStruct, _torpedoGroupsTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterRepeat
		_title = 'IDS_SHIP_PARAM_TORPEDO_MAX_DIST'
		_values = "[_torpedoGroupsTTX.torpedo.maxDist, _torpedoGroupsTTX.torpedoAlt.maxDist]"
		_valueConfigs = "[VALUE_CONFIG.FLOAT, VALUE_CONFIG.KILOMETER]"

		(controller $Tooltip
			(renderer = 'TorpedoesMaxDistTooltipTTX')
			(args
				_shipTTX="_shipTTX"
				_torpedoGroupsTTX = "_torpedoGroupsTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)
	)
	(element ShipParameterRepeat
		_title = 'IDS_SHIP_PARAM_TORPEDO_SPEED'
		_values = "[_torpedoGroupsTTX.torpedo.speed, _torpedoGroupsTTX.torpedoAlt.speed]"
		_valueConfigs = "[VALUE_CONFIG.DEFAULT, VALUE_CONFIG.KNOT]"

		(controller $Tooltip
			(renderer = 'TorpedoesSpeedTooltipTTX')
			(args
				_shipTTX="_shipTTX"
				_torpedoGroupsTTX = "_torpedoGroupsTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)
	)
)

(def element TorpedoStatsSingleTTX (_shipTTX:dhStruct, _torpedoGroupsTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_TORPEDO_MAX_DIST'
		_value = "_torpedoGroupsTTX.torpedo.maxDist"
		_valueConfig = "VALUE_CONFIG.KILOMETER"

		(controller $Tooltip
			(renderer = 'TorpedoesMaxDistTooltipTTX')
			(args
				_shipTTX="_shipTTX"
				_torpedoGroupsTTX = "_torpedoGroupsTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_TORPEDO_SPEED'
		_value = "_torpedoGroupsTTX.torpedo.speed"
		_valueConfig = "VALUE_CONFIG.KNOT"

		(controller $Tooltip
			(renderer = 'TorpedoesSpeedTooltipTTX')
			(args
				_shipTTX="_shipTTX"
				_torpedoGroupsTTX = "_torpedoGroupsTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)
	)
)


(def element TorpedoCanHitClassesTTX (_shipTTX:dhStruct, _torpedoTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterClassIcons
		_title = 'IDS_SHIP_PARAM_TORPEDOES_AFFECTED_SHIPS'
		_values = "_torpedoTTX.canHitClasses"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_TORPEDOES_AFFECTED_SHIPS'
				_descriptionText = 'IDS_TOOLTIP_TORPEDOES_AFFECTED_SHIPS'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
)

(def element TorpedoesMaxDistTooltipTTX (_shipTTX:dhStruct, _torpedoGroupTTX:dhStruct)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW
			_title='IDS_SHIP_PARAM_TORPEDO_MAX_DIST'
			_descr='IDS_TOOLTIP_TORPEDO_MAX_DIST'
		)
		(element TTX_INSTANCE
			_elementName='TorpedoMaxDistanceTTX'
			_shipTTX="_shipTTX"
			_value="_torpedoGroupTTX.torpedo"
			_enabled="_torpedoGroupTTX.torpedoAlt != null"
		)
		(element TTX_INSTANCE
			_elementName='TorpedoMaxDistanceTTX'
			_shipTTX="_shipTTX"
			_value="_torpedoGroupTTX.torpedoAlt"
			_enabled="_torpedoGroupTTX.torpedoAlt != null"
		)
	)
)

(def element TorpedoesSpeedTooltipTTX (_shipTTX:dhStruct, _torpedoGroupTTX:dhStruct)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW
			_title='IDS_SHIP_PARAM_TORPEDO_SPEED'
			_descr='IDS_TOOLTIP_TORPEDO_SPEED'
		)
		(element TTX_INSTANCE
			_elementName='TorpedoSpeedTTX'
			_shipTTX="_shipTTX"
			_value="_torpedoGroupTTX.torpedo"
			_enabled="_torpedoGroupTTX.torpedoAlt != null"
		)
		(element TTX_INSTANCE
			_elementName='TorpedoSpeedTTX'
			_shipTTX="_shipTTX"
			_value="_torpedoGroupTTX.torpedoAlt"
			_enabled="_torpedoGroupTTX.torpedoAlt != null"
		)
	)
)

(def element TorpedoGroupTooltipTTX (_shipTTX:dhStruct, _torpedoGroupTTX:dhStruct)
	(scope
		(var isGroup:bool = "_shipTTX.torpedoGroups != null")
		(var torpedoes:dhStruct = "isGroup ? _shipTTX.torpedoGroups.groups[0] : _shipTTX.torpedoes")
		(struct paramsNumShots = TORPEDO_PARAMS_NUM_SHOTS(_torpedoes = "torpedoes"))
		(struct torpedoChargeIds = SCOPE_GET_TORPEDO_CHARGE_IDS(nFirstReloadTimeShots = "paramsNumShots.nFirstReloadTimeShots" numShotsValue = "paramsNumShots.numShotsValue"))
	)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER

		(element TooltipSystemHeaderSubheaderText
			_headerText = "_torpedoGroupTTX.groupName"
		)
		(element TooltipSystemHorizontalDivider)
		(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
			(element TOOLTIP_SYSTEM_PARAMS_BLOCK
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_SHOT_DELAY'
					_value = "_torpedoGroupTTX.reloadTime"
					_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
					_zeroValueHidden = true
				)
				(element ShipParameterNumber
					_title = "torpedoChargeIds.firstParamShotDeleyIds"
					_value = "torpedoes.firstReloadTime"
					_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
					_zeroValueHidden = true
				)
				(element ShipParameterNumber
					_title = "torpedoChargeIds.secondParamShotDeleyIds"
					_value = "torpedoes.secondReloadTime"
					_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
					_zeroValueHidden = true
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_TORPEDO_MIN_SWITCH_TIME'
					_value = "_torpedoGroupTTX.ammoSwitchTime"
					_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
					_zeroValueHidden = true
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_TORPEDO_TUBE_COUNT'
					_value = "_torpedoGroupTTX.numGuns"
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_TORPEDO_LOADERS_COUNT'
					_value = "_torpedoGroupTTX.numLoaders"
				)
			)
		)
		(element TTX_INSTANCE
			_elementName='SubmarineTorpedoTTX'
			_shipTTX="_shipTTX"
			_value="_shipTTX.torpedoGroups.torpedo"
		)
		(element TTX_INSTANCE
			_elementName='SubmarineTorpedoTTX'
			_shipTTX="_shipTTX"
			_value="_shipTTX.torpedoGroups.torpedoAlt"
		)
	)
)

(def element SubmarineTorpedoTTX (_shipTTX:dhStruct, _submarineTorpedoTTX:dhStruct)
	(style (width = 100%))
	(element TTX_AMMO_ROW
		_title="'IDS_SHIP_PARAM_' + toUpper(_submarineTorpedoTTX.type) + '_AMMO'"
		_ammoTTX="_submarineTorpedoTTX"
	)
	(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
		(element TOOLTIP_SYSTEM_PARAMS_BLOCK
			(element ShipParameterClassIcons
				_title = 'IDS_SHIP_PARAM_TORPEDOES_AFFECTED_SHIPS'
				_values = "_submarineTorpedoTTX.canHitClasses"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_TORPEDO_MAX_DIST'
				_value = "_submarineTorpedoTTX.maxDist"
				_valueConfig = "VALUE_CONFIG.KILOMETER"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_TORPEDO_DAMAGE'
				_value = "_submarineTorpedoTTX.damage"
			)
			(element ShipParameterPercent
				_title = 'IDS_SHIP_PARAM_TORPEDO_BURN_PROB'
				_value = "_submarineTorpedoTTX.burnChance"
				_valueConfig = "VALUE_CONFIG.PERCENT_FLOAT"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_TORPEDO_SPEED'
				_value = "_submarineTorpedoTTX.speed"
				_valueConfig = "VALUE_CONFIG.KNOT"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_TOOLTIP_VISIBILITY'
				_value = "_submarineTorpedoTTX.visibility"
				_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
			)
		)
	)
)
