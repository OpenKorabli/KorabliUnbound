(def element UnderwaterMobilityTTX (_shipTTX:dhStruct)
	(style (width = 100%))
	(class $TTXSecondaryPanel)

	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_MAX_SPEED_UNDER_WATER'
		_value = "_shipTTX.underwaterMobility.speed"
		_valueConfig = "VALUE_CONFIG.KNOT_FLOAT"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_MAX_SPEED_UNDER_WATER'
				_descriptionText = 'IDS_TOOLTIP_MAX_SPEED_UNDER_WATER'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_BUOYANCY_RUDDER_TIME'
		_value = "_shipTTX.underwaterMobility.rudderTime"
		_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_BUOYANCY_RUDDER_TIME'
				_descriptionText = 'IDS_TOOLTIP_BUOYANCY_RUDDER_TIME'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_MAX_BUOYANCY_SPEED'
		_value = "_shipTTX.underwaterMobility.buoyancySpeed"
		_valueConfig = "VALUE_CONFIG.METER_SECOND_FLOAT"

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_MAX_BUOYANCY_SPEED'
				_descriptionText = 'IDS_TOOLTIP_MAX_BUOYANCY_SPEED'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
)