(def element ATBAGunTTX (_shipTTX:dhStruct, _atbaGunTTX:dhStruct)
	(scope
		(var hasDiff:bool = "_shipTTX.artillery.atbaMaxDist.delta != 0")
	)
	(style (width = 100%))
	(element ShipParameterGunConfiguration
		_title='IDS_SECONDARY_CALIBER'
		_gunTTX="_atbaGunTTX"
		_externalDiff="hasDiff"

		(controller $Tooltip
			(renderer = 'ATBAGunTooltipTTX')
			(args
				_shipTTX = "_shipTTX"
				_atbaGunTTX = "_atbaGunTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)

		(element ShipParamExcursionButton
			_shipTTX = "_shipTTX"
			_excursionId="['_Atba', $index]"
			_isExcursionOn="false"
		)
	)
)

(def element ATBAGunTooltipTTX (_shipTTX:dhStruct, _atbaGunTTX:dhStruct)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW
			_title='IDS_SHIP_PARAM_ATBA_GUN'
			_descr='IDS_TOOLTIP_ATBA_GUN'
		)
		(element TooltipSystemHorizontalDivider)
		(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
			(element TOOLTIP_SYSTEM_PARAMS_BLOCK
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_SHOT_DELAY'
					_value = "_atbaGunTTX.reloadTime"
					_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_MAX_DIST'
					_value = "_shipTTX.artillery.atbaMaxDist"
					_valueConfig = "VALUE_CONFIG.KILOMETER"
				)
			)
		)
		(element TTX_INSTANCE
			_elementName='AmmoHETTX'
			_shipTTX="_shipTTX"
			_value="_atbaGunTTX.ammoHE"
		)
		(element TTX_INSTANCE
			_elementName='AmmoCSTTX'
			_shipTTX="_shipTTX"
			_value="_atbaGunTTX.ammoCS"
		)
		(element TTX_INSTANCE
			_elementName='AmmoAPTTX'
			_shipTTX="_shipTTX"
			_value="_atbaGunTTX.ammoAP"
		)
		(element TooltipSystemExcursionMouseInstruction
			_shipTTX="_shipTTX"
		)
	)
)
