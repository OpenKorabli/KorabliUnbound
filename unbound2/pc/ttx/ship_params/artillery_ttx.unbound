					_zeroValueHidden = true
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_ROTATION_TIME'
					_value = "_mainGunTTX.rotationTime"
					_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_DISPERSION'
					_value = "_shipTTX.secondaryArtillery.mgDispersion"
					_valueConfig = "VALUE_CONFIG.METER_NEGATIVE"
				)
				(element ShipParameterNumber
					_title = 'IDS_TOOLTIP_ARTILLERY_SHOOT_DIST'
					_value = "_shipTTX.secondaryArtillery.mgMaxDist"
					_valueConfig = "VALUE_CONFIG.KILOMETER"
				)
			)
		)
		(element TTX_INSTANCE
			_elementName='AmmoHETTX'
			_shipTTX="_shipTTX"
			_value="_shipTTX.secondaryArtillery.ammoHE"
		)
		(element TTX_INSTANCE
			_elementName='AmmoCSTTX'
			_shipTTX="_shipTTX"
			_value="_shipTTX.secondaryArtillery.ammoCS"
		)
		(element TTX_INSTANCE
			_elementName='AmmoAPTTX'
			_shipTTX="_shipTTX"
			_value="_shipTTX.secondaryArtillery.ammoAP"
		)
		(element TTX_INSTANCE
			_elementName='AmmoSSTTX'
			_shipTTX="_shipTTX"
			_value="_shipTTX.secondaryArtillery.ammoSS"
		)
		(element TooltipSystemExcursionMouseInstruction
			_shipTTX="_shipTTX"
		)
	)
)


(def element FireModeTTX (_shipTTX:dhStruct)
	(scope
		(var visualSlotDataEntity:dhEntity = "getPrimaryCompositeEntity(CC.visualSlotData, SC.Ships.SHIP_INFO_WEAPON_TYPE.VALUE_TO_NAME[SC.Ships.SHIP_INFO_WEAPON_TYPE.FIRE_MODE], DEFAULT_AVATAR_ID)")
		(var visualSlotDataComponent:dhComponent = "visualSlotDataEntity.visualSlotData")
		(var title:str = "visualSlotDataComponent.title ?: ''")
	)
	(style (width = 100%))
	(element ShipParameterStr
		_title="title"

		(controller $Tooltip
			(renderer = 'FireModeTooltipTTX')
			(args
				_shipTTX = "_shipTTX"
				_visualSlotDataEntity = "visualSlotDataEntity"
			)
			(macro TTX_TOOLTIP_STYLES)
		)
	)
)

(def element FireModeSecondaryTTX (_shipTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterStr
		_title = 'IDS_DOCK_FIRE_MODE_SECONDARY_TITLE_DRUM'

		(controller $Tooltip
			(renderer = 'FireModeSecondaryTooltipTTX')
			(args
				_shipTTX = "_shipTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)
	)
)

(def element FireModeTooltipTTX (_shipTTX:dhStruct, _visualSlotDataEntity:dhEntity)
	(scope
		(var artilleryTTX:dhStruct = "_shipTTX.artillery")

		(var visualSlotDataComponent:dhComponent = "_visualSlotDataEntity.visualSlotData")
		(var title:str = "visualSlotDataComponent.title ?: ''")
		(var description:str = "visualSlotDataComponent.description ?: ''")

		(var attributesNegative:array = "_visualSlotDataEntity.attributes.negative ?: []")
		(var attributesPositive:array = "_visualSlotDataEntity.attributes.positive ?: []")
	)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW_SIMPLE
			_title = "title"
		)
		(block
			(style (width = 100%))
			(controller $Instance renderer='TTX_ROW_SIMPLE'
				(bind enabled "artilleryTTX.drumFireMode.isChargeable.value")
				(args
					_text = 'IDS_DOCK_FIRE_MODE_CHARGEABLE'
					_isDividerEnabled = true
				)
			)
		)
		(element TTX_ROW_SIMPLE
			_text = "description"
		)

		(controller $Instance renderer='FireModeTooltipTTXParamsInfo'
			(args
				_artilleryTTX = "artilleryTTX"
				_attributesNegative = "attributesNegative"
				_attributesPositive = "attributesPositive"
			)
		)
	)
)

(def element FireModeSecondaryTooltipTTX (_shipTTX:dhStruct)
	(scope
		(var secondaryArtilleryTTX:dhStruct = "_shipTTX.secondaryArtillery")
		(var isFireModeChargeable:bool = "secondaryArtilleryTTX.drumFireMode.isChargeable.value")
	)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW_SIMPLE
			_title = 'IDS_DOCK_FIRE_MODE_SECONDARY_TITLE_DRUM'
		)
		(block
			(style (width = 100%))
			(controller $Instance renderer='TTX_ROW_SIMPLE'
				(bind enabled "isFireModeChargeable")
				(args
					_text = 'IDS_DOCK_FIRE_MODE_CHARGEABLE'
					_isDividerEnabled = true
				)
			)
		)
		(element TTX_ROW_SIMPLE
			_text = "'IDS_DOCK_FIRE_MODE_SECONDARY_DESCRIPTION_DRUM' + (isFireModeChargeable ? '_CHARGEABLE' : '')"
		)

		(controller $Instance renderer='FireModeTooltipTTXParamsInfo'
			(args
				_artilleryTTX = "secondaryArtilleryTTX"
				_attributesNegative = []
				_attributesPositive = []
				_isSecondary = true
			)
		)
	)
)

(def element FireModeTooltipTTXParamsInfo (	_artilleryTTX:dhStruct,
											_attributesNegative:array,
											_attributesPositive:array,
											_isSecondary:bool = false)
	(scope
		(var ownerEntity:dhEntity = "getSingleEntity(CC.playerAvatar)")
		(struct paramsNumShots = PARAMS_NUM_SHOTS(_artilleryTTX = "_artilleryTTX"))
		(struct drumIds = SCOPE_GET_DRUM_IDS(_nFirstReloadTimeShots = "paramsNumShots.nFirstReloadTimeShots" _numShotsValue = "paramsNumShots.numShotsValue"))
	)

	(style (width = 100%))
	(element TooltipSystemHorizontalDivider)
	(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
		(element TOOLTIP_SYSTEM_PARAMS_BLOCK
			(element TooltipSystemParamsModifiersListTTX
				_attributesNegative = "_attributesNegative"
				_attributesPositive = "_attributesPositive"
				_ownerId = "ownerEntity.id"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_SHOT_DELAY'
				_value = "_artilleryTTX.drumFireMode.reloadTime"
				_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = "drumIds.firstParamShotDeleyIds"
				_value = "_artilleryTTX.drumFireMode.firstReloadTime"
				_alternativeValueKey = "ownerEntity.id + '_' + (_isSecondary ? SC.Battle.PARAMETER.firstReloadTimeFull_SecondaryBurstFire : SC.Battle.PARAMETER.firstReloadTimeFull_BurstFire)"
				_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = "drumIds.secondParamShotDeleyIds"
				_value = "_artilleryTTX.drumFireMode.secondReloadTime"
				_alternativeValueKey = "ownerEntity.id + '_' + (_isSecondary ? SC.Battle.PARAMETER.secondReloadTimeFull_SecondaryBurstFire : SC.Battle.PARAMETER.secondReloadTimeFull_BurstFire)"
				_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_DRUM_FIRE_SALVO_SHOT_DELAY'
				_value = "_artilleryTTX.drumFireMode.shotDelay"
				_valueConfig = "VALUE_CONFIG.SECONDS_PRECISE"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_DRUM_FIRE_SALVO_COUNT'
				_value = "_artilleryTTX.drumFireMode.numShots"
				_valueConfig = "VALUE_CONFIG.DEFAULT"
			)
		)
	)
)



(def element AmmoHETTX (_shipTTX:dhStruct, _ammoHETTX:dhStruct)
	(style (width = 100%))
	(element TTX_AMMO_ROW
		_title='IDS_SHIP_PARAM_AMMO_HE_FULL_NAME'
