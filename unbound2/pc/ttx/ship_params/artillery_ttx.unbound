(def element ArtilleryTTX (_shipTTX:dhStruct)
	(scope
		(var mainGun:array = "_shipTTX.artillery.mainGun")
		(var secMainGun:array = "_shipTTX.secondaryArtillery.mainGun")
		(var atba:array = "_shipTTX.artillery.atba")
	)
	(style (width = 100%))
	(class $TTXSecondaryPanel)

	(element TTX_REPEAT
		_elementName='MainGunTTX'
		_shipTTX="_shipTTX"
		_array="mainGun"
	)
	(element TTX_REPEAT
		_elementName='SecMainGunTTX'
		_shipTTX="_shipTTX"
		_array="secMainGun"
	)
	(element TTX_REPEAT
		_elementName='ATBAGunTTX'
		_shipTTX="_shipTTX"
		_array="atba"
	)
	(element TTX_INSTANCE
		_elementName = 'FireModeTTX'
		_shipTTX = "_shipTTX"
		_value = "_shipTTX.artillery.drumFireMode"
	)
	(element TTX_INSTANCE
		_elementName = 'FireModeSecondaryTTX'
		_shipTTX = "_shipTTX"
		_value = "_shipTTX.secondaryArtillery.drumFireMode"
	)

	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_ARTILLERY_MAX_DIST'
		_value = "_shipTTX.artillery.mgMaxDist"
		_valueConfig = "VALUE_CONFIG.KILOMETER"
		_zeroValueHidden = true

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_ARTILLERY_MAX_DIST'
				_descriptionText = 'IDS_TOOLTIP_ARTILLERY_MAX_DIST'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)

	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SECONDARY_ARTILLERY_MAX_DIST'
		_value = "_shipTTX.secondaryArtillery.mgMaxDist"
		_valueConfig = "VALUE_CONFIG.KILOMETER"
		_zeroValueHidden = true

		(controller $Tooltip
			(renderer = 'SimpleTTXTooltip')
			(args
				_headerText = 'IDS_SHIP_PARAM_SECONDARY_ARTILLERY_MAX_DIST'
				_descriptionText = 'IDS_TOOLTIP_SECONDARY_ARTILLERY_MAX_DIST'
			)
			(macro SIMPLE_TTX_TOOLTIP_STYLES)
		)
	)
)



(def element MainGunTTX (_shipTTX:dhStruct, _mainGunTTX:dhStruct)
	(scope
		(var hasDiff:bool = "	_shipTTX.artillery.mgMaxDist.delta ||
								_shipTTX.artillery.mgDispersion.delta ||
								_shipTTX.artillery.mgReloadTime.delta ||
								_shipTTX.artillery.ammoSwitchTime.delta ||
								_shipTTX.artillery.ammoHE && _shipTTX.artillery.ammoHE.hasDiff ||
								_shipTTX.artillery.ammoCS && _shipTTX.artillery.ammoCS.hasDiff ||
								_shipTTX.artillery.ammoAP && _shipTTX.artillery.ammoAP.hasDiff ||
								_shipTTX.artillery.ammoSS && _shipTTX.artillery.ammoSS.hasDiff")
	)
	(style (width = 100%))
	(element ShipParameterGunConfiguration
		_title='IDS_MAIN_CALIBER'
		_gunTTX="_mainGunTTX"
		_externalDiff="hasDiff"

		(controller $Tooltip
			(renderer = 'MainGunTooltipTTX')
			(args
				_shipTTX = "_shipTTX"
				_mainGunTTX = "_mainGunTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)

		(element ShipParamExcursionButton
			_shipTTX = "_shipTTX"
			_excursionId="['_Artillery', $index]"
			_isExcursionOn="false"
		)
	)
)

(def element SecMainGunTTX (_shipTTX:dhStruct, _mainGunTTX:dhStruct)
	(scope
		(var hasDiff:bool = "	_shipTTX.secondaryArtillery.mgMaxDist.delta ||
								_shipTTX.secondaryArtillery.mgDispersion.delta ||
								_shipTTX.secondaryArtillery.mgReloadTime.delta ||
								_shipTTX.secondaryArtillery.ammoSwitchTime.delta ||
								_shipTTX.secondaryArtillery.ammoHE && _shipTTX.secondaryArtillery.ammoHE.hasDiff ||
								_shipTTX.artillerysecondaryArtillery.ammoCS && _shipTTX.secondaryArtillery.ammoCS.hasDiff ||
								_shipTTX.secondaryArtillery.ammoAP && _shipTTX.secondaryArtillery.ammoAP.hasDiff ||
								_shipTTX.secondaryArtillery.ammoSS && _shipTTX.secondaryArtillery.ammoSS.hasDiff")
	)
	(style (width = 100%))
	(element ShipParameterGunConfiguration
		_title='IDS_SEC_MAIN_CALIBER'
		_gunTTX="_mainGunTTX"
		_externalDiff="hasDiff"

		(controller $Tooltip
			(renderer = 'SecMainGunTooltipTTX')
			(args
				_shipTTX = "_shipTTX"
				_mainGunTTX = "_mainGunTTX"
			)
			(macro TTX_TOOLTIP_STYLES)
		)

		(element ShipParamExcursionButton
			_shipTTX = "_shipTTX"
			_excursionId="['_SecondaryArtillery', $index]"
			_isExcursionOn="false"
		)
	)
)

(def element MainGunTooltipTTX (_shipTTX:dhStruct, _mainGunTTX:dhStruct)
	(scope
		(var fireModeSlotComponent:dhComponent = "getSingleComponent(CC.fireModeSlot)")
		(var isDrumFireModeActive:bool = "fireModeSlotComponent.isActive" (event "fireModeSlotComponent.evIsActiveChanged"))
		(var isDrumFire:bool = "fireModeSlotComponent.isDrumFire")
		(var reloadTimeTTX:dhStruct = "isDrumFireModeActive && isDrumFire	? _shipTTX.artillery.drumFireMode.reloadTime
																			: _shipTTX.artillery.mgReloadTime")

		(struct paramsNumShots = PARAMS_NUM_SHOTS(_artilleryTTX = "_shipTTX.artillery"))
		(struct drumIds = SCOPE_GET_DRUM_IDS(_nFirstReloadTimeShots = "paramsNumShots.nFirstReloadTimeShots" _numShotsValue = "paramsNumShots.numShotsValue"))

	)
	(style (width = "TTX_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TTX_HEADER_ROW
			_title='IDS_SHIP_PARAM_MAIN_GUN'
			_descr='IDS_TOOLTIP_MAIN_GUN'
		)
		(element TooltipSystemHorizontalDivider)
		(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
			(element TOOLTIP_SYSTEM_PARAMS_BLOCK
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_SHOT_DELAY'
					_value = "reloadTimeTTX"
					_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
					_zeroValueHidden = true
				)
				(element ShipParameterNumber
					_title = "drumIds.firstParamShotDeleyIds"
					_value = "_shipTTX.artillery.drumFireMode.firstReloadTime"
					_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
					_zeroValueHidden = true
				)
				(element ShipParameterNumber
					_title = "drumIds.secondParamShotDeleyIds"
					_value = "_shipTTX.artillery.drumFireMode.secondReloadTime"
					_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
					_zeroValueHidden = true
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_ARTILLERY_MIN_SWITCH_TIME'
					_value = "_shipTTX.artillery.ammoSwitchTime"
					_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
					_zeroValueHidden = true
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_ROTATION_TIME'
					_value = "_mainGunTTX.rotationTime"
					_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
				)
				(element ShipParameterNumber
					_title = 'IDS_SHIP_PARAM_DISPERSION'
					_value = "_shipTTX.artillery.mgDispersion"
					_valueConfig = "VALUE_CONFIG.METER_NEGATIVE"
				)
				(element ShipParameterNumber
					_title = 'IDS_TOOLTIP_ARTILLERY_SHOOT_DIST'
					_value = "_shipTTX.artillery.mgMaxDist"
					_valueConfig = "VALUE_CONFIG.KILOMETER"
				)
			)
		)
		(element TTX_INSTANCE
			_elementName='AmmoHETTX'
			_shipTTX="_shipTTX"
			_value="_shipTTX.artillery.ammoHE"
		)
		(element TTX_INSTANCE
			_elementName='AmmoCSTTX'
			_shipTTX="_shipTTX"
			_value="_shipTTX.artillery.ammoCS"
		)
		(element TTX_INSTANCE
			_elementName='AmmoAPTTX'
			_shipTTX="_shipTTX"
			_value="_shipTTX.artillery.ammoAP"
		)
		(element TTX_INSTANCE
			_elementName='AmmoSSTTX'
			_shipTTX="_shipTTX"
			_value="_shipTTX.artillery.ammoSS"
		)
		(element TooltipSystemExcursionMouseInstruction
			_shipTTX="_shipTTX"
		)
	)
)

(def element SecMainGunTooltipTTX (_shipTTX:dhStruct, _mainGunTTX:dhStruct)
	(scope
