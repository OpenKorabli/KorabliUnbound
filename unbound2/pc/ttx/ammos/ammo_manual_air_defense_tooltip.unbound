(def element ManualAirDefenseParametersForDock (_shipTTX:dhStruct)
	(scope
		(var airDefenseTTX:dhStruct = "_shipTTX.airDefense")
		(var manualAirDefenseTTX:dhStruct = "airDefenseTTX.manualAirDefense")
	)
	(style (width = 100%))

	(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
		(element TOOLTIP_SYSTEM_PARAMS_BLOCK
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_MANUAL_AIR_DEFENSE_CHARGES'
				_value = "manualAirDefenseTTX.charges"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_MANUAL_AIR_DEFENSE_DAMAGE'
				_value = "airDefenseTTX.bubble.damage"
			)
			(element ShipParameterNumber
				_title 			= 'IDS_SHIP_PARAM_MANUAL_AIR_DEFENSE_RELOAD_TIME'
				_value 			= "manualAirDefenseTTX.reloadTime"
				_valueConfig 	= "VALUE_CONFIG.SECONDS"
			)
			(element ShipParameterNumber
				_title 				= 'IDS_SHIP_PARAM_MANUAL_AIR_DEFENSE_NEGATIVE_EFFECT_DURATION'
				_value 				= "manualAirDefenseTTX.negativeEffectDuration"
				_valueConfig 		= "VALUE_CONFIG.SECONDS"
				_zeroValueHidden 	= true
			)
		)
	)
)

