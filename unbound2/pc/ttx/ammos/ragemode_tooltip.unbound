(def element RageModeParametersForDock (_shipTTX:dhStruct, _isFull:bool=true, _isRageModeParamsHeaderVisible:bool=true, _isDynamicAttributes:bool=true, _avatarId:number="DEFAULT_AVATAR_ID", _showAttributes:bool=true)
	(scope
		(var rageModeTTX:dhStruct = "_shipTTX.specials.rageMode")
		(var rageModeEventTriggerTTX:dhStruct = "rageModeTTX.eventTrigger")
		(var progressName:str = "rageModeEventTriggerTTX.progressAction.progressName ?: ''")
		(var progressIDS:str = "'IDS_PARAMS_MODIFIER_PROGRESS_' + toUpper(progressName)")

		(var isShowProgress:bool = "rageModeEventTriggerTTX.progressAction.progress.value < 100.0")
		(var hasDecrementDelay:bool = "rageModeTTX.decrementDelay.value != 0.0")
		(var hasDecrementCount:bool = "rageModeTTX.decrementCount.value != 0.0")
		(var hasAnyActivator:bool = "rageModeEventTriggerTTX.potentialActivator || rageModeEventTriggerTTX.timerActivator || rageModeEventTriggerTTX.shotActivator")
		(var isShowUpperBlock:bool = "(isShowProgress || hasDecrementDelay || hasDecrementCount || hasAnyActivator) && _isFull")
	)
	(style (width = 100%))
	(block
		(bind visible "isShowUpperBlock")
		(style (width = 100%))
		(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
			(element TOOLTIP_SYSTEM_PARAMS_BLOCK
				(block
					(style (width = 100%))
					(controller $Instance renderer='ShipParameterNumber'
						(bind enabled "rageModeEventTriggerTTX.potentialActivator")
						(args
							_title = 'IDS_PARAMS_MODIFIER_POTENTIALDAMAGESHIFT_RAGEMODE'
							_value = "rageModeEventTriggerTTX.potentialActivator.potentialDamageShift"
						)
					)

					(controller $Instance renderer='ShipParameterNumber'
						(bind enabled "rageModeEventTriggerTTX.timerActivator")
						(args
							_title = 'IDS_PARAMS_MODIFIER_DURATION_RAGEMODETIMER'
							_value = "rageModeEventTriggerTTX.timerActivator.duration"
							_valueConfig = "VALUE_CONFIG.SECONDS"
						)
					)

					(controller $Instance renderer='ShipParameterNumber'
						(bind enabled "rageModeEventTriggerTTX.shotActivator")
						(args
							_title = 'IDS_PARAMS_MODIFIER_RADIUS_RAGEMODE'
							_value = "rageModeEventTriggerTTX.shotActivator.radius"
							_valueConfig = "VALUE_CONFIG.KILOMETER"
						)
					)
				)
				(block
					(style (width = 100%))
					(controller $Instance renderer='ShipParameterNumber'
						(bind enabled "isShowProgress")
						(args
							_title = "progressIDS"
							_value = "rageModeEventTriggerTTX.progressAction.progress"
							_valueConfig = "VALUE_CONFIG.PERCENT"
						)
					)
				)
				(block
					(style (width = 100%))
					(controller $Instance renderer='ShipParameterNumber'
						(bind enabled "hasDecrementDelay")
						(args
							_title = 'IDS_PARAMS_MODIFIER_DECREMENTDELAY_RAGEMODE'
							_value = "rageModeTTX.decrementDelay"
							_valueConfig = "VALUE_CONFIG.SECONDS"
						)
					)
				)
				(block
					(style (width = 100%))
					(controller $Instance renderer='ShipParameterNumber'
						(bind enabled "hasDecrementCount")
						(args
							_title = 'IDS_PARAMS_MODIFIER_DECREMENTCOUNT_RAGEMODE'
							_value = "rageModeTTX.decrementCount"
							_valueConfig = "VALUE_CONFIG.PERCENT"
						)
					)
				)
			)
		)
	)
	(block
		(style (width = 100%))
		(controller $Instance renderer='RageModeTooltipParameters'
			(bind enabled "_showAttributes")
			(args
				_rageModeTTX = "rageModeTTX"
				_isShowUpperBlock = "isShowUpperBlock"
				_avatarId = "_avatarId"
				_isDynamicAttributes="_isDynamicAttributes"
				_isRageModeParamsHeaderVisible="_isRageModeParamsHeaderVisible"
			)
		)
	)
)

(def element RageModeTooltipParameters (_rageModeTTX:dhStruct, _isShowUpperBlock:bool=true, _avatarId:number="DEFAULT_AVATAR_ID", _isDynamicAttributes:bool=true, _isRageModeParamsHeaderVisible:bool=true)
	(scope
		(var rageModeBonusTriggerTTX:dhStruct = "_rageModeTTX.bonusTrigger")
		(var squadronType:str = "rageModeBonusTriggerTTX.squadronTimeAction.squadronType ?: ''")
		(var squadronReduceTimeIDS:str = "'IDS_PARAMS_MODIFIER_REDUCE_TIME_' + squadronType")

		(var rageModeSlotEntity:dhEntity = "getPrimaryEntity(CC.visualSlotData, SC.Ships.SHIP_INFO_WEAPON_TYPE.VALUE_TO_NAME[SC.Ships.SHIP_INFO_WEAPON_TYPE.RAGE_MODE] + '_' + _avatarId)")
		(var attributeComponent:dhComponent = "rageModeSlotEntity.attributes")
		(var attributesRageModeNegative:array =	"attributeComponent.negative	?: []" (event "attributeComponent.evChanged"))
		(var attributesRageModePositive:array =	"attributeComponent.positive	?: []" (event "attributeComponent.evChanged"))
		(var attributesRageModeNeutral:array =	"attributeComponent.neutral		?: []" (event "attributeComponent.evChanged"))

		(var rageModeStateComponent:dhComponent = "getSingleComponent(CC.rageModeState)")
		(var currentActivationCount:number = "rageModeStateComponent.currentActivationCount ?: 0" (event "rageModeStateComponent.evCurrentActivationCountChanged"))
		(var isStagingStarted:bool = "currentActivationCount > 0 && _isDynamicAttributes")
	)
	(style (width = 100%))
	(block
		(bind visible "_isRageModeParamsHeaderVisible")
		(style (width = 100%))

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider'
				(bind enabled "_isShowUpperBlock")
			)
		)

		(element TooltipSystemSecondaryHeaderText
			_headerText = "isStagingStarted ? 'IDS_RAGE_MODE_CURRENT_PARAMS_HEADER' : 'IDS_RAGE_MODE_PARAMS_HEADER'"
		)
		(element TooltipSystemHorizontalDivider)
	)
	(block
		(style (width = 100%))
		(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
			(element TOOLTIP_SYSTEM_PARAMS_BLOCK

				(element ShipParameterNumber
					_title = 'IDS_PARAMS_MODIFIER_REGENERATIONHPSPEED'
					_value = "rageModeBonusTriggerTTX.healAction.healPerSecond"
					_valueConfig = "VALUE_CONFIG.FLOAT_GREEN"
					_zeroValueHidden = true
				)

				(block
					(style (width = 100%))
					(controller $Instance renderer='ShipParameterNumber'
						(bind enabled "rageModeBonusTriggerTTX.squadronTimeAction")
						(args
							_title = "squadronReduceTimeIDS"
							_value = "rageModeBonusTriggerTTX.squadronTimeAction.reduceTime"
							_valueConfig = "VALUE_CONFIG.SECONDS"
						)
					)
				)

				(element ShipParameterNumber
					_title = 'IDS_PARAMS_MODIFIER_VAMPIREDAMAGE_AMOUNT_RAGEMODE'
					_value = "rageModeBonusTriggerTTX.consumablesCountAction.count"
					_valueConfig = "VALUE_CONFIG.INT_GREEN_SIGNED"
					_zeroValueHidden = true
				)

				(block
					(style (width = 100%))
					(controller $Instance renderer='ShipParameterNumberValuesPair'
						(bind enabled "isStagingStarted")
						(args
							_title = 'IDS_PARAMS_MODIFIER_STAGEDAMOUNT'
							_value1 = "currentActivationCount"
							_value2 = "_rageModeTTX.maxActivationCount"
						)
					)
				)

				(element TooltipSystemParamsModifiersListTTX
					_attributesNegative="attributesRageModeNegative"
					_attributesPositive="attributesRageModePositive"
					_attributesNeutral="attributesRageModeNeutral"
				)

				(element ShipParameterNumber
					_title = 'IDS_PARAMS_MODIFIER_WORKTIME_RAGEMODE'
					_value = "_rageModeTTX.boostDuration"
					_valueConfig = "VALUE_CONFIG.SECONDS"
					_zeroValueHidden = true
				)
			)
		)
	)
)

(def element RageModeParametersInfotip ()
	(scope
		(event evLevelChanged)

		(var rageModeAttributesComponent:dhComponent = "getSingleComponent(CC.rageModeAttributes)")
		(var rageModeAttributes:array = "rageModeAttributesComponent.attributes")
		(var level:number = "$event.level ?: 0" (event "evLevelChanged"))
	)
	(macro HIDE_UI_ON_SHIPOVERVIEW)
	(style (width = 380px))

	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND _isInfotip="true")

	(element INFOTIP_SYSTEM_DEFAULT_CONTAINER
		(block
			(style
				(width = 100%)
				(padding = "M")
			)
			(element TooltipSystemHeaderSubheaderText
				_headerText = 'IDS_RAGE_MODE_LEVELS_INFOTIP_HEADER'
			)
		)

		(element HorizontalDividerTwoPx)

		(hblock
			(style (width = 100%))

			(controller $Repeat renderer='RageModeParametersInfotipTabButtonWrapper'
				(bind count "rageModeAttributes.length")
				(args
					_activeGroup = "level"
					_maxActivationCount = "rageModeAttributes.length"
				)
			)
		)

		(block
			(style 
				(width = 100%)
				(marginTop = "-XXS")
			)
			(element HorizontalDividerTwoPx)
		)

		(block
			(style (width = 100%))
			(element INFOTIP_SYSTEM_PARAMS_WRAPPER
				(element INFOTIP_SYSTEM_PARAMS_BLOCK
					(element TooltipSystemParamsModifiersListTTX
						_attributesNegative="rageModeAttributes[level].negative"
						_attributesPositive="rageModeAttributes[level].positive"
						_attributesNeutral="rageModeAttributes[level].neutral"
					)
				)
			)
		)

		(element HorizontalDividerTwoPx)

		(block
			(style
				(width = 100%)
				(padding = "SXS")
			)

			(element TooltipSystemStatusLine
				_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.INFO"
				_text = 'IDS_RAGE_MODE_LEVELS_INFOTIP_INFO'
			)
		)
	)
)

(def element RageModeParametersInfotipTabButtonWrapper (_activeGroup:number, _maxActivationCount:number)
	(scope
		(event evLevelChanged)
		(var levelLabel:str = "SC.Common.ROMAN_DIGITS.COMMON[$index + 1]")
	)
	(style (bind width "toPercent(100 / _maxActivationCount)"))
	(element TabButton
		_isSelected = "_activeGroup == $index"
		_width = 100%
		_dispatchedEv = 'evLevelChanged'
		_dispatchParams = "{ level: $index }"
		_label = "levelLabel"
	)
)

(def element RageModeParametersForBattle (_shipTTX:dhStruct, _avatarId:number="DEFAULT_AVATAR_ID", _isFull:bool=true, _isRageModeParamsHeaderVisible:bool=true, _isDynamicAttributes:bool=true)
	(scope
		(macro SELF_AVATAR_ID)
		(var isSelfAvatar:bool = "_avatarId == selfAvatarId")
	)
	(style (width = 100%))
	
	(element RageModeParametersForDock
		_shipTTX="_shipTTX"
		_isFull="_isFull"
		_isRageModeParamsHeaderVisible="_isRageModeParamsHeaderVisible"
		_isDynamicAttributes="_isDynamicAttributes"
		_avatarId="	!isSelfAvatar || _isDynamicAttributes ? _avatarId	: DEFAULT_AVATAR_ID"
	)
)
