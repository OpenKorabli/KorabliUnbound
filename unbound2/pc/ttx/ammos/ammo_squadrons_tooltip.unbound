




(def element SHARED_SQUADRON_PARAMETERS (_squadronTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SQUADRON_VITALITY'
		_value = "_squadronTTX.health"
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SQUADRON_SPEED'
		_value = "_squadronTTX.speed"
		_valueConfig = "VALUE_CONFIG.KNOT"
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SQUADRON_SPEED_MAX'
		_value = "_squadronTTX.maxSpeed"
		_valueConfig = "VALUE_CONFIG.KNOT"
	)
	(element ShipParameterNumber
		_title 				= 'IDS_SHIP_PARAM_SQUADRON_JATO_DURATION'
		_value 				= "_squadronTTX.jatoDuration"
		_valueConfig 		= "VALUE_CONFIG.SECONDS"
		_zeroValueHidden 	= true
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SQUADRON_NUM_ATTACKERS'
		_value = "_squadronTTX.numAttackers"
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SQUADRON_NUM_PLANES'
		_value = "_squadronTTX.numPlanes"
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_HANGARVOLUME'
		_value = "_squadronTTX.hangarVolume"
	)
	(element ShipParameterPair
		_title = 'IDS_SHIP_PARAM_SQUADRON_PLANES_RESTORE_RATE'
		_value1 = "_squadronTTX.restorePlanes"
		_value2 = "_squadronTTX.restoreTime"
		_valueConfig2 = "VALUE_CONFIG.SECONDS_NEGATIVE"
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SQ_VISIBILITY_DIST_BY_SHIP'
		_value = "_squadronTTX.visibility"
		_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
	)
	(element ShipParameterBool
		_title = 'IDS_PARAMS_MODIFIER_NOTAVAILABLE_PERISCOPESTATE'
		_value = "_squadronTTX.disabledUnderwater"
	)
)

(def element  TTX_SQUADRON_PARAMS_TOOLTIP (_squadronTTX:dhStruct)
	(style (width = 100%))
	(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
		(element TOOLTIP_SYSTEM_PARAMS_BLOCK
			(element SHARED_SQUADRON_PARAMETERS
				_squadronTTX="_squadronTTX"
			)
		)
	)
)

