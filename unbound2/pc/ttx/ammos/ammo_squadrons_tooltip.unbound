(def element SquadronFighterParametersForBattle (_shipTTX:dhStruct, _ownerEntityId:number)
	(scope
		(var squadronTTX:dhStruct = "_shipTTX.squadrons.fighter")
		(var bombTTX:dhStruct = "	squadronTTX.rocketAP	? squadronTTX.rocketAP :
									squadronTTX.rocketHE	? squadronTTX.rocketHE
															: null")
	)
	(style (width = 100%))
	(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
		(element TOOLTIP_SYSTEM_PARAMS_BLOCK
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_SQUADRON_VITALITY'
				_value = "squadronTTX.health"
				_alternativeValueKey = "_ownerEntityId + '_' + SC.Battle.PARAMETER.vitality"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_SQUADRON_SPEED'
				_value = "squadronTTX.speed"
				_alternativeValueKey = "_ownerEntityId + '_' + SC.Battle.PARAMETER.cruiseSpeed"
				_valueConfig = "VALUE_CONFIG.KNOT"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_SQUADRON_SPEED_MAX'
				_value = "squadronTTX.maxSpeed"
				_alternativeValueKey = "_ownerEntityId + '_' + SC.Battle.PARAMETER.maxSpeed"
				_valueConfig = "VALUE_CONFIG.KNOT"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_SQUADRON_JATO_DURATION'
				_value = "squadronTTX.jatoDuration"
				_valueConfig = "VALUE_CONFIG.SECONDS"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_SQUADRON_NUM_ATTACKERS'
				_value = "squadronTTX.numAttackers"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_SQUADRON_NUM_PLANES'
				_value = "squadronTTX.numPlanes"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_HANGARVOLUME'
				_value = "squadronTTX.hangarVolume"
			)
			(element ShipParameterRepeat
				_title = 'IDS_SHIP_PARAM_SQUADRON_PLANES_RESTORE_RATE'
				_values = "[squadronTTX.restorePlanes, squadronTTX.restoreTime]"
				_alternativeValueKeys = "['', _ownerEntityId + '_' + SC.Battle.PARAMETER.planeRespawnTime]"
				_valueConfigs = "[VALUE_CONFIG.DEFAULT, VALUE_CONFIG.SECONDS_NEGATIVE]"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_SQ_VISIBILITY_DIST_BY_SHIP'
				_value = "squadronTTX.visibility"
				_alternativeValueKey = "_ownerEntityId + '_' + SC.Battle.PARAMETER.visibilityRange"
				_valueConfig = "VALUE_CONFIG.KILOMETER_NEGATIVE"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_SQUADRON_AMMO_COUNT_FIGHTER'
				_value = "bombTTX.numBombs"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_SQUADRON_ROCKET_DAMAGE'
				_value = "bombTTX.damage"
				_alternativeValueKey = "_ownerEntityId + '_' + SC.Battle.PARAMETER.fighterDamage"
			)
			(element ShipParameterBool
				_title = 'IDS_PARAMS_MODIFIER_NOTAVAILABLE_PERISCOPESTATE'
				_value = "squadronTTX.disabledUnderwater"
			)
		)
	)
)

(def element SquadronFighterAltParametersForBattle (_shipTTX:dhStruct, _ownerEntityId:number)
	(scope
		(var squadronTTX:dhStruct = "_shipTTX.squadrons.fighterAlt")
		(var bombTTX:dhStruct = "	squadronTTX.rocketAP	? squadronTTX.rocketAP :
									squadronTTX.rocketHE	? squadronTTX.rocketHE
															: null")
