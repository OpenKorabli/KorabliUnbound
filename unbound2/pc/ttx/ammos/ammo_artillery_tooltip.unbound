(def struct PARAMS_NUM_SHOTS(_artilleryTTX:dhStruct)
	(var nFirstReloadTimeShots:number = "_artilleryTTX.drumFireMode.nFirstReloadTimeShots.value")
	(var numShotsValue:number = "_artilleryTTX.drumFireMode.numShots.value")
)

(def struct SCOPE_GET_DRUM_IDS(_nFirstReloadTimeShots:number, _numShotsValue:number)
	(var firstShotCount:str = "_nFirstReloadTimeShots > 1	? 1 + '–' + _nFirstReloadTimeShots
															: toString(_nFirstReloadTimeShots)")
	(var secondShotCount:str = "_nFirstReloadTimeShots + 1 != _numShotsValue	? (_nFirstReloadTimeShots + 1) + '–' + _numShotsValue
																			: toString(_numShotsValue)")

	(var firstIdsNumber:number = "_nFirstReloadTimeShots > 1 ? 2 : 1")
	(var secondIdsNumber:number = "_nFirstReloadTimeShots + 1 != _numShotsValue ? 2 : 1")

	(var firstParamShotDeleyIds:str = "_nFirstReloadTimeShots == _numShotsValue ? 'IDS_SHIP_PARAM_SHOT_DELAY':
																				subst('IDS_SHIP_PARAM_DRUM_SHOT_DELAY',[], {_shotCount: firstShotCount}, firstIdsNumber)")
	(var secondParamShotDeleyIds:str = "subst('IDS_SHIP_PARAM_DRUM_SHOT_DELAY',[], {_shotCount: secondShotCount}, secondIdsNumber)")
)

