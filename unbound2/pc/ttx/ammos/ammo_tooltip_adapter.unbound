(def element BattleAmmoParameters (_ttxDescriptor:str, _ownerId:number)
	(scope
		(var selfVehicle:dhComponent = "getSingleComponent(CC.selfVehicle)")
		(var shipTTX:dhStruct = "selfVehicle.shipTTX")
		(var rendererName:str = "_ttxDescriptor in BATTLE_AMMO_DESCRIPTOR_TO_RENDERER	? BATTLE_AMMO_DESCRIPTOR_TO_RENDERER[_ttxDescriptor]
																						: 'DefaultParametersForTooltip'"
		)
	)
	(style (width = 100%))
	(controller $Instance
		(bind enabled "shipTTX != null")
		(bind renderer "rendererName")
		(args "shipTTX" "_ownerId")
	)
)


(def element AmmoParametersAdapter (_ttxDescriptor:str)
	(scope
		(var comparison:dhComponent = "getSingleComponent(CC.comparison)")
		(var panelTTX:dhStruct = "comparison.panelTTX" (event "comparison.evPanelTTXChanged"))
		(var rendererName:str = "_ttxDescriptor in DOCK_AMMO_DESCRIPTOR_TO_RENDERER	? DOCK_AMMO_DESCRIPTOR_TO_RENDERER[_ttxDescriptor]
																					: 'DefaultParametersForTooltip'"
		)
	)
	(style (width = 100%))

	(controller $Instance
		(bind enabled "panelTTX != null")
		(bind renderer "rendererName")
		(args "panelTTX")
	)
)

(def element SimplifiedAmmoParametersAdapter (_ttxDescriptor:str, _ammoTTX:dhStruct)
	(scope
		(var rendererName:str = "_ttxDescriptor in DOCK_AMMO_DESCRIPTOR_TO_RENDERER	? 'Simplified' + DOCK_AMMO_DESCRIPTOR_TO_RENDERER[_ttxDescriptor]
																					: 'DefaultParametersForTooltip'"
		)
	)
	(style (width = 100%))

	(controller $Instance
		(bind enabled "_ammoTTX != null")
		(bind renderer "rendererName")
		(args "_ammoTTX")
	)
)

(def element AmmoParametersAdapterInBattlePage (_ttxDescriptor:str, _shipTTX:dhStruct, _avatarId:number)
	(scope
		(var rendererName:str = "_ttxDescriptor in BATTLE_AMMO_DESCRIPTOR_TO_RENDERER	? BATTLE_AMMO_DESCRIPTOR_TO_RENDERER[_ttxDescriptor]
																						: 'DefaultParametersForTooltip'"
		)
	)

	(style (width = 100%))

	(controller $Instance
		(bind enabled "_shipTTX != null")
		(bind renderer "rendererName")
		(args "_shipTTX"
			_isFull = false
			_isRageModeParamsHeaderVisible = true
			_isDynamicAttributes = false
			_ownerEntityId = "DEFAULT_AVATAR_ID"
			_avatarId = "_avatarId"
		)
	)
)

(def element DefaultParametersForTooltip (_shipTTX:dhStruct)
	(style (width = 100%))
	(macro trace "_shipTTX")
)