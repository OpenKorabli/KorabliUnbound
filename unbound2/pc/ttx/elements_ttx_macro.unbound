(def css $TTXValueRowHorizontal ()
	(flow = "horizontal")
	(width = 100%)
	(marginTop = 6px)
	(marginBottom = 6px)
	(backgroundColor = "NO_COLOR")
)

(def css $TextTTXLine ()
	(extends $TextDefaultNM)
	(leading = -3)
	(alpha = "TA")
)

(def css $TextTTXLineBold ()
	(extends $TextDefaultBoldNM)
	(leading = -3)
	(alpha = "TA")
)

(def constant TTX_TOOLTIP_WIDTH 340px)

(def element TTX_INSTANCE (_elementName:str, _shipTTX:dhStruct, _value:dhStruct, _enabled:bool=true)
	(style (width = 100%))
	(controller $Instance
		(bind enabled "_enabled && _elementName && _value != null")
		(args "_shipTTX" "_value")
		(bind renderer "_elementName")
	)
)

(def element TTX_INSTANCE_SELECTOR (_elementName:str, _shipTTX:dhStruct, _value:dhStruct, _enabled:bool=true)
	(style (width = 100%))
	(controller $Instance
		(bind enabled "_enabled && _elementName && _value != null")
		(args "_shipTTX" "_value")
		(bind renderer "_elementName")
	)
)

(def element TTX_REPEAT (_elementName:str, _shipTTX:dhStruct, _array:array)
	(style (width = 100%))
	(controller $Repeat
		(bind enabled "_array")
		(bind count "_array ? _array.length : 0")
		(bind renderer "_elementName")
		(args "_shipTTX" "_array[$index]")
	)
)

(def element TTX_AMMO_ROW (_title:str, _ammoTTX:dhStruct, _needTopDivider:bool=true)
	(style (width = 100%))
	(block
		(style (width = 100%))
		(controller $Instance renderer='TooltipSystemHorizontalDivider'
			(bind enabled "_needTopDivider")
		)
	)
	(element TooltipSystemHeaderSubheaderText
		_headerText = "'IDS_' + toUpper(_ammoTTX.name)"
		_subheaderText = "_title"
		_headerSize = "SIZE.SMALL"
	)
	(element TooltipSystemHorizontalDivider)
)

(def element TTX_INNER_HEADER_ROW (_title:str)
	(style (width = 100%))
	(element TooltipSystemHorizontalDivider)
	(element TooltipSystemHeaderSubheaderText
		_headerText = "_title"
		_headerSize = "SIZE.SMALL"
	)
	(element TooltipSystemHorizontalDivider)
)

(def element TTX_HEADER_ROW (_title:str, _descr:str)
	(style (width = 100%))
	(element TooltipSystemHeaderSubheaderText
		_headerText = "_title"
	)
	(element TooltipSystemHorizontalDivider)
	(element TooltipSystemHtmlDescriptionText
		_descriptionText = "_descr"
	)
)

(def element TTX_HEADER_ROW_SIMPLE (_title:str)
	(style (width = 100%))
	(element TooltipSystemHeaderSubheaderText
		_headerText = "_title"
	)
	(element TooltipSystemHorizontalDivider)
)


(def element TTX_ROW_SIMPLE (_text:str, _isDividerEnabled:bool=false)
	(style (width = 100%))
	(element TooltipSystemHtmlDescriptionText
		_descriptionText = "_text"
	)
	(block
		(style (width = 100%))
		(controller $Instance renderer='TooltipSystemHorizontalDivider'
			(bind enabled "_isDividerEnabled")
		)
	)
)

(def macro TTX_TOOLTIP_STYLES ()
	(macro SIMPLE_TOOLTIP_ANIMATION)
	(align="bottom|left")
	(offset=[10, 0])
	(screenBoundsOffset=50)
)

(def macro SIMPLE_TTX_TOOLTIP_STYLES ()
	(macro SIMPLE_TOOLTIP_ANIMATION)
	(align="bottom|left")
	(offset=[20, 0])
	(screenBoundsOffset=50)
)
