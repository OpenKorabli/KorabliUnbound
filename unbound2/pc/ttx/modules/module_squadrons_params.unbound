(def element FighterName (_shipTTX:dhStruct, _squadronTTX:dhStruct)
	(style (width = 100%))
	(element TTX_AMMO_ROW
		_title = 'IDS_MODULE_TYPE_FIGHTER'
		_ammoTTX = "_squadronTTX"
		_needTopDivider = false
	)
)

(def element ModuleRocketHEParams (_shipTTX:dhStruct, _rocketTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = "tr('IDS_SHIP_PARAM_SQUADRON_AMMO_ROCKET_HE_SHORT') + ' ' + tr('IDS_' + _rocketTTX.name)"
		_value = "_rocketTTX.numBombs"
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SQUADRON_ROCKET_DAMAGE'
		_value = "_rocketTTX.damage"
	)
)

(def element RocketAPParams (_shipTTX:dhStruct, _rocketTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = "tr('IDS_SHIP_PARAM_SQUADRON_AMMO_ROCKET_AP_SHORT') + ' ' + tr('IDS_' + _rocketTTX.name)"
		_value = "_rocketTTX.numBombs"
	)
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_SQUADRON_ROCKET_DAMAGE'
		_value = "_rocketTTX.damage"
	)
)

(def element FighterParams (_shipTTX:dhStruct, _squadronTTX:dhStruct)
	(scope
		(var isTwoSquadrons:bool = "_shipTTX.squadrons.fighter && _shipTTX.squadrons.fighterAlt")
	)
	(style (width = 100%))
	(element TTX_INSTANCE
		_elementName='FighterName'
		_shipTTX="_shipTTX"
		_value="_squadronTTX"
		_enabled="isTwoSquadrons"
	)
	(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
		(element TOOLTIP_SYSTEM_PARAMS_BLOCK
			(element SHARED_SQUADRON_PARAMETERS
				_squadronTTX="_squadronTTX"
			)
			(element TTX_INSTANCE
				_elementName='ModuleRocketHEParams'
				_shipTTX="_shipTTX"
				_value="_squadronTTX.rocketHE"
			)
			(element TTX_INSTANCE
				_elementName='RocketAPParams'
				_shipTTX="_shipTTX"
				_value="_squadronTTX.rocketAP"
			)
		)
	)
)

(def element ModuleFighterParametersForDock (_shipTTX:dhStruct, _hasIntegralDiff:bool)
	(scope
		(var squadrons:dhStruct = "_shipTTX.squadrons")
		(var mainPlane:dhStruct = "squadrons.fighter")
		(var altPlane:dhStruct = "squadrons.fighterAlt")
		(var isTwoSquadrons:bool = "mainPlane != null && altPlane != null")
	)
	(style (width = 100%))
	(element TTX_INSTANCE
		_elementName='FighterParams'
		_shipTTX="_shipTTX"
		_value="mainPlane"
	)
	(block
		(style (width = 100%))
		(controller $Instance renderer='TooltipSystemHorizontalDivider'
			(bind enabled "isTwoSquadrons")
		)
	)
	(element TTX_INSTANCE
		_elementName='FighterParams'
		_shipTTX="_shipTTX"
		_value="altPlane"
	)
	(element TTX_INSTANCE
		_elementName='ModuleIntegralParams'
		_shipTTX="_shipTTX"
		_value="_shipTTX"
		_enabled="_hasIntegralDiff"
	)
)

