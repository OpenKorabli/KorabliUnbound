(def element MaxSpeedUnderwater (_shipTTX:dhStruct, _underwaterMobilityTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_MAX_SPEED_UNDER_WATER'
		_value = "_underwaterMobilityTTX.speed"
		_valueConfig = "VALUE_CONFIG.KNOT_FLOAT"
	)
)

(def element ModuleEngineParametersForDock (_shipTTX:dhStruct, _hasIntegralDiff:bool)
	(style (width = 100%))
	(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
		(element TOOLTIP_SYSTEM_PARAMS_BLOCK
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_MAXSPEED'
				_value = "_shipTTX.mobility.speed"
				_valueConfig = "VALUE_CONFIG.KNOT_FLOAT"
			)
			(element TTX_INSTANCE
				_elementName='MaxSpeedUnderwater'
				_shipTTX="_shipTTX"
				_value="_shipTTX.underwaterMobility"
			)
		)
	)
	(element TTX_INSTANCE
		_elementName='ModuleIntegralParams'
		_shipTTX="_shipTTX"
		_value="_shipTTX"
		_enabled="_hasIntegralDiff"
	)
)
