(def element AmmoHEDamage (_shipTTX:dhStruct, _ammoHETTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_DAMAGE_HE'
		_value = "_ammoHETTX.damage"
	)
)
(def element AmmoCSDamage (_shipTTX:dhStruct, _ammoCSTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_DAMAGE_CS'
		_value = "_ammoCSTTX.damage"
	)
)
(def element AmmoAPDamage (_shipTTX:dhStruct, _ammoAPTTX:dhStruct)
	(style (width = 100%))
	(element ShipParameterNumber
		_title = 'IDS_SHIP_PARAM_DAMAGE_AP'
		_value = "_ammoAPTTX.damage"
	)
)

(def element ModuleArtilleryParametersForDock (_shipTTX:dhStruct, _hasIntegralDiff:bool)
	(scope
		(var anyGun:dhStruct = "_shipTTX.artillery.mainGun[0]")
		(var rotationTime:dhStruct = "anyGun ? anyGun.rotationTime : STUB_VALUE")
		(struct paramsNumShots = PARAMS_NUM_SHOTS(_artilleryTTX = "_shipTTX.artillery"))
		(struct drumIds = SCOPE_GET_DRUM_IDS(_nFirstReloadTimeShots = "paramsNumShots.nFirstReloadTimeShots" _numShotsValue = "paramsNumShots.numShotsValue"))
	)
	(style (width = 100%))
	(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
		(element TOOLTIP_SYSTEM_PARAMS_BLOCK
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_SHOT_DELAY'
				_value = "_shipTTX.artillery.mgReloadTime"
				_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = "drumIds.firstParamShotDeleyIds"
				_value = "_shipTTX.artillery.drumFireMode.firstReloadTime"
				_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = "drumIds.secondParamShotDeleyIds"
				_value = "_shipTTX.artillery.drumFireMode.secondReloadTime"
				_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_ARTILLERY_MIN_SWITCH_TIME'
				_value = "_shipTTX.artillery.ammoSwitchTime"
				_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_ROTATION_TIME'
				_value = "rotationTime"
				_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
			)
			(element TTX_INSTANCE
				_elementName='AmmoHEDamage'
				_shipTTX="_shipTTX"
				_value="_shipTTX.artillery.ammoHE"
			)
			(element TTX_INSTANCE
				_elementName='AmmoCSDamage'
				_shipTTX="_shipTTX"
				_value="_shipTTX.artillery.ammoCS"
			)
			(element TTX_INSTANCE
				_elementName='AmmoAPDamage'
				_shipTTX="_shipTTX"
				_value="_shipTTX.artillery.ammoAP"
			)
		)
	)
	(element TTX_INSTANCE
		_elementName='ModuleIntegralParams'
		_shipTTX="_shipTTX"
		_value="_shipTTX"
		_enabled="_hasIntegralDiff"
	)
)