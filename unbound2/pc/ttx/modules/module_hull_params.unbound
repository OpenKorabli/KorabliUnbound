(def element ModuleHullParametersForDock (_shipTTX:dhStruct, _hasIntegralDiff:bool)
	(style (width = 100%))
	(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
		(element TOOLTIP_SYSTEM_PARAMS_BLOCK
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_HEALTH'
				_value = "_shipTTX.durability.health"
			)
			(element ShipParameterRange
				_title = 'IDS_SHIP_PARAM_ARMOR'
				_valueMin = "_shipTTX.armor.min"
				_valueMax = "_shipTTX.armor.max"
				_valueConfig = "VALUE_CONFIG.MILLIMETER"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_ARTILLERY_GUNS_COUNT'
				_value = "_shipTTX.hull.artilleryGunsCount"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_SEC_ARTILLERY_GUNS_COUNT'
				_value = "_shipTTX.hull.secArtilleryGunsCount"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_ATBA_GUNS_COUNT'
				_value = "_shipTTX.hull.atbaGunsCount"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_TORPEDOES_GUNS_COUNT'
				_value = "_shipTTX.hull.torpedoesGunsCount"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_AA_GUNS_COUNT'
				_value = "_shipTTX.hull.aaGunsCount"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_DEPTH_CHARGE_GUNS_COUNT'
				_value = "_shipTTX.hull.depthChargeGunsCount"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_BATTERY_MAX_CAPACITY'
				_value = "_shipTTX.hull.batteryCapacity"
				_valueConfig = "VALUE_CONFIG.UNITS"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title 				= 'IDS_SHIP_PARAM_HYDROPHONE_WAVE_RADIUS'
				_value 				= "_shipTTX.hull.hydrophoneWaveRadius"
				_valueConfig 		= "VALUE_CONFIG.KILOMETER"
				_zeroValueHidden 	= true
			)
		)
	)
	(element TTX_INSTANCE
		_elementName='ModuleIntegralParams'
		_shipTTX="_shipTTX"
		_value="_shipTTX"
		_enabled="_hasIntegralDiff"
	)
)