
(def element TorpedoName (_shipTTX:dhStruct, _torpedoTTX:dhStruct)
	(scope
		(var isGroup:bool = "_shipTTX.torpedoGroups != null")
		(var torpedoesTTX:dhStruct = "isGroup ? _shipTTX.torpedoGroups : _shipTTX.torpedoes")
		(var isTwoTorpedoes:bool = "torpedoesTTX.torpedo && torpedoesTTX.torpedoAlt")
	)
	(style (width = 100%))
	(element TTX_AMMO_ROW
		_title="'IDS_SHIP_PARAM_' + toUpper(_torpedoTTX.type) + '_AMMO'"
		_ammoTTX="_torpedoTTX"
		_needTopDivider="!isTwoTorpedoes"
	)
)

(def element TorpedoLoaderInfoSeparate (_shipTTX:dhStruct, _torpedoTTX:dhStruct)
	(style (width = 100%))
	(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
		(element TOOLTIP_SYSTEM_PARAMS_BLOCK
			(block
				(class $TTXValueRowHorizontal)
				(macro TTX_ROW_TITLE "'IDS_SHIP_PARAM_TORPEDO_LOADERS_COUNT'")
				(block
					(class $TTXValueContainer)
					(controller $Repeat renderer='TorpedoLoadersCount'
						(bind count "_torpedoTTX.groups.length")
						(args
							_torpedoGroupTTX="_torpedoTTX.groups[$index]"
						)
					)
				)
			)
		)
	)
)

(def element TorpedoLoaderInfoInner (_shipTTX:dhStruct, _torpedoTTX:dhStruct)
	(style (width = 100%))
	(block
		(class $TTXValueRowHorizontal)
		(macro TTX_ROW_TITLE "'IDS_SHIP_PARAM_TORPEDO_LOADERS_COUNT'")
		(block
			(class $TTXValueContainer)
			(controller $Repeat renderer='TorpedoLoadersCount'
				(bind count "_torpedoTTX.groups.length")
				(args
					_torpedoGroupTTX="_torpedoTTX.groups[$index]"
				)
			)
		)
	)
)

(def element TorpedoLoadersCount (_torpedoGroupTTX:dhStruct)
	(style (flow = "horizontal"))
	(macro TTX_DELIMITER '/' _enabled="$index > 0")
	(tf
		(class $TextTTXLine)
		(bind text "_torpedoGroupTTX.numLoaders.value")
	)
)

(def element TorpedoModuleParams (_shipTTX:dhStruct, _torpedoTTX:dhStruct)
	(scope
		(var isGroup:bool = "_shipTTX.torpedoGroups != null")
		(var torpedoesTTX:dhStruct = "isGroup ? _shipTTX.torpedoGroups : _shipTTX.torpedoes")
		(var torpedoesReloadTime:dhStruct = "isGroup ? torpedoesTTX.groups[0].reloadTime : torpedoesTTX.reloadTime")
		(var torpedoes:dhStruct = "isGroup ? _shipTTX.torpedoGroups.groups[0] : _shipTTX.torpedoes")
		(struct paramsNumShots = TORPEDO_PARAMS_NUM_SHOTS(_torpedoes = "torpedoes"))
		(struct torpedoChargeIds = SCOPE_GET_TORPEDO_CHARGE_IDS(nFirstReloadTimeShots = "paramsNumShots.nFirstReloadTimeShots" numShotsValue = "paramsNumShots.numShotsValue"))

		(var isTwoTorpedoes:bool = "torpedoesTTX.torpedo && torpedoesTTX.torpedoAlt")
	)
	(style (width = 100%))
	(element TTX_INSTANCE
		_elementName='TorpedoName'
		_shipTTX="_shipTTX"
		_value="_torpedoTTX"
		_enabled="isTwoTorpedoes"
	)
	(element TOOLTIP_SYSTEM_PARAMS_WRAPPER
		(element TOOLTIP_SYSTEM_PARAMS_BLOCK
			(element TTX_INSTANCE
				_elementName='TorpedoLoaderInfoInner'
				_shipTTX="_shipTTX"
				_value="torpedoesTTX"
				_enabled="isGroup && !isTwoTorpedoes"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_SHOT_DELAY'
				_value = "torpedoesReloadTime"
				_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = "torpedoChargeIds.firstParamShotDeleyIds"
				_value = "torpedoes.firstReloadTime"
				_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
				_zeroValueHidden = true
			)
			(element ShipParameterNumber
				_title = "torpedoChargeIds.secondParamShotDeleyIds"
				_value = "torpedoes.secondReloadTime"
				_valueConfig = "VALUE_CONFIG.SECONDS_NEGATIVE"
				_zeroValueHidden = true
			)
			(element ShipParameterClassIcons
				_title = 'IDS_SHIP_PARAM_TORPEDOES_AFFECTED_SHIPS'
				_values = "_torpedoTTX.canHitClasses"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_TORPEDO_MAX_DIST'
				_value = "_torpedoTTX.maxDist"
				_valueConfig = "VALUE_CONFIG.KILOMETER"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_TORPEDO_DAMAGE'
				_value = "_torpedoTTX.damage"
			)
			(element ShipParameterNumber
				_title = 'IDS_SHIP_PARAM_TORPEDO_SPEED'
				_value = "_torpedoTTX.speed"
				_valueConfig = "VALUE_CONFIG.KNOT"
			)
		)
	)
)

(def layout ModuleTorpedoesParametersForDock (_shipTTX:dhStruct, _hasIntegralDiff:bool)
	(scope
		(var isGroup:bool = "_shipTTX && _shipTTX.torpedoGroups != null")
		(var torpedoesTTX:dhStruct = "isGroup ? _shipTTX.torpedoGroups : _shipTTX.torpedoes")
		(var isTwoTorpedoes:bool = "torpedoesTTX ? torpedoesTTX.torpedo && torpedoesTTX.torpedoAlt : false")
	)
	(style (width = 100%))
	(element TTX_INSTANCE
		_elementName='TorpedoLoaderInfoSeparate'
		_shipTTX="_shipTTX"
		_value="torpedoesTTX"
		_enabled="isGroup && isTwoTorpedoes"
	)
	(block
		(style (width = 100%))
		(controller $Instance renderer='TooltipSystemHorizontalDivider'
			(bind enabled "isGroup && isTwoTorpedoes")
		)
	)
	(element TTX_INSTANCE
		_elementName='TorpedoModuleParams'
		_shipTTX="_shipTTX"
		_value="torpedoesTTX.torpedo"
	)
	(block
		(style (width = 100%))
		(controller $Instance renderer='TooltipSystemHorizontalDivider'
			(bind enabled "isTwoTorpedoes")
		)
	)
	(element TTX_INSTANCE
		_elementName='TorpedoModuleParams'
		_shipTTX="_shipTTX"
		_value="torpedoesTTX.torpedoAlt"
	)

	(element TTX_INSTANCE
		_elementName='ModuleIntegralParams'
		_shipTTX="_shipTTX"
		_value="_shipTTX"
		_enabled="_hasIntegralDiff"
	)
)
