(def constant SAGA_CHOICE_TYPE_TO_ELEM "{
	SC.Sagas.FORK_UI_TYPE.BIG_IMAGE:	'SagaConfirmChoiceImageConfirmation',
	SC.Sagas.FORK_UI_TYPE.DEFAULT:		'SagaConfirmChoiceTextConfirmation'
}")

(def element ModalWindowSagaChoiceConfirm (forkID:str, forkChoiceID:str)	
	(macro MODAL_WINDOW_INIT)
	(scope
		(var sagaFork:dhComponent =		"getPrimaryComponent(CC.sagaFork, forkID)")
		(var sagaForkType:number =		"sagaFork.uiType"		(event "sagaFork.evChanged"))

		(var isForkRewardDefining:bool = "sagaForkType == SC.Sagas.FORK_UI_TYPE.BIG_IMAGE")

		(macro GET_PREF 'isBlurOptionEnabled' "'graphics.GUI.blur'")
	)

	(class $Fullsize)
	(style (align = "center|middle"))

	(macro SAGA_MODAL_WINDOW_BG
		_isBlurOptionEnabled = "isBlurOptionEnabled"
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 0)

		(style (marginTop = "isForkRewardDefining ? -30% : -20%"))

		(controller $Instance
			(bind renderer "SAGA_CHOICE_TYPE_TO_ELEM[sagaForkType]")
			(args
				_forkID =			"forkID"
				_forkChoiceID =		"forkChoiceID"
			)
		)
	)

	(block
		(bind visible "isForkRewardDefining")

		(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)

		(style
			(position = "absolute")
			(bottom = 0px)
			(width = 100%)
		)

		(controller $Instance renderer='SagaMainProgressBarContainer'
			(bind enabled "isForkRewardDefining")
		)
	)
)

(def element SagaConfirmChoiceImageConfirmation (_forkID:str, _forkChoiceID:str)
	(scope
		(var selectedForkChoiceEntity:dhEntity =	"getPrimaryEntity(CC.sagaForkChoice, _forkID + '_' + _forkChoiceID)")
		(var selectedForkChoice:dhComponent =		"selectedForkChoiceEntity.sagaForkChoice")
		(var confirmationText:str =					"selectedForkChoice.confirmationText"		(event "selectedForkChoice.evChanged"))

		(var selectedForkChoiceRewardEntity:dhEntity =	"getPrimaryEntity(CC.sagaForkChoiceRewardDefinition, _forkID + '_' + _forkChoiceID)")
		(var selectedForkChoiceReward:dhComponent =		"selectedForkChoiceRewardEntity.sagaForkChoiceRewardDefinition")
		(var rewardID:number =							"selectedForkChoiceReward.rewardID"		(event "selectedForkChoiceReward.evChanged"))

		(var rewardEntity:dhEntity =	"getEntity(rewardID)")
		(var reward:dhComponent =		"rewardEntity.rewardComponent")
		(var rewardType:str =			"reward.type"					(event "reward.evUpdate"))
		(var crewID:number =			"reward.params.primaryKey"		(event "reward.evUpdate"))
		(var rewardRenderer:str =		"REWARD_ELEMENT_BY_TYPE[rewardType].rewardViewStylized")
		(var tooltipRenderer:str =		"REWARD_ELEMENT_BY_TYPE[rewardType].tooltip")

		(struct crewHistory =			PULL_CREW_HISTORY_INFO(_crewHistoryId = "crewID"))
		(var hasVoiceOver:bool =		"crewHistory.component.hasVoiceOver")
	)

	(style (width = "SAGA_ELEMS.FORK.CONFIRM_POPUP.REWARD.WIDTH"))

	(block
		(style (width = 100%))

		(element SagaTextBoxTexture)

		(block
			(style
				(align = "center")
				(width = 100%)
				(paddingLeft = "SAGA_ELEMS.FORK.CONFIRM_POPUP.SIDE_PADDING")
				(paddingRight = "SAGA_ELEMS.FORK.CONFIRM_POPUP.SIDE_PADDING")
				(paddingTop = "SAGA_ELEMS.POPUP.PADDING_TOP")
				(paddingBottom = "L")
			)

			(tf
				(class $TextDefaultBold24NMWithoutShadow)
				(style
					(width = 100%)
					(marginBottom = "MS")
					(textAlign = "center")
					(textColor = "SAGA_COLORS.COMMON_TEXT")
				)

				(text = "toUpper(tr('IDS_SAGA_FORK_CHOICE_CONFIRMATION_TITLE'))")
			)

			(tf
				(class $TextDefault22NMWithoutShadow)
				(style
					(width = 100%)
					(marginBottom = "S")
					(textAlign = "center")
					(textColor = "SAGA_COLORS.COMMON_TEXT")
				)

				(bind text "confirmationText")
			)

			(block
				(style
					(align = "center|middle")
					(width = 200px)
					(height = 200px)
					(marginBottom = "S")
					(backgroundColor = "NO_COLOR")
				)

				(controller $Instance
					(bind renderer "rewardRenderer")
					(bind enabled "toBool(rewardRenderer)")
					(args
						_data =	"{ crewHistoryId: crewID }"
						_size =	"SC.Ui_styles.SIZE.LARGE"
					)
				)

				(controller $Tooltip
					(bind renderer "tooltipRenderer")
					(bind enabled "toBool(tooltipRenderer)")
					(args
						_crewHistoryId =		"crewID"
						_noMouseInstruction =	true
						_hasVoiceMarker =		"hasVoiceOver"
					)
					(macro DEFAULT_TOOLTIP_BEHAVIOUR)
				)
			)

			(tf
				(class $TextDefault18NMWithoutShadow)
				(style
					(width = 100%)
					(textAlign = "center")
					(marginBottom = "SXS")
					(textColor = "SAGA_COLORS.MAIN.UP")
				)

				(text = 'IDS_SAGA_FORK_NO_REVERSE_WARNING')
			)

			(tf
				(class $TextDefault18NMWithoutShadow)
				(style
					(width = 100%)
					(textAlign = "center")
					(marginBottom = "MS")
					(textColor = "SAGA_COLORS.MAIN.UP")
				)

				(text = 'IDS_REWARD_SAGA_FULL_COMPLETION_REQUIRED_HINT')
			)

			(block
				(style (marginBottom = "M"))

				(element SagaConfirmChoiceButtons)
			)
		)
	)
)

(def element SagaConfirmChoiceTextConfirmation (_forkID:str, _forkChoiceID:str)
	(scope
		(var selectedForkChoiceEntity:dhEntity =	"getPrimaryEntity(CC.sagaForkChoice, _forkID + '_' + _forkChoiceID)")
		(var selectedForkChoice:dhComponent =		"selectedForkChoiceEntity.sagaForkChoice")
		(var confirmationText:str =					"selectedForkChoice.confirmationText"	(event "selectedForkChoice.evChanged"))
	)

	(style (width = "SAGA_ELEMS.FORK.CONFIRM_POPUP.NARRATIVE.WIDTH"))

	(block
		(style (width = 100%))

		(element SagaTextBoxTexture)

		(block
			(style
				(align = "center")
				(width = 100%)
				(paddingLeft = "SAGA_ELEMS.FORK.CONFIRM_POPUP.SIDE_PADDING")
				(paddingRight = "SAGA_ELEMS.FORK.CONFIRM_POPUP.SIDE_PADDING")
				(paddingTop = "SAGA_ELEMS.POPUP.PADDING_TOP")
				(paddingBottom = "L")
			)

			(tf
				(class $TextDefaultBold24NMWithoutShadow)
				(style
					(width = 100%)
					(marginBottom = "L")
					(textAlign = "center")
					(textColor = "SAGA_COLORS.COMMON_TEXT")
				)

				(text = "toUpper(tr('IDS_SAGA_FORK_CHOICE_CONFIRMATION_TITLE'))")
			)

			(block
				(style
					(width = 100%)
					(marginBottom = "L")
					(vgap = "L")
				)

				(tf
					(class $TextDefault22NMWithoutShadow)
					(style
						(width = 100%)
						(textAlign = "center")
						(textColor = "SAGA_COLORS.COMMON_TEXT")
					)

					(text = "confirmationText")
				)
			)

			(block
				(style (marginBottom = "M"))

				(element SagaConfirmChoiceButtons)
			)
		)
	)
)

(def element SagaConfirmChoiceButtons ()
	(style
		(flow = "horizontal")
		(hgap = "M")
	)

	(element SagaDefaultButton
		_name =				'btn_yes'
		_width =			150px
		_label =			'IDS_SAGA_BUTTON_SELECT'
		_focusIndex =		0
		_methods =			"[	{ type: 'direct.action',			name: 'onTurnNarrativeForward',		args: {} },
								{ type: 'inputMapping.onRequest',	name: 'confirmChoice',				args: {} }]"
		_borderRadius =		"XS"
	)

	(element SagaDefaultButton
		_name =				'btn_no'
		_width =			150px
		_label =			'IDS_SAGA_BUTTON_CANCEL'
		_focusIndex =		1
		_methods =			"[{ type: 'inputMapping.onRequest',	name: 'declineChoice',	args: {} }]"
		_borderRadius =		"XS"
	)
)