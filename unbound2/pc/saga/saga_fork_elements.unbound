(def constant SAGA_CHOICE_NONE '')

(def element SagaChoiceOperatingContainer (_sagaParentID:str, _sceneEntity:dhEntity, _lastPathElementID:str, _isConfirmationWindowActive:bool)
	(scope
		(var scene:dhComponent =		"_sceneEntity.sagaScene")
		(var actingCharacterID:str =	"scene.speakerID"		(event "scene.evChanged"))
		(var currentTextLine:str =		"scene.text"			(event "scene.evChanged"))

		(var actingCharacter:dhComponent =	"getPrimaryComponent(CC.sagaCharacter, actingCharacterID)")
		(var actingCharacterName:str =		"actingCharacter.name"		(event "actingCharacter.evChanged"))
		(var actingCharacterFace:str =		"'img://gui/saga/characters/portrait/160/' + actingCharacterID + '.png'")

		(var sagaFork:dhComponent =		"getPrimaryComponent(CC.sagaFork, _sagaParentID)")
		(var sagaForkType:number =		"sagaFork.uiType"				(event "sagaFork.evChanged"))
		(var selectedChoiceId:str =		"sagaFork.selectedElementID"	(event "sagaFork.evChanged"))

		(var isForkWithImages:bool =		"sagaForkType == SC.Sagas.FORK_UI_TYPE.BIG_IMAGE")
		(var isThisForkLastReached:bool =	"_lastPathElementID == _sagaParentID")
	)

	(style
		(align = "center")
		(width = 100%)
	)

	(controller $Instance renderer='SagaImageChoiceContainer'
		(bind enabled "isForkWithImages")
		(args
			_forkId =						"_sagaParentID"
			_selectedChoiceId =				"selectedChoiceId"
			_actingCharacterName =			"actingCharacterName"
			_actingCharacterFace =			"actingCharacterFace"
			_forkLabel =					"currentTextLine"
			_isThisForkLastReached =		"isThisForkLastReached"
			_isConfirmationWindowActive =	"_isConfirmationWindowActive"
		)
	)

	(controller $Instance renderer='SagaTextOnlyChoiceContainer'
		(bind enabled "!isForkWithImages")
		(args
			_forkId =						"_sagaParentID"
			_selectedChoiceId =				"selectedChoiceId"
			_actingCharacterName =			"actingCharacterName"
			_actingCharacterFace =			"actingCharacterFace"
			_forkLabel =					"currentTextLine"
			_isThisForkLastReached =		"isThisForkLastReached"
			_isConfirmationWindowActive =	"_isConfirmationWindowActive"
		)
	)
)

(def element SagaImageChoiceContainer (_forkId:str, _selectedChoiceId:str, _actingCharacterName:str, _actingCharacterFace:str, _forkLabel:str, _isThisForkLastReached:bool, _isConfirmationWindowActive:bool)
	(macro DEFAULT_MODAL_WINDOW_SCOPE_EVENTS)
	(scope
		(var forkChoices:dhCollection = "getCollectionByPath(CC.sagaForkChoice, 'byForkID.' + _forkId)")

		(var selectedForkChoiceEntity:dhEntity =	"getPrimaryEntity(CC.sagaForkChoice, _forkId + '_' + _selectedChoiceId)")
		(var selectedForkChoice:dhComponent =		"selectedForkChoiceEntity.sagaForkChoice")
		(var nextElementID:str =					"selectedForkChoice.nextElementID"		(event "selectedForkChoice.evChanged"))
		(var confirmationText:str =					"selectedForkChoice.confirmationText"	(event "selectedForkChoice.evChanged"))

		(var isConfirmationNeeded:bool = "toBool(confirmationText)")
		(var isAnythingChosen:bool = "_selectedChoiceId != SAGA_CHOICE_NONE")
	)

	(style (width = "SAGA_ELEMS.FORK.OPERATING_CONTAINER.TYPE_IMAGE.WIDTH"))

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
		(macro DEFAULT_VISIBILITY_ANIMATION_BY_TRIGGER
			_trigger =			"_isConfirmationWindowActive"
			_compareValue =		"false"
		)

		(style
			(width = 100%)
			(marginBottom = "S")
		)

		(element SagaForkHeader
			_portrait =		"_actingCharacterFace"
			_name =			"_actingCharacterName"
			_caption =		"_forkLabel"
		)
	)

	(block
		(style
			(width = 100%)
			(paddingLeft = "SAGA_ELEMS.FORK.OPERATING_CONTAINER.SHARED.PADDING_LEFT")
			(paddingRight = "SAGA_ELEMS.FORK.OPERATING_CONTAINER.SHARED.PADDING_RIGHT")
		)

		(hblock
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
			(macro DEFAULT_VISIBILITY_ANIMATION_BY_TRIGGER
				_trigger =			"_isConfirmationWindowActive"
				_compareValue =		"false"
			)

			(style
				(align = "center")
				(width = 100%)
				(marginBottom = "M")
				(hgap = "M")
			)

			
			(controller $Repeat renderer='SagaImageChoiceOption'
				(bind count "forkChoices.length")
				(args
					_forkId =				"_forkId"
					_forkChoices =			"forkChoices"
					_forkChoiceIndex =		"$index"
					_selectedChoiceId =		"_selectedChoiceId"
					_isDisabled =			"!_isThisForkLastReached"
				)
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 3)
			(macro DEFAULT_VISIBILITY_ANIMATION_BY_TRIGGER
				_trigger =			"_isConfirmationWindowActive"
				_compareValue =		"false"
			)

			(style
				(align = "right")
				(width = 100%)
			)

			(element SagaForkButtonsBlock
				_forkId =					"_forkId"
				_nextElementID =			"nextElementID"
				_isAnythingChosen =			"isAnythingChosen"
				_isConfirmationNeeded =		"isConfirmationNeeded"
				_isThisForkLastReached =	"_isThisForkLastReached"
			)
		)
	)
)

(def element SagaTextOnlyChoiceContainer (_forkId:str, _selectedChoiceId:str, _actingCharacterName:str, _actingCharacterFace:str, _forkLabel:str, _isThisForkLastReached:bool, _isConfirmationWindowActive:bool)
	(macro DEFAULT_MODAL_WINDOW_SCOPE_EVENTS)
	(scope
		(var forkChoices:dhCollection = "getCollectionByPath(CC.sagaForkChoice, 'byForkID.' + _forkId)")

		(var selectedForkChoiceEntity:dhEntity =	"getPrimaryEntity(CC.sagaForkChoice, _forkId + '_' + _selectedChoiceId)")
		(var selectedForkChoice:dhComponent =		"selectedForkChoiceEntity.sagaForkChoice")
		(var nextElementID:str =					"selectedForkChoice.nextElementID"		(event "selectedForkChoice.evChanged"))
		(var confirmationText:str =					"selectedForkChoice.confirmationText"	(event "selectedForkChoice.evChanged"))

		(var choicesContainerHeight:number = "forkChoices.length > 2	? 2 * SAGA_ELEMS.FORK.NARRATIVE.HEIGHT + SAGA_ELEMS.FORK.NARRATIVE.CHOICES_CONTAINER.VGAP
																		: SAGA_ELEMS.FORK.NARRATIVE.HEIGHT")

		(var isConfirmationNeeded:bool = "toBool(confirmationText)")
		(var isAnythingChosen:bool = "_selectedChoiceId != SAGA_CHOICE_NONE")
	)

	(style (width = "SAGA_ELEMS.FORK.OPERATING_CONTAINER.TYPE_DEFAULT.WIDTH"))

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
		(macro DEFAULT_VISIBILITY_ANIMATION_BY_TRIGGER
			_trigger =			"_isConfirmationWindowActive"
			_compareValue =		"false"
		)

		(style
			(width = 100%)
			(marginBottom = "S")
		)

		(element SagaForkHeader
			_portrait =		"_actingCharacterFace"
			_name =			"_actingCharacterName"
			_caption =		"_forkLabel"
		)
	)

	(block
		(style
			(width = 100%)
			(paddingLeft = "SAGA_ELEMS.FORK.OPERATING_CONTAINER.SHARED.PADDING_LEFT")
			(paddingRight = "SAGA_ELEMS.FORK.OPERATING_CONTAINER.SHARED.PADDING_RIGHT")
		)

		(htile
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
			(macro DEFAULT_VISIBILITY_ANIMATION_BY_TRIGGER
				_trigger =			"_isConfirmationWindowActive"
				_compareValue =		"false"
			)

			(style
				(bind height "choicesContainerHeight")
				(width = 100%)
				(marginBottom = "M")
				(hgap = "SAGA_ELEMS.FORK.NARRATIVE.CHOICES_CONTAINER.HGAP")
				(vgap = "SAGA_ELEMS.FORK.NARRATIVE.CHOICES_CONTAINER.VGAP")
			)

			
			(controller $Repeat renderer='SagaTextOnlyChoiceOption'
				(bind count "forkChoices.length")
				(args
					_forkId =				"_forkId"
					_forkChoices =			"forkChoices"
					_forkChoiceIndex =		"$index"
					_selectedChoiceId =		"_selectedChoiceId"
					_isDisabled =			"!_isThisForkLastReached"
				)
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 3)
			(macro DEFAULT_VISIBILITY_ANIMATION_BY_TRIGGER
				_trigger =			"_isConfirmationWindowActive"
				_compareValue =		"false"
			)

			(style
				(align = "right")
				(width = 100%)
			)

			(element SagaForkButtonsBlock
				_forkId =					"_forkId"
				_nextElementID =			"nextElementID"
				_isAnythingChosen =			"isAnythingChosen"
				_isConfirmationNeeded =		"isConfirmationNeeded"
				_isThisForkLastReached =	"_isThisForkLastReached"
			)
		)
	)
)

(def element SagaForkHeader (_portrait:str, _name:str, _caption:str)
	(style (width = 100%))

	(block
		(style
			(width = 100%)
			(paddingLeft = "SAGA_ELEMS.FORK.OPERATING_CONTAINER.SHARED.PADDING_LEFT")
		)

		(block
			(style
				(width = 100%)
				(height = 100px)
				(paddingLeft = "L")
				(paddingRight = "L")
				(paddingTop = "MS")
				(paddingBottom = "MS")
				(backgroundImage = "SAGA_TEXTURES.PANELS.FORK_HEADER")
				(scale9grid = [6, 0, 40, 0])
			)

			(tf
				(class $TextDefault24NMWithoutShadow)
				(style
					(width = 100%)
					(textColor = "SAGA_COLORS.COMMON_TEXT")
				)

				(bind text "_caption")
			)
		)
	)

	(block
		(style
			(position = "absolute")
			(top = -46px)
		)

		(element SagaActingCharacterNarrativeWidget
			_image =	"_portrait"
			_name =		"_name"
		)
	)
)

(def element SagaImageChoiceOption (_forkId:str, _forkChoices:dhCollection, _forkChoiceIndex:number, _selectedChoiceId:str, _isDisabled:bool) 
	(scope
		(struct mouseHandler = MOUSE_HANDLER())

		(struct stageSize = STAGE_SIZE())
		(var screenSizeType:number = "stageSize.height < 765 ? SC.Ui_styles.SIZE.SMALL : SC.Ui_styles.SIZE.MEDIUM")

		(var forkChoiceEntity:dhEntity =	"_forkChoices.getEntityAtIndex(_forkChoiceIndex)")
		(var forkChoice:dhComponent =		"forkChoiceEntity.sagaForkChoice")
		(var label:str =			"forkChoice.text"				(event "forkChoice.evChanged"))
		(var image:str =			"forkChoice.image"				(event "forkChoice.evChanged"))
		(var nextElementID:str =	"forkChoice.nextElementID"		(event "forkChoice.evChanged"))

		(var isSelected:bool = "nextElementID == _selectedChoiceId")

		(var patternCT:dict =	"SAGA_COLORS.COLOR_TRANSFORM.IMAGE_FORK.PATTERN")
		(var outlineCT:dict =	"SAGA_COLORS.COLOR_TRANSFORM.MAIN")

		(struct pattern =	GET_INTERACTIVE_COLOR_TRANSFORM(_states="patternCT"		_isSelected="isSelected"	_isDisabled="_isDisabled"	_isRollOver="mouseHandler.rollOver"))
		(struct outline =	GET_INTERACTIVE_COLOR_TRANSFORM(_states="outlineCT"		_isSelected="isSelected"	_isDisabled="_isDisabled"	_isRollOver="mouseHandler.rollOver"))
	)

	(macro STRUCT_MOUSE_DISPATCHER
		_mouseHandler = "mouseHandler"
	)
	(macro STRUCT_SOUND_HANDLER
		_mouseHandler =		"mouseHandler"
		_soundSet =			"_isDisabled ? '' : 'button_default'"
	)
	(macro STRUCT_CLICK_HANDLER
		_mouseHandler =		"mouseHandler"
		_methods =			"_isDisabled ? [] : [{ type: 'direct.action',	name: 'onToggleForkChoice',		args: { forkID: _forkId, forkChoiceID: nextElementID } }]"
	)

	(controller $Tooltip
		(bind enabled "_isDisabled && !isSelected")
		(renderer = 'SimpleStatusTooltip')
		(args
			_unifiedStatus =	"SC.Ui_styles.UNIFIED_STATUS.LOCK"
			_text =				'IDS_SAGA_FORK_CHOICE_UNAVAILABLE'
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR)
	)

	(style (backgroundColor = "NO_COLOR"))

	
	(block
		(style
			(hitTest = false)
			(bind width "SAGA_ELEMS.FORK.REWARD.PORTRAIT_SIZE[screenSizeType]")
			(bind height "SAGA_ELEMS.FORK.REWARD.PORTRAIT_SIZE[screenSizeType]")
		)

		(block
			(class $FullsizeAbsolute)
			(style (backgroundColor = "SC.Ui_styles.SERVICE_COLORS.WHITE"))

			(bind colorTransform "outline.CT")
		)

		(block
			(class $Fullsize)
			(style (padding = 5px))

			(block
				(class $FullsizeAbsolute)
				(style (backgroundColor = "SAGA_COLORS.PAPER"))
			)

			(block
				(class $FullsizeAbsolute)
				(style (backgroundColor = "NO_COLOR"))
				(isMask = true)
			)

			(block
				(class $FullsizeAbsolute)

				(element TextureCentrified
					_image =		"SAGA_TEXTURES.PATTERN.MEDIUM_UNCOLORIZED"
					_width =		"SAGA_ELEMS.TEXTURES.MEDIUM_PATTERN.WIDTH"
					_height =		"SAGA_ELEMS.TEXTURES.MEDIUM_PATTERN.HEIGHT"
					_offset =		-380px
				)

				(macro DEFAULT_CONTROL_STATE_ANIMATION_CT
					_colorTransform = "pattern.CT"
					_duration = "0.15"
				)
			)

			(block
				(class $Fullsize)
				(style
					(bind backgroundImage "image")
					(backgroundSize = "contain")
					(bind alpha "isSelected		? 1 :
								 _isDisabled	? 0.55
												: 1")
				)
			)
		)
	)
	

	
	(block
		(style
			(hitTest = false)
			(width = 100%)
			(marginTop = 6px)
		)

		(element SagaRewardSubCaption
			_caption =			"label"
			_isRollOver =		"mouseHandler.rollOver"
			_isSelected =		"isSelected"
			_isDisabled =		"_isDisabled"
			_screenSizeType =	"screenSizeType"
		)
	)
	
)

(def element SagaRewardSubCaption (_caption:str, _isRollOver:bool = false, _isSelected:bool = false, _isDisabled:bool = false, _screenSizeType:number = "SC.Ui_styles.SIZE.MEDIUM")
	(scope
		(var bgCT:dict =		"SAGA_COLORS.COLOR_TRANSFORM.IMAGE_FORK.SUBCAPTION_BACKGROUND")
		(var outlineCT:dict =	"SAGA_COLORS.COLOR_TRANSFORM.IMAGE_FORK.OUTLINE")
		(var textCT:dict =		"SAGA_COLORS.COLOR_TRANSFORM.IMAGE_FORK.TEXT")

		(struct bg =		GET_INTERACTIVE_COLOR_TRANSFORM(_states="bgCT"			_isSelected="_isSelected"	_isDisabled="_isDisabled"	_isRollOver="_isRollOver"))
		(struct outline =	GET_INTERACTIVE_COLOR_TRANSFORM(_states="outlineCT"		_isSelected="_isSelected"	_isDisabled="_isDisabled"	_isRollOver="_isRollOver"))
		(struct text =		GET_INTERACTIVE_COLOR_TRANSFORM(_states="textCT"		_isSelected="_isSelected"	_isDisabled="_isDisabled"	_isRollOver="_isRollOver"))
	)

	(style
		(align = "center")
		(bind width "SAGA_ELEMS.FORK.REWARD.LABEL_SIZE[_screenSizeType].WIDTH")
		(bind height "SAGA_ELEMS.FORK.REWARD.LABEL_SIZE[_screenSizeType].HEIGHT")
	)

	(block
		(class $FullsizeAbsolute)
		(style (bind backgroundImage "SAGA_TEXTURES.SERVICE_KIT.REWARD_SUBCAPTION[_screenSizeType].OUTER"))

		(macro DEFAULT_CONTROL_STATE_ANIMATION_CT
			_colorTransform = "outline.CT"
			_duration = "0.15"
		)
	)

	(block
		(class $FullsizeAbsolute)
		(style (bind backgroundImage "SAGA_TEXTURES.SERVICE_KIT.REWARD_SUBCAPTION[_screenSizeType].INNER"))

		(macro DEFAULT_CONTROL_STATE_ANIMATION_CT
			_colorTransform = "bg.CT"
			_duration = "0.15"
		)
	)

	(tf
		(class $TextDefaultBold24NMWithoutShadow)
		(style
			(textAlign = "center")
			(textColor = "SC.Ui_styles.SERVICE_COLORS.WHITE")
			(bind maxWidth "SAGA_ELEMS.FORK.REWARD.LABEL_SIZE[_screenSizeType].TEXT_MAX_WIDTH")
			(bind marginTop "SAGA_ELEMS.FORK.REWARD.LABEL_SIZE[_screenSizeType].TEXT_MARGIN_TOP")
		)

		(macro DEFAULT_CONTROL_STATE_ANIMATION_CT
			_colorTransform = "text.CT"
			_duration = "0.15"
		)

		(bind text "toUpper(tr(_caption))")
	)
)

(def element SagaTextOnlyChoiceOption (_forkId:str, _forkChoices:dhCollection, _forkChoiceIndex:number, _selectedChoiceId:str, _isDisabled:bool)
	(scope
		(struct mouseHandler = MOUSE_HANDLER())

		(var forkChoiceEntity:dhEntity =	"_forkChoices.getEntityAtIndex(_forkChoiceIndex)")
		(var forkChoice:dhComponent =		"forkChoiceEntity.sagaForkChoice")
		(var label:str =					"forkChoice.text"				(event "forkChoice.evChanged"))
		(var nextElementID:str =			"forkChoice.nextElementID"		(event "forkChoice.evChanged"))

		(var isSelected:bool = "nextElementID == _selectedChoiceId")

		(var outlineCT:dict =	"SAGA_COLORS.COLOR_TRANSFORM.TEXT_FORK.OUTLINE")
		(var bgCT:dict =		"SAGA_COLORS.COLOR_TRANSFORM.TEXT_FORK.BACKGROUND")
		(var patternCT:dict =	"SAGA_COLORS.COLOR_TRANSFORM.TEXT_FORK.PATTERN")
		(var textCT:dict =		"SAGA_COLORS.COLOR_TRANSFORM.TEXT_FORK.TEXT")

		(struct outline =	GET_INTERACTIVE_COLOR_TRANSFORM(_states="outlineCT"	_isSelected="isSelected"	_isDisabled="_isDisabled"	_isRollOver="mouseHandler.rollOver"))
		(struct bg =		GET_INTERACTIVE_COLOR_TRANSFORM(_states="bgCT"		_isSelected="isSelected"	_isDisabled="_isDisabled"	_isRollOver="mouseHandler.rollOver"))
		(struct pattern =	GET_INTERACTIVE_COLOR_TRANSFORM(_states="patternCT"	_isSelected="isSelected"	_isDisabled="_isDisabled"	_isRollOver="mouseHandler.rollOver"))
		(struct text =		GET_INTERACTIVE_COLOR_TRANSFORM(_states="textCT"	_isSelected="isSelected"	_isDisabled="_isDisabled"	_isRollOver="mouseHandler.rollOver"))
	)

	(macro STRUCT_MOUSE_DISPATCHER
		_mouseHandler = "mouseHandler"
	)
	(macro STRUCT_SOUND_HANDLER
		_mouseHandler =		"mouseHandler"
		_soundSet =			"_isDisabled ? '' : 'button_default'"
	)
	(macro STRUCT_CLICK_HANDLER
		_mouseHandler =		"mouseHandler"
		_methods =			"_isDisabled ? [] : [{ type: 'direct.action',	name: 'onToggleForkChoice',		args: { forkID: _forkId, forkChoiceID: nextElementID } }]"
	)

	(controller $Tooltip
		(bind enabled "_isDisabled && !isSelected")
		(renderer = 'SimpleStatusTooltip')
		(args
			_unifiedStatus =	"SC.Ui_styles.UNIFIED_STATUS.LOCK"
			_text =				'IDS_SAGA_FORK_CHOICE_UNAVAILABLE'
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR)
	)

	(style
		(width = "SAGA_ELEMS.FORK.NARRATIVE.WIDTH")
		(height = "SAGA_ELEMS.FORK.NARRATIVE.HEIGHT")
		(backgroundColor = "NO_COLOR")
	)

	(block
		(class $Fullsize)
		(style (hitTest = false))

		(block
			(class $FullsizeAbsolute)
			(style
				(borderRadiusTopRight = "SAGA_ELEMS.FORK.NARRATIVE.BORDER_RADIUS_OUTER")
				(borderRadiusBottomRight = "SAGA_ELEMS.FORK.NARRATIVE.BORDER_RADIUS_OUTER")
				(backgroundColor = "SC.Ui_styles.SERVICE_COLORS.WHITE")
			)

			(macro DEFAULT_CONTROL_STATE_ANIMATION_CT
				_colorTransform = "outline.CT"
				_duration = "0.15"
			)
		)

		
		(block
			(class $FullsizeAbsolute)
			(style (padding = 5px))

			(block
				(class $FullsizeAbsolute)
				(style
					(borderRadiusTopRight = "SAGA_ELEMS.FORK.NARRATIVE.BORDER_RADIUS_INNER")
					(borderRadiusBottomRight = "SAGA_ELEMS.FORK.NARRATIVE.BORDER_RADIUS_INNER")
					(backgroundColor = "SC.Ui_styles.SERVICE_COLORS.WHITE")
				)

				(macro DEFAULT_CONTROL_STATE_ANIMATION_CT
					_colorTransform = "bg.CT"
					_duration = "0.15"
				)
			)

			(block
				(class $FullsizeAbsolute)
				(style
					(borderRadiusTopRight = "SAGA_ELEMS.FORK.NARRATIVE.BORDER_RADIUS_INNER")
					(borderRadiusBottomRight = "SAGA_ELEMS.FORK.NARRATIVE.BORDER_RADIUS_INNER")
					(backgroundColor = "NO_COLOR")
				)
				(isMask = true)
			)

			(block
				(style
					(position = "absolute")
					(right = 0px)
					(width = 500px)
					(height = 70px)
					(backgroundImage = "SAGA_TEXTURES.PATTERN.FORK_NARRATIVE_SELECTED")
					(backgroundSize = "contain")
				)

				(macro DEFAULT_CONTROL_STATE_ANIMATION_CT
					_colorTransform = "pattern.CT"
					_duration = "0.15"
				)
			)
		)
		

		(block
			(class $FullsizeAbsolute)
			(style
				(align = "middle")
				(paddingLeft = "L")
				(paddingRight = "LS")
			)

			(tf
				(class $TextDefault20NMWithoutShadow)
				(style
					(width = 100%)
					(textColor = "SC.Ui_styles.SERVICE_COLORS.WHITE")
				)

				(macro DEFAULT_CONTROL_STATE_ANIMATION_CT
					_colorTransform = "text.CT"
					_duration = "0.15"
				)

				(bind text "label")
			)
		)
	)
)

(def element SagaForkButtonsBlock (_forkId:str, _nextElementID:str, _isAnythingChosen:bool, _isConfirmationNeeded:bool, _isThisForkLastReached:bool)
	(style (flow = "horizontal"))

	(element SagaDefaultButton
		_name =				'btn_back'
		_width =			"SAGA_ELEMS.BUTTON.DEFAULT.WIDTH"
		_label =			'IDS_SAGA_BUTTON_BACKWARD'
		_focusIndex =		1
		_methods =			"[{ type: 'direct.action',	name: 'onTurnNarrativeBackward',	args: {} }]"
	)

	(block
		(style (marginLeft = "M"))

		(element SagaDefaultButton
			_name =				'btn_apply_choice'
			_enabled =			"_isAnythingChosen"
			_width =			"SAGA_ELEMS.BUTTON.DEFAULT.WIDTH"
			_label =			'IDS_SAGA_BUTTON_FORWARD'
			_focusIndex =		0
			_methods =			"_isConfirmationNeeded && _isThisForkLastReached	? [ {	type:	'inputMapping.onRequest',
																							name:	'askToConfirmSagaChoice',
																							args:	{ forkID: _forkId, forkChoiceID: _nextElementID } }]
																					: [{ type: 'direct.action',	name: 'onTurnNarrativeForward',	args: {} }]"
		)
	)

	(block
		(bind visible "!_isThisForkLastReached")

		(style (marginLeft = "M"))

		(controller $Instance renderer='SagaButtonRewind'
			(bind enabled "!_isThisForkLastReached")
		)
	)
)
