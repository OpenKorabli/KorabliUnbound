(def element SagaArchive ()
	(macro DEFAULT_MODAL_WINDOW_SCOPE_EVENTS)
	(scope
		(var chaptersCollection:dhCollection = "getCollection(CC.sagaChapterElement)")
	)

	(class $Fullsize)
	(style (align = "center|middle"))

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 0)
		(class $FullsizeAbsolute)
		(style
			(backgroundImage = "SAGA_TEXTURES.ARCHIVE.BACKGROUND")
			(backgroundSize = "cover")
		)
	)

	(htile
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)

		(style
			(width = "SAGA_ELEMS.ARCHIVE.CONTAINER.WIDTH")
			(height = "SAGA_ELEMS.ARCHIVE.CONTAINER.HEIGHT")
			(marginTop = "SAGA_ELEMS.ARCHIVE.CONTAINER.MARGIN_TOP")
			(hgap = "SAGA_ELEMS.ARCHIVE.CONTAINER.HGAP")
			(vgap = "SAGA_ELEMS.ARCHIVE.CONTAINER.VGAP")
		)

		(controller $Repeat	renderer='SagaArchiveListElem'
			(bind items "chaptersCollection")
			(args
				_entity = "$item"
			)
		)
	)
)

(def element SagaArchiveListElem (_entity:dhEntity)
	(scope
		(struct mouseHandler = MOUSE_HANDLER())

		(var chapter:dhComponent = "_entity.sagaChapterElement")

		(var id:str =				"chapter.chapterID ?: ''"	(event "chapter.evChanged"))
		(var chapterName:str =		"chapter.name ?: ''"		(event "chapter.evChanged"))
		(var chapterImage:str =		"chapter.image ?: ''"		(event "chapter.evChanged"))
		(var chapterStatus:number =	"chapter.status ?: SC.Sagas.CHAPTER_STATUS.COMPLETED"	(event "chapter.evChanged"))

		(var isUnavailable:bool =	"chapterStatus == SC.Sagas.CHAPTER_STATUS.UNAVAILABLE")
	)

	(macro STRUCT_MOUSE_DISPATCHER
		_mouseHandler = "mouseHandler"
	)
	(macro STRUCT_SOUND_HANDLER
		_mouseHandler =		"mouseHandler"
		_soundSet =			"isUnavailable ? '' : 'button_default'"
	)
	(macro STRUCT_CLICK_HANDLER
		_mouseHandler =		"mouseHandler"
		_methods =			"isUnavailable ? [] : [{ type: 'direct.action',	name: 'onNarrativeChapterSelected',		args: { chapterID: id } }]"
	)

	(style
		(width = "SAGA_ELEMS.ARCHIVE.ELEMENT.SELF.WIDTH")
		(height = "SAGA_ELEMS.ARCHIVE.ELEMENT.SELF.HEIGHT")
		(bind alpha "isUnavailable ? 0.5 : 1")
		(backgroundColor = "NO_COLOR")
	)

	(block
		(class $Fullsize)
		(style (align = "center"))

		(block
			(style
				(width = "SAGA_ELEMS.ARCHIVE.ELEMENT.IMAGE.WIDTH")
				(height = "SAGA_ELEMS.ARCHIVE.ELEMENT.IMAGE.HEIGHT")
				(marginBottom = "M")
				(backgroundImage = "chapterImage")
				(backgroundSize = "contain")
			)

			(macro DEFAULT_CONTROL_STATE_ANIMATION_CT " isUnavailable			? CT_NONE :
														mouseHandler.mouseDown	? COLOR_TRANSFORM_MOUSE_DOWN :
														mouseHandler.rollOver	? COLOR_TRANSFORM_MOUSE_OVER
																				: CT_NONE")
		)

		(tf
			(class $TextDefaultBold24NM)
			(style
				(textAlign = "center")
				(width = 100%)
				(marginBottom = "M")
				(alpha = "TA")
			)

			(bind text "chapterName")
		)

		(element StatusLine
			_textClass =		"'$TextDefault18NM'"
			_unifiedStatus =	"chapterStatus == SC.Sagas.CHAPTER_STATUS.COMPLETED		? SC.Ui_styles.UNIFIED_STATUS.CHECK :
								 isUnavailable											? SC.Ui_styles.UNIFIED_STATUS.LOCK
																						: SC.Ui_styles.UNIFIED_STATUS.DEFAULT"
			_text =				"tr('IDS_SAGA_ARCHIVE_CHAPTER_STATUS_' + chapterStatus)"
		)
	)

	(controller $Tooltip
		(renderer = 'ArchiveChapterTooltip')
		(args
			_entity = "_entity"
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR)
	)
)

(def element ArchiveChapterTooltip (_entity:dhEntity)
	(scope
		(var chapter:dhComponent = "_entity.sagaChapterElement")

		(var chapterName:str =			"chapter.name ?: ''"									(event "chapter.evChanged"))
		(var chapterDescription:str =	"chapter.description ?: ''"								(event "chapter.evChanged"))
		(var chapterStatus:number =		"chapter.status ?: SC.Sagas.CHAPTER_STATUS.COMPLETED"	(event "chapter.evChanged"))

		(var description:str =	"chapterStatus != SC.Sagas.CHAPTER_STATUS.UNAVAILABLE ? chapterDescription : ''")

		(var unifiedStatusState:str = "	chapterStatus == SC.Sagas.CHAPTER_STATUS.COMPLETED		? SC.Ui_styles.UNIFIED_STATUS.CHECK :
								 		chapterStatus == SC.Sagas.CHAPTER_STATUS.UNAVAILABLE	? SC.Ui_styles.UNIFIED_STATUS.LOCK
																								: SC.Ui_styles.UNIFIED_STATUS.DEFAULT")

		(var isChapterAvailable:bool =	"chapterStatus != SC.Sagas.CHAPTER_STATUS.UNAVAILABLE")
		(var mouseInstructionText:str =	"isChapterAvailable ? 'IDS_SAGA_ARCHIVE_CHAPTER_STATUS_' + chapterStatus + '_MOUSE_INSTRUCTION' : ''")
	)

	(style (width = "DEFAULT_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TooltipSystemHeaderSubheaderText
			_headerText = "chapterName"
		)

		(element TooltipSystemHorizontalDivider)

		(block
			(style (width = 100%))

			(controller $Instance renderer='TooltipSystemDescriptionText'
				(bind enabled "toBool(description)")
				(args
					_descriptionText = "description"
				)
			)
		)

		(block
			(style (width = 100%))

			(controller $Instance renderer='TooltipSystemHorizontalDivider'
				(bind enabled "toBool(description)")
			)
		)

		(element TooltipSystemStatusLine
			_unifiedStatus =	"unifiedStatusState"
			_text =				"isChapterAvailable ? tr('IDS_SAGA_ARCHIVE_CHAPTER_STATUS_' + chapterStatus) : 'IDS_SAGA_ARCHIVE_CHAPTER_STATUS_UNAVAILABLE_DESCRIPTION'"
		)

		(block
			(style (width = 100%))

			(controller $Instance renderer='TooltipSystemHorizontalDivider'
				(bind enabled "isChapterAvailable")
			)
		)

		(block
			(style (width = 100%))

			(controller $Instance renderer='TooltipSystemStatusLine'
				(bind enabled "isChapterAvailable")
				(args
					_unifiedStatus =	"SC.Ui_styles.UNIFIED_STATUS.MOUSE_LEFT"
					_text =				"mouseInstructionText"
				)
			)
		)
	)
)