(def constant CT_ACTIVE_CHARACTER "{	redMultiplier:	1,		greenMultiplier:	1,		blueMultiplier:	1,		alphaMultiplier:	1,
										redOffset:		0,		greenOffset:		0,		blueOffset:		0,		alphaOffset:		0 }")
(def constant CT_INACTIVE_CHARACTER "{	redMultiplier:	1,		greenMultiplier:	1,		blueMultiplier:	1,		alphaMultiplier:	1,
										redOffset:		-15,	greenOffset:		-15,	blueOffset:		-15,	alphaOffset:		0 }")

