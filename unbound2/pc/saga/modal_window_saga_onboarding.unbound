(def element ModalWindowSagaOnboarding ()
	(macro MODAL_WINDOW_INIT)
	(scope
		(var descriptionData:array = "[ 'IDS_SAGA_ONBOARDING_DESCRIPTION_0', 'IDS_SAGA_ONBOARDING_DESCRIPTION_1' ]")
		(var charactersData:array = "[ SC.Sagas.CHARACTER.NERET, SC.Sagas.CHARACTER.HILDA, SC.Sagas.CHARACTER.TINA ]")

		(struct sagaID = EXTRACT_SAGA_ID())

		(var sagaEntity:dhEntity =		"getPrimaryEntity(CC.saga, sagaID.value)")
		(var saga:dhComponent =			"sagaEntity.saga")
		(var sagaName:str =				"saga.name ?: ''"	(event "saga.evChanged"))
		(var sagaFlags:number =			"saga.flags ?: 0"	(event "saga.evChanged"))

		(struct sagaTimer = PULL_SAGA_TIMER(_component = "saga"))
		(var timeLeftText:str = "!sagaTimer.isFinalStatsTimeReached		? subst('IDS_SUBST_SAGA_TIMER_TILL_END', [], { _timeLeft: sagaTimer.progressionFinishTime.value })
																		: 'IDS_SAGA_FINISHED'")

		(var sagaTitle:str = "sagaName ? tr('IDS_SAGA_MAIN_TITLE_' + toUpper(sagaName)) : ''")

		(var isOnboardingSeen:bool =	"toBool(sagaFlags & SC.Sagas.SAGA_FLAGS.ONBOARDING_SEEN)")
	)

	(bindcall externalCall 'direct.action' "['onSetSagaFlag', { sagaID: sagaID.value, sagaFlags: SC.Sagas.SAGA_FLAGS.ONBOARDING_SEEN }]"	on='removedFromStage')

	(class $Fullsize)
	(style (align = "center"))

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 0)
		(class $FullsizeAbsolute)
		(style
			(backgroundImage = 'img://gui/saga/onboarding/background.png')
			(backgroundSize = "cover")
		)
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 0)

		(style (width = 100%))

		(element SagaHeader
			_header = "sagaTitle"
		)
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)

		(style
			(position = "absolute")
			(top = { 720: 53px, 1080: 217px })
			(left = { 1280: 24px, 1920: 80px })
			(width = "SAGA_ELEMS.ONBOARDING.CONTAINER.WIDTH")
		)

		(block
			(style (width = 100%))

			(element SagaTextBoxTexture)

			(block
				(style
					(align = "center")
					(width = 100%)
					(paddingTop = "SAGA_ELEMS.POPUP.PADDING_TOP")
					(paddingBottom = "{ 720: L, 1080: 56px }")
					(paddingLeft = "SAGA_ELEMS.ONBOARDING.CONTAINER.CONTENT_PADDING_HOR")
					(paddingRight = "SAGA_ELEMS.ONBOARDING.CONTAINER.CONTENT_PADDING_HOR")
				)

				(tf
					(class $TextDefaultBold26NMWithoutShadow)
					(style
						(textAlign = "center")
						(width = 100%)
						(marginBottom = "MS")
						(textColor = "SAGA_COLORS.COMMON_TEXT")
					)

					(text = 'IDS_SAGA_ONBOARDING_TITLE')
				)

				(block
					(style
						(align = "center")
						(width = 100%)
						(marginBottom = "MS")
						(vgap = "{ 720: M, 1080: MS }")
					)

					(controller $Repeat renderer='SagaOnboardingDescription'
						(bind count "descriptionData.length")
						(args
							_text = "descriptionData[$index]"
						)
					)
				)

				(hblock
					(style
						(align = "center")
						(width = 100%)
						(marginBottom = "MS")
						(hgap = "MS")
					)

					(controller $Repeat renderer='SagaOnboardingCharacterPortrait'
						(bind count "charactersData.length")
						(args
							_character = "charactersData[$index]"
						)
					)
				)

				(block
					(style
						(width = 100%)
						(marginBottom = "MS")
					)

					(tf
						(class $TextDefault18NMWithoutShadow)
						(style
							(width = 100%)
							(textAlign = "center")
							(textColor = "SAGA_COLORS.MAIN.UP")
						)

						(text = 'IDS_SAGA_ONBOARDING_ADDITIONAL_CREW_INFO')
					)
				)

				(hblock
					(style (marginBottom = "MS"))

					(block
						(style
							(width = 19px)
							(height = 19px)
							(marginTop = -3px)
							(marginRight = 3px)
							(backgroundImage = "SAGA_TEXTURES.SERVICE_KIT.UNIFIED_STATUS.DATE")
						)

						(colorTransform = "SAGA_COLORS.COLOR_TRANSFORM.COMMON_TEXT.UP")
					)

					(tf
						(class $TextDefault18NMWithoutShadow)
						(style (textColor = "SAGA_COLORS.COMMON_TEXT"))

						(bind text "timeLeftText")
					)
				)

				(element SagaDefaultButton
					_width =	190px
					_name =		'btn_ok'
					_label =	"isOnboardingSeen || sagaTimer.isFinalStatsTimeReached ? 'IDS_CLOSE_BTN' : 'IDS_SAGA_ONBOARDING_BUTTON_CONFIRM_LABEL_ETERIA'"
					_methods =	"[{ type: 'inputMapping.onRequest',	name: 'closeOnboarding',	args: {} }]"
				)
			)
		)
	)
)

(def element SagaOnboardingDescription (_text:str)
	(style (width = 100%))

	(tf
		(class $TextDefault22NMWithoutShadow)
		(style
			(width = 100%)
			(textAlign = "center")
			(textColor = "SAGA_COLORS.COMMON_TEXT")
		)

		(text = "_text")
	)
)

(def element SagaOnboardingCharacterPortrait (_character:number)
	(style
		(width = "SAGA_ELEMS.ONBOARDING.CHARACTER_PORTRAIT.WIDTH")
		(height = "SAGA_ELEMS.ONBOARDING.CHARACTER_PORTRAIT.HEIGHT")
		(padding = 3px)
		(backgroundImage = "SAGA_TEXTURES.PANELS.PORTRAIT.ONBOARDING_CREW_BG")
	)

	(block
		(class $FullsizeAbsolute)
		(style
			(bind backgroundImage "SAGA_CHARACTER[_character].ASSETS.PORTRAIT_320")
			(backgroundSize = "contain")
		)
	)
)