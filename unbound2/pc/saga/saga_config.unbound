(def constant SAGA_FINAL_REWARD_APPEAR_ANIMATION_KEYFRAMES "[
	{ percent: 0,		to: { scaleX: 0.7,	scaleY: 0.7,	alpha: 0,	colorTransform: CT_NONE } },
	{ percent: 60,		to: { scaleX: 1.05,	scaleY: 1.05,	alpha: 1,	colorTransform: SAGA_COLORS.COLOR_TRANSFORM.REWARD.TEAL } },
	{ percent: 70,		to: { scaleX: 1.1,	scaleY: 1.1,	alpha: 1,	colorTransform: SAGA_COLORS.COLOR_TRANSFORM.REWARD.HOT } },
	{ percent: 80,		to: { scaleX: 1.1,	scaleY: 1.1,	alpha: 1,	colorTransform: SAGA_COLORS.COLOR_TRANSFORM.REWARD.HOT } },
	{ percent: 100,		to: { scaleX: 1,	scaleY: 1,		alpha: 1,	colorTransform: CT_NONE } }
]")