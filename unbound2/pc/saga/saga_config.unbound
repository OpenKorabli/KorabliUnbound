(def constant SAGA_COLORS_CT "{
	NONE:		{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 0,
					redOffset: 0,		greenOffset: 0,			blueOffset: 0,			alphaOffset: 0 },

	WHITE_09:	{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 0.9,
					redOffset: 0,		greenOffset: 0,			blueOffset: 0,			alphaOffset: 0 },

	ORANGE: {
		UP:				{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 1,
							redOffset: -90,		greenOffset: -190,		blueOffset: -210,		alphaOffset: 0 },
		OVER:			{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 1,
							redOffset: -48,		greenOffset: -186,		blueOffset: -213,		alphaOffset: 0 },
		DOWN:			{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 1,
							redOffset: -85,		greenOffset: -203,		blueOffset: -225,		alphaOffset: 0 },
		DISABLED:		{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 1,
							redOffset: -131,	greenOffset: -174,		blueOffset: -182,		alphaOffset: 0 },
		UP_05:			{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 0.5,
							redOffset: -90,		greenOffset: -190,		blueOffset: -210,		alphaOffset: 0 }
	},

	PAPER: {
		UP:			{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 1,
						redOffset: -15,		greenOffset: -37,		blueOffset: -80,		alphaOffset: 0 },
		OVER:		{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 1,
						redOffset: 0,		greenOffset: -22,		blueOffset: -65,		alphaOffset: 0 },
		DOWN:		{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 1,
						redOffset: -80,		greenOffset: -100,		blueOffset: -130,		alphaOffset: 0 },
		UP_025:		{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 0.25,
						redOffset: -15,		greenOffset: -37,		blueOffset: -80,		alphaOffset: 0 }
	},

	PAPER_BRIGHT: {
		UP:			{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 1,
						redOffset: 0,		greenOffset: -7,		blueOffset: -26,		alphaOffset: 0 },
		OVER:		{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 1,
						redOffset: 0,		greenOffset: 0,			blueOffset: -10,		alphaOffset: 0 },
		DOWN:		{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 1,
						redOffset: -30,		greenOffset: -40,		blueOffset: -60,		alphaOffset: 0 }
	},

	DARK_GRAY: {
		UP:			{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 1,
						redOffset: -180,	greenOffset: -180,		blueOffset: -180,		alphaOffset: 0 },
		DISABLED:	{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 0.55,
						redOffset: -180,	greenOffset: -180,		blueOffset: -180,		alphaOffset: 0 }
	}
}")

(def constant SAGA_COLORS "{
	MAIN: {
		UP:				0xFFA5412D,
