			},
			PATTERN: {
				UP:			SAGA_COLORS_CT.NONE,
				OVER:		SAGA_COLORS_CT.ORANGE.UP_05,
				DOWN:		SAGA_COLORS_CT.ORANGE.UP_05,
				DISABLED:	SAGA_COLORS_CT.NONE
			},
			TEXT: {
				UP:			SAGA_COLORS_CT.DARK_GRAY.UP,
				OVER:		SAGA_COLORS_CT.WHITE_09,
				DOWN:		SAGA_COLORS_CT.WHITE_09,
				DISABLED:	SAGA_COLORS_CT.DARK_GRAY.DISABLED
			}
		},

		TEXT_FORK: {
			BACKGROUND: {
				UP:			SAGA_COLORS_CT.PAPER.UP,
				OVER:		SAGA_COLORS_CT.ORANGE.OVER,
				DOWN:		SAGA_COLORS_CT.ORANGE.DOWN,
				DISABLED:	SAGA_COLORS_CT.PAPER.UP
			},
			OUTLINE: {
				UP:			SAGA_COLORS_CT.ORANGE.UP,
				OVER:		SAGA_COLORS_CT.PAPER.UP,
				DOWN:		SAGA_COLORS_CT.PAPER.UP,
				DISABLED:	SAGA_COLORS_CT.ORANGE.DISABLED
			},
			PATTERN: {
				UP:			SAGA_COLORS_CT.NONE,
				OVER:		SAGA_COLORS_CT.PAPER.UP_025,
				DOWN:		SAGA_COLORS_CT.PAPER.UP_025,
				DISABLED:	SAGA_COLORS_CT.NONE
			},
			TEXT: {
				UP:			SAGA_COLORS_CT.DARK_GRAY.UP,
				OVER:		SAGA_COLORS_CT.WHITE_09,
				DOWN:		SAGA_COLORS_CT.WHITE_09,
				DISABLED:	SAGA_COLORS_CT.DARK_GRAY.DISABLED
			}
		},

		REWARD: {
			HOT:		{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 1,
							redOffset: 180,		greenOffset: 180,		blueOffset: 180,		alphaOffset: 0 },
			TEAL:		{	redMultiplier: 1,	greenMultiplier: 1,		blueMultiplier: 1,		alphaMultiplier: 1,
							redOffset: 60,		greenOffset: 180,		blueOffset: 180,		alphaOffset: 0 },
			GLOW: {
				TEAL:	{	redMultiplier: 0.2,	greenMultiplier: 0.95,	blueMultiplier: 1.05,	alphaMultiplier: 0.9,
							redOffset: 60,		greenOffset: 60,		blueOffset: 60,			alphaOffset: 0 }
			}
		}
	}
}")


