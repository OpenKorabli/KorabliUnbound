(def element ShipGroupCheckBox (_filterType:str, _prefName:str, _field:str, _isEnabled:bool, _shipId:number, _value:bool = false, _selectedShipGroupField:str = '', _isFromTooltip:bool = false)
	(scope
		(var imagePath:str = "'swf:../service_kit/filters_svg/filters_svg.swf:' + _field")
		(var value:bool = "_value ?: _isFromTooltip && (_field == _selectedShipGroupField)")

		(var ownShipInfo:dhComponent = "getPrimaryComponent(CC.ownShip, _shipId)")
		(var shipGroup:str = "ownShipInfo.favoriteGroupKey" (event "ownShipInfo.evFavoriteGroupKeyChanged"))
		(var hasShipGroup:bool = "toBool(shipGroup)")

		(var statusTooltipData:dict = "	_isEnabled	?	{	_text:	_isFromTooltip	?	value			?	'IDS_HINT_CHECKBOX_FILTER_UNLINK_FROM' :
																						hasShipGroup	?	'IDS_HINT_CHECKBOX_FILTER_RELINK_TO'
																										:	'IDS_HINT_CHECKBOX_FILTER_LINK_TO'
																					:	value			?	'IDS_HINT_CHECKBOX_FILTER_GROUP_DISABLE'
																										:	'IDS_HINT_CHECKBOX_FILTER_GROUP',
															_unifiedStatus:									SC.Ui_styles.UNIFIED_STATUS.MOUSE_LEFT }
													:	{	_text:											'IDS_HINT_CHECKBOX_FILTER_GROUP_NOT_AVAILABLE',
															_unifiedStatus:									SC.Ui_styles.UNIFIED_STATUS.ATTENTION }")
	)
	(bind name "'CarouselCheckBox_' + _filterType + '_' + _field")

	(element ImageRadioButton
		_enabled = "_isEnabled"
		_selected = "value"
		_renderElement = 'CheckBoxImageLabel'
		_renderArgs = "{	_height: 39px,
							_width: 39px,
							_imagePath: imagePath }"
		_methods = "_isEnabled && _isFromTooltip	?	[{
															type:	'inputMapping.onRequest',
															name:	'setGroupForShip',
															args:	{ groupKey: _field, shipID: _shipId }
														}] :
					_isEnabled						?	[{
															type:	'direct.action',
															name:	'option.set',
															args:	[_prefName, !value]
														}]
													:	[]"
		_dispatchedEv = "'evMenuItemClicked'"
		_size = "SIZE.MEDIUM"
		_statusTooltipData = "statusTooltipData"
	)
)


(def element ShipCrewCheckBox (_filterType:str, _prefName:str, _value:bool, _field:str, _isEnabled:bool)
	(scope
		(var imagePath:str = "'swf:../service_kit/filters_svg/filters_svg.swf:' + _field")

		(var statusTooltipData:dict = "_isEnabled	?	{	_text:	_value	?	'IDS_HINT_CHECKBOX_FILTER_' + _field + '_DISABLE'
