(def element AppliedSnowflakeFilters ()

	(scope
		(struct mouseHandler = MOUSE_HANDLER())

		(var bonusTagSeasonEntity:dhEntity = "getSingleEntity(CC.bonusTagSeason, 'snowflakeSeasonCollection')")
		(var bonusTagSeason:dhComponent = "bonusTagSeasonEntity.bonusTagSeason")
		(var filterTag:str = "bonusTagSeason.filterTag" (event "bonusTagSeason.evChanged"))

		(var state:number = "	mouseHandler.mouseDown	? SC.Ui_styles.BUTTON_STATE.DOWN :
								mouseHandler.rollOver	? SC.Ui_styles.BUTTON_STATE.OVER
														: SC.Ui_styles.BUTTON_STATE.UP")
		(var buttonAlpha:number = "APPLIED_FILTERS_BUTTON_ALPHA[state]")
		(var closeIconAlpha:number = "APPLIED_FILTERS_BUTTON_CLOSE_ALPHA[state]")
	)

	(macro STRUCT_MOUSE_DISPATCHER
		_mouseHandler = "mouseHandler"
	)

	(macro STRUCT_SOUND_HANDLER
		_mouseHandler = "mouseHandler"
		_soundSet = "'button_secondary'"
	)

	(style
		(align = "middle")
		(height = "CAROUSEL_APPLIED_FILTER_HEIGHT")
	)

	(block
		(class $FullsizeAbsolute)
		(element BlurMapRoundedWithContrastPanel
			_blurType = "ROUNDED_BLUR_TYPE.LOW"
		)
	)

	(element AppliedFilterBackground
		_state = "state"
		_alpha = "buttonAlpha"
	)
	(hblock
		(style
			(height = 100%)
			(marginLeft = "S")
			(marginRight = "S")
		)

		(tf
			(class $TextDefault18NM)
			(style
				(hitTest = false)
				(marginLeft = "XS")
				(marginTop = "S")
				(alpha = "TA")
			)
			(bind text "filterTag")
		)

		(block
			(style (width = 17px))

			(block
				(name = 'SnowflakesFilterCloseButton')
				(style
					(height = 21px)
					(marginLeft = 6px)
					(marginTop = 9px)
					(alpha = "closeIconAlpha")
				)

				(macro DEFAULT_CONTROL_STATE_ANIMATION_ALPHA
					_trigger = "state"
					_alpha = "closeIconAlpha"
				)

				(element CloseButton
					_methods = "[{	type: 'inputMapping.onAction',
									name: 'resetLevelFilters',
									args: {}
								}]"
					_tooltipText = 'IDS_HINT_RESET_FILTER'
				)
			)
		)
	)
)


(def element CarouselAppliedFilterResetAllButton (_ident:number, _hasBlurBackground:bool = true)
	(scope
		(struct mouseHandler = MOUSE_HANDLER())

		(var state:number = "	mouseHandler.mouseDown	? SC.Ui_styles.BUTTON_STATE.DOWN :
								mouseHandler.rollOver	? SC.Ui_styles.BUTTON_STATE.OVER
														: SC.Ui_styles.BUTTON_STATE.UP")

		(var buttonAlpha:number = "APPLIED_FILTERS_BUTTON_ALPHA[state]")
		(var closeIconAlpha:number = "APPLIED_FILTERS_BUTTON_CLOSE_ALPHA[state]")
	)

	(style (height = "CAROUSEL_APPLIED_FILTER_HEIGHT"))

	(macro STRUCT_MOUSE_DISPATCHER
		_mouseHandler = "mouseHandler"
	)

	(macro STRUCT_SOUND_HANDLER
		_mouseHandler = "mouseHandler"
		_soundSet = "'button_secondary'"
	)

	(macro STRUCT_DISPATCH_HANDLER
		_mouseHandler = "mouseHandler"
		_dispatchedEv = "'evResetAllFilters'"
	)

	(macro STRUCT_CLICK_HANDLER
		_mouseHandler = "mouseHandler"
		_methods = "[	{	type: 'inputMapping.onAction',
							name: 'resetAllFilters',
							args: {ident: _ident}
						}]"
	)

	(block
		(class $FullsizeAbsolute)

		(controller $Instance renderer='BlurMapRoundedWithContrastPanel'
			(bind enabled "_hasBlurBackground")
			(args
				_blurType = "ROUNDED_BLUR_TYPE.LOW"
			)
		)

		(controller $Tooltip
			(renderer = 'SimpleStatusTooltip')
			(args
				_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.MOUSE_LEFT"
				_text = 'IDS_HINT_RESET_ALL_FILTERS'
			)
			(macro DEFAULT_TOOLTIP_BEHAVIOUR)
		)
	)

	(block
		(style
			(align = "middle")
			(height = 100%)
		)

		(element AppliedFilterBackground
			_hitTest = false
			_alpha = "buttonAlpha"
			_state = "state"
		)

		(hblock
			(style
				(align = "middle")
				(height = 100%)
				(paddingLeft = "S")
				(paddingRight = "S")
			)

			(tf
				(class $TextDefault18NM)
				(style
					(hitTest = false)
					(alpha = "TC")
				)
				(text = 'IDS_RESET_ALL_FILTERS')
			)

			(block
				(style
					(marginLeft = 6px)
					(marginRight = -1px)
					(marginTop = 1px)
					(alpha = "closeIconAlpha")
				)

				(macro DEFAULT_CONTROL_STATE_ANIMATION_ALPHA
					_trigger = "state"
					_alpha = "closeIconAlpha"
				)

				(element CloseButton
					_tooltipText = 'IDS_HINT_RESET_FILTER'
				)
			)
		)
	)
)