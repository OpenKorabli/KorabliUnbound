(def element ModalWindowConstructorBuyDogTag ()
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)

	(scope
		
		(var dogTagPreviewComponent:dhComponent =	"getSingleComponent(CC.dogTagComponentPreview)")
		(var previewSymbolId:number =				"dogTagPreviewComponent.symbol			?: 0"					(event "dogTagPreviewComponent.evChanged"))
		(var previewBgShapeId:number =				"dogTagPreviewComponent.bgShape			?: 0"					(event "dogTagPreviewComponent.evChanged"))
		(var previewBgColorId:number =				"dogTagPreviewComponent.bgColor			?: 0"					(event "dogTagPreviewComponent.evChanged"))
		(var previewBgBorderId:number =				"dogTagPreviewComponent.bgBorderColor	?: 0"					(event "dogTagPreviewComponent.evChanged"))

		
		(var dogTagPreviewedElementsArray:array =	"[previewSymbolId, previewBgShapeId, previewBgColorId, previewBgBorderId]" (event "dogTagPreviewComponent.evChanged"))

		(var dogTagSymbolComponent:dhComponent =		"getPrimaryComponent(CC.dogTagComponent, previewSymbolId)"		(event "dogTagPreviewComponent.evChanged"))
		(var dogTagBgShapeComponent:dhComponent =		"getPrimaryComponent(CC.dogTagComponent, previewBgShapeId)"		(event "dogTagPreviewComponent.evChanged"))
		(var dogTagBgColorComponent:dhComponent =		"getPrimaryComponent(CC.dollBackgroundColor, previewBgColorId)"	(event "dogTagPreviewComponent.evChanged"))
		(var dogTagBorderColorComponent:dhComponent =	"getPrimaryComponent(CC.dollBorderColor, previewBgBorderId)"	(event "dogTagPreviewComponent.evChanged"))

		
		(var dogTagPreviewedElementsCategoryArray:array = "[dogTagSymbolComponent.categoryId, dogTagBgShapeComponent.categoryId, dogTagBgColorComponent.categoryId, dogTagBorderColorComponent.categoryId]")

		
		(struct symbolPrice = PULL_PRICE(_entityId = "dogTagSymbolComponent.id" _actionId = "SC.Common.PRICE_ACTION.BUY"))
		(struct bgShapePrice = PULL_PRICE(_entityId = "dogTagBgShapeComponent.id" _actionId = "SC.Common.PRICE_ACTION.BUY"))
		(struct bgColorPrice = PULL_PRICE(_entityId = "dogTagBgColorComponent.id" _actionId = "SC.Common.PRICE_ACTION.BUY"))
		(struct bgBorderColorPrice = PULL_PRICE(_entityId = "dogTagBorderColorComponent.id" _actionId = "SC.Common.PRICE_ACTION.BUY"))

		(var symbolPriceInfo:dict = "symbolPrice.info")
		(var bgShapePriceInfo:dict = "bgShapePrice.info")
		(var bgColorPriceInfo:dict = "bgColorPrice.info")
		(var bgBorderColorPriceInfo:dict = "bgBorderColorPrice.info")

		
		(var finalPrice:number = "	(!dogTagSymbolComponent.enabled			? symbolPriceInfo.finalPrice		: 0) +
									(!dogTagBgShapeComponent.enabled		? bgShapePriceInfo.finalPrice		: 0) +
									(!dogTagBgColorComponent.enabled		? bgColorPriceInfo.finalPrice		: 0) +
									(!dogTagBorderColorComponent.enabled	? bgBorderColorPriceInfo.finalPrice	: 0)"	(event "dogTagSymbolComponent.evUpdate")
																														(event "dogTagBgShapeComponent.evUpdate")
																														(event "dogTagBgColorComponent.evUpdate")
																														(event "dogTagBorderColorComponent.evUpdate"))

		
		(var finalDogTagPriceInfo:dict = "	symbolPriceInfo.finalPrice			?	symbolPriceInfo :
											bgShapePriceInfo.finalPrice			?	bgShapePriceInfo :
											bgColorPriceInfo.finalPrice			?	bgColorPriceInfo :
											bgBorderColorPriceInfo.finalPrice	?	bgBorderColorPriceInfo.info
																				:	{	finalPrice: finalPrice,
																						currency: SC.Common.CURRENCIES.GOLD }")

		
		(var finalDogTagPriceInfoSum:dict = "{	till: finalDogTagPriceInfo.till,
												currency: finalDogTagPriceInfo.currency,
												type: finalDogTagPriceInfo.type,
												basePrice: finalPrice,
												finalPrice: finalPrice,
												discountPercent: finalDogTagPriceInfo.discountPercent,
												isPrivate: finalDogTagPriceInfo.isPrivate }")

		(var accountResource:dhComponent = "getSingleComponent(CC.accountResource)")
		(var priceDeficit:number = "finalPrice - accountResource[finalDogTagPriceInfo.currency]" (event "accountResource.evChangedGold") (event "accountResource.evChangedCredit"))
		(var isDeficit:bool = "priceDeficit > 0")
	)

	(name = 'dogTagModalBuyConstructor')

	(block
		(class $EyeLevelAligned)
		(style (width = "MODAL_WINDOW_EXTERIOR_BUY_WIDTH"))

		
		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
			(style (width = 100%))

			(element ModalWindowShortHeader
				_header = 'IDS_MODAL_WINDOW_CONSTRUCTOR_BUY_DOGTAG_HEADER'
				_hasDivider = false
			)
		)

		(block
			(style
				(align = "center")
				(width = 100%)
			)

			
			(block
				(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
				(style (width = 100%))

				(element CurrenciesPanel
					_priceInfo = "[{ finalPrice: -finalPrice, currency: finalDogTagPriceInfo.currency }]"
					_width = "MODAL_WINDOW_EXTERIOR_BUY_WIDTH"
				)
			)

			
			(block
				(macro DEFAULT_MODAL_WINDOW_ANIMATION 1.5)
				(style
					(width = 100%)
					(marginBottom = "MS")
				)

				(controller $Repeat renderer='DogtagPriceAndInfoLineItem'
					(bind items "dogTagPreviewedElementsArray")
					(args
						_dogTagElementId = "$item"
						_dogTagElementCategoryId = "dogTagPreviewedElementsCategoryArray[$index]"
					)
				)
			)

			
			(block
				(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
				(style
					(width = 100%)
					(marginBottom = "MS")
				)

				(element ModalWindowSystemPurchaseItemPriceAndInfo
					_priceInfo =		"finalDogTagPriceInfoSum"
					_questionString =	'IDS_MODAL_WINDOW_BUY_DOGTAG_AND_SAVE'
					_isDeficit =		"isDeficit"
					_deficit =			"priceDeficit"
					_isWarningText =	"isDeficit"
				)
			)

			
			(block
				(macro DEFAULT_MODAL_WINDOW_ANIMATION 2.5)
				(style
					(align = "center")
					(width = 100%)
				)

				(element ModalWindowSystemPurchaseItemYesNoCloseButtons
					_isDeficit = "isDeficit"
					_okMethods = "[
						{
							type: 'inputMapping.onAction',
							name: SC.Ui_methods.DOGTAG_METHODS.SAVE,
							args: {}
						}
					]"
				)
			)
		)
	)
)

(def element DogtagPriceAndInfoLineItem (_dogTagElementId:number, _dogTagElementCategoryId:number)
	(scope
		
		(var componentClass:number = "	_dogTagElementCategoryId == SC.Common.DOGTAG_ELEMENTS.BG_COLOR			? CC.dollBackgroundColor :
										_dogTagElementCategoryId == SC.Common.DOGTAG_ELEMENTS.BG_BORDER_COLOR	? CC.dollBorderColor :
										_dogTagElementCategoryId == SC.Common.DOGTAG_ELEMENTS.BG_MATERIAL		? CC.dollTexture
																												: CC.dogTagComponent")
		(var dogTagElementComponent:dhComponent = "getPrimaryComponent(componentClass, _dogTagElementId)")

		(var dogTagIconPrefix:str = "	componentClass == CC.dollBackgroundColor	? SC.Common.DOGTAG_ELEMENTS.NAMES.BG_COLOR :
										componentClass == CC.dollBorderColor		? SC.Common.DOGTAG_ELEMENTS.NAMES.BG_BORDER_COLOR
																					: ''")
		(var isColorizableShape:bool = "componentClass == CC.dogTagComponent ? dogTagElementComponent.isColorizable : false")

		(var dogTagName:str = "dogTagElementComponent.gpName" (event "dogTagElementComponent.evUpdate"))
		(var dogTagIconDir:str = "dogTagIconPrefix || dogTagName ? ('url:../dogTags/' + (dogTagIconPrefix ? 'preview/' + dogTagIconPrefix : 'small/' + dogTagName)) : ''")
		(var iconPath:str = "dogTagIconDir ? dogTagIconDir + (isColorizableShape ? '/PCNT001' : '') + '.png' : ''")
		(var iconColor:number = "dogTagIconPrefix && dogTagElementComponent.colorHEX ? toNumber(dogTagElementComponent.colorHEX) : DOGTAG_BASE_COLOR")
		(var hasInStorage:bool = "dogTagElementComponent.enabled" (event "dogTagElementComponent.evUpdate"))

		(macro COLOR_DIFF_TO_COLOR_TRANSFORM "'iconTransform'" "DOGTAG_BASE_COLOR" "iconColor")
		(var finalIconTransform:dict = "dogTagIconPrefix ? iconTransform : CT_NONE")

		
		(struct dogtagPrice = PULL_PRICE(_entityId = "_dogTagElementId" _actionId = "SC.Common.PRICE_ACTION.BUY"))
		(var finalDogTagPriceInfo:dict = "dogtagPrice.info")
		(var accountResource:dhComponent = "getSingleComponent(CC.accountResource)")
		(var priceDeficit:number = "finalDogTagPriceInfo.finalPrice - accountResource[finalDogTagPriceInfo.currency]" (event "accountResource.evChangedGold") (event "accountResource.evChangedCredit"))
		(var isDeficit:bool = "priceDeficit > 0")

		(var isPatch:bool = "_dogTagElementCategoryId == SC.Common.DOGTAG_ELEMENTS.SYMBOL_PATCH")
		(var dogtagStereotypeSubheader:str = "(isPatch ? 'IDS_DOGTAGS_TAB_' : 'IDS_DOGTAGS_CONSTRUCTOR_TAB_') + SC.Common.DOGTAG_ELEMENTS.VALUE_TO_NAME[_dogTagElementCategoryId]")
	)

	(bind visible "!hasInStorage && dogTagElementComponent")

	(style (width = "MODAL_WINDOW_EXTERIOR_BUY_WIDTH"))

	
	(hblock
		(style
			(flow = 'horizontal')
			(align = "middle")
			(width = 100%)
			(paddingLeft = "M")
			(paddingRight = "M")
			(hgap = "MS")
		)

		(controller $Tooltip
			(renderer = 'DogTagComponentTooltip')
			(args
				_elementEntityId = "dogTagElementComponent._entity_id"
			)
			(macro DEFAULT_TOOLTIP_BEHAVIOUR)
		)

		(block
			(style (width = 100%))
			(element ModalWindowSystemExpendableIconWithHeaderAndSubheader
				_imageWidth =		80px
				_imageHeight =		80px
				_headerIconType =	"MODAL_WINDOW_SYSTEM_PURCHASABLE_ITEM_ICON.DOGTAG"
				_maxWidth =			"MODAL_WINDOW_EXTERIOR_BUY_WIDTH - 100px"
				_headerText =		"'IDS_DOGTAG_' + dogTagName + '_NAME'"
				_subheaderText =	"dogtagStereotypeSubheader"
				_unifiedStatus =	"SC.Ui_styles.UNIFIED_STATUS.DEFAULT"
				_data =				"{ imageUrl: iconPath, iconTransform: finalIconTransform }"
			)
		)

		(element PriceTag
			_priceInfo = "finalDogTagPriceInfo"
			_isDeficit = "isDeficit"
		)
	)

	
	(block
		(style
			(width = 100%)
			(paddingTop = "XS")
			(paddingBottom = "XS")
		)

		(element HorizontalDividerTwoPx)
	)
)
