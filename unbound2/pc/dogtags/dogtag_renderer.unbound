(def element DogTagInHUDSpectator (_observedShipId:number) 
	(scope
		
		(var vehicleEntity:dhEntity =		"getPrimaryEntity(CC.vehicle, _observedShipId)")
		(var vehicleComponent:dhComponent =	"vehicleEntity.accountSimple")
		(var vehicleAvatarId:number =		"vehicleComponent	? vehicleComponent.dbId
																: INVALID_PLAYER_AVATAR_ID")

		(macro SELF_AVATAR_ID)

		(var observedPlayerDbId:number = "vehicleAvatarId != INVALID_PLAYER_AVATAR_ID	? vehicleAvatarId
																						: null" )
		(var vehicleAlreadySwitched:bool = "observedPlayerDbId != null")
	)
	(bind name "'dogTagSpectator'")

	(alpha = 0)

	(controller $Animation
		(bindcall play
			from = { alpha: 0 }
			to = { alpha: 1 }
			duration = 0.2
			easing = "Easing.sine_in"
			on = 'addedToStage'
		)
	)

	(element PlayerDogTag
		_playerId	= "vehicleAlreadySwitched ? observedPlayerDbId : selfAvatarId"
		_size		= "DOG_TAG_SIZE.MEDIUM"
	)
)

(def element PlayerDogTag (_playerId:number, _size:number="DOG_TAG_SIZE.SMALL", _forceAssetDir:str = "null")
	(scope
		(var accountEntity:dhEntity = "getPrimaryEntity(CC.accountSimple, _playerId)")
		(var dogTagViewComponent:dhComponent = "accountEntity.dogTagView")
		(var dogTagIdList:array = "dogTagViewComponent.components" (event "dogTagViewComponent.evComponentsChanged"))

		(var dogTagEntitySymbol:dhEntity =			"getPrimaryEntity(CC.dogTagComponent, dogTagIdList[0])")
		(var dogTagEntityBgShape:dhEntity =			"dogTagIdList.length > 1 ? getPrimaryEntity(CC.dogTagComponent, dogTagIdList[1]) : null")
		(var dogTagEntityBgColor:dhEntity =			"dogTagIdList.length > 2 ? getPrimaryEntity(CC.dollBackgroundColor, dogTagIdList[2]) : null")
		(var dogTagEntityBgBorderColor:dhEntity =	"dogTagIdList.length > 2 ? getPrimaryEntity(CC.dollBorderColor, dogTagIdList[3]) : null")
		(var dogTagEntityBgMaterial:dhEntity =		"dogTagIdList.length > 2 ? getPrimaryEntity(CC.dollTexture, dogTagIdList[4]) : null")

		(var dogTagSymbolComponent:dhComponent =		"dogTagEntitySymbol.dogTagComponent")
		(var dogTagBgShapeComponent:dhComponent =		"dogTagEntityBgShape.dogTagComponent")
		(var dogTagBgColorComponent:dhComponent =		"dogTagEntityBgColor.dollBackgroundColor")
		(var dogTagBgBorderColorComponent:dhComponent =	"dogTagEntityBgBorderColor.dollBorderColor")
		(var dogTagBgMaterialComponent:dhComponent =	"dogTagEntityBgMaterial.dollTexture")

		(var dogTagSymbolName:str =		"dogTagSymbolComponent.gpName		?: ''" (event "dogTagSymbolComponent.evUpdate"))
		(var dogTagBgShapeName:str =	"dogTagBgShapeComponent.gpName		?: ''" (event "dogTagBgShapeComponent.evUpdate"))
		(var dogTagBgMaterialName:str =	"dogTagBgMaterialComponent.gpName	?: ''" (event "dogTagBgMaterialComponent.evUpdate"))
		(var isColorizableShape:bool =	"dogTagBgShapeComponent.isColorizable" (event "dogTagBgShapeComponent.evUpdate"))
		(var symbolOffsetY:number =		"_size / 100 * (dogTagBgShapeComponent.symbolOffsetY ?: 0)"	(event "dogTagBgShapeComponent.evUpdate"))

		(var dogTagSizeDir:str = "	_forceAssetDir != null			?	_forceAssetDir :
									_size == DOG_TAG_SIZE.SMALL		?	SC.Battle.DOG_TAG_SIZE.SMALL	:
									_size == DOG_TAG_SIZE.MEDIUM	?	SC.Battle.DOG_TAG_SIZE.MEDIUM	:
									_size == DOG_TAG_SIZE.BIG		?	SC.Battle.DOG_TAG_SIZE.BIG
																	:	SC.Battle.DOG_TAG_SIZE.SMALL")

		(var iconPath:str = "'url:../dogTags/' + dogTagSizeDir + '/'")
		(var dogTagSymbolPath:str = "dogTagSymbolName ? iconPath + dogTagSymbolName + '.png' : ''")
		(var dogTagBgMaterialDir:str = "dogTagBgMaterialName && isColorizableShape ? '/' + dogTagBgMaterialName : ''")
		(var bgShapePath:str = "dogTagBgShapeName ? iconPath + dogTagBgShapeName + dogTagBgMaterialDir + '.png' : ''" (event "dogTagViewComponent.evComponentsChanged"))
		(var bgBorderPath:str = "dogTagBgShapeName && isColorizableShape ? iconPath + dogTagBgShapeName + '/border.png' : ''" (event "dogTagViewComponent.evComponentsChanged"))

		(var dogtagBgColor:number = "dogTagBgColorComponent ? toNumber(dogTagBgColorComponent.colorHEX) : DOGTAG_BASE_COLOR")
		(var dogtagBorderColor:number = "dogTagBgBorderColorComponent ? toNumber(dogTagBgBorderColorComponent.colorHEX) : DOGTAG_BASE_COLOR")
		(var dogtagBaseColor:number = "dogTagBgMaterialComponent ? toNumber(dogTagBgMaterialComponent.baseColorHEX) : DOGTAG_BASE_COLOR")

		(macro COLOR_DIFF_TO_COLOR_TRANSFORM "'bgTransform'" "dogtagBaseColor" "dogtagBgColor")
		(macro COLOR_DIFF_TO_COLOR_TRANSFORM "'borderTransform'" "dogtagBaseColor" "dogtagBorderColor")

		(var playerEntity:dhEntity = "getPrimaryEntity(CC.accountSimple, _playerId)")
		(var playerComponentClanman:dhComponent = "playerEntity.clanman")
		(var clanId:number = "playerComponentClanman.clanId" (event "playerComponentClanman.evClanIdChanged"))

		(var clanEntity:dhEntity = "getPrimaryEntity(CC.clan, clanId)")
		(var clanComponent:dhComponent = "clanEntity.clan")
		(var clanTag:str = "clanComponent.tag ?: ''" (event "clanComponent.evTagChanged"))

		(var clanTagComponent:dhComponent = "dogTagSymbolComponent.clanTagVisible ? dogTagSymbolComponent : dogTagBgShapeComponent")
		(var clanTagVisible:bool = "clanTagComponent.clanTagVisible" (event "clanTagComponent.evUpdate"))

		(var clanTagOffsetX:number = "clanTagComponent ? _size / 100 * clanTagComponent.clanTagOffsetX : 0" (event "clanTagComponent.evUpdate"))
		(var clanTagOffsetY:number = "clanTagComponent ? _size / 100 * clanTagComponent.clanTagOffsetY : 0" (event "clanTagComponent.evUpdate"))
		(var clanTagFontColor:number = "clanTagComponent && clanTagComponent.clanTagFontColor	? toNumber(clanTagComponent.clanTagFontColor)
																								: dogtagBorderColor" (event "clanTagComponent.evUpdate"))

		(var clanTagStr:str = "clanTag ? '[' + clanTag + ']' : '^'")
		(var clanTagUrl:str = "'img://embedded:DogTag?text=' + clanTagStr + '&font=' + dogTagSizeDir + '/WarHeliosCond_Textile'")

		(var dogTagBgColorName:str = "dogTagBgColorComponent.gpName" (event "dogTagBgColorComponent.evUpdate"))
		(var dogTagBgBorderColorName:str = "dogTagBgBorderColorComponent.gpName" (event "dogTagBgBorderColorComponent.evUpdate"))

		(macro COLOR_DIFF_TO_COLOR_TRANSFORM "'clanTagTransform'" "dogtagBaseColor" "clanTagFontColor")
	)

	(bind name "'current_dogtag_' + dogTagSymbolName + '_' +  dogTagBgShapeName + '_' + dogTagBgColorName + '_' + dogTagBgBorderColorName + '_' + dogTagBgMaterialName")
	(style
		(bind width "_size")
		(bind height "_size")
	)

	
	(block
		(bind name "dogTagSizeDir + '/shape/' + dogTagBgShapeName ")
		(bind visible "dogTagBgShapeComponent")
		(class $FullsizeAbsolute)
		(style
			(backgroundSize = "fill")
			(bind backgroundImage "bgShapePath")
		)
		(bind colorTransform "isColorizableShape && dogTagBgColorComponent ? bgTransform : {}")
	)

	(block
		(bind name "dogTagSizeDir + '/borderColor/' + dogtagBorderColor")
		(bind visible "dogTagBgBorderColorComponent")
		(class $FullsizeAbsolute)
		(style
			(backgroundSize = "fill")
			(bind backgroundImage "bgBorderPath")
		)
		(bind colorTransform "isColorizableShape && dogTagBgBorderColorComponent ? borderTransform : {}")
	)

	
	(block
		(bind name "dogTagSizeDir + '/symbolName/' + dogTagSymbolName")
		(bind visible "dogTagSymbolComponent")
		(class $FullsizeAbsolute)
		(style
			(backgroundSize = "fill")
			(bind backgroundImage "dogTagSymbolPath")
			(bind top "symbolOffsetY")
		)
	)

	
	(block
		(bind visible "clanTagVisible")
		(class $FullsizeAbsolute)
		(style
			(position = "absolute")
			(bind left "clanTagVisible ? clanTagOffsetX : 0")
			(bind top "clanTagVisible ? clanTagOffsetY : 0")
		)

		(block
			(style
				(position = "absolute")
				(backgroundSize = "autosize")
				(bind marginLeft "-50%")
				(bind marginTop "-50%")
				(bind backgroundImage "clanTagUrl")
			)
			(bind colorTransform "clanTagTransform")
		)
	)
)