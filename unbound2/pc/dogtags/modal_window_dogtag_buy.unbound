(def element ModalWindowBuyDogTag (_dogTagElementId:number, _dogTagElementCategoryId:number, _noSaved:bool = true)
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)

	(scope
		(macro PULL_SHIP_ID)

		
		(var dogTagElementTypeShared:str = "SC.Common.DOGTAG_ELEMENTS.VALUE_TO_NAME[_dogTagElementCategoryId]")
		(var dogTagElementType:str = "SC.Common.DOGTAG_ELEMENTS.NAMES[dogTagElementTypeShared]")
		(var windowHeader:str = "'IDS_MODAL_WINDOW_BUY_DOGTAG_' + dogTagElementType +  '_HEADER'")

		
		(var componentClass:number = "	_dogTagElementCategoryId == SC.Common.DOGTAG_ELEMENTS.BG_COLOR			? CC.dollBackgroundColor :
										_dogTagElementCategoryId == SC.Common.DOGTAG_ELEMENTS.BG_BORDER_COLOR	? CC.dollBorderColor :
										_dogTagElementCategoryId == SC.Common.DOGTAG_ELEMENTS.BG_MATERIAL		? CC.dollTexture
																												: CC.dogTagComponent")
		(var dogTagElementComponent:dhComponent = "getPrimaryComponent(componentClass, _dogTagElementId)")

		(var dogTagIconPrefix:str = "	componentClass == CC.dollBackgroundColor	? SC.Common.DOGTAG_ELEMENTS.NAMES.BG_COLOR :
										componentClass == CC.dollBorderColor		? SC.Common.DOGTAG_ELEMENTS.NAMES.BG_BORDER_COLOR
																					: ''")
		(var isColorizableShape:bool = "componentClass && dogTagElementComponent.isColorizable")

		(var dogTagName:str = "dogTagElementComponent.gpName" (event "dogTagElementComponent.evUpdate"))
		(var dogTagIconDir:str = "dogTagIconPrefix || dogTagName ? ('url:../dogTags/' + (dogTagIconPrefix ? 'preview/' + dogTagIconPrefix : 'small/' + dogTagName)) : null")
		(var dogTagIconPath:str = "dogTagIconDir ? dogTagIconDir + (isColorizableShape ? '/PCNT001' : '') + '.png' : ''")
		(var dogTagIconColor:number = "dogTagIconPrefix && dogTagElementComponent.colorHEX ? toNumber(dogTagElementComponent.colorHEX) : DOGTAG_BASE_COLOR")

		(macro COLOR_DIFF_TO_COLOR_TRANSFORM "'iconTransform'" "DOGTAG_BASE_COLOR" "dogTagIconColor")
		(var finalIconTransform:dict = "dogTagIconPrefix ? iconTransform : CT_NONE")

		
		(struct dogtagPrice = PULL_PRICE(_entityId = "dogTagElementComponent.id" _actionId = "SC.Common.PRICE_ACTION.BUY"))
		(var finalDogTagPriceInfo:dict = "dogtagPrice.info")

		(var accountResource:dhComponent = "getSingleComponent(CC.accountResource)")
		(var priceDeficit:number = "finalDogTagPriceInfo.finalPrice - accountResource[finalDogTagPriceInfo.currency]" (event "accountResource.evChangedGold") (event "accountResource.evChangedCredit"))
		(var isDeficit:bool = "priceDeficit > 0")

		(var isPatch:bool = "_dogTagElementCategoryId == SC.Common.DOGTAG_ELEMENTS.SYMBOL_PATCH")
		(var dogtagStereotypeSubheader:str = "isPatch	? 'IDS_DOGTAGS_TAB_' + SC.Common.DOGTAG_ELEMENTS.VALUE_TO_NAME[_dogTagElementCategoryId]
														: 'IDS_DOGTAGS_CONSTRUCTOR_TAB_' + SC.Common.DOGTAG_ELEMENTS.VALUE_TO_NAME[_dogTagElementCategoryId]")
	)

	(name = 'dogTagModalBuy')

	(block
		(class $EyeLevelAligned)
		(style (width = "MODAL_WINDOW_EXTERIOR_BUY_WIDTH"))

		
		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
			(style (width = 100%))

			(element ModalWindowShortHeader
				_header = "windowHeader"
				_hasDivider = false
			)
		)

		
		(block
			(style
				(align = "center")
				(width = 100%)
			)

			
			(block
				(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
				(style (width = 100%))

				(element CurrenciesPanel
					_priceInfo = "[{ finalPrice: -finalDogTagPriceInfo.finalPrice, currency: finalDogTagPriceInfo.currency }]"
					_width = " MODAL_WINDOW_EXTERIOR_BUY_WIDTH"
				)
			)

			
			(block
				(macro DEFAULT_MODAL_WINDOW_ANIMATION 1.5)
				(style
					(align = "center")
					(width = 100%)
					(paddingLeft = "SXS")
					(paddingRight = "SXS")
					(marginBottom = "S")
				)

				(controller $Tooltip
					(renderer = 'DogTagComponentTooltip')
					(args
						_elementEntityId = "dogTagElementComponent._entity_id"
					)
					(macro DEFAULT_TOOLTIP_BEHAVIOUR)
				)

				(element ModalWindowSystemExpendableIconWithHeaderAndSubheader
					_imageWidth =		80px
					_imageHeight =		80px
					_headerIconType =	"MODAL_WINDOW_SYSTEM_PURCHASABLE_ITEM_ICON.DOGTAG"
					_maxWidth =			"MODAL_WINDOW_EXTERIOR_BUY_WIDTH"
					_headerText =		"'IDS_DOGTAG_' + dogTagName + '_NAME'"
					_subheaderText =	"dogtagStereotypeSubheader"
					_unifiedStatus =	"SC.Ui_styles.UNIFIED_STATUS.DEFAULT"
					_data =				"{ imageUrl: dogTagIconPath, iconTransform: finalIconTransform }"
				)
			)

			
			(block
				(macro DEFAULT_MODAL_WINDOW_ANIMATION 1.5)
				(style
					(width = 100%)
					(marginBottom = "MS")
				)

				(element HorizontalDividerTwoPx)
			)

			
			(block
				(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
				(style
					(width = 100%)
					(marginBottom = "MS")
				)

				(element ModalWindowSystemPurchaseItemPriceAndInfo
					_priceInfo =					"finalDogTagPriceInfo"
					_questionString =				"_noSaved ? 'IDS_MODAL_WINDOW_BUY_DOGTAG' : 'IDS_MODAL_WINDOW_BUY_DOGTAG_AND_SAVE'"
					_isDeficit =					"isDeficit"
					_deficit =						"priceDeficit"
					_isWarningText =				"isDeficit"
				)
			)

			
			(block
				(macro DEFAULT_MODAL_WINDOW_ANIMATION 2.5)
				(style
					(align = "center")
					(width = 100%)
				)

				(element ModalWindowSystemPurchaseItemYesNoCloseButtons
					_isDeficit = "isDeficit"
					_okMethods = "_noSaved	? [{ type: 'inputMapping.onAction', name: SC.Ui_methods.DOGTAG_METHODS.BUY_ITEM, args: { dogTagId: _dogTagElementId } }]
								 			: [{ type: 'inputMapping.onAction', name: SC.Ui_methods.DOGTAG_METHODS.SAVE, args: {} }]"
				)
			)
		)
	)
)
