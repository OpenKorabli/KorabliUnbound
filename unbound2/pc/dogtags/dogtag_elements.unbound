(def constant DOGTAG_BASE_COLOR 0xBCBCBC)

(def element DogTagComponentTooltip (_elementEntityId:number, _rewardItem:dict = {}, _canInstall:bool=false, _isClickDisabled:bool=false)
	(scope
		(var isReward:bool = "'id' in _rewardItem")

		(var dogTagRewardComponent:dhComponent = "	_rewardItem.subtype == 'BackgroundColor'	? getPrimaryComponent(CC.dollBackgroundColor, _rewardItem.id) :
													_rewardItem.subtype == 'BorderColor'		? getPrimaryComponent(CC.dollBorderColor, _rewardItem.id)
																								: getPrimaryComponent(CC.dogTagComponent, _rewardItem.id)")

		(var dogTagEntity:dhEntity = "getEntity(_elementEntityId)")

		(var dogTagIconRewardPrefix:str = "	_rewardItem.subtype == 'BackgroundColor'	? SC.Common.DOGTAG_ELEMENTS.NAMES.BG_COLOR :
											_rewardItem.subtype == 'BorderColor'		? SC.Common.DOGTAG_ELEMENTS.NAMES.BG_BORDER_COLOR
																						: ''")

		(var dogTagIconBasePrefix:str = "	dogTagEntity.dollBackgroundColor	? SC.Common.DOGTAG_ELEMENTS.NAMES.BG_COLOR :
											dogTagEntity.dollBorderColor		? SC.Common.DOGTAG_ELEMENTS.NAMES.BG_BORDER_COLOR
																				: ''")

		(var dogTagBaseComponent:dhComponent =	"	dogTagEntity.hasComponent(CC.dogTagComponent)		? dogTagEntity.dogTagComponent :
													dogTagEntity.hasComponent(CC.dollBackgroundColor)	? dogTagEntity.dollBackgroundColor :
													dogTagEntity.hasComponent(CC.dollBorderColor)		? dogTagEntity.dollBorderColor :
													dogTagEntity.hasComponent(CC.dollTexture)			? dogTagEntity.dollTexture
																										: null")

		(var dogTagIconPrefix:str = "isReward ? dogTagIconRewardPrefix : dogTagIconBasePrefix")
		(var dogTagComponent:dhComponent = "isReward ? dogTagRewardComponent : dogTagBaseComponent")

		(var isEnabled:bool =		"dogTagComponent ? dogTagComponent.enabled	: true"		(event "dogTagComponent.evUpdate"))
		(var dogTagName:str =		"dogTagComponent.gpName				?: ''"				(event "dogTagComponent.evUpdate"))
		(var categoryId:number =	"dogTagComponent.categoryId			?: 0"				(event "dogTagComponent.evUpdate"))
		(var hasDescription:bool =	"dogTagComponent && dogTagComponent.description != ''"	(event "dogTagComponent.evUpdate"))
		(var restriction:str =		"dogTagComponent.restriction		?: ''"				(event "dogTagComponent.evUpdate"))
		(var data:dict =			"dogTagComponent.data				?: {}"				(event "dogTagComponent.evUpdate"))
		(var progress:array =		"dogTagComponent.progress			?: []"				(event "dogTagComponent.evUpdate"))
		(var quest:str =			"dogTagComponent.quest				?: ''"				(event "dogTagComponent.evUpdate"))
		(var clanTagVisible:bool =	"dogTagComponent.clanTagVisible"						(event "dogTagComponent.evUpdate"))
		(var isColorizable:bool =	"dogTagComponent.isColorizable"							(event "dogTagComponent.evUpdate"))
		(var dogTagCanBuy:bool =	"dogTagComponent.canBuy")

		(var dogTagIconDir:str =	"dogTagIconPrefix || dogTagName ? ('url:../dogTags/' + (dogTagIconPrefix ? 'preview/' + dogTagIconPrefix : 'small/' + dogTagName)) : ''")
		(var dogTagIconPath:str =	"dogTagIconDir ? dogTagIconDir + (isColorizable ? '/PCNT001' : '') + '.png' : ''")

		(var iconColor:number = "dogTagIconPrefix && dogTagComponent.colorHEX ? toNumber(dogTagComponent.colorHEX) : DOGTAG_BASE_COLOR")

		(macro COLOR_DIFF_TO_COLOR_TRANSFORM "'iconTransform'" "DOGTAG_BASE_COLOR" "iconColor")

		
		(var isDogTagComponentSaved:bool = "dogTagEntity && dogTagEntity.hasComponent(CC.dogTagComponentSaved)"	(event "dogTagComponent.evUpdate"))
		(var isStatusVisible:bool = "!isReward && isEnabled && isDogTagComponentSaved")

		(var battleTypesRestrictionArray:array = "data.battleTypes ?: []" (event "dogTagComponent.evUpdate"))

		(var hasRestrictions:bool = "dogTagEntity.hasComponent(CC.shipListRestrictions) || dogTagEntity.hasComponent(CC.divisionRestrictions)")
		(var hasProgressBarBlock:bool = "!isEnabled && !isReward")

		(var hasInStorage:bool = "dogTagComponent.enabled" (event "dogTagComponent.evUpdate"))
		(var canBuy:bool = "isIn(dogTagComponent.categoryId, SC.Common.DOGTAG_ELEMENTS.PURCHASABLE) && !hasInStorage && dogTagCanBuy")

		(struct dogTagPrice = PULL_PRICE(_entityId = "dogTagComponent.id" _actionId = "SC.Common.PRICE_ACTION.BUY"))
	)

	(style (width = 320px))

	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)
	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(block
			(style (width = 100%))
			(controller $Instance renderer='DogTagComponentTooltipHeader'
				(args
					_id = "dogTagEntity.id"
					_iconPath = "dogTagIconPath"
					_categoryId = "categoryId"
					_dogTagName = "dogTagName"
					_clanTagVisible = "clanTagVisible"
					_colorTransform = "iconTransform"
					_isReward = "isReward"
				)
			)
		)

		
		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider' (bind enabled "isStatusVisible"))
		)
		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemStatusLine'
				(bind enabled "isStatusVisible")
				(args
					_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.CHECK"
					_text = 'IDS_DOGTAG_COMPONENT_SET'
				)
			)
		)

		
		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider' (bind enabled "!hasInStorage && (!isReward || canBuy)"))
		)
		(element TOOLTIP_SYSTEM_ELEMENTS_GROUP
			(bind visible "!hasInStorage && (!isReward || canBuy)")

			
			(element TOOLTIP_SYSTEM_GROUP_ELEMENT _isEnabled="!isReward"
				(controller $Instance renderer='TooltipSystemDescriptionText'
					(bind enabled "!isReward")
					(args
						_descriptionText = 'IDS_OUT_OF_STOCK'
					)
				)
			)

			
			(element TOOLTIP_SYSTEM_GROUP_ELEMENT _isEnabled="canBuy && !isReward"
				(controller $Instance renderer='TooltipSystemPriceTagLine'
					(bind enabled "canBuy && !isReward")
					(args
						_title = 'IDS_COST_COLON'
						_priceInfo = "dogTagPrice.info"
						_isAutoWidth = true
					)
				)
			)
		)

		
		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider' (bind enabled "hasDescription"))
		)
		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHtmlDescriptionText'
				(bind enabled "hasDescription")
				(args
					_descriptionText = "tr(toUpper('IDS_DOGTAG_' + dogTagName + '_DESCRIPTION'))"
				)
			)
		)

		
		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider' (bind enabled "!isReward && quest"))
		)
		(block
			(style
				(width = 100%)
			)
			(block
				(style
					(width = 100%)
					(bind marginBottom "hasProgressBarBlock && quest ? SXS : 0px")
				)
				(controller $Instance renderer= 'TooltipSystemDescriptionText'
					(bind enabled "!isReward && quest")
					(args
						_descriptionText = "quest"
					)
				)
			)
			(block
				(style
					(width = 100%)
					(vgap = 9px)
				)
				
				(controller $Repeat renderer='TooltipSystemProgressBarBlock'
					(bind enabled "hasProgressBarBlock")
					(bind count "progress.length")
					(args
						_title = "tr('IDS_DOGTAG_PARAM_' + progress[$index][0])"
						_currentValue = "progress[$index][2]"
						_maxValue = "progress[$index][1]"
						_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.DEFAULT"
					)
				)
			)
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider' (bind enabled "restriction"))
		)

		
		(block
			(bind visible "restriction")
			(style (width = 100%))
			(macro TOOLTIP_SYSTEM_INNER_PANEL_BACKGROUND)

			(block
				(style (width = 100%))

				(controller $Instance renderer='TooltipSystemDescriptionText'
					(bind enabled "restriction")
					(args
						_descriptionText = 'IDS_SSE_TASK_RESTRICTIONS_COLON'
					)
				)
			)

			
			(hblock
				(style (marginTop = "S"))

				(hblock
					(controller $Repeat renderer='DogTagBattleTypeRestriction'
						(bind items "battleTypesRestrictionArray")
						(args
							_battleType = "$item"
						)
					)
				)

				(block
					(bind visible "hasRestrictions")
					(style
						(height = 21px)
						(marginRight = 3px)
					)
					(element VerticalDivider)
				)

				(block
					(controller $Instance renderer='ShipRestrictions'
						(bind enabled "hasRestrictions")
						(args
							_restrictionsEntityId = "dogTagEntity.id"
							_isFromTooltip = true
						)
					)
				)
			)
		)

		
		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider' (bind enabled "_canInstall && !_isClickDisabled"))
		)
		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemStatusLine'
				(bind enabled "_canInstall && !_isClickDisabled")
				(args
					_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.MOUSE_LEFT"
					_text = "'IDS_SELECT_DOGTAG_COMPONENT_' + SC.Common.DOGTAG_ELEMENTS.VALUE_TO_NAME[categoryId]"
				)
			)
		)
	)
)

(def element DogTagComponentTooltipHeader (_id:number, _iconPath:str, _categoryId:number, _dogTagName:str, _clanTagVisible:bool=true, _colorTransform:dict={}, _isReward:bool = false)
	(scope
		(macro PULL_SELF_PLAYER_SCOPE)
	)

	(style
		(align = "middle")
		(flow = "horizontal")
		(width = 100%)
		(minHeight = 80px)
	)

	(block
		(style
			(align = "top|center")
			(width = 80px)
			(height = 100%)
			(marginRight = "M")
		)

		
		(element DogTagItemView
			_isActive = true
			_iconPath = "_iconPath"
			_hasInStorage = true
			_isEnabled = true
			_isSelected = false
			_iconColorTransform = "_colorTransform ?: CT_NONE"
			_isReward = "_isReward"
		)

		(controller $Instance renderer='ClanTagForDogTag'
			(bind enabled "_clanTagVisible")
			(args
				_dogTagEntityId = "_id"
				_playerDbId = "selfPlayerDbId"
				_dogTagSize = "DOG_TAG_SIZE.SMALL"
			)
		)
	)

	(element TooltipSystemHeaderSubheaderText
		_headerText = "'IDS_DOGTAG_' + _dogTagName + '_NAME'"
		_subheaderText = "_isReward	? 'IDS_DOGTAG_COMPONENT_REWARD_CATEGORY_' + _categoryId
									: 'IDS_DOGTAG_COMPONENT_TOOLTIP_CATEGORY_' + _categoryId"
	)
)

(def element ClanTagForDogTag (_dogTagEntityId:number, _playerDbId:number, _dogTagSize:number)
	(scope
		(var playerEntity:dhEntity = "getPrimaryEntity(CC.accountSimple, _playerDbId)")
		(var clanId:number = "playerEntity.clanman.clanId" (event "playerEntity.clanman.evClanIdChanged"))

		(var clanEntity:dhEntity = "getPrimaryEntity(CC.clan, clanId)")
		(var clanTag:str = "clanEntity && clanEntity.clan ? clanEntity.clan.tag : ''" (event "clanEntity.clan.evTagChanged"))

		(var dogTagEntity:dhEntity = "getEntity(_dogTagEntityId)")
		(var dogTagComponent:dhComponent = "dogTagEntity.dogTagComponent")
		(var dogTagSize:str = "	_dogTagSize == DOG_TAG_SIZE.SMALL	? SC.Battle.DOG_TAG_SIZE.SMALL	:
								_dogTagSize == DOG_TAG_SIZE.MEDIUM	? SC.Battle.DOG_TAG_SIZE.MEDIUM :
								_dogTagSize == DOG_TAG_SIZE.BIG		? SC.Battle.DOG_TAG_SIZE.BIG
																	: SC.Battle.DOG_TAG_SIZE.SMALL")

		(var clanTagOffsetX:number = "dogTagComponent ? dogTagComponent.clanTagOffsetX : 0" (event "dogTagComponent.evUpdate"))
		(var clanTagOffsetY:number = "dogTagComponent ? dogTagComponent.clanTagOffsetY : 0" (event "dogTagComponent.evUpdate"))
		(var dogtagBaseColor:number = "dogTagComponent.baseColorHEX ?: DOGTAG_BASE_COLOR")
		(var clanTagFontColor:number = "dogTagComponent.clanTagFontColor	? toNumber(dogTagComponent.clanTagFontColor)
																			: dogtagBaseColor"	(event "dogTagComponent.evUpdate"))

		(macro COLOR_DIFF_TO_COLOR_TRANSFORM "'clanTagTransform'" "dogtagBaseColor" "clanTagFontColor")

		(var clanTagStr:str = "clanTag ? '[' + clanTag + ']' : '^'")
		(var clanTagUrl:str = "'img://embedded:DogTag?text=' + clanTagStr + '&font=' + dogTagSize + '/WarHeliosCond_Textile'")
	)

	(style
		(position = "absolute")
		(bind left "clanTagOffsetX")
		(bind top "clanTagOffsetY")
	)

	(block
		(style
			(position = "absolute")
			(backgroundSize = "autosize")
			(bind marginLeft "-50%")
			(bind marginTop "-50%")
			(bind backgroundImage "clanTagUrl")
		)
		(bind colorTransform "clanTagTransform")
	)
)

(def element DogTagBattleTypeRestriction (_battleType:str)
	(scope
		(var battleTypeIcon:str = "	_battleType == 'PVP'				? SC.Common.BATTLE_TYPES.RANDOM_BATTLE :
									_battleType == 'COOPERATIVE'		? SC.Common.BATTLE_TYPES.COOPERATIVE_BATTLE :
									_battleType == 'RANKED'				? SC.Common.BATTLE_TYPES.RANKED_BATTLE :
									_battleType == 'PVE'				? SC.Common.BATTLE_TYPES.PVE_BATTLE :
									_battleType == 'CLAN'				? SC.Common.BATTLE_TYPES.CLAN_BATTLE :
									_battleType == 'PVE_TRIAL'			? SC.Common.BATTLE_TYPES.TRIAL_BATTLE :
									_battleType == 'RATING'				? SC.Common.BATTLE_TYPES.RATING_BATTLE
																		: SC.Common.BATTLE_TYPES.RANDOM_BATTLE")
	)

	(style
		(width = 20px)
		(height = 20px)
		(marginRight = 6px)
		(backgroundSize = "cover")
		(bind backgroundImage "'url:../service_kit/battle_types/' + battleTypeIcon + '_tiny.png'")
	)
)
