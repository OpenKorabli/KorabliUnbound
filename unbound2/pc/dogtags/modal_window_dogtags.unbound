(def constant DOGTAG_CONTENT_WIDTH 80px)

(def constant DOGTAG_CATEGORY_TAB_CONTENT "['DogtagConstructorInset',
											'DogtagSubgroupInset',
											'DogtagGroupInset' ]")

(def constant CONSTRUCTOR_COLORIZATION_CATEGORIES "[SC.Common.DOGTAG_ELEMENTS.BG_COLOR,
													SC.Common.DOGTAG_ELEMENTS.BG_BORDER_COLOR,
													SC.Common.DOGTAG_ELEMENTS.BG_MATERIAL ]")

(def macro COLOR_DIFF_TO_COLOR_TRANSFORM(_colorTransformField:expression, _baseColor:expression, _desiredColor:expression)
	(var name="_colorTransformField" type=dict value="{	redOffset: ((_desiredColor & 0xFF0000) >> 16) - ((_baseColor & 0xFF0000) >> 16), 
														greenOffset: ((_desiredColor & 0x00FF00) >> 8) - ((_baseColor & 0x00FF00) >> 8), 
														blueOffset: (_desiredColor & 0x0000FF) - (_baseColor & 0x0000FF) }")
)

(def element ModalWindowDogTag ()
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)

	(scope
		(event evTabClicked)
		(event evContentChanged)

		(var selfAvatarEntity:dhEntity =  "getSingleEntity(CC.accountSelf)")
		(var selfClanmanComponent:dhComponent = "selfAvatarEntity.clanman")
		(var clanId:number = "selfClanmanComponent.clanId" (event "selfClanmanComponent.evClanIdChanged"))

		(var clanComponent:dhComponent = "getPrimaryComponent(CC.clan, clanId)")
		(var clanTag:str = "clanComponent.tag" (event "clanComponent.evTagChanged"))

		(var dogTagPatchCollection:dhCollection = "getCollectionByPath(CC.dogTagComponent, 'patch')")
		(var hasPatches:bool = "dogTagPatchCollection.length > 0")

		(var dogTagSortedSavedCollection:dhCollection = "getCollectionByPath(CC.dogTagComponentSaved, 'sorted')")

		(var dogTagPreviewComponent:dhComponent =	"getSingleComponent(CC.dogTagComponentPreview)")
		(var previewSymbolId:number =				"dogTagPreviewComponent.symbol			?: 0" (event "dogTagPreviewComponent.evChanged"))
		(var previewBgShapeId:number =				"dogTagPreviewComponent.bgShape			?: 0" (event "dogTagPreviewComponent.evChanged"))
		(var previewBgColorId:number =				"dogTagPreviewComponent.bgColor			?: 0" (event "dogTagPreviewComponent.evChanged"))
		(var previewBgBorderId:number =				"dogTagPreviewComponent.bgBorderColor	?: 0" (event "dogTagPreviewComponent.evChanged"))
		(var previewBgMaterialId:number =			"dogTagPreviewComponent.bgMaterial		?: 0" (event "dogTagPreviewComponent.evChanged"))

		(var selectedSymbolEntity:dhEntity =		"getPrimaryEntity(CC.dogTagComponent, previewSymbolId)" 		(event "dogTagPreviewComponent.evChanged"))
		(var selectedBgShapeEntity:dhEntity =		"getPrimaryEntity(CC.dogTagComponent, previewBgShapeId)" 		(event "dogTagPreviewComponent.evChanged"))
		(var selectedBgColorEntity:dhEntity =		"getPrimaryEntity(CC.dollBackgroundColor, previewBgColorId)"	(event "dogTagPreviewComponent.evChanged"))
		(var selectedBgBorderColorEntity:dhEntity =	"getPrimaryEntity(CC.dollBorderColor, previewBgBorderId)"		(event "dogTagPreviewComponent.evChanged"))
		(var selectedBgMaterialEntity:dhEntity =	"getPrimaryEntity(CC.dollTexture, previewBgMaterialId)" 		(event "dogTagPreviewComponent.evChanged"))
		(var isSelectedUnique:bool =				"dogTagPreviewComponent.isUnique"								(event "dogTagPreviewComponent.evChanged"))
		(var isSaveVisible:bool =					"dogTagPreviewComponent.isSaveVisible"							(event "dogTagPreviewComponent.evChanged"))
		(var isSaveEnabled:bool =					"dogTagPreviewComponent.isSaveEnabled"							(event "dogTagPreviewComponent.evChanged"))
		(var purchasableComponents:number =			"dogTagPreviewComponent.purchasableComponents"					(event "dogTagPreviewComponent.evPurchasableComponentsChanged"))

		(var dogTagSymbolEntity:dhEntity =			"	selectedSymbolEntity						?	selectedSymbolEntity
																									:	dogTagSortedSavedCollection.getEntityAtIndex(0)")
		(var dogTagBgShapeEntity:dhEntity =			"	selectedBgShapeEntity						?	selectedBgShapeEntity :
														dogTagSortedSavedCollection.length > 1		?	dogTagSortedSavedCollection.getEntityAtIndex(1)
																									:	null")
		(var dogTagBgColorEntity:dhEntity =			"	selectedBgColorEntity						?	selectedBgColorEntity :
														dogTagSortedSavedCollection.length > 2		?	dogTagSortedSavedCollection.getEntityAtIndex(2)
																									:	null")
		(var dogTagBorderColorEntity:dhEntity =		"	selectedBgBorderColorEntity					?	selectedBgBorderColorEntity :
														dogTagSortedSavedCollection.length > 2		?	dogTagSortedSavedCollection.getEntityAtIndex(3)
																									:	null")
		(var dogTagBgMaterialEntity:dhEntity =		"	selectedBgMaterialEntity					?	selectedBgMaterialEntity :
														dogTagSortedSavedCollection.length > 2		?	dogTagSortedSavedCollection.getEntityAtIndex(4)
																									:	null")

		(var dogTagSymbolComponent:dhComponent =		"dogTagSymbolEntity.dogTagComponent")
		(var dogTagBgShapeComponent:dhComponent =		"dogTagBgShapeEntity.dogTagComponent")
		(var dogTagBgColorComponent:dhComponent =		"dogTagBgColorEntity.dollBackgroundColor")
		(var dogTagBorderColorComponent:dhComponent =	"dogTagBorderColorEntity.dollBorderColor")
		(var dogTagBgMaterialComponent:dhComponent =	"dogTagBgMaterialEntity.dollTexture")

		(var dogTagSymbolName:str = "dogTagSymbolComponent.gpName" (event "dogTagSymbolComponent.evUpdate"))
		(var dogTagSymbolHasDescr:bool = "dogTagSymbolComponent.description" (event "dogTagSymbolComponent.evUpdate"))
		(var dogTagSymbolCategoryId:number = "dogTagSymbolComponent.categoryId ?: 0" (event "dogTagSymbolComponent.evUpdate"))

		(var dogTagBackgroundName:str = "dogTagBgShapeComponent.gpName" (event "dogTagBgShapeComponent.evUpdate"))
		(var isColorizableShape:bool = "dogTagBgShapeComponent.isColorizable" (event "dogTagBgShapeComponent.evUpdate"))
		(var hasBorder:bool = "dogTagBorderColorComponent && !isSelectedUnique && isColorizableShape")
		(var symbolOffsetY:number = "dogTagBgShapeComponent.symbolOffsetY ?: 0" (event "dogTagBgShapeComponent.evUpdate"))
		(var dogTagPreviewSize:number = 512px)
		(var finalSymbolOffsetY:number = "!isSelectedUnique ? dogTagPreviewSize / 100 * symbolOffsetY : 0")

		(var dogTagBgMaterialName:str = "dogTagBgMaterialComponent.gpName" (event "dogTagBgMaterialComponent.evUpdate"))

		(var dogTagPreviewDir:str = 'url:../dogTags/big/')
		(var dogTagBgMaterialDir:str = "dogTagBgMaterialComponent && isColorizableShape ? '/' + dogTagBgMaterialName : ''")

		(var dogtagBgColor:number = "dogTagBgColorComponent ? toNumber(dogTagBgColorComponent.colorHEX) : DOGTAG_BASE_COLOR")
		(var dogtagBorderColor:number = "dogTagBorderColorComponent ? toNumber(dogTagBorderColorComponent.colorHEX) : DOGTAG_BASE_COLOR")
		(var dogtagBaseColor:number = "dogTagBgMaterialComponent ? toNumber(dogTagBgMaterialComponent.baseColorHEX) : DOGTAG_BASE_COLOR")

		(var dogTagShapePath:str = "dogTagBackgroundName ? dogTagPreviewDir + dogTagBackgroundName + dogTagBgMaterialDir + '.png' : ''" watch=false (event "dogTagPreviewComponent.evChanged"))
		(var dogTagBorderPath:str = "hasBorder ? dogTagPreviewDir + dogTagBackgroundName + '/border.png' : ''" watch=false (event "dogTagPreviewComponent.evChanged"))
		(var dogTagSymbolPath:str = "dogTagSymbolName ? dogTagPreviewDir + dogTagSymbolName + '.png' : ''")

		(macro COLOR_DIFF_TO_COLOR_TRANSFORM "'bgTransform'" "dogtagBaseColor" "dogtagBgColor")
		(macro COLOR_DIFF_TO_COLOR_TRANSFORM "'borderTransform'" "dogtagBaseColor" "dogtagBorderColor")

		(var clanTagComponent:dhComponent = "dogTagBgShapeComponent && !isSelectedUnique	?	dogTagBgShapeComponent
																							:	dogTagSymbolComponent" (event "dogTagBgShapeComponent.evUpdate") (event "dogTagSymbolComponent.evUpdate"))
		(var clanTagVisible:bool = "dogTagBgShapeComponent && !isSelectedUnique	?	dogTagBgShapeComponent.clanTagVisible :
									dogTagSymbolComponent						?	dogTagSymbolComponent.clanTagVisible
																				:	false" (event "dogTagPreviewComponent.evChanged"))

		(var clanTagOffsetX:number = "clanTagComponent ? 512 / 100 * clanTagComponent.clanTagOffsetX : 0"	(event "clanTagComponent.evUpdate"))
		(var clanTagOffsetY:number = "clanTagComponent ? 512 / 100 * clanTagComponent.clanTagOffsetY : 0"	(event "clanTagComponent.evUpdate"))
		(var clanTagFontColor:number = "clanTagComponent && clanTagComponent.clanTagFontColor	? toNumber(clanTagComponent.clanTagFontColor)
																								: dogtagBorderColor" (event "clanTagComponent.evUpdate"))

		(macro COLOR_DIFF_TO_COLOR_TRANSFORM "'clanTagTransform'" "dogtagBaseColor" "clanTagFontColor")

		(var clanTagStr:str = "clanTag ? '[' + clanTag + ']' : '^'")
		(var clanTagUrl:str = "'img://embedded:DogTag?text=' + clanTagStr + '&font=big/WarHeliosCond_Textile'")

		(struct newSymbolCounter =			PULL_NEW_CONTENT(_type="SC.Common.CONTENT_CATEGORY.SYMBOL"))
		(struct newBgShapeCounter =			PULL_NEW_CONTENT(_type="SC.Common.CONTENT_CATEGORY.BG_SHAPE"))
		(struct newBgColorCounter =			PULL_NEW_CONTENT(_type="SC.Common.CONTENT_CATEGORY.BG_COLOR"))
		(struct newBgBorderColorCounter =	PULL_NEW_CONTENT(_type="SC.Common.CONTENT_CATEGORY.BG_BORDER_COLOR"))
		(struct newBgMaterialCounter =		PULL_NEW_CONTENT(_type="SC.Common.CONTENT_CATEGORY.BG_MATERIAL"))
		(struct newPatchCounter =			PULL_NEW_CONTENT(_type="SC.Common.CONTENT_CATEGORY.SYMBOL_PATCH"))
		(struct newEmblemCounter =			PULL_NEW_CONTENT(_type="SC.Common.CONTENT_CATEGORY.SYMBOL_UNIQUE"))

		(var newCounterInfo:array = "[	(newSymbolCounter.value + newBgShapeCounter.value + newBgColorCounter.value + newBgBorderColorCounter.value + newBgMaterialCounter.value),
										newPatchCounter.value,
										newEmblemCounter.value ]")

		(var selectedTab:number = "dogTagSymbolCategoryId" watch=false)
		(var isConstructorTabSelected:bool = "selectedTab == SC.Common.DOGTAG_CATEGORIES.CONSTRUCTOR")

		(bind selectedTab "$event.index" init=false (event "evContentChanged"))
		(bind selectedTab "!hasPatches ? SC.Common.DOGTAG_CATEGORIES.CONSTRUCTOR : selectedTab" init=false watch=false (event "dogTagPatchCollection.evUpdated"))

		
		(var hasSingleItemToBuy:bool = "purchasableComponents == 1")
		(var singleItemBuyInfo:dict = "		previewSymbolId != 0 && dogTagSymbolComponent.enabled == false			?	{ _dogTagElementId: previewSymbolId, _dogTagElementCategoryId: dogTagSymbolComponent.categoryId, _noSaved: false } :
											previewBgShapeId != 0 && dogTagBgShapeComponent.enabled == false		?	{ _dogTagElementId: previewBgShapeId, _dogTagElementCategoryId: dogTagBgShapeComponent.categoryId, _noSaved: false } :
											previewBgColorId != 0 && dogTagBgColorComponent.enabled == false		?	{ _dogTagElementId: previewBgColorId, _dogTagElementCategoryId: dogTagBgColorComponent.categoryId, _noSaved: false } :
											previewBgBorderId != 0 && dogTagBorderColorComponent.enabled == false	?	{ _dogTagElementId: previewBgBorderId, _dogTagElementCategoryId: dogTagBorderColorComponent.categoryId, _noSaved: false }
																													:	{}")

		
		(var isBuyAction:bool = "purchasableComponents > 0")
		(var saveButtonMethods:array = "isBuyAction	?	hasSingleItemToBuy	? [{	type: 'inputMapping.onRequest',
																					name: 'showModalBuyDogTag',
																					args: singleItemBuyInfo}]
																			: [{	type: 'inputMapping.onRequest',
																					name: 'showModalConstructorBuyDogTag',
																					args: {}}]
													: [{	type: 'inputMapping.onAction',
															name: SC.Ui_methods.DOGTAG_METHODS.SAVE,
															args: {}}]")

		(var isInBalancer:bool = "getSingleEntity(CC.balancerInfo) != null")
		(var dogTagBgColorName:str = "dogTagBgColorComponent.gpName" (event "dogTagBgColorComponent.evUpdate"))
		(var dogTagBgBorderColorName:str = "dogTagBorderColorComponent.gpName" (event "dogTagBorderColorComponent.evUpdate"))
	)

	(name = 'dogTagModal')
	(dispatch evContentChanged args="$event" delay=0.1 (event "evTabClicked"))
	(bindcall externalCall "'inputMapping.onAction'" "['flushDogtagPreview', {}]" delay=0.075 init=false watch=false (event "startHide"))

	
	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
		(style (width = 100%))
		(element ModalWindowHeaderFullSize
			_windowName = 'IDS_MODAL_WINDOW_DOG_TAG_HEADER'
			_paddingRight = "M"
			_paddingLeft = "M"
			_hideBackButton = true
		)

		(block
			(style
				(position = "absolute")
				(bottom = "XXS")
				(right = "XLM")
			)

			(block
				(name = 'buttonBuyGold')

				(element DockResourcesWidget
					_name =		'goldBalance'
					_currency =	"SC.Common.CURRENCIES.GOLD"
					_label =	'IDS_DO_PURCHASE'
					_height =	47px
				)
			)
		)
	)

	
	(block
		(class $Fullsize)

		
		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 1.5)
			(style
				(align = "center")
				(width = 100%)
				(marginTop = "{ 720:SXS, 1080:MS }")
			)

			(element MAIN_TAB_BUTTONS_BLOCK

				
				(element MainTabButton
					_label = "'IDS_DOGTAGS_TAB_CONSTRUCTOR'"
					_width = "MAIN_TAB_BUTTON_WIDTH.MEDIUM"
					_isSelected = "isConstructorTabSelected"
					_dispatchedEv = 'evTabClicked'
					_dispatchParams = "{ index: SC.Common.DOGTAG_CATEGORIES.CONSTRUCTOR }"
					_newContentCounter = "!isConstructorTabSelected && newCounterInfo[SC.Common.DOGTAG_CATEGORIES.CONSTRUCTOR] > 0 ?
																	newCounterInfo[SC.Common.DOGTAG_CATEGORIES.CONSTRUCTOR] : 0"
					_name = 'DogTagTab_Constructor'
				)

				
				(block
					(bind visible "hasPatches")

					(controller $Instance renderer='MainTabButton'
						(bind enabled "hasPatches")
						(args
							_label = 'IDS_DOGTAGS_TAB_SYMBOL_PATCH'
							_width = "MAIN_TAB_BUTTON_WIDTH.MEDIUM"
							_isSelected = "selectedTab == SC.Common.DOGTAG_CATEGORIES.PATCH"
							_dispatchedEv = 'evTabClicked'
							_dispatchParams = "{ index: SC.Common.DOGTAG_CATEGORIES.PATCH }"
							_newContentCounter = "newCounterInfo[SC.Common.DOGTAG_CATEGORIES.PATCH] > 0 ? newCounterInfo[SC.Common.DOGTAG_CATEGORIES.PATCH] : 0"
							_name = 'DogTagTab_Patch'
						)
					)
				)

				
				(element MainTabButton
					_label = "'IDS_DOGTAGS_TAB_EMBLEM'"
					_width = "MAIN_TAB_BUTTON_WIDTH.MEDIUM"
					_isSelected = "selectedTab == SC.Common.DOGTAG_CATEGORIES.EMBLEM"
					_dispatchedEv = "'evTabClicked'"
					_dispatchParams = "{ index: SC.Common.DOGTAG_CATEGORIES.EMBLEM }"
					_newContentCounter = "newCounterInfo[SC.Common.DOGTAG_CATEGORIES.EMBLEM] > 0 ? newCounterInfo[SC.Common.DOGTAG_CATEGORIES.EMBLEM] : 0"
					_name = 'DogTagTab_Emblem'
				)
			)
		)

		
		(hblock
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 1.5)
			(class $Fullsize)
			(style
				(align = "center")
				(marginTop = "{ 720:S, 1080:L }")
			)

			
			(block
				(style
					(width = "dogTagPreviewSize")
					(marginRight = "XL")
					(marginBottom = "{ 720:S, 1080:M }")
				)

				
				(block
					(bind name "'current_dogtag_' + dogTagSymbolName + '_' + dogTagBackgroundName + '_' + dogTagBgColorName + '_' + dogTagBgBorderColorName + '_' + dogTagBgMaterialName")

					(style
						(hitTest = false)
						(width = 100%)
						(height = "dogTagPreviewSize")
					)

					
					(block
						(bind visible "dogTagBgShapeComponent && !isSelectedUnique")
						(class $FullsizeAbsolute)
						(style
							(backgroundSize = "cover")
							(bind backgroundImage "dogTagShapePath")
						)
						(bind colorTransform "dogTagBgColorComponent && isColorizableShape ? bgTransform : {}")
					)

					
					(block
						(bind visible "hasBorder")
						(class $FullsizeAbsolute)
						(style
							(backgroundSize = "cover")
							(bind backgroundImage "dogTagBorderPath")
						)
						(bind colorTransform "dogTagBorderColorComponent && isColorizableShape ? borderTransform : {}")
					)

					
					(block
						(bind visible "dogTagSymbolComponent")
						(class $FullsizeAbsolute)
						(style
							(backgroundSize = "cover")
							(bind backgroundImage "dogTagSymbolPath")
							(bind top "finalSymbolOffsetY")
						)
					)

					
					(block
						(bind visible "clanTagVisible")
						(class $FullsizeAbsolute)
						(style
							(position = "absolute")
							(bind left "clanTagVisible ? clanTagOffsetX : 0px")
							(bind top "clanTagVisible ? clanTagOffsetY : 0px")
						)

						(block
							(style
								(position = "absolute")
								(backgroundSize = "autosize")
								(bind marginLeft "-50%")
								(bind marginTop "-50%")
								(bind backgroundImage "clanTagUrl")
							)
							(bind colorTransform "clanTagTransform")
						)
					)
				)

				
				(block
					(style
						(position = "absolute")
						(marginTop = -6px)
						(alpha = "isConstructorTabSelected ? 1 : 0")
					)

					(controller $Animation
						(bindcall play
							duration = 0.15
							to		= "{ alpha: isConstructorTabSelected ? 1 : 0 }"
							easing	= "Easing.quad_in"
							(bind trigger "isConstructorTabSelected")
						)
					)

					(element ImageButton
						_enabled = "isConstructorTabSelected"
						_width = 48px
						_height = 48px
						_backgroundImage = 'url:../service_kit/icons/random.png'
						_methods = "[	{	type: 'inputMapping.onAction',
											name: 'previewRandomDogtag',
											args: {} 
										}]"
						_name = 'DogTagRandomizer'
					)
				)

				
				(block
					(style
						(width = 100%)
						(align = "center")
						(paddingLeft = "-XXS")
					)

					(scrollArea
						(style
							(width = 410px)
							(height = "{ 720:60px, 1080:300px }")
							(backgroundColor = "NO_COLOR")
						)

						(macro DEFAULT_VERTICAL_SCROLL_PARAMS
							_singleStep = "150px"
							_wheelScrollAcceleration = "0.8"
						)

						(content
							(style
								(width = 100%)
								(paddingLeft = "XXS")
							)

							(tf
								(class $TextDefaultBold30NM)
								(style
									(width = 100%)
									(marginTop = "XXS")
									(marginBottom = "{ 720:S, 1080:M }")
									(alpha = "TA")
								)
								(bind text "'IDS_DOGTAG_' + dogTagSymbolName + '_NAME'")
							)

							(tf
								(bind visible "dogTagSymbolHasDescr")
								(class $TextDefault18NM)
								(style
									(width = 100%)
									(marginBottom = "XS")
									(alpha = "TA")
									(multiline = true)
									(leading = -1)
									(styleSheet = '.p_spacing { font-size: 8px; }')
								)
								(bind htmlText "'IDS_DOGTAG_' + dogTagSymbolName +'_DESCRIPTION'")
							)
						)

						(bindcall scrollToBegin animated=false (bind trigger "dogTagSymbolName"))
					)
				)
			)

			
			(block
				(style (width = 590px))
				(bind alpha "0" init=false watch=false (event "evTabClicked"))

				(controller $Animation
					(bindcall play
						delay=0.15
						duration = 0.2
						to = "{ alpha: 1 }"
						easing = "Easing.line"
						action = "kill"
						(event "evTabClicked")
					)
				)

				(controller $Instance
					(bind renderer "DOGTAG_CATEGORY_TAB_CONTENT[selectedTab]")
					(args
						_insetName = "toLower(SC.Common.DOGTAG_CATEGORIES.VALUE_TO_NAME[selectedTab])"
						_isColorizableShape = "isColorizableShape"
					)
				)
			)
		)
	)

	
	(hblock
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
		(style
			(position = "absolute")
			(align = "center")
			(width = 100%)
			(bottom = "{ 720:S, 1080:LM }")
		)

		(block
			(style
				(marginRight = "M")
				(alpha = "isSaveVisible ? 1 : 0")
				(bind ubScaleX "isSaveVisible ? 1 : 0")
			)

			(controller $Animation
				(bindcall play
					duration = 0.15
					from =	"{alpha: 0, ubScaleX: 0}"
					to =	"{alpha: 1, ubScaleX: 1}"
					reverse = "!isSaveVisible"
					(bind trigger "isSaveVisible")
				)
			)

			(element DefaultButton
				_enabled = "isSaveEnabled && !isInBalancer"
				_label = "isBuyAction ? 'IDS_BUY_AND_SAVE_DOGTAG' : 'IDS_SAVE_DOGTAG'"
				_methods = "saveButtonMethods"
				_name = 'saveDogTag'
				_defaultFocused = true
				_focusIndex = 0
			)

			(controller $Tooltip
				(renderer = 'SimpleStatusTooltip')
				(bind enabled "isInBalancer")
				(args
					_text = 'IDS_UNABLE_TO_SET_WHILE_IN_BALANCER'
					_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.WARNING"
				)
				(macro DEFAULT_TOOLTIP_BEHAVIOUR)
			)
		)

		(element DefaultButton
			_name = 'btn_cancel'
			_label = 'IDS_CLOSE_BTN'
		)
	)
)

(def element DogtagConstructorInset (_insetName:str, _isColorizableShape:bool=true)
	(scope
		(event evConstructorTabClicked)
		(event evConstructorContentChanged)

		(var dogTagPreviewComponent:dhComponent = "getSingleComponent(CC.dogTagComponentPreview)")
		(var selectedConstructorTab:number = 0)
		(bind selectedConstructorTab "$event.index" init=false watch=false (event "evConstructorContentChanged"))
		(bind selectedConstructorTab "!_isColorizableShape && isIn(SC.Common.DOGTAG_ELEMENTS.ORDER[selectedConstructorTab], CONSTRUCTOR_COLORIZATION_CATEGORIES)
												? indexOf(SC.Common.DOGTAG_ELEMENTS.BG_SHAPE, SC.Common.DOGTAG_ELEMENTS.ORDER)
												: selectedConstructorTab" init=false watch=false (event "dogTagPreviewComponent.evChanged")) 

		(struct newSymbolCounter =			PULL_NEW_CONTENT(_type="SC.Common.CONTENT_CATEGORY.SYMBOL"))
		(struct newBgShapeCounter =			PULL_NEW_CONTENT(_type="SC.Common.CONTENT_CATEGORY.BG_SHAPE"))
		(struct newBgColorCounter =			PULL_NEW_CONTENT(_type="SC.Common.CONTENT_CATEGORY.BG_COLOR"))
		(struct newBgBorderColorCounter =	PULL_NEW_CONTENT(_type="SC.Common.CONTENT_CATEGORY.BG_BORDER_COLOR"))
		(struct newBgMaterialCounter =		PULL_NEW_CONTENT(_type="SC.Common.CONTENT_CATEGORY.BG_MATERIAL"))

		(var newCounterInfo:array = "[ newSymbolCounter.value, newBgShapeCounter.value, newBgColorCounter.value, newBgBorderColorCounter.value, newBgMaterialCounter.value ]")
	)
	(bind name "'dogTagInset_'+_insetName")
	(style (width = 100%))
	(dispatch evConstructorContentChanged args="$event" delay=0.1 (event "evConstructorTabClicked"))

	
	(hblock
		(style (width = 100%))

		(controller $Repeat renderer='DogtagConstructorInsetTabButtonWrapper'
			(count = "SC.Common.DOGTAG_ELEMENTS.ORDER.length")
			(args
				_selectedConstructorTab = "selectedConstructorTab"
				_isColorizableShape = "_isColorizableShape"
				_newCounterInfo = "newCounterInfo"
			)
		)

		(block
			(style
				(position = "absolute")
				(width = 100%)
				(bottom = 0px)
			)
			(element HorizontalDividerTwoPx)
		)
	)

	
	(block
		(style
			(width = 100%)
			(height = 660px)
			(bind alpha "0" init=false watch=false (event "evConstructorTabClicked"))
		)

		(controller $Animation
			(bindcall play
				delay = 0.1
				duration = 0.15
				to = "{ alpha: 1 }"
				easing = "Easing.line"
				action = "kill"
				(event "evConstructorTabClicked")
			)
		)

		(element DogtagSubgroupInset
			_insetName = "SC.Common.DOGTAG_ELEMENTS.NAMES[SC.Common.DOGTAG_ELEMENTS.VALUE_TO_NAME[SC.Common.DOGTAG_ELEMENTS.ORDER[selectedConstructorTab]]]"
		)
	)
)

(def element DogtagConstructorInsetTabButtonWrapper (_selectedConstructorTab:number, _isColorizableShape:bool, _newCounterInfo:array)
	(scope
		(var isTabDisabled:bool = "!_isColorizableShape && isIn(SC.Common.DOGTAG_ELEMENTS.ORDER[$index], CONSTRUCTOR_COLORIZATION_CATEGORIES)")
	)

	(element TabButton
		_label = "'IDS_DOGTAGS_CONSTRUCTOR_TAB_' + SC.Common.DOGTAG_ELEMENTS.VALUE_TO_NAME[SC.Common.DOGTAG_ELEMENTS.ORDER[$index]]"
		_isSelected = "SC.Common.DOGTAG_ELEMENTS.ORDER[_selectedConstructorTab] == SC.Common.DOGTAG_ELEMENTS.ORDER[$index]"
		_dispatchedEv = 'evConstructorTabClicked'
		_dispatchParams = "{ index: $index }"
		_name = "'DogTagSubtypeTabButton_' + SC.Common.DOGTAG_ELEMENTS.NAMES[SC.Common.DOGTAG_ELEMENTS.VALUE_TO_NAME[SC.Common.DOGTAG_ELEMENTS.ORDER[$index]]]"
		_newContentCounter = "_newCounterInfo[$index] > 0 ? _newCounterInfo[$index] : 0"
		_isDisabled = "isTabDisabled"
	)

	(controller $Tooltip
		(bind enabled "isTabDisabled")
		(renderer = 'SimpleStatusTooltip')
		(args
			_text = 'IDS_DOGTAGS_CONSTRUCTOR_TAB_DISABLED_TOOLTIP'
			_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.DEFAULT"
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR)
	)
)


(def element DogtagGroupInset (_insetName:str)
	(scope
		(var insetGroups:array = "SC.Dogtags_classifications[toUpper(_insetName) + '_GROUPS'].SORT_ORDER")
	)
	(bind name "'dogTagInset_'+_insetName")

	(scrollArea
		(style
			(width = 590px)
			(height = "{ 720:573px, 1080:794px }")
			(backgroundColor = "NO_COLOR")
		)

		(macro DEFAULT_VERTICAL_SCROLL_PARAMS
			_singleStep = "150px"
			_wheelScrollAcceleration = "0.7"
		)

		(content
			(style
				(width = 100%)
				(paddingTop = "MS")
				(paddingBottom = "S")
			)

			(controller $Repeat renderer='DogtagElementGroup'
				(bind items "insetGroups")
				(args
					_elementType = "_insetName"
					_groupName = "$item"
				)
			)
		)
	)
)


(def element DogtagSubgroupInset (_insetName:str)
	(scope
		(var insetGroups:array = "SC.Dogtags_classifications[toUpper(_insetName) + '_GROUPS'].SORT_ORDER")
		(var insetGroupsLength:number = "insetGroups.length")

		(var isCumulativeDelayCheck:bool = "isIn(_insetName, [SC.Common.DOGTAG_ELEMENTS.NAMES.SYMBOL, SC.Common.DOGTAG_ELEMENTS.NAMES.SYMBOL_PATCH])")
		(var activeGroupsComponent:dhComponent = "isCumulativeDelayCheck ? getPrimaryComponent(CC.dogTagActiveGroups, _insetName) : null")
		(var activeGroupsArray:array = "isCumulativeDelayCheck ? activeGroupsComponent.activeGroups : []" (event "activeGroupsComponent.evUpdate"))

		(var isPatch:bool = "_insetName == SC.Common.DOGTAG_ELEMENTS.NAMES.SYMBOL_PATCH")
		(var minDynamicHeight:number = "isPatch ? 573px : 536px")
		(var maxDynamicHeight:number = "isPatch ? 794px : 757px")

		(var componentClass:number = "	_insetName == SC.Common.DOGTAG_ELEMENTS.NAMES.BG_COLOR			? CC.dollBackgroundColor :
										_insetName == SC.Common.DOGTAG_ELEMENTS.NAMES.BG_BORDER_COLOR	? CC.dollBorderColor :
										_insetName == SC.Common.DOGTAG_ELEMENTS.NAMES.BG_MATERIAL		? CC.dollTexture
																										: CC.dogTagComponent")
	)
	(bind name "'dogTagInset_'+_insetName")

	(scrollArea
		(style
			(width = 590px)
			(height = "{ 720:minDynamicHeight, 1080:maxDynamicHeight }")
			(margin = 3px)
			(backgroundColor = "NO_COLOR")
		)

		(macro DEFAULT_VERTICAL_SCROLL_PARAMS
			_singleStep = "150px"
			_wheelScrollAcceleration = "0.7"
		)

		(content
			(style
				(width = 100%)
				(paddingTop = "MS")
				(paddingBottom = "S")
			)

			(controller $Repeat renderer='DogtagElementSubgroup'
				(bind count "isCumulativeDelayCheck ? activeGroupsArray.length : insetGroupsLength")
				(args
					_elementType = "_insetName"
					_groupName = "isCumulativeDelayCheck ? activeGroupsArray[$index] : insetGroups[$index]"
					_subgroupName = ''
					_isDeepSorting = false
					_componentClass = "componentClass"
				)
			)
		)
	)
)

(def element DogtagElementGroup (_elementType:str, _groupName:str)
	(scope
		(var subcollectionPath:str = "_elementType + '.byGroup.' + _groupName")
		(var componentClass:number = "	_elementType == SC.Common.DOGTAG_ELEMENTS.NAMES.BG_COLOR		? CC.dollBackgroundColor :
										_elementType == SC.Common.DOGTAG_ELEMENTS.NAMES.BG_BORDER_COLOR	? CC.dollBorderColor :
										_elementType == SC.Common.DOGTAG_ELEMENTS.NAMES.BG_MATERIAL		? CC.dollTexture
																										: CC.dogTagComponent")

		(var subgroupSharedName:str = "toUpper(_groupName + '_' + _elementType)")
		(var subgroupSharedArray:array = "SC.Dogtags_classifications[subgroupSharedName].SORT_ORDER")

		(var dogtagElementsCollection:dhCollection = "getCollectionByPath(componentClass, subcollectionPath)")
	)

	(bind visible "dogtagElementsCollection.length > 0")
	(style (width = 100%))

	
	(tf
		(bind visible "_elementType == SC.Common.DOGTAG_ELEMENTS.NAMES.SYMBOL_UNIQUE")
		(class $TextDefaultBold18NM)
		(style
			(marginBottom = "MS")
			(alpha = "TA")
		)

		(bind text "'IDS_DOGTAGS_' + _elementType + '_GROUP_' + _groupName")
	)

	
	(block
		(style (width = 100%))

		(controller $Repeat renderer='DogtagElementSubgroup'
			(bind items "subgroupSharedArray")
			(args
				_elementType = "_elementType"
				_groupName = "_groupName"
				_subgroupName = "$item"
				_componentClass = "componentClass"
			)
		)
	)
)

(def element DogtagElementSubgroup (_elementType:str, _componentClass:number, _groupName:str, _subgroupName:str, _isDeepSorting:bool=true)
	(scope
		(var subgroupTitle:str = "_isDeepSorting	? 'IDS_DOGTAGS_' + _elementType + '_' + _groupName + '_SUBGROUP_' + _subgroupName
													: 'IDS_DOGTAGS_' + _elementType + '_GROUP_' + _groupName")

		(var dogtagElementsCollection:dhCollection = "getCollectionByPath(_componentClass, _elementType + '.byGroup.' + _groupName + (_isDeepSorting ? '.bySubgroup.' + _subgroupName : ''))")
		(var dogTagGroupFirstEntity:dhEntity = "dogtagElementsCollection.firstEntity")

		(var dogTagComponent:dhComponent = "_elementType == SC.Common.DOGTAG_ELEMENTS.NAMES.BG_COLOR			? dogTagGroupFirstEntity.dollBackgroundColor:
											_elementType == SC.Common.DOGTAG_ELEMENTS.NAMES.BG_BORDER_COLOR		? dogTagGroupFirstEntity.dollBorderColor :
											_elementType == SC.Common.DOGTAG_ELEMENTS.NAMES.BG_MATERIAL			? dogTagGroupFirstEntity.dollTexture
																												: dogTagGroupFirstEntity.dogTagComponent")
		(struct dogTagPrice = PULL_PRICE(_entityId = "dogTagComponent.id" _actionId = "SC.Common.PRICE_ACTION.BUY"))
		(var isGroupPriceVisible:bool = "isIn(dogTagComponent.categoryId, SC.Common.DOGTAG_ELEMENTS.PURCHASABLE) && dogTagComponent.canBuy")
	)

	(bind visible "dogtagElementsCollection.length > 0")

	(style
		(width = 100%)
		(marginBottom = "S")
	)

	(tf
		(bind class "_isDeepSorting && _elementType == SC.Common.DOGTAG_ELEMENTS.NAMES.SYMBOL_UNIQUE ? '$TextDefaultNM' : '$TextDefaultBold18NM'")
		(style
			(marginBottom = "M")
			(bind alpha "_isDeepSorting && _elementType == SC.Common.DOGTAG_ELEMENTS.NAMES.SYMBOL_UNIQUE ? TC : TA")
		)
		(bind text "subgroupTitle")
	)

	(block
		(style (bind paddingBottom "isGroupPriceVisible ? M : 0px"))

		(controller $Instance renderer='PriceTag'
			(bind enabled "isGroupPriceVisible")
			(args
				_priceInfo = "dogTagPrice.info"
				_showDiscountTag = true
			)
		)
	)

	(htile
		(style
			(width = 100%)
			(gap = "M")
			(paddingBottom = "M")
		)

		(controller $DynamicRepeat renderer='DogtagElement'
			(bind items "dogtagElementsCollection")
			(args
				_dogtagElementEntity = "$item"
				_elementType = "_elementType"
			)

			(itemWidth = "DOGTAG_CONTENT_WIDTH")
			(itemHeight = "DOGTAG_CONTENT_WIDTH")
			(itemOffset = "DOGTAG_CONTENT_WIDTH * 3")
			(sharedCache = true)
		)
	)
)

(def element DogtagElement (_dogtagElementEntity:dhEntity, _elementType:str)
	(scope
		
		(struct mouseHandler = MOUSE_HANDLER())
		
		(struct mouseHandlerClickArea = MOUSE_HANDLER())

		(var dogTagComponent:dhComponent = "_dogtagElementEntity.dollBackgroundColor	? _dogtagElementEntity.dollBackgroundColor :
											_dogtagElementEntity.dollBorderColor		? _dogtagElementEntity.dollBorderColor :
											_dogtagElementEntity.dollTexture			? _dogtagElementEntity.dollTexture
																						: _dogtagElementEntity.dogTagComponent")

		(var isNew:bool = "_dogtagElementEntity.hasComponent(CC.newItem)")
		(var isSaved:bool = "_dogtagElementEntity.hasComponent(CC.dogTagComponentSaved)")

		(var dogTagIconPrefix:str = "	_dogtagElementEntity.dollBackgroundColor	? SC.Common.DOGTAG_ELEMENTS.NAMES.BG_COLOR :
										_dogtagElementEntity.dollBorderColor		? SC.Common.DOGTAG_ELEMENTS.NAMES.BG_BORDER_COLOR
																					: ''")

		(var dogTagPreviewComponent:dhComponent = "getSingleComponent(CC.dogTagComponentPreview)")

		(var isUnique:bool = "isIn(_elementType, [SC.Common.DOGTAG_ELEMENTS.NAMES.SYMBOL_PATCH, SC.Common.DOGTAG_ELEMENTS.NAMES.SYMBOL_UNIQUE])")

		(var isSelected:bool = "dogTagPreviewComponent[_elementType] == dogTagComponent.id ||
								isUnique && dogTagPreviewComponent[SC.Common.DOGTAG_ELEMENTS.NAMES.SYMBOL] == dogTagComponent.id ||
								dogTagPreviewComponent[_elementType] == 0 &&
								isSaved && !dogTagPreviewComponent.isUnique" (event "dogTagPreviewComponent.evChanged"))

		(var dogTagName:str =		"dogTagComponent.gpName"	(event "dogTagComponent.evUpdate"))
		(var isEnabled:bool =		"dogTagComponent.enabled"	(event "dogTagComponent.evUpdate"))
		(var dogTagIconDir:str =	"dogTagIconPrefix || dogTagName ? ('url:../dogTags/' + (dogTagIconPrefix ? 'preview/' + dogTagIconPrefix : 'small/' + dogTagName)) : ''")
		(var dogTagIconPath:str =	"dogTagIconDir ? dogTagIconDir + (dogTagComponent.isColorizable ? '/PCNT001' : '') + '.png' : ''")

		(var iconColor:number = "dogTagIconPrefix && dogTagComponent.colorHEX ? toNumber(dogTagComponent.colorHEX) : DOGTAG_BASE_COLOR")

		(macro COLOR_DIFF_TO_COLOR_TRANSFORM "'iconTransform'" "DOGTAG_BASE_COLOR" "iconColor")

		(var progress:array =		"_dogtagElementEntity.dogTagComponent ? dogTagComponent.progress : []" (event "dogTagComponent.evUpdate"))
		(var progressIndex:number =	"progress.length > 0 ? progress.length - 1 : 0" (event "dogTagComponent.evUpdate"))
		(var progressNumber:number = "progress[progressIndex][2] && progress[progressIndex][1] ? progress[progressIndex][2] / progress[progressIndex][1] : 0")

		(var hasInStorage:bool = "dogTagComponent.enabled" (event "dogTagComponent.evUpdate"))
		(var canBuy:bool = "isIn(dogTagComponent.categoryId, SC.Common.DOGTAG_ELEMENTS.PURCHASABLE) && !hasInStorage && dogTagComponent.canBuy")

		(var isFirstRollOverActive:bool = false)
		(bind isFirstRollOverActive "true" init=false watch=false on='rollOver')
	)

	(bind name "'DogTagComponentItemRenderer_' + dogTagName")

	(bindcall externalCall "isNew ? 'inputMapping.onAction' : ''" "['makeSeen', {entityId: _dogtagElementEntity.id}]" init=false watch=false (bind enabled "isNew && mouseHandler.rollOver"))

	(macro STRUCT_MOUSE_DISPATCHER
		_mouseHandler = "mouseHandler"
	)

	(style
		(width = "DOGTAG_CONTENT_WIDTH")
		(height = "DOGTAG_CONTENT_WIDTH")
	)

	
	(block
		(class $FullsizeAbsolute)

		(controller $Instance renderer='ControlBackground'
			(bind enabled "isFirstRollOverActive || isSaved")
			(args
				_mouseDown = "mouseHandlerClickArea.mouseDown"
				_mouseOver = "mouseHandler.rollOver"
				_selected = "isSaved"
				_isSelectedStateInteractive = true
			)
		)
	)

	
	(element DogTagItemView
		_isActive = "isSaved || !isEnabled"
		_iconPath = "dogTagIconPath"
		_hasInStorage = "hasInStorage"
		_isEnabled = "isEnabled"
		_isSelected = "isSelected"
		_iconColorTransform = "dogTagIconPrefix ? iconTransform : CT_NONE"
	)

	(block
		(class $FullsizeAbsolute)
		(controller $Instance renderer ='DogTagOnePixelFrame'
			(bind enabled "isSelected")
		)
	)

	
	(block
		(class $FullsizeAbsolute)
		(style (padding = "-XS"))

		(block
			(class $Fullsize)
			(style (backgroundColor = "NO_COLOR"))

			(macro STRUCT_MOUSE_DISPATCHER
				_mouseHandler = "mouseHandlerClickArea"
			)

			(macro STRUCT_SOUND_HANDLER
				_mouseHandler = "mouseHandler"
				_soundSet = "'button_dogtag'"
			)

			(macro STRUCT_CLICK_HANDLER
				_mouseHandler = "mouseHandlerClickArea"
				_methods = "[{ type: 'inputMapping.onAction', name: isUnique ? 'previewDogTagUnique' : 'previewDogTagConstructor', args: isUnique ? { elementID: dogTagComponent.id } : { elementID: dogTagComponent.id, elementType: _elementType }}]"
			)

			(controller $Tooltip
				(renderer = 'DogTagComponentTooltip')
				(args
					_elementEntityId = "_dogtagElementEntity.id"
					_canInstall = "!isSelected"
				)
				(macro DEFAULT_TOOLTIP_BEHAVIOUR)
			)
		)
	)

	
	(block
		(bind visible "!isEnabled && progress && progressNumber > 0")
		(style
			(position = "absolute")
			(align = "center")
			(width = 100%)
			(bottom = "-S")
		)

		(block
			(style
				(width = 50%)
				(paddingRight = -1px)
				(paddingLeft = -1px)
			)

			(controller $Instance renderer='DefaultProgressBar'
				(bind enabled "!isEnabled && progress && progressNumber > 0")
				(args
					_progress = "progressNumber"
				)
			)
		)
	)

	
	(block
		(style
			(position = "absolute")
			(width = 100%)
			(bottom = "-S")
			(visualOffsetY = "S")
			(alpha = 0)
		)

		(controller $Animation
			(bind enabled "canBuy")
			(bindcall play
				from = "{alpha: 0, visualOffsetY: -S}"
				to = "{alpha: 1, visualOffsetY: 0px}"
				reverse = "!mouseHandler.rollOver"
				duration = 0.12
				easing = "Easing.quad_in"
				action = "killAndContinue"
				(bind trigger "mouseHandler.rollOver")
			)
		)

		(controller $Instance renderer='DogTagPriceButton'
			(bind enabled "canBuy && isFirstRollOverActive")
			(args
				_dogTagComponent = "dogTagComponent"
			)
		)
	)

	
	(block
		(macro DEFAULT_CONTROL_MARKER_ANIMATION "isNew")
		(style
			(hitTest = false)
			(position = "absolute")
			(top = "XS")
			(right = "MS")
		)
		(element MarkerNew)
	)
)

(def element DogTagItemView (	_iconPath:str, _hasInStorage:bool, _isEnabled:bool, _isSelected:bool, _iconColorTransform:dict="CT_NONE",
								_isReward:bool=false, _forceShowIcon:bool=false)
	(bind name "_isSelected ? 'selected' : 'not_selected'")

	(class $FullsizeAbsolute)
	(style (bind alpha "!_hasInStorage && !_isReward && !_forceShowIcon ? 0.3 : 1"))

	(block
		(class $FullsizeAbsolute)
		(style
			(bind backgroundImage "_iconPath")
			(macro DESATURATION_DEFAULT "_isEnabled")
		)
		(bind colorTransform "_iconColorTransform")
	)
)

(def element DogTagPriceButton (_dogTagComponent:dhComponent, _hasInStorage:bool, _isCanBuy:bool = true)
	(scope
		(macro PULL_SHIP_ID)
		(struct dogTagPrice = PULL_PRICE(_entityId = "_dogTagComponent.id" _actionId = "SC.Common.PRICE_ACTION.BUY"))

		(var accountResource:dhComponent =	"getSingleComponent(CC.accountResource)")
		(var isDeficit:bool =				"dogTagPrice.info.finalPrice > accountResource[dogTagPrice.info.currency]" (event "accountResource.evChangedGold"))
		(var isPriceVisible:bool =			"isDeficit && !_hasInStorage && _isCanBuy")

		(var ownShipComponent:dhComponent =	"getPrimaryComponent(CC.ownShip, playerShipId)")
		(var isShipInBalancer:bool =		"ownShipComponent.lock == SC.Common.OWN_SHIP_LOCK.BALANCER" (event "ownShipComponent.evUpdateLock"))

		(var isBuyable:bool =				"!_hasInStorage && _isCanBuy")
		(var isBuyLinkButtonVisible:bool =	"!isPriceVisible && !isShipInBalancer && isBuyable")
	)

	(style
		(align = "center")
		(width = 100%)
		(height = 24px)
	)

	(block
		(bind visible "isPriceVisible")

		(style
			(hitTest = false)
			(marginTop = 18px)
			(marginLeft = "XXS")
			(marginBottom = "XXS")
		)

		(controller $Instance renderer='PriceTag'
			(bind enabled "isPriceVisible")
			(args
				_priceInfo = "dogTagPrice.info"
				_showDiscountTag = true
			)
		)
	)

	(controller $Instance renderer='DefaultButton'
		(bind enabled "isBuyLinkButtonVisible")
		(args
			_width = 80px
			_size = "SIZE.SMALL"
			_isTransactionBtn = true
			_label = 'IDS_BUY_UPPER_CASE'
			_methods = "[	{	type: 'inputMapping.onRequest',
								name: 'showModalBuyDogTag',
								args: { _dogTagElementId: _dogTagComponent.id, _dogTagElementCategoryId: _dogTagComponent.categoryId } }]"
		)
	)
)

(def element DogTagOnePixelFrame ()
	(class $Fullsize)
	(style
		(backgroundImage = 'url:../service_kit/frames/one_pixel_frame_rounded.png')
		(scale9grid = 5)
		(alpha = 0.7)
	)
)