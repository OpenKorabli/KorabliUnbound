(def constant ICON_FEATURE_ALPHA_STATE {
	SC.Ui_styles.BUTTON_STATE.DOWN		: 0.65,
	SC.Ui_styles.BUTTON_STATE.OVER		: 1.1,
	SC.Ui_styles.BUTTON_STATE.UP		: "TA"
})

(def constant CONTENT_MARKER_GROUP_BY_NATION "{
	SC.Common.NATION.RUSSIA:		SC.Ui_common.CONTENT_MARKER_GROUPS.SECONDARY_RESEARCH_TAB_RUSSIA,
	SC.Common.NATION.JAPAN:			SC.Ui_common.CONTENT_MARKER_GROUPS.SECONDARY_RESEARCH_TAB_JAPAN,
	SC.Common.NATION.USA:			SC.Ui_common.CONTENT_MARKER_GROUPS.SECONDARY_RESEARCH_TAB_USA,
	SC.Common.NATION.GERMANY:		SC.Ui_common.CONTENT_MARKER_GROUPS.SECONDARY_RESEARCH_TAB_GERMANY,
	SC.Common.NATION.UK:			SC.Ui_common.CONTENT_MARKER_GROUPS.SECONDARY_RESEARCH_TAB_UK,
	SC.Common.NATION.FRANCE:		SC.Ui_common.CONTENT_MARKER_GROUPS.SECONDARY_RESEARCH_TAB_FRANCE,
	SC.Common.NATION.ITALY:			SC.Ui_common.CONTENT_MARKER_GROUPS.SECONDARY_RESEARCH_TAB_ITALY,
	SC.Common.NATION.PANASIA:		SC.Ui_common.CONTENT_MARKER_GROUPS.SECONDARY_RESEARCH_TAB_PANASIA,
	SC.Common.NATION.EUROPE:		SC.Ui_common.CONTENT_MARKER_GROUPS.SECONDARY_RESEARCH_TAB_EUROPE,
	SC.Common.NATION.NETHERLANDS:	SC.Ui_common.CONTENT_MARKER_GROUPS.SECONDARY_RESEARCH_TAB_NETHERLANDS,
	SC.Common.NATION.PANAMERICA:	SC.Ui_common.CONTENT_MARKER_GROUPS.SECONDARY_RESEARCH_TAB_PANAMERICA,
	SC.Common.NATION.SPAIN:			SC.Ui_common.CONTENT_MARKER_GROUPS.SECONDARY_RESEARCH_TAB_SPAIN
}")

(def element BranchTypeLabel (_shipType:str, _nation:str)
	(scope
		(var isPremiumType:bool = "_shipType == SC.Ships.SHIP_GROUPS.PREMIUM")

		(struct activeTip =			PULL_ACTIVE_GUIDING_TIP())
		(struct checkedTipId =		SAFE_CHECK_ACTIVE_TIP_ID(_tipId = "activeTip.tipId"		_validValues = "[ SC.Context_guiding_tip.TIP_TYPE.SHIP_CLASSES_DESTROYER ]"))

		(var isShipClassesGuidingTipVisible:bool = "checkedTipId.value && _shipType == SC.Common.SHIP_TYPE.DESTROYER")
	)

	(bindcall externalCall "isShipClassesGuidingTipVisible ? 'inputMapping.onAction' : ''" "[ 'deactivateTipChain', { tip_chain_id: SC.Context_guiding_tip.TIP_CHAIN_ID.SHIP_CLASSES_ONBOARDING } ]" init=false watch=false on='rollOver')
	(bindcall externalCall "'inputMapping.onAction'" "[ 'evHighlightBranchByHeaderOver', { shipType: _shipType, country: _nation }]" watch=false on='rollOver')
	(bindcall externalCall "'inputMapping.onAction'" "[ 'evHighlightBranchByHeaderOut', { country: _nation }]" watch=false on='rollOut')
	
	(style
		(flow = "horizontal")
		(backgroundColor = "NO_COLOR")
	)

	(controller $Tooltip
		(renderer = 'ShipBranchTypeTooltip')
		(args
			_shipType = "_shipType"
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR)
	)

	(block
		(controller $Instance renderer='ShipTypeWithText'
			(bind enabled "!isPremiumType")
			(args
				_textAlpha = "TA"
				_iconSize = 30
				_shipType = "_shipType"
				_textClass = '$TextDefaultBold20NM'
			)
		)

		(controller $Instance renderer='GuidingTipHub'
			(bind enabled "isShipClassesGuidingTipVisible")
			(args
				_tipId =			"checkedTipId.value"
				_tipPositioning =	"TIP_POSITION_BOTTOM"
				_offsetY =			"MS"
				_pointerOffset =	"-L"
				_isHideOnBounds =	true
				_modalWindowName =	"SC.Ui_windows.WINDOWS.DOCK"
				_hasAssistant =		true
			)
		)
	)

	(block
		(bind visible "isPremiumType")

		(tf
			(class $TextDefaultBoldNM)
			(style (textColor = "SC.Ui_styles.SERVICE_COLORS.YELLOW"))
			(text = 'IDS_PREMIUMS')
		)
	)
)

(def element ShipTypeWithText (_shipType:str, _isUpperCase:bool = false, _textClass:str='$TextDefaultNM', _textAlpha:number = "TC", _iconSize:number = 27)
	(style
		(flow = "horizontal")
		(align = "middle")
	)

	(block
		(style
			(marginTop = "-S")
			(marginBottom = -10px)
			(marginLeft = -5px)
			(marginRight = "XS")
		)
		(element ShipIcon
			_shipType = "_shipType"
			_iconSize = "_iconSize"
		)
	)

	(tf
		(bind class "_textClass")
		(bind alpha "_textAlpha")
		(bind text "_isUpperCase ? toUpper(tr('IDS_' + _shipType + 'S'))  : 'IDS_' + _shipType + 'S'")
	)
)

(def element ShipsBranchesFeaturesInfoIcon (_branchId:number, _country:str, _useClassGap:bool, _arrowDirection:number)
	(scope
		(macro MOUSE_HANDLER_SCOPE)

		(var classGapOffset:number = "_useClassGap ? (SHIP_TREE_BLOCK_WIDTH / 2) : 0")

		(var tooltipOffset:number = "	_arrowDirection == SC.Common.DIRECTION.UP		?	SHIP_TREE_BLOCK_WIDTH - M - (INFO_ICON_SIZE / 2) + S :
										_arrowDirection == SC.Common.DIRECTION.LEFT		?	(SHIP_TREE_BLOCK_WIDTH * 2) + classGapOffset - (INFO_ICON_SIZE / 2) - M + S
																						:	S")

		(var tooltipReverseOffset:number = "_arrowDirection == SC.Common.DIRECTION.UP		?	tooltipOffset :
											_arrowDirection == SC.Common.DIRECTION.RIGHT	?	(SHIP_TREE_BLOCK_WIDTH * 2) + classGapOffset - (INFO_ICON_SIZE / 2) - M + S
																							:	S")
		
		(var alphaState:number = "	mouseDown	? SC.Ui_styles.BUTTON_STATE.DOWN :
									rollOver	? SC.Ui_styles.BUTTON_STATE.OVER
												: SC.Ui_styles.BUTTON_STATE.UP")
		(var btnAlpha:number = "ICON_FEATURE_ALPHA_STATE[alphaState]")


		(struct activeTip =			PULL_ACTIVE_GUIDING_TIP())
		(struct checkedTipId =		SAFE_CHECK_ACTIVE_TIP_ID(_tipId = "activeTip.tipId"		_validValues = "[ SC.Context_guiding_tip.TIP_TYPE.SHIP_FEATURES_RESEARCH_ICON ]"))

		(var isFeaturesResearchTipVisible:bool = "checkedTipId.value && _branchId == activeTip.targetId")
	)

	(style
		(width = "INFO_ICON_SIZE")
		(height = "INFO_ICON_SIZE")
	)

	(macro MOUSE_EVENTS_DISPATCHER)

	(bindcall externalCall "'inputMapping.onRequest'" "[ 'showModalShipsBranchesFeatures', { _branchId: _branchId, _shipId: 0 }]" watch=false on='leftClick')

	(bindcall externalCall "_branchId ? 'inputMapping.onAction' : ''" "[ 'evHighlightBranchButtonOver',	{ branchId: _branchId, country: _country }]" watch=false on='rollOver')
	(bindcall externalCall "'inputMapping.onAction'" "[ 'evHighlightBranchButtonOut',	{ country: _country }]" watch=false on='rollOut')

	(block
		(class $FullsizeAbsolute)
		(style
			(backgroundImage = "'url:../service_kit/buttons/backgrounds/' + SC.Ui_styles.BUTTON_TYPE.ICON_SECONDARY + '.png'")
			(alpha = "btnAlpha")
		)

		(macro DEFAULT_CONTROL_STATE_ANIMATION_ALPHA
			_trigger = "alphaState"
			_alpha = "btnAlpha"
		)

		(block
			(class $Fullsize)
			(style (backgroundImage = "'url:../service_kit/buttons/icons/' + SC.Ui_styles.BUTTON_ICON.INFO + '.png'"))
		)

		(controller $Tooltip
			(renderer = 'ShipsBranchesFeaturesTooltip')
			(args
				_branchId = "_branchId"
			)
			(macro DEFAULT_TOOLTIP_BEHAVIOUR)

			(align = "right|innerTop")
			(bind offsetMap "{ left: tooltipReverseOffset, top: -1px, right: tooltipOffset, bottom: 0px }")
			(position = "borderNoTrack")
		)
	)

	(controller $Instance renderer='GuidingTipHub'
		(bind enabled "isFeaturesResearchTipVisible")
		(args
			_tipId =				"checkedTipId.value"
			_tipPositioning =		"TIP_POSITION_TOP"
			_pointerOffset =		20px
			_alongPointerOffset =	-25px
			_offsetX =				24px
			_offsetY =				"XS"
			_screenOffsetLeft =		10px
			_isHideOnBounds =		true
			_modalWindowName =		"SC.Ui_windows.WINDOWS.DOCK"
			_hasAssistant =			true
		)
	)
)

(def element ParagonsDropBranchButton (_shipId:number, _country:str)
	(scope
		(event evRollOver)
		(event evRollOut)
		(var rollOver:bool = "$event.isOver ?: false" watch=false (event "evRollOver") (event "evRollOut"))

		(var paragonSeasonEntity:dhEntity = "getSingleEntity(CC.paragonSeason)")
		(var dropsSharedMade:number = "paragonSeasonEntity.paragonSeason.dropsSharedMade" (event "paragonSeasonEntity.paragonSeason.evUpdateDropsMade"))
		(var bonusTagsForFirstDrop:number = "paragonSeasonEntity.paragonSeason.bonusTagsForFirstDrop" (event "paragonSeasonEntity.paragonSeason.evUpdate"))
	)
	(dispatch evRollOver	on='rollOver'	args="{isOver: true}")
	(dispatch evRollOut		on='rollOut'	args="{isOver: false}")

	(bindcall externalCall "'inputMapping.onRequest'" "[ 'showPreviewParagonsDropBranch', { shipId: _shipId }]" watch=false (event "evRollOver"))
	(bindcall externalCall "'inputMapping.onAction'" "[ 'evParagonDropBranchButtonOver', { shipId: _shipId, country: _country }]" watch=false (event "evRollOver"))
	(bindcall externalCall "'inputMapping.onAction'" "[ 'evParagonDropBranchButtonOut', { country: _country }]" watch=false (event "evRollOut"))
	(bindcall externalCall "'inputMapping.onAction'" "[ 'evParagonDropBranchButtonOut', { country: _country }]" watch=false on='removedFromStage')

	(bind name 'paragons_drop_branch_icon')

	(style
		(width = 100%)
		(height = 52px)
		(align = "center")
		(backgroundColor = "NO_COLOR")
	)

	(block
		(style (hitTest = false))

		(controller $Animation
			(bindcall play
				duration = 0.15
				from = "{ alpha: 1, visualOffsetY: 0px }"
				to = "{ alpha: 0, visualOffsetY: 10px }"
				easing = "Easing.quad_out"
				action = "kill"
				reverse = "!rollOver"
				(bind trigger "rollOver")
			)
		)

		(block
			(style
				(width = 32px)
				(height = 32px)
				(backgroundImage = 'url:../paragons/icon_reset_ships_active.png')
			)
		)

		(block
			(bind visible "bonusTagsForFirstDrop > 1 && dropsSharedMade == 0")
			(style
				(position = "absolute")
				(right = -10px)
				(bottom = "XXS")
			)
			
			(tf
				(class $TextDefaultBold22NM)
				(style (alpha = "TA"))
				(bind text "'x' + bonusTagsForFirstDrop")
			)
		)
	)

	(block
		(style
			(position = "absolute")
			(width = 100%)
			(align = "center")
			(visualOffsetY = 20px)
			(alpha = 0)
		)
		(visible = false)

		(controller $Animation
			(bindcall play
				duration = 0.15
				from = "{ alpha: 0, visible: false, visualOffsetY: 20px }"
				to = "{ alpha: 1, visible: true, visualOffsetY: 0px }"
				easing = "Easing.quad_out"
				action = "kill"
				reverse = "!rollOver"
				(bind trigger "rollOver")
			)
		)

		(element DefaultButton
			_name = 'paragons_drop_branch_button'
			_width = 162px
			_label = 'IDS_DROP_BRANCH_BUTTON'
			_methods = "[{	type: 'inputMapping.onRequest',
							name: 'showModalParagonsDropBranch',
							args: { shipId: _shipId }}]"
		)
	)
)

(def element VehicleRestorationResearchTreeFooter ()
	(scope
		(var userTaskEntity:dhEntity = "getSingleEntity(CC.userTask)")
		(var currentUserTaskFlags:array = "userTaskEntity.userTask.flags ?: []" (event "userTaskEntity.userTask.evFlagChanged"))
		(var hasRestorableShips:bool = "toBool(getCollection(CC.restorableShip).length)")
		(var isNew:bool = "hasRestorableShips && currentUserTaskFlags[BINARY_SHIFT_MAP[SC.Common.USER_TASKS_FLAGS.KNOWS_ABOUT_SHIP_RESTORATION]] == 0")

		(var formattedDate:str = "formatTime(SC.Common.SHIP_RESTORATION.RESTORED_SINCE_DATE, 'dd.MM.yy', '', true)")
		(var paragraphItems:array = "['IDS_SHIP_RESTORATION_DESCRIPTION_PARAGRAPH_1', 'IDS_SHIP_RESTORATION_DESCRIPTION_PARAGRAPH_2']")
	)
	(style
		(flow = "horizontal")
		(width = "{ 1280:550px, 1920:700px }")
	)

	(block
		(style
			(width = 80px)
			(height = 80px)
			(marginRight = "L")
			(backgroundSize = "cover")
			(backgroundImage = 'url:../service_kit/research_tree_footer/icon_ship_restoration.png')
		)
	)

	(block
		(style (width = 100%))

		(tf
			(class $TextDefaultBold24NM)
			(style
				(width = 100%)
				(marginBottom = "M")
				(alpha = "TA")
			)
			(text = 'IDS_SHIP_RESTORATION_FOOTER_TITLE')
		)

		(block
			(style
				(width = 100%)
				(marginBottom = "SXS")
				(vgap = "SXS")
				(alpha = "TC")
			)

			(controller $Repeat renderer='RepeatParagraphItemNM'
				(bind count "paragraphItems.length")
				(args
					_paragraphText = "paragraphItems[$index]"
					_width = 100%
					_size = "SC.Ui_styles.SIZE.LARGE"
					_leading = -1
				)
			)
		)

		(tf
			(class $TextDefaultNM)
			(style
				(width = 100%)
				(marginBottom = "MS")
				(alpha = "TS")
			)
			(bind text "subst('IDS_SHIP_RESTORATION_RESTORED_SINCE', [], {_date: formattedDate})")
		)

		(block
			(block
				(element DefaultButton
					_enabled = "hasRestorableShips"
					_width = 164px
					_label = 'IDS_SHIP_RESTORATION_SHIP_LIST'
					_methods = "[	{	type: 'inputMapping.onRequest',
										name: 'showModalShipRestoration',
										args: { } },
									 {	type: isNew ? 'inputMapping.onAction' : '',
										name: 'ServerUIDataUSS.setUserTaskExecuted',
										args: { taskId: BINARY_SHIFT_MAP[SC.Common.USER_TASKS_FLAGS.KNOWS_ABOUT_SHIP_RESTORATION] }
									 }]"
				)
			)

			(controller $Tooltip
				(bind enabled "!hasRestorableShips")
				(renderer = 'SimpleStatusTooltip')
				(args
					_text = 'IDS_NO_SHIPS_TO_RESTORE_HINT'
					_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.WARNING"
				)
				(macro DEFAULT_TOOLTIP_BEHAVIOUR)
			)

			
			(block
				(macro DEFAULT_CONTROL_MARKER_ANIMATION "isNew")
				(class $MarkerNewButtonPosition)

				(element MarkerNew)
			)
		)
	)
)

(def element ParagonsResearchTreeFooter (_currentNationName:str)
	(scope
		(event evScrollToBottom)
		(var userTaskEntity:dhEntity = "getSingleEntity(CC.userTask)")
		(var currentUserTaskFlags:array = "userTaskEntity.userTask.flags ?: []" (event "userTaskEntity.userTask.evFlagChanged"))
		(var isNotSeenParagonInShipTree:bool = "currentUserTaskFlags[BINARY_SHIFT_MAP[SC.Common.USER_TASKS_FLAGS.KNOWS_ABOUT_PARAGONS_IN_SHIP_TREE]] == 0")

		(var paragonSeasonEntity:dhEntity = "getSingleEntity(CC.paragonSeason)")
		(var paragonSeasonEndDate:number = "paragonSeasonEntity.paragonSeason.endDate" (event "paragonSeasonEntity.paragonSeason.evUpdate"))
		(var paragonSeasonDropsSharedMade:number = "paragonSeasonEntity.paragonSeason.dropsSharedMade" (event "paragonSeasonEntity.paragonSeason.evUpdateDropsMade"))
		(var bonusTagsForFirstDrop:number = "paragonSeasonEntity.paragonSeason.bonusTagsForFirstDrop" (event "paragonSeasonEntity.paragonSeason.evUpdate"))

		(macro SERVER_TIME_SCOPE)
		(macro COUNTDOWN_SCOPE _scopeName="'paragonSeasonTimeToFinish'" _time="paragonSeasonEndDate" _format="'HIGHEST'" _declination="'ACC'" _isLocalTime="true")

		(var isMultiplierAvailable:bool = "bonusTagsForFirstDrop > 1 && paragonSeasonDropsSharedMade == 0")
	
		(var paragraphItems:array = "[	{ text: isMultiplierAvailable	? subst('IDS_PARAGON_BONUS_FOOTER_MULTIPLIER_INFO', [], { multiplier: bonusTagsForFirstDrop })
																		: 'IDS_PARAGON_BONUS_FOOTER_NO_MULTIPLIER_INFO' },
										{ text: 'IDS_PARAGON_BONUS_FOOTER_SPECIAL_STORAGE_INFO'}]")


		(struct activeTip =			PULL_ACTIVE_GUIDING_TIP())
		(struct checkedTipId =		SAFE_CHECK_ACTIVE_TIP_ID(_tipId = "activeTip.tipId"		_validValues = "[ SC.Context_guiding_tip.TIP_TYPE.PARAGONS_RULES ]"))

		(var isGuidingTipVisible:bool = "checkedTipId.value && isNotSeenParagonInShipTree")
	)

	(dispatch evScrollToBottom	delay=0.15 dir="EventDirection.UP"	on='addedToStage' (bind enabled "isGuidingTipVisible"))
	(dispatch evScrollToBottom	delay=0.15 dir="EventDirection.UP"	(bind enabled "isGuidingTipVisible") (bind trigger "isGuidingTipVisible"))
	(dispatch evScrollToBottom	delay=0.15 dir="EventDirection.UP"	(bind trigger "_currentNationName") (bind enabled "isGuidingTipVisible"))

	(style
		(flow = "horizontal")
		(width = "{ 1280:550px, 1920:700px }")
	)

	(block
		(style
			(width = 80px)
			(height = 80px)
			(marginRight = "L")
			(backgroundSize = "cover")
			(backgroundImage = 'url:../service_kit/research_tree_footer/icon_paragon_rules.png')
		)
	)

	(block
		(style (width = 100%))

		(tf
			(class $TextDefaultBold24NM)
			(style
				(width = 100%)
				(marginBottom = "M")
				(alpha = "TA")
			)
			(text = 'IDS_PARAGON_FOOTER_TITLE')
		)

		(block
			(style
				(width = 100%)
				(marginBottom = "SXS")
				(vgap = "SXS")
				(alpha = "TC")
			)

			(controller $Repeat renderer='RepeatParagraphItemNM'
				(bind count "paragraphItems.length")
				(args
					_paragraphText = "paragraphItems[$index].text"
					_width = 100%
					_size = "SC.Ui_styles.SIZE.LARGE"
					_leading = -1
				)
			)
		)

		(tf
			(class $TextDefaultNM)
			(style
				(width = 100%)
				(marginBottom = "MS")
				(alpha = "TS")
			)
			(bind text "subst('IDS_PARAGON_BONUS_SEASON_UPDATE', [], {timeUntilMultiplier: paragonSeasonTimeToFinish})")
		)

		(block
			(block
				(element DefaultButton
					_width = 164px
					_label = 'IDS_PRMP_DETAILS_BUTTON'
					_methods = "[	{	type: 'inputMapping.onRequest',
										name: 'showParagonRules',
										args: { rulesType: 'paragons' } },
									{	type: isNotSeenParagonInShipTree ? 'inputMapping.onAction' : '',
										name: 'ServerUIDataUSS.setUserTaskExecuted',
										args: { taskId: BINARY_SHIFT_MAP[SC.Common.USER_TASKS_FLAGS.KNOWS_ABOUT_PARAGONS_IN_SHIP_TREE] }
								}]"
				)
			)

			(controller $Instance renderer='GuidingTipHub'
				(bind enabled "isGuidingTipVisible")
				(args
					_tipId =			"checkedTipId.value"
					_tipPositioning =	"TIP_POSITION_RIGHT"
					_offsetX =			"XS"
					_pointerOffset =	"-L"
					_isHideOnBounds =	true
					_modalWindowName =	"SC.Ui_windows.WINDOWS.DOCK"
				)
			)

			
			(block
				(macro DEFAULT_CONTROL_MARKER_ANIMATION "isNotSeenParagonInShipTree")
				(class $MarkerNewButtonPosition)

				(element MarkerNew)
			)
		)
	)
)

(def element NationTabButton (_nationRoute:str, _sidePaddings:dict)
	(scope
		(struct routeMenuData = ROUTE_MENU_DATA(_route = "_nationRoute"))
		(struct markerData = PULL_MARKER_NEW(_groupName = "CONTENT_MARKER_GROUP_BY_NATION[_nationRoute]"))
	)
	(bind name "'button_tree_' + _nationRoute")

	(element DockSecondaryImageTabButton
		_imageUrl = "'swf:../nation_flags/ships_tree_svg/ships_tree_svg.swf:flag_' + _nationRoute"
		_isEnabled = "routeMenuData.isEnabled"
		_isSelected = "routeMenuData.isActive"
		_markerType = "markerData.markerType"
		_methods = "[{ type: 'inputMapping.onAction', name: 'navigateTo', args: { route: _nationRoute } }]"
		_sidePaddings = "_sidePaddings"
		_data = "{ nation: _nationRoute }"
	)

	(controller $Tooltip
		(renderer = 'SimpleStatusTooltip')
		(args
			_text = "'IDS_' + toUpper(_nationRoute)"
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR)
	)
)

(def element CurrentXPMedium (_label:str, _exp:number, _fontSize:number)
	(name = 'upgrade_tree_CurrentShipXP')

	(hblock
		(style
			(align = "middle")
			(marginBottom = "XXS")
		)

		(block
			(style (marginRight = 3px))
			(tf
				(class $TextDefaultBold18NM)
				(class $FontColorExp)
				(bind text "formatSeparator(_exp)")
			)
		)

		(block
			(style
				(width = 24px)
				(height = 24px)
				(backgroundImage = 'url:../service_kit/currencies/icon_exp.png')
			)
		)
	)
	
	(tf
		(class $TextDefaultNM)
		(style (alpha = 0.8))
		(bind text "_label")
	)
)

(def element ShipTreeMenu (_shipId:number, _disableShipActions:bool=false)
	(scope
		(var shipEntity:dhEntity = "getPrimaryEntity(CC.ship, _shipId)")
		(var upgradableShipInfo:dhComponent = "shipEntity.upgradableShipInfo")
		(var shipInfo:dhComponent = "shipEntity.ship")

		(struct shipBuyPrice = PULL_PRICE(_entityId = "toString(_shipId)" _actionId = "SC.Common.PRICE_ACTION.BUY"))

		(var fullName:str = "shipInfo.fullName" (event "shipInfo.evUpdate"))
		(var group:str = "shipInfo.group" (event "shipInfo.evUpdate"))
		(var canBuy:bool = "shipInfo.canBuy" (event "shipInfo.evUpdate"))
		(var isEventLike:bool = "shipInfo.isEventLike" (event "shipInfo.evUpdate"))

		(var isNotEventGroup:bool = 		"group != SC.Ships.SHIP_GROUPS.EVENT")
		(var isNotEarlyAccessGroup:bool = 	"group != SC.Ships.SHIP_GROUPS.EARLY_ACCESS")

		(var shipOwnEntity:dhEntity = "getPrimaryEntity(CC.ownShip, _shipId)" watch=false)
		(var shipComponent:dhComponent = "shipOwnEntity.ship")
		(var ownShipComponent:dhComponent = "shipOwnEntity.ownShip")
		(var isOwned:bool =	"shipOwnEntity != null")

		(var isNeedRepair:bool =	"ownShipComponent.isNeedRepair"		(event "ownShipComponent.evUpdateDockState"))
		(var isTimeRent:bool =		"toBool(ownShipComponent.timeRent)"	(event "ownShipComponent.evUpdateDockState"))
		(var isSellable:bool =		"ownShipComponent.sellable"			(event "ownShipComponent.evUpdateConfig"))
		(var crewId:number =		"ownShipComponent.crewId"			(event "ownShipComponent.evCrewChanged"))
		(var isWithoutCrewPenalty:bool = "shipComponent.isWithoutCrewPenalty" (event "shipComponent.evUpdate"))

		(var isShipInBalancer:bool =		"ownShipComponent.lock == SC.Common.OWN_SHIP_LOCK.BALANCER"				(event "ownShipComponent.evUpdateLock"))
		(var isShipReadyForBattle:bool =	"ownShipComponent.lock == SC.Common.OWN_SHIP_LOCK.DIVISION_IS_READY"	(event "ownShipComponent.evUpdateLock"))

		
		(var resourceEntity:dhEntity = "getSingleEntity(CC.accountResource)")
		(var accountResourceComponent:dhComponent = "resourceEntity.accountResource")
		(var accountGold:number = "accountResourceComponent.gold ?: 0" (event "accountResourceComponent.evChangedGold"))
		(var accountCredits:number = "accountResourceComponent.credits ?: 0" (event "accountResourceComponent.evChangedCredit"))
		
		(var moneyDeficit:number =	"shipBuyPrice.info.currency == SC.Result_screen.FORMAT.GOLD	? shipBuyPrice.info.finalPrice - accountGold
																								: shipBuyPrice.info.finalPrice - accountCredits")
		(var isEnoughMoney:bool =	"moneyDeficit <= 0")
		
		
		(var shipCrossResearchInfoComponent:dhComponent = "getSingleComponent(CC.shipCrossResearchInfo)")
		(var isResearchAvailable:bool = "shipCrossResearchInfoComponent.isResearchAvailable" (event "shipCrossResearchInfoComponent.evChanged"))

		
		(var isSupership:bool =	"shipEntity && shipInfo.level == SC.Ships.SHIP_LEVELS.SUPER_SHIP")
		(var superShipFeatureEntity:dhEntity = "getSingleEntity(CC.superShipFeature)")
		(var superShipFeatureComponent:dhComponent = "superShipFeatureEntity.superShipFeature")
		(var isUnlockedSuperShipFeature:bool = "superShipFeatureComponent.isUnlocked" (event "superShipFeatureComponent.evUpdate"))

		(var lastBoardedCrewId:number =	"shipInfo.lastBoardedCrewId"	(event "shipInfo.evLastBoardedCrewIdChanged") (event "shipInfo.evUpdate"))

		(struct lastBoardedCrew =		PULL_CREW(_crewId = "lastBoardedCrewId"))

		(var hasLastBoardedCrew:bool =	"lastBoardedCrew.entity != null")
		(var isReturnLastCrewButtonVisible:bool = "crewId == 0 && lastBoardedCrewId != 0 && hasLastBoardedCrew")

		(var otherShipEntity:dhEntity = "getPrimaryEntity(CC.ownShip, lastBoardedCrew.component.shipID)")
		(var otherShipComponent:dhComponent = "otherShipEntity.ownShip")

		(var isOtherShipExist:bool =			"otherShipEntity != null")
		(var isOtherShipInBalancer:bool =		"otherShipComponent.lock == SC.Common.OWN_SHIP_LOCK.BALANCER"				(event "otherShipComponent.evUpdateLock"))
		(var isOtherShipReadyForBattle:bool =	"otherShipComponent.lock == SC.Common.OWN_SHIP_LOCK.DIVISION_IS_READY"		(event "otherShipComponent.evUpdateLock"))

		(var isLastBoardedCrewLocked:bool =	"isOtherShipExist && (isOtherShipInBalancer || isOtherShipReadyForBattle)")
		(var isReturnCrewDisabled:bool = "isShipInBalancer || isShipReadyForBattle || isLastBoardedCrewLocked")

		(var canAssignWithoutRetrain:bool = "lastBoardedCrew.component && lastBoardedCrew.component.specializationID == _shipId || isWithoutCrewPenalty")

		(struct researchTreeFeatures = FEATURES(_state = 17))
		(var isResearchStateNotLocked:bool = "researchTreeFeatures.state != 'locked'")

		(var cantBuyReason:str = "shipBuyPrice.info.currency == SC.Result_screen.FORMAT.GOLD ? 'IDS_NOT_ENOUGH_GOLD' : 'IDS_NOT_ENOUGH_CREDITS'")
		(var cantResearchReason:str = "isSupership && !isUnlockedSuperShipFeature ? 'IDS_RESEARCH_SUPERSHIP_SHORT_INFO' : 'IDS_NOT_ENOUGH_EXP'")

		(struct overviewRoute = PULL_FULL_ROUTE(_id = "SC.Ui_windows.ROUTE.OVERVIEW"))
		(struct upgradesRoute = PULL_FULL_ROUTE(_id = "SC.Ui_windows.ROUTE.UPGRADES"))

		(var isLockAction:bool = "isShipInBalancer || isShipReadyForBattle || isNeedRepair")

		(var isItemBuyShipVisible:bool = "	(!isOwned || isTimeRent) &&
											isResearchStateNotLocked && 
											upgradableShipInfo.isExplored && 
											canBuy &&
											!_disableShipActions")
		
		(var isItemResearchVisible:bool = "	isResearchStateNotLocked &&
											!upgradableShipInfo.isExplored &&
											!isEventLike &&
											isNotEarlyAccessGroup &&
											isNotEventGroup")

		(var isItemLinkGroupVisible:bool = "isResearchStateNotLocked &&
											isOwned &&
											!isLockAction &&
											!_disableShipActions")

		(var isItemSellShipVisible:bool = "	isItemLinkGroupVisible &&
											isSellable &&
											!isTimeRent")

		(var isItemExchageForShipCoinVisible:bool = "	!isOwned &&
														shipInfo.level in SHIP_COINS_LEVELS_ALL &&
														isIn(shipInfo.group, SC.Ships.SHIP_GROUPS.UPGRADEABLE_ALL) &&
														accountResourceComponent[SHIP_LEVEL_TO_SHIP_COINS[shipInfo.level]] > 0"	(event "accountResourceComponent.evChangedShipcoin"))

		(var isDividerVisible:bool = "isOwned || isItemBuyShipVisible || isItemResearchVisible")
		(var isGroupDividerVisible:bool = "(!isDividerVisible || isReturnLastCrewButtonVisible || isItemSellShipVisible || isItemBuyShipVisible) && isOwned")
	)

	(name = 'ShipContextMenu')
	(bind class "isItemResearchVisible ? '$ContextMenuDimensions' : '$ContextCarouselMenuDimensions'")

	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND _isInfotip="true")

	(element INFOTIP_SYSTEM_DEFAULT_CONTAINER _hasInsideOffset = true
		

		(block
			(style
				(width = 100%)
				(vgap = "XXS")
			)

			(block
				(style (width = 100%))
				(name = 'ShipContextMenu_Overview')
				(controller $Instance renderer='ContextMenuItem'
					(bind enabled "isResearchStateNotLocked")
					(args
						_title = 'IDS_SECONDARY_TAB_BUTTON_OVERVIEW'
						_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.DEFAULT"
						_methods = "[{ type: 'inputMapping.onAction', name: 'selectShip', args: { shipId: _shipId } },
									 { type: 'inputMapping.onAction', name: 'navigateTo', args: { route: SC.Ui_windows.ROUTE.OVERVIEW } }]"
					)
				)
			)

			(block
				(style (width = 100%))
				(name = 'ShipContextMenu_Upgrades')
				(controller $Instance renderer='ContextMenuItem'
					(bind enabled "isResearchStateNotLocked")
					(args
						_title = 'IDS_SECONDARY_TAB_BUTTON_UPGRADES'
						_methods = "[	{ type: 'inputMapping.onAction', name: 'selectShip', args: { shipId: _shipId } },
										{ type: 'inputMapping.onAction', name: 'navigateTo', args: { route: SC.Ui_windows.ROUTE.UPGRADES } }]"
					)
				)
			)

			(block
				(style (width = 100%))
				(controller $Instance renderer='ContextMenuItem'
					(bind enabled "isNotEventGroup")
					(args
						_title = 'IDS_SHIP_BRANCHES_FEATURE'
						_methods="[ {
										type:	'inputMapping.onRequest',
										name:	'showModalShipsBranchesFeatures',
										args:	{ _branchId: shipEntity.ship.branchId, _shipId: _shipId }
									}]"
					)
				)
			)

			(block
				(style (width = 100%))
				(controller $Instance renderer='ContextMenuItem'
					(bind enabled "shipEntity.shipMastery != null")
					(args
						_title = 'IDS_SHIP_MASTERY'
						_methods="[ {
										type:	'inputMapping.onAction',
										name:	'selectShip',
										args:	{shipId: _shipId}
									},
									{
										type:	'inputMapping.onAction',
										name:	'navigateTo',
										args:	{ route: SC.Ui_windows.ROUTE.SHIP_MASTERY }
									}]"
					)
				)
			)

			(block
				(style (width = 100%))
				(element ContextMenuItem
					_title = 'IDS_SHIP_PREVIEW'
					_methods="[ {
									type:	'inputMapping.onAction',
									name:	'selectShip',
									args:	{shipId: toNumber(_shipId)}
								},
								{
									type:	'inputMapping.onAction',
									name:	'navigateTo',
									args:	{ route: SC.Ui_windows.ROUTE.SHIP_INFO }
								}]"
				)
			)
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='ContextMenuHorizontalDivider'
				(bind enabled "isDividerVisible")
			)
		)

		(block
			(style
				(width = 100%)
				(vgap = "XXS")
			)

			
			(block
				(name = 'ShipContextMenu_Primary')
				(style (width = 100%))
				(bind alpha "isReturnCrewDisabled ? 0.5 : 1")
				(controller $Instance renderer='ContextMenuItem'
					(bind enabled "isReturnLastCrewButtonVisible")
					(args
						_title =	'IDS_CREW_HIRE_LAST_CREW'
						_enabled =	"!isReturnCrewDisabled"
						_methods =	"[{	type:	'inputMapping.onAction',
										name:	'selectShip',
										args:	{ shipId: _shipId } },
									  {	type:	!canAssignWithoutRetrain ? 'inputMapping.onRequest' : 'inputMapping.onAction',
										name:	!canAssignWithoutRetrain ? SC.Ui_methods.CREW_METHODS.OPEN_CREW_RETRAIN_WINDOW : SC.Ui_methods.CREW_METHODS.ASSIGN_TO_SHIP,
										args:	{ crewId: lastBoardedCrewId, shipId: _shipId } }]"
					)
				)

				(controller $Tooltip
					(bind enabled "isReturnLastCrewButtonVisible")
					(renderer = 'CrewTooltip')
					(args
						_crewId = "lastBoardedCrewId"
						_targetShipId = "_shipId"
						_noContextMenuInstruction = "true"
					)
					(macro DEFAULT_TOOLTIP_BEHAVIOUR)
				)
			)

			
			(block
				(name = 'ShipContextMenu_Sell')
				(style (width = 100%))
				(controller $Instance renderer='ContextMenuItem'
					(bind enabled "isItemSellShipVisible")
					(args
						_title = 'IDS_SELL'
						_methods = "[{
										type:	'inputMapping.onRequest',
										name:	'sellShipWindow',
										args:	{	shipId:	_shipId,
													shipName:	fullName }
									}]"
					)
				)
			)

			
			(block
				(name = 'ShipContextMenu_Purchase')
				(style (width = 100%) )
				(controller $Instance renderer='ContextMenuItem'
					(bind enabled "isItemBuyShipVisible")
					(args
						_title = 'IDS_DO_PURCHASE'
						_enabled = "isEnoughMoney"
						_methods = "[{
										type:	'inputMapping.onAction',
										name:	'purchaseShip',
										args:	{	shipId:	_shipId }
									}]"
					)
				)

				(controller $Tooltip
					(bind enabled "!isEnoughMoney")
					(renderer = 'SimpleStatusTooltip')
					(args
						_text = "cantBuyReason"
						_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.NEGATIVE"
					)
					(macro DEFAULT_TOOLTIP_BEHAVIOUR)
				)
			)

			
			(block
				(name = 'ShipContextMenu_Research')
				(style (width = 100%))
				(controller $Instance renderer='ContextMenuItem'
					(bind enabled "isItemResearchVisible")
					(args
						_title = 'IDS_DO_RESEARCH'
						_enabled = "isResearchAvailable"
						_methods = "[ {
										type:	'inputMapping.onAction',
										name:	'researchShip',
										args:	{ shipId: _shipId }
									},
									{
										type:	'inputMapping.onAction',
										name:	'selectShip',
										args:	{ shipId: _shipId }
									}]"
					)
				)
				(controller $Tooltip
					(bind enabled "!isResearchAvailable")
					(renderer = 'SimpleStatusTooltip')
					(args
						_text = "cantResearchReason"
						_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.NEGATIVE"
					)
					(macro DEFAULT_TOOLTIP_BEHAVIOUR)
				)
			)

			(block
				(name = 'ShipContextMenu_ExchangeForCoin')
				(style (width = 100%) )
				(controller $Instance renderer='ContextMenuItem'
					(bind enabled "isItemExchageForShipCoinVisible")
					(args
						_title = 'IDS_EXCHANGE_FOR_SHIP_COINS'
						_methods = "[
							{
								type: 'inputMapping.onRequest',
								name: 'exchangeShipForCoin',
								args: { _shipId: _shipId }
							}
						]"
					)
				)
			)

		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='ContextMenuHorizontalDivider'
				(bind enabled "isGroupDividerVisible")
			)
		)

		
		(block
			(name = 'ShipContextMenu_SetGroup')
			(style (width = 100%))
			(controller $Instance renderer='ContextMenuShipGroupChooser'
				(bind enabled "isOwned")
				(args
					_shipId = "_shipId"
				)
			)
		)
	)
)

(def element ShipContextMenuRepairDock (_shipId:number)
	(scope
		(var shipEntity:dhEntity = "getPrimaryEntity(CC.ship, _shipId)")
	)
	(name = 'ShipContextMenuRepairDock')
	(class $ContextMenuDimensions)

	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND _isInfotip="true")

	(element INFOTIP_SYSTEM_DEFAULT_CONTAINER _hasInsideOffset = true
		(element ContextMenuItem
			_title = 'IDS_SHIP_BRANCHES_FEATURE'
			_methods="[{	type: 'inputMapping.onRequest',
							name: 'showModalShipsBranchesFeatures',
							args: { _branchId: shipEntity.ship.branchId, _shipId: _shipId }}]"
		)
	)
)
