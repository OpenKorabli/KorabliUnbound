(def element ModalShipRestorationConfirmation (_shipId:number, _needBuySlot:bool, _priceInfo:dict, _optionalPriceInfo:dict)
	(macro MODAL_WINDOW_INIT)
	(macro MODAL_WINDOW_BG)
	(name = 'ModalShipRestorationConfirmation')

	(block
		(class $EyeLevelAligned)
		(style
			(width = 500px)
			(align = "center")
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
			(style
				(width = 100%)
				(marginBottom = "MS")
			)
			(element ModalWindowShortHeader
				_header = 'IDS_CONFIRMATION'
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 2)
			(style (marginBottom = "MS"))
			(element ModalWindowSystemPurchaseItemPriceAndInfo
				_priceInfo =			"_priceInfo"
				_optionalPriceInfo =	"_optionalPriceInfo"
				_questionString =		'IDS_QUESTION_RESTORE_FOR'
			)
		)

		(block
			(macro DEFAULT_MODAL_WINDOW_ANIMATION 3)
			(element ModalWindowSystemPurchaseItemYesNoCloseButtons
				_okMethods = "[{	type: 'inputMapping.onRequest',
									name: 'restoreShip',
									args: { shipID: _shipId, needBuySlot: _needBuySlot } }]"
			)
		)
	)
)
